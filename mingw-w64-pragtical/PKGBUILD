_realname='pragtical'
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=3.13.1
pkgrel=1
pkgdesc='The practical and pragmatic code editor. (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://pragtical.dev/'
msys2_repository_url='https://github.com/pragtical/pragtical'
msys2_references=(
  'archlinux: pragtical'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-freetype"
  "${MINGW_PACKAGE_PREFIX}-harfbuzz"
  "${MINGW_PACKAGE_PREFIX}-luajit"
  # "${MINGW_PACKAGE_PREFIX}-mbedtls" # requires 4.1 which we don't have yet, uses submodule instead
  "${MINGW_PACKAGE_PREFIX}-pcre2"
  "${MINGW_PACKAGE_PREFIX}-sdl3"
  "${MINGW_PACKAGE_PREFIX}-sdl3-image"
  "${MINGW_PACKAGE_PREFIX}-sdl3-mixer"
  "${MINGW_PACKAGE_PREFIX}-sdl3-net"
  "${MINGW_PACKAGE_PREFIX}-uchardet"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-git"
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
)
source=(
  "https://github.com/pragtical/pragtical/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
  '0001-pragtical-meson-fix-install.patch'
)
sha256sums=('962b4f14d2f26d0cb18d2de7a02010fe3db4d9e6a7f322071375eb3c746acfad'
            'd52d8a6f470b4da2b93aa964ffdcdb4bdfd557705bb38ab50154e1b0d1f2a8b1')

prepare() {
  cd "${_realname}-${pkgver}"

  patch -Np1 -i "${srcdir}/0001-pragtical-meson-fix-install.patch"
}

build() {
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    meson setup \
      --prefix="${MINGW_PREFIX}" \
      --auto-features=enabled \
      --buildtype=plain \
      -Duse_system_lua=true \
      -Dppm=false \
      "${_realname}-${pkgver}" \
      "build-${MSYSTEM}"

  meson compile -C "build-${MSYSTEM}"
}

package() {
  meson install -C "build-${MSYSTEM}" --destdir "${pkgdir}"

  install -Dm644 "${_realname}-${pkgver}/LICENSE" -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
