# Maintainer: Konstantin Podsvirov <konstantin@podsvirov.su>

_realname=typer
pkgbase="mingw-w64-python-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.27.3
pkgrel=1
pkgdesc='Build great CLIs. Easy to code. Based on Python type hints (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://typer.tiangolo.com/'
msys2_repository_url='https://github.com/fastapi/typer'
msys2_changelog_url='https://github.com/fastapi/typer/blob/master/docs/release-notes.md'
msys2_references=(
  'anitya: 58739'
  'archlinux: python-typer'
  'gentoo: dev-python/typer'
  'purl: pkg:pypi/typer'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-annotated-doc"
  "${MINGW_PACKAGE_PREFIX}-python-colorama"
  "${MINGW_PACKAGE_PREFIX}-python-rich"
  "${MINGW_PACKAGE_PREFIX}-python-shellingham"
  "${MINGW_PACKAGE_PREFIX}-python-typing_extensions"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-pdm-backend"
)
options=('!strip')
source=("https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz")
sha256sums=('d0396f770a560ab1b0a8504e13b5f254b728cedb05c61cf0359e944e50ce8901')

build() {
  cp -r "${_realname}-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "${srcdir}/python-build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
