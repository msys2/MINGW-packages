_realname=f3d
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=4.0.1
pkgrel=1
pkgdesc="Fast and minimalist 3D viewer. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/f3d-app/f3d'
license=('spdx:BSD-3-Clause')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs"
         #"${MINGW_PACKAGE_PREFIX}-ffmpeg"
         "${MINGW_PACKAGE_PREFIX}-imath"
         "${MINGW_PACKAGE_PREFIX}-libwebp"
         "${MINGW_PACKAGE_PREFIX}-openexr"
         "${MINGW_PACKAGE_PREFIX}-vtk"
         "${MINGW_PACKAGE_PREFIX}-zlib")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-cxxopts"
             "${MINGW_PACKAGE_PREFIX}-nlohmann-json"
             "${MINGW_PACKAGE_PREFIX}-python"
             "${MINGW_PACKAGE_PREFIX}-pybind11"
             "${MINGW_PACKAGE_PREFIX}-alembic"
             "${MINGW_PACKAGE_PREFIX}-assimp"
             "${MINGW_PACKAGE_PREFIX}-draco"
             "${MINGW_PACKAGE_PREFIX}-opencascade"
             "${MINGW_PACKAGE_PREFIX}-eigen3"
             "${MINGW_PACKAGE_PREFIX}-exprtk"
             "${MINGW_PACKAGE_PREFIX}-freetype"
             "${MINGW_PACKAGE_PREFIX}-netcdf"
             "${MINGW_PACKAGE_PREFIX}-utf8cpp")
optdepends=("${MINGW_PACKAGE_PREFIX}-alembic: Alembic plugin"
            "${MINGW_PACKAGE_PREFIX}-assimp: Assimp plugin"
            "${MINGW_PACKAGE_PREFIX}-draco: Draco plugin"
            "${MINGW_PACKAGE_PREFIX}-netcdf: HDF plugin"
            "${MINGW_PACKAGE_PREFIX}-opencascade: OCCT plugin"
            "${MINGW_PACKAGE_PREFIX}-openvdb: VDB plugin"
            "${MINGW_PACKAGE_PREFIX}-pdal: PDAL plugin")
            #"${MINGW_PACKAGE_PREFIX}-python: Python bindings")
# checkdepends=("${MINGW_PACKAGE_PREFIX}-git-lfs"
#               "${MINGW_PACKAGE_PREFIX}-python-pytest")
source=("https://github.com/f3d-app/f3d/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
        "001-fix-build-on-mingw.patch"
        "002-support-modern-windows.patch")
sha256sums=('336dd26581a0a9b0bf9e6e9c900e3f103cf6df58971cfd5bbaf6fa93cd285560'
            'f9ef591985ad1e4bba5d23c89068ecc2b5346af66bda9f2239ca5de8868fb22b'
            'b6bb82c7dec5d90fdd78118e541a3e22693c2fcbe31d6c70a07d98aa6dbb1c0d')

prepare() {
  cd "${_realname}-${pkgver}"

  patch -Np1 -i "${srcdir}"/001-fix-build-on-mingw.patch
  patch -Np1 -i "${srcdir}"/002-support-modern-windows.patch
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  if [[ ${CC} == clang ]]; then
    CXXFLAGS+=" -Wno-ignored-attributes"
  else
    CXXFLAGS+=" -Wno-attributes"
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -Wno-author \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${extra_config[@]}" \
      -DBUILD_SHARED_LIBS=ON \
      -DCMAKE_DLL_NAME_WITH_SOVERSION=ON \
      -DF3D_EXCLUDE_DEPRECATED=ON \
      -DF3D_MODULE_EXR=ON \
      -DF3D_MODULE_RAYTRACING=ON \
      -DF3D_MODULE_WEBP=ON \
      -DF3D_USE_EXTERNAL_CXXOPTS=ON \
      -DF3D_USE_EXTERNAL_NLOHMANN_JSON=ON \
      -DF3D_BINDINGS_PYTHON=ON \
      -DF3D_PLUGIN_BUILD_ALEMBIC=ON \
      -DF3D_PLUGIN_BUILD_ASSIMP=ON \
      -DF3D_PLUGIN_BUILD_DRACO=ON \
      -DF3D_PLUGIN_BUILD_HDF=ON \
      -DF3D_PLUGIN_BUILD_OCCT=ON \
      -DF3D_PLUGIN_BUILD_PDAL=ON \
      -DF3D_PLUGIN_BUILD_VDB=ON \
      -DF3D_PLUGINS_STATIC_BUILD=OFF \
      -DF3D_WINDOWS_BUILD_SHELL_THUMBNAILS_EXTENSION=ON \
      -DF3D_WINDOWS_BUILD_CONSOLE_APPLICATION=ON \
      -DPython_EXECUTABLE=${MINGW_PREFIX}/bin/python \
      -DBUILD_TESTING=OFF \
      -S "${_realname}-${pkgver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

