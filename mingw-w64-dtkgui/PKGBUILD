# Maintainer: Cloud <kt286@qq.com>

_realname=dtk6gui
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=6.7.47
pkgrel=1
pkgdesc='DTK6 gui module'
arch=('any')
mingw_arch=('ucrt64')
url="https://github.com/linuxdeepin/dtkgui"
license=('LGPL3')
depends=("${MINGW_PACKAGE_PREFIX}-gcc-libs"
         "${MINGW_PACKAGE_PREFIX}-qt6-base"
         "${MINGW_PACKAGE_PREFIX}-qt6-svg"
         "${MINGW_PACKAGE_PREFIX}-librsvg"
         "${MINGW_PACKAGE_PREFIX}-dtk6core")
makedepends=("${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-gcc")

source=("dtkgui-${pkgver}.tar.gz::https://github.com/linuxdeepin/dtkgui/archive/refs/tags/${pkgver}.tar.gz")
sha512sums=('25eb13022bdfa51b3cc8d330f40633cc6b23bff0d63315a73827c164684c020ce5e9bf14c181a82c9a6226d5d85815d8de8bb5b4aaec2172e919a5f251fcff6c')

build() {
  cd "${srcdir}"/dtkgui-${pkgver}

  # Fix: use cygpath to convert MSYS path to real Windows path for cmake EXISTS check
  sed -i 's|set(_PREF_CONFIG_JSON ${CMAKE_INSTALL_PREFIX}/share/dsg/configs/org.deepin.dtk.preference.json)|execute_process(COMMAND cygpath -w "${CMAKE_INSTALL_PREFIX}/share/dsg/configs/org.deepin.dtk.preference.json" OUTPUT_VARIABLE _PREF_CONFIG_JSON OUTPUT_STRIP_TRAILING_WHITESPACE)|' src/kernel/kernel.cmake

  mkdir -p build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    ${MINGW_PREFIX}/bin/cmake .. -GNinja \
      -DCMAKE_INSTALL_PREFIX=${MINGW_PREFIX} \
      -DCMAKE_PREFIX_PATH=${MINGW_PREFIX} \
      -DDTK5=OFF \
      -DDTK_DISABLE_XCB=OFF \
      -DDTK_DISABLE_LIBXDG=ON \
      -DDTK_DISABLE_EX_IMAGE_FORMAT=ON \
      -DBUILD_EXAMPLES=OFF \
      -DBUILD_DOCS=OFF
  ${MINGW_PREFIX}/bin/ninja
}

package() {
  cd "${srcdir}"/dtkgui-${pkgver}/build-${MSYSTEM}
  DESTDIR="${pkgdir}" ${MINGW_PREFIX}/bin/ninja install
}
