# Maintainer: Cloud <kt286@qq.com>

_realname=dtk6gui
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=6.7.48
pkgrel=1
pkgdesc="DTK6 gui module"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/linuxdeepin/dtkgui"
license=('spdx:LGPL-3.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-gcc-libs"
         "${MINGW_PACKAGE_PREFIX}-qt6-base"
         "${MINGW_PACKAGE_PREFIX}-qt6-svg"
         "${MINGW_PACKAGE_PREFIX}-qt6-imageformats"
         "${MINGW_PACKAGE_PREFIX}-librsvg"
         "${MINGW_PACKAGE_PREFIX}-libraw"
         "${MINGW_PACKAGE_PREFIX}-freeimage"
         "${MINGW_PACKAGE_PREFIX}-dtk6core")
makedepends=("${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-cc")

source=("https://github.com/linuxdeepin/dtkgui/archive/refs/tags/${pkgver}.tar.gz"
        "0001-fix-getpid-on-windows.patch"
        "0002-fix-cygpath-for-cmake-on-msys2.patch"
        "0003-fix-cmake-install-and-export-symbols.patch")
sha256sums=('f11fb2225810ca961b09f760539bca2506d899ff1be58004d7d6210b7257c36f'
            'a931a03d88bf36a7c978145633ac02a0e1a96b68ecc7593138a10fc21c8abfc9'
            '4a6a929f4637f01de3e407cd2ae31ad63e9ee3d63e837d077e5917ec602d279e'
            '85af8443b9f8f816e45d0439be06583538a87ee5a91b8a5d5affc0d09b374f72')

prepare() {
  cd "${_realname/dtk6/dtk}-${pkgver}"

  patch -Np1 -i ../0001-fix-getpid-on-windows.patch
  patch -Np1 -i ../0002-fix-cygpath-for-cmake-on-msys2.patch
  patch -Np1 -i ../0003-fix-cmake-install-and-export-symbols.patch
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${extra_config[@]}" \
      -DDTK5=OFF \
      -DDTK_DISABLE_XCB=ON \
      -DDTK_DISABLE_LIBXDG=ON \
      -DBUILD_DOCS=OFF \
      -S "${_realname/dtk6/dtk}-${pkgver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"
}
