# Contributor: Raed Rizqie <raed.rizqie@gmail.com>

_realname=rolldown
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=1.3.4
pkgrel=1
pkgdesc='Fast Rust bundler for JavaScript/TypeScript with Rollup-compatible API (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://rolldown.rs/'
msys2_repository_url='https://github.com/rolldown/rolldown'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-nodejs")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-rust"
)
source=("https://github.com/rolldown/rolldown/archive/refs/tags/v${pkgver}.tar.gz"
        "001-add-pc-arm64-gnu-support.patch")
noextract=("v${pkgver}.tar.gz")
sha256sums=('c1f9824ca361d763eaad7facc5366d17c70c5f6fb3d74a6fefd366019121836b'
            'd3df861b59ecdf2e8f16c2a79ec999cba13535d381133bd9a6137073eea31532')

prepare() {
  tar -xf v${pkgver}.tar.gz || true

  cd ${_realname}-${pkgver}

  sed -e 's|target_os = "windows"|target_env = "msvc"|g' \
      -i .cargo/config.toml
  sed -e 's|-msvc|-gnu|g' -i packages/rolldown/package.json

  patch -Np1 <../001-add-pc-arm64-gnu-support.patch
}

build() {
  cd ${_realname}-${pkgver}

  export CARGO_HOME="${srcdir}/cargo-home"
  export CMAKE_GENERATOR="Ninja"

  local _cpu=x64
  if [[ ${MSYSTEM} == CLANGARM64 ]]; then
    _cpu=arm64
  fi
  local _arch="win32-${_cpu}-gnu"

  cargo fetch --locked --target "${RUST_CHOST}"

  msg2 "Building Rust binding..."
  RUSTFLAGS="-C target-feature=+crt-static -C link-arg=-ladvapi32" \
  cargo build --release -p rolldown_binding

  cp -v "target/release/rolldown_binding.dll" "packages/rolldown/src/rolldown-binding.${_arch}.node"
}

package() {
  local _cpu=x64
  if [[ ${MSYSTEM} == CLANGARM64 ]]; then
    _cpu=arm64
  fi
  local _arch="win32-${_cpu}-gnu"

  npm install -g \
    --cache npm-cache \
    --prefix "${pkgdir}${MINGW_PREFIX}" \
    --ignore-scripts \
    --omit=optional \
    --verbose \
    rolldown@1.3.4

  cd ${_realname}-${pkgver}

  local _node_modules="${pkgdir}${MINGW_PREFIX}/lib/node_modules"
  local _node_bin="packages/rolldown/src/rolldown-binding.${_arch}.node"

  install -vDm755 "${_node_bin}" "${_node_modules}/rolldown/dist"
  install -vDm755 "${_node_bin}" "${_node_modules}/rolldown"

  # for NAPI-RS fallback resolution
  mkdir -p "${_node_modules}/@rolldown/binding-${_arch}"
  install -vDm755 "${_node_bin}" "${_node_modules}/@rolldown/binding-${_arch}"

  cat <<EOF > "${_node_modules}/@rolldown/binding-${_arch}/package.json"
{
  "name": "@rolldown/binding-${_arch}",
  "version": "${pkgver}",
  "cpu": ["${_cpu}"],
  "main": "rolldown-binding.${_arch}.node",
  "files": ["rolldown-binding.${_arch}.node"],
  "os": ["win32"],
}
EOF

  # remove unwanted msvc-based binding
  rm -rf "${pkgdir}${MINGW_PREFIX}/lib/node_modules/rolldown/node_modules/@rolldown/binding-${_arch/gnu/msvc}"

  install -Dm644 "${srcdir}/${_realname}-${pkgver}/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
