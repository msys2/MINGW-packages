# Maintainer: Konstantin Podsvirov <konstantin@podsvirov.su>

_realname=passlib
pkgbase="mingw-w64-python-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-python-$_realname")
pkgver=1.9.5
pkgrel=1
pkgdesc="A password hashing library for Python (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://notypecheck.github.io/passlib/"
msys2_repository_url="https://github.com/notypecheck/passlib"
msys2_changelog_url="https://github.com/notypecheck/passlib/blob/main/CHANGELOG.md"
msys2_references=(
  'purl: pkg:pypi/passlib'
)
license=('spdx:BSD-3-Clause')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-hatchling"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-pytest"
)
optdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-argon2_cffi: support Argon2 hashes"
  "${MINGW_PACKAGE_PREFIX}-python-bcrypt: accelerate Bcrypt hashes"
  "${MINGW_PACKAGE_PREFIX}-python-cryptography: support AES-encrypted TOTP wallet keys"
  # "${MINGW_PACKAGE_PREFIX}-python-scrypt: accelerate SCrypt hashes"
)
source=("https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz")
sha256sums=('15d39a9b2044a86f341a2e443170e4e9a6d71fe0266fe28b91032a8ca723f8aa')

build() {
  cp -r "${_realname}-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "${srcdir}/python-build-${MSYSTEM}"

  python -m pytest || warning 'Tests failed'
}

package() {
  cd "${srcdir}/python-build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
  install -Dm644 README.md -t "${pkgdir}${MINGW_PREFIX}/share/doc/python-${_realname}"
}

# vim:set ts=2 sw=2 et:
