# Maintainer: Andrew Sun <adsun701@gmail.com>

_realname=libfilezilla
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
# update together with filezilla and fzssh
pkgver=0.58.0
pkgrel=1
pkgdesc="Small and modern C++ library, offering some basic functionality to build high-performing, platform-independent programs (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://lib.filezilla-project.org/"
msys2_repository_url="https://svn.filezilla-project.org/filezilla/libfilezilla/trunk/"
msys2_documentation_url="https://lib.filezilla-project.org/doc/"
msys2_references=(
  'archlinux: libfilezilla'
  'aur:' # ignore libfilezilla-svn
  'gentoo: dev-libs/libfilezilla'
)
license=('spdx:GPL-2.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-gnutls"
  "${MINGW_PACKAGE_PREFIX}-nettle"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-gettext"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-cppunit"
)
# Upstream download link became (purposely) unstable
# See https://trac.filezilla-project.org/ticket/13186
#source=("https://download.filezilla-project.org/${_realname}/${_realname}-${pkgver}.tar.xz")
source=(
  "https://sources.archlinux.org/other/${_realname}/${_realname}-${pkgver}.tar.xz"
)
sha256sums=('276d7a720af53a9767de4882bd992996c5430b0b13be05913bd7a640052d6ece')

prepare() {
  cd "${_realname}-${pkgver}"

  # Fix missing <cstdlib> include for abort() on clang64/libc++
  sed -i '1i#include <cstdlib>' lib/libfilezilla/nonowning_buffer.hpp lib/nonowning_buffer.cpp

  # autoreconf to get updated libtool files with clang support
  autoreconf -fiv
}

build() {
  mkdir -p "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  "../${_realname}-${pkgver}/configure" \
    --prefix="${MINGW_PREFIX}" \
    --build="${MINGW_CHOST}" \
    --host="${MINGW_CHOST}" \
    --target="${MINGW_CHOST}" \
    --enable-shared

  make
}

check() {
  cd "build-${MSYSTEM}"

  # LANG needed to fix string_test::test_conversion2
  LANG=en_US.UTF-8 make check || true
}

package() {
  cd "build-${MSYSTEM}"

  make install DESTDIR="${pkgdir}"
}
