_realname='rtl_433'
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=25.12
pkgrel=3
pkgdesc='Program to decode radio transmissions from devices on the ISM bands (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/merbanan/rtl_433'
msys2_repository_url='https://github.com/merbanan/rtl_433'
msys2_references=(
  'archlinux: rtl_433'
  'aur:' # ignore rtl_433-git
  'cpe: cpe:/a:rtl_433_project:rtl_433'
  'gentoo: net-wireless/rtl_433'
)
license=('spdx:GPL-2.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-libusb"
  "${MINGW_PACKAGE_PREFIX}-rtl-sdr"
  "${MINGW_PACKAGE_PREFIX}-soapysdr"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-git"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=("https://github.com/merbanan/${_realname}/archive/${pkgver}/${_realname}-${pkgver}.tar.gz")
sha256sums=('d283ec7a41a02d398e8918b20b65df3bf684cf4478371830662004005dadcdd2')

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
      "${extra_config[@]}" \
      -S "${_realname}-${pkgver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "${_realname}-${pkgver}/COPYING" -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
