# Maintainer: eminsk <M_N_N@tut.by>

_realname=xlsx-viewer-pro
_pkgname=xlsx_viewer_pro
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=1.0.7
pkgrel=1
pkgdesc="Modern Excel spreadsheet engine, 129 formula functions, SIMD SSE2 math, and desktop GUI viewer (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://github.com/eminsk/xlsx_vievers"
msys2_repository_url='https://github.com/eminsk/xlsx_vievers'
msys2_changelog_url="https://github.com/eminsk/xlsx_vievers/releases"
msys2_references=(
  'purl: pkg:pypi/xlsx-viewer-pro'
)
license=('spdx:MIT')
options=(!strip)
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-openpyxl"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
  "${MINGW_PACKAGE_PREFIX}-python-wheel"
)
source=("https://pypi.org/packages/source/${_realname::1}/${_realname}/${_pkgname}-${pkgver}.tar.gz")
sha256sums=('3ec7652133b26146f05312f0fcf88a46e9b62a9ace7ba3232b487f1b06042469')

build() {
  cp -r "${_pkgname}-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "${srcdir}/python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 "${srcdir}/${_pkgname}-${pkgver}/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
