# Maintainer: Cloud <kt286@qq.com>

_realname=dtk6log
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=6.7.47
pkgrel=1
pkgdesc='DTK6 log module'
arch=('any')
mingw_arch=('ucrt64')
url="https://github.com/linuxdeepin/dtklog"
license=('LGPL3')
depends=("${MINGW_PACKAGE_PREFIX}-gcc-libs"
         "${MINGW_PACKAGE_PREFIX}-qt6-base"
         "${MINGW_PACKAGE_PREFIX}-spdlog")
makedepends=("${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-gcc")

source=("dtklog-${pkgver}.tar.gz::https://github.com/linuxdeepin/dtklog/archive/refs/tags/${pkgver}.tar.gz")
sha512sums=('30d739b34cee0c17d355e381425dd9abdfd5e298b5ecbe4f48a7d00ff416a344b9dbbf2ae3fd70f1d39c22d15d906d67815fca2341b2846767fafb0b3b9ded85')

build() {
  mkdir -p "${srcdir}"/dtklog-${pkgver}/build-${MSYSTEM}
  cd "${srcdir}"/dtklog-${pkgver}/build-${MSYSTEM}

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    ${MINGW_PREFIX}/bin/cmake .. -GNinja \
      -DCMAKE_INSTALL_PREFIX=${MINGW_PREFIX} \
      -DCMAKE_PREFIX_PATH=${MINGW_PREFIX} \
      -DDTK5=OFF \
      -DBUILD_WITH_SYSTEMD=OFF
  ${MINGW_PREFIX}/bin/ninja
}

package() {
  cd "${srcdir}"/dtklog-${pkgver}/build-${MSYSTEM}
  DESTDIR="${pkgdir}" ${MINGW_PREFIX}/bin/ninja install
}
