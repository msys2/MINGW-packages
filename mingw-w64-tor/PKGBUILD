# Maintainer: Haroogan <Haroogan@gmail.com>

_realname='tor'
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.4.9.14
pkgrel=1
pkgdesc='Anonymizing overlay network (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://www.torproject.org/'
msys2_repository_url='https://gitlab.torproject.org/tpo/core/tor/'
msys2_references=(
  'anitya: 4991'
  'archlinux: tor'
  'cpe: cpe:/a:tor:tor'
  'cpe: cpe:/a:tor_project:tor'
  'cpe: cpe:/a:torproject:tor'
  'gentoo: net-vpn/tor'
)
msys2_ignore_vulnerabilities=(
  'CVE-2017-16541' # wrong product, tor-browser, not tor
)
license=('spdx:BSD-3-Clause')
depends=(
  "${MINGW_PACKAGE_PREFIX}-libevent"
  "${MINGW_PACKAGE_PREFIX}-openssl"
  "${MINGW_PACKAGE_PREFIX}-xz"
  "${MINGW_PACKAGE_PREFIX}-zlib"
  "${MINGW_PACKAGE_PREFIX}-zstd"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-ca-certificates"
  "${MINGW_PACKAGE_PREFIX}-cc"
)
source=("https://dist.torproject.org/${_realname}-${pkgver}.tar.gz"{,.sha256sum{,.asc}})
sha256sums=('182449ac1c8ff43278da27b69b02040e11d03d0327db6d9126e4190ec6235e4a'
            '7afa503d7654c9280e4ab8e74bb0b543b0b248d83c10ea6d76c049882a53abed'
            'SKIP')
# list of keys https://gitlab.torproject.org/tpo/core/tor/-/raw/main/README.md
validpgpkeys=(
  '1C1BC007A9F607AA8152C040BEA7B180B1491921' # Alexander Færøy <ahf@0x90.dk>
  '514102454D0A87DB0767A1EBBE6A0531C18A9179' # Alexander Færøy <ahf@0x90.dk>
  'B74417EDDF22AC9F9E90F49142E86A2A11F48D36' # David Goulet <dgoulet@ev0ke.net>
  '2133BC600AB133E1D826D173FE43009C4607B1FB' # Nick Mathewson <nickm@alum.mit.edu>
)

build() {
  mkdir -p "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  export CPPFLAGS="-isystem ${MINGW_PREFIX}/include"
  export CFLAGS="-pipe -O3 -fomit-frame-pointer -funroll-loops"
  export LDFLAGS="-s -Wl,-s"

  "${srcdir}/${_realname}-${pkgver}/configure" \
    --prefix="${MINGW_PREFIX}" \
    --build="${MINGW_CHOST}" \
    --disable-seccomp \
    --disable-libscrypt \
    --enable-lzma \
    --enable-zstd

  make
}

check() {
  cd "build-${MSYSTEM}"

  make test || true
}

package() {
  cd "build-${MSYSTEM}"

  make DESTDIR="${pkgdir}" install

  cd "${srcdir}/${_realname}-${pkgver}"

  install -Dm644 "LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
  install -dm755 "${pkgdir}${MINGW_PREFIX}/var/lib/tor"
}
