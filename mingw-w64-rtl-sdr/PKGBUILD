_realname='rtl-sdr'
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=2.0.3
pkgrel=1
pkgdesc='Driver for Realtek RTL2832U, allowing general purpose software defined radio (SDR) (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://osmocom.org/projects/rtl-sdr/wiki'
msys2_repository_url='https://gitea.osmocom.org/sdr/rtl-sdr/'
msys2_references=(
  'anitya: 17786'
  'archlinux: rtl-sdr'
  'aur:' # ignore rtl-sdr-blog
  'gentoo: net-wireless/rtl-sdr'
)
license=('spdx:GPL-2.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-libusb>=1.0"
  "${MINGW_PACKAGE_PREFIX}-libwinpthread"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
# https://gitea.osmocom.org/sdr/rtl-sdr/archive/v$pkgver.tar.gz
source=("https://github.com/osmocom/rtl-sdr/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz")
sha512sums=('1bb2a2b65a68afb2402e900526092eb544aa8155156c75cba201581d58fe616016e9742d4736854e8658a48a5375413f5a7d474502e128cbaf94ee0da32d8937')

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
    -GNinja \
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DCMAKE_C_FLAGS="${CFLAGS} -std=gnu17" \
    -DDETACH_KERNEL_DRIVER=ON \
    -Wno-author \
    "${extra_config[@]}" \
    -S "${_realname}-${pkgver}" \
    -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  # remove path reference in cmake
  local _prefix_win
  _prefix_win=$(cygpath -wm "${MINGW_PREFIX}")
  for _f in "${pkgdir}${MINGW_PREFIX}"/lib/cmake/${_realname/-/}/*.cmake; do
    sed -e "s|${_prefix_win}|\$\{_IMPORT_PREFIX\}|g" -i "${_f}"
    sed -e "s|${MINGW_PREFIX}|\$\{_IMPORT_PREFIX\}|g" -i "${_f}"
  done

  install -Dm644 "${_realname}-${pkgver}/COPYING" -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
