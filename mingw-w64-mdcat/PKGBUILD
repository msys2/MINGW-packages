# Maintainer: Sylvain Rouquette <srouquette@gmail.com>

_realname=mdcat
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=2.20.0
pkgrel=1
pkgdesc="Fancy cat for Markdown (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/BIRSAx2/mdcat'
msys2_repository_url='https://github.com/BIRSAx2/mdcat'
msys2_references=(
  'aur: mdcat'
  'purl: pkg:cargo/mdcat'
)
license=('spdx:MPL-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-curl"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-rust"
)
options=('!strip')
source=("${url}/archive/${_realname}-${pkgver}.tar.gz")
sha256sums=('3436d183cf55d628245b30e605f14a4d7b3b129a457e34eac029828e2c2a07e6')

prepare() {
  cd "${_realname}-${_realname}-${pkgver}"

  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${_realname}-${_realname}-${pkgver}"

  export WINAPI_NO_BUNDLED_LIBRARIES=1
  cargo build --release --frozen
}

check() {
  cd "${_realname}-${_realname}-${pkgver}"

  cargo test --release --frozen
}

package() {
  cd "${_realname}-${_realname}-${pkgver}"

  cargo install \
    --offline \
    --no-track \
    --frozen \
    --path . \
    --root "${pkgdir}${MINGW_PREFIX}"

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
