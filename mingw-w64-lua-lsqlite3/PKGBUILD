# Contributor (Fluke): Ricky Wu <rickleaf.wu@gmail.com>

_realname=lsqlite3
pkgbase=mingw-w64-lua-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-lua-${_realname}"
         "${MINGW_PACKAGE_PREFIX}-lua54-${_realname}"
         "${MINGW_PACKAGE_PREFIX}-lua51-${_realname}")
pkgver=0.9.7
pkgrel=2
pkgdesc="LuaSQLite is a Lua 5 binding to allow users/developers to manipulate SQLite 2 and SQLite 3 databases (through different implementations) from lua (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://lua.sqlite.org"
license=('spdx:MIT')
depends=()
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-pkgconf"
             "${MINGW_PACKAGE_PREFIX}-lua"
             "${MINGW_PACKAGE_PREFIX}-lua51"
             "${MINGW_PACKAGE_PREFIX}-lua54"
             "${MINGW_PACKAGE_PREFIX}-sqlite3")
source=("lsqlite3_${pkgver}.zip::https://lua.sqlite.org/home/zip/lsqlite3_v${pkgver//./}.zip?uuid=v${pkgver}"
        "installpath.lua"
        "lunit.lua"
        "Makefile.mingw")
sha256sums=('de690611e248daceebe85ffeca99899a0fbdac92b91bd7ede11dac66eb290a9a'
            'd9b058b10d1d6e0fc1ac9338193c8b8b25e808e00955ce13ef1c91c6af0c9d3a'
            'ae756636ed73147259cb55e13768d88bef5e7fa3373209c886ab46e8ea89b92f'
            '8cdba6874cde341a19c4b96f9da335309cedabf6eab04fa0e1bafd674b8dd74e')

prepare() {
  cd "${srcdir}/${_realname}_v${pkgver//./}"
  cp ../installpath.lua .
  cp ../lunit.lua .
  cp ../Makefile.mingw .
  mkdir -p tmp
}

build() {
  for _lua_ver in 5.1 5.4 5.5; do
    cp -r "${srcdir}/${_realname}_v${pkgver//./}" "${srcdir}"/build-${MSYSTEM}-${_lua_ver}
    cd "${srcdir}"/build-${MSYSTEM}-${_lua_ver}
    make -f Makefile.mingw "LSQLITE_VERSION=${pkgver}" LUA=lua${_lua_ver} all
  done
}

package_lua-lsqlite3() {
  depends=("${MINGW_PACKAGE_PREFIX}-lua"
           "${MINGW_PACKAGE_PREFIX}-sqlite3")

  cd "${srcdir}"/build-${MSYSTEM}-5.5
  install -Dm755 lsqlite3.dll "${pkgdir}${MINGW_PREFIX}/lib/lua/5.5/lsqlite3.dll"
}

package_lua51-lsqlite3() {
  depends=("${MINGW_PACKAGE_PREFIX}-lua51"
           "${MINGW_PACKAGE_PREFIX}-sqlite3")

  cd "${srcdir}"/build-${MSYSTEM}-5.1
  install -Dm755 lsqlite3.dll "${pkgdir}${MINGW_PREFIX}/lib/lua/5.1/lsqlite3.dll"
}

package_lua54-lsqlite3() {
  depends=("${MINGW_PACKAGE_PREFIX}-lua54"
           "${MINGW_PACKAGE_PREFIX}-sqlite3")

  cd "${srcdir}"/build-${MSYSTEM}-5.4
  install -Dm755 lsqlite3.dll "${pkgdir}${MINGW_PREFIX}/lib/lua/5.4/lsqlite3.dll"
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
