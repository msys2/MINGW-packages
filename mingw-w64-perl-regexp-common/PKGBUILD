# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=Regexp-Common
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=2024080801
pkgrel=2
pkgdesc="Provide commonly requested regular expressions. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/Regexp-Common"
msys2_references=(
  'purl: pkg:cpan/ABIGAIL/Regexp-Common'
)
license=('spdx:Artistic-1.0-Perl OR Aritistic-2.0 OR MIT OR BSD-3-Clause')
depends=("${MINGW_PACKAGE_PREFIX}-perl")
makedepends=("${MINGW_PACKAGE_PREFIX}-make")
source=("https://cpan.metacpan.org/authors/id/A/AB/ABIGAIL/${_perlname}-${pkgver}.tar.gz")
sha256sums=('0677afaec8e1300cefe246b4d809e75cdf55e2cc0f77c486d13073b69ab4fbdd')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
  install -Dm644 LICENSE "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE
  install -Dm644 COPYRIGHT.* -t "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/
}
