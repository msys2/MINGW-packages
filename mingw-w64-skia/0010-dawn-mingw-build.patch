--- a/sync-deps.py	1970-01-01 03:00:00.000000000 +0300
+++ b/sync-deps.py	2026-11-11 07:00:37.489200100 +0300
@@ -0,0 +1,94 @@
+import os, subprocess, sys
+
+os.chdir(os.path.dirname(os.path.abspath(__file__)))
+ROOT = os.getcwd()
+E = "third_party/externals/"
+
+# ---- Skia's own DEPS: only what your gn args need -----------------------
+# System libs (expat, harfbuzz, icu, libpng, libjpeg-turbo, libwebp, zlib)
+# are NOT fetched. dng_sdk/wuffs/xps are off. Tools/tests are off.
+SKIA_ALLOW = {E + n for n in [
+    "dawn",
+    "freetype",     # cheap; remove if gn gen never asks for it
+    "zlib",
+]}
+
+# ---- Dawn's DEPS: D3D12 + Null backend, Tint WGSL, no tests/samples -----
+DAWN_ALLOW = {
+    "third_party/abseil-cpp",
+    "third_party/dxheaders",             # D3D12 headers
+    "third_party/dxc",                   # large; try removing, add back if configure/compile asks
+    "third_party/glfw",                  # configure needs it unless DAWN_USE_GLFW=OFF
+    "third_party/jinja2",                # code generators
+    "third_party/markupsafe",
+    "third_party/protobuf",              # TINT_BUILD_IR_BINARY
+    "third_party/libprotobuf-mutator/src",
+    "third_party/glslang/src",           # TINT_BUILD_GLSL_VALIDATOR
+    "third_party/spirv-headers/src",
+    "third_party/webgpu-headers/src",
+    "third_party/vulkan-headers/src",               # Vulkan backend
+    "third_party/vulkan-utility-libraries/src",     # Vulkan backend
+    "third_party/spirv-tools/src",                  # Tint's SPIR-V writer
+    "third_party/khronos/EGL-Registry",             # OpenGLES backend
+    "third_party/khronos/OpenGL-Registry",          # OpenGLES backend
+}
+# Deliberately skipped: vulkan-*, khronos/*, spirv-tools, google_benchmark,
+# googletest, swiftshader, node-*, gpuweb, webgpu-cts.
+
+def load_deps(path):
+    ns = {"Str": str}
+    ns["Var"] = lambda n: ns["vars"][n]
+    exec(open(path).read(), ns)
+    v = ns.get("vars", {})
+    out = {}
+    for p, ent in ns["deps"].items():
+        url = ent.get("url") if isinstance(ent, dict) else ent
+        if not isinstance(url, str):
+            continue                      # cipd etc.
+        if "{" in url:
+            try: url = url.format(**v)
+            except KeyError: continue
+        if "@" in url:
+            out[p] = url
+    return out
+
+def git(*a, cwd=None, check=True):
+    return subprocess.run(["git", *a], cwd=cwd, check=check,
+                          capture_output=True, text=True)
+
+def fetch(dest, url):
+    repo, commit = url.rsplit("@", 1)
+    os.makedirs(dest, exist_ok=True)
+    if os.path.isdir(os.path.join(dest, ".git")):
+        head = git("rev-parse", "HEAD", cwd=dest, check=False).stdout.strip()
+        if head == commit:
+            print("have    ", os.path.relpath(dest, ROOT)); return
+    else:
+        git("init", "-q", cwd=dest)
+    print("fetching", os.path.relpath(dest, ROOT), commit[:8], flush=True)
+    try:
+        git("remote", "remove", "origin", cwd=dest, check=False)
+        git("remote", "add", "origin", repo, cwd=dest)
+        git("fetch", "-q", "--depth", "1", "origin", commit, cwd=dest)
+        git("checkout", "-q", "-f", "FETCH_HEAD", cwd=dest)
+    except subprocess.CalledProcessError as e:
+        sys.exit("FAILED %s\n%s" % (dest, e.stderr))
+
+def sync(deps, allow, base):
+    missing = [a for a in allow if a not in deps]
+    if missing:
+        print("WARNING not in DEPS:", missing)
+    for p in sorted(allow):
+        if p in deps:
+            fetch(os.path.join(base, p), deps[p])
+
+# extra args: "freetype" -> Skia dep, "dawn:third_party/khronos/EGL-Registry" -> Dawn dep
+for a in sys.argv[1:]:
+    if a.startswith("dawn:"):
+        DAWN_ALLOW.add(a[5:])
+    else:
+        SKIA_ALLOW.add(a if "/" in a else E + a)
+
+sync(load_deps("DEPS"), SKIA_ALLOW, ROOT)
+dawn = os.path.join(ROOT, E + "dawn")
+sync(load_deps(os.path.join(dawn, "DEPS")), DAWN_ALLOW, dawn)
