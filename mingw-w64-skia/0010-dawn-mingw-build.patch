+#pragma once
+#include <windows.h>
+#include <unknwn.h>
+#include <guiddef.h>
+#include <d3d12.h>
+
+#ifdef __cplusplus
+extern "C++" {
+  struct __declspec(uuid("9f251eaf-ee36-427c-87ea-aeff843d7574")) IDXGraphicsAnalysis : public IUnknown {
+      virtual void STDMETHODCALLTYPE BeginCapture() = 0;
+      virtual void STDMETHODCALLTYPE EndCapture() = 0;
+  };
+}
+
+#if defined(__MINGW32__) && !defined(SKIA_HAS_DX_ANALYSIS_UUID)
+#define SKIA_HAS_DX_ANALYSIS_UUID
+__CRT_UUID_DECL(IDXGraphicsAnalysis, 0x9f251eaf, 0xee36, 0x427c, 0x87, 0xea, 0xae, 0xff, 0x84, 0x3d, 0x75, 0x74);
+// MinGW headers already handle ID3D12Device natively now, so omit its manual re-declaration
+#endif
+#endif
diff -urN -x __pycache__ -x '*.orig' a/third_party/dawn/mingw_compat/mingw_uuidof_fix.h b/third_party/dawn/mingw_compat/mingw_uuidof_fix.h
--- a/third_party/dawn/mingw_compat/mingw_uuidof_fix.h	1970-01-01 03:00:00.000000000 +0300
+++ b/third_party/dawn/mingw_compat/mingw_uuidof_fix.h	2026-11-11 06:39:15.347902800 +0300
@@ -0,0 +1,12 @@
+#pragma once
+#include <windows.h>
+#include <guiddef.h>
+#include <wrl/client.h>
+namespace dawn_mingw_compat {
+template <typename T> struct ComUuid;   // intentionally undefined: unsupported types fail at compile time
+template <typename T> struct ComUuid<Microsoft::WRL::ComPtr<T>> {
+  static const GUID& Get() { return __mingw_uuidof<T>(); }
+};
+}
+template <typename T>
+inline constexpr const GUID& __mingw_uuidof() { return dawn_mingw_compat::ComUuid<T>::Get(); }
diff -urN -x __pycache__ -x '*.orig' a/third_party/dawn/mingw_compat/windows.h b/third_party/dawn/mingw_compat/windows.h
--- a/third_party/dawn/mingw_compat/windows.h	1970-01-01 03:00:00.000000000 +0300
+++ b/third_party/dawn/mingw_compat/windows.h	2026-11-11 06:39:15.363560100 +0300
@@ -0,0 +1,17 @@
+#pragma GCC system_header
+#pragma once
+#include_next <windows.h>
+#include <windef.h>
+#include <winerror.h>
+#include <winbase.h>
+
+#if defined(__cplusplus) && defined(__MINGW32__)
+// CompareObjectHandles (Windows 10 1607+) is missing from MinGW's headers: look it up at run time
+inline BOOL dawn_mingw_CompareObjectHandles(HANDLE a, HANDLE b) {
+  using Fn = BOOL (WINAPI*)(HANDLE, HANDLE);
+  static Fn fn = reinterpret_cast<Fn>(reinterpret_cast<void*>(
+      GetProcAddress(GetModuleHandleW(L"kernelbase.dll"), "CompareObjectHandles")));
+  return fn ? fn(a, b) : (a == b);
+}
+#define CompareObjectHandles dawn_mingw_CompareObjectHandles
+#endif
