apply_patch_with_msg() {
  for _patch in "$@"; do
      msg2 "Applying $_patch"
      patch -Nbp1 -i "${srcdir}/$_patch"
  done
}

pkgver() {
  git clone --filter=blob:none --revision "${_commit}" https://skia.googlesource.com/skia.git skia_temp
  cd skia_temp
  local _milestone=$(grep -Eo "Milestone ([0-9]+)" RELEASE_NOTES.md | head -1 | cut -f 2 -d ' ')
  printf "%s.r%s.%s" "${_milestone}" "$(git rev-list --count HEAD)" "$(git rev-parse --short=8 "${_commit}")"
  cd ..
  rm -Rf skia_temp
}

prepare() {
  mv "${_realname}-${_commit}" "${_realname}"
  cd ${_realname}
  apply_patch_with_msg \
    0001-add-pkgconfig-support.patch \
    0002-add-mingw-toolchain-skia.patch \
    0003-fix-dwrite-function-mingw.patch \
    0004-misc-mingw-fixes.patch \
    0005-external-packages-update.patch \
    0006-integrates-svg-into-skia-lib.patch \
    0008-dwrite.patch \
    0009-allow-opengl-aarch64.patch \
    0010-dawn-mingw-build.patch \
    0012-fix-missing-cstdlib-with-libcxx.patch

  patch -R -Nbp1 -i "${srcdir}/0007-Reland-Make-SkPath-immutable-on-GN-build.patch"

  # gn is expected to be in skia/bin
  cp ${MINGW_PREFIX}/bin/gn.exe bin/gn.exe

  # MSVC-style /w flag is not valid for g++
  sed -i 's|"/w"|"-w"|' \
      src/gpu/vk/vulkanmemoryallocator/BUILD.gn \
      third_party/third_party.gni

  echo -e "\033[1;32m -> running sync-deps.py\033[0m"
  python3 sync-deps.py

  # changes inside Dawn's own source (D3DError.h, QueueD3D11.cpp): applied after sync-deps.py fetched it
  msg2 "Applying 0011-dawn-source-mingw.patch"
  patch -Np1 -d third_party/externals/dawn -i "${srcdir}/0011-dawn-source-mingw.patch"

  sed -e "s|@PREFIX@|${MINGW_PREFIX}|g" \
      -e "s|@VERSION@|${pkgver}|g" -i "${srcdir}"/skia.pc
}

build() {
  local _buildtype=Release
  local _debug=false
  local _official=false
  if check_option "debug" "y"; then
      _buildtype=Debug
      _debug=true
      _official=false
  fi

  local _arch=x64
  if [[ ${CARCH} == aarch64 ]]; then
      _arch=arm64
  fi

  cd ${_realname}



  # --- 1. BUILD STATIC VERSION ---
  msg2 "Building Static Library..."
  gn gen out/static-${_buildtype}-${MSYSTEM} --args="
    target_cpu=\"${_arch}\"
    cc=\"${CC}\"
    cxx=\"${CXX}\"
    is_debug=${_debug}
    is_official_build=${_official}
    is_component_build=false
    skia_enable_tools=false
    skia_use_dng_sdk=false
    skia_use_wuffs=false
    skia_use_xps=false
    skia_enable_graphite=true
    skia_use_dawn=true
    skia_use_expat=true
    skia_use_system_expat=true
    skia_use_system_harfbuzz=true
    skia_use_system_icu=true
    skia_use_system_libjpeg_turbo=true
    skia_use_system_libpng=true
    skia_use_system_libwebp=true
    skia_use_system_zlib=true
    skia_use_webgpu=true
    dawn_enable_d3d12=true
    dawn_enable_d3d11=true
    dawn_enable_vulkan=true
    dawn_enable_desktop_gl=true
    dawn_enable_opengles=true
    extra_cflags=[\"-w\"]"

  ninja -C out/static-${_buildtype}-${MSYSTEM}

  # --- 2. BUILD SHARED/DYNAMIC VERSION ---
  msg2 "Building Shared/Dynamic Library..."
  gn gen out/shared-${_buildtype}-${MSYSTEM} --args="
    target_cpu=\"${_arch}\"
    cc=\"${CC}\"
    cxx=\"${CXX}\"
    is_debug=${_debug}
    is_official_build=${_official}
    is_component_build=true
    skia_enable_tools=false
    skia_use_dng_sdk=false
    skia_use_wuffs=false
    skia_use_xps=false
    skia_enable_graphite=true
    skia_use_dawn=true
    skia_use_expat=true
    skia_use_system_expat=true
    skia_use_system_harfbuzz=true
    skia_use_system_icu=true
    skia_use_system_libjpeg_turbo=true
    skia_use_system_libpng=true
    skia_use_system_libwebp=true
    skia_use_system_zlib=true
    skia_use_webgpu=true
    dawn_enable_d3d12=true
    dawn_enable_d3d11=true
    dawn_enable_vulkan=true
    dawn_enable_desktop_gl=true
    dawn_enable_opengles=true
    extra_ldflags=[\"-Wl,--export-all-symbols\"]
    extra_cflags=[\"-w\"]"

  ninja -C out/shared-${_buildtype}-${MSYSTEM}
}

package() {
  cd ${_realname}

  local _buildtype=Release
  if check_option "debug" "y"; then
      _buildtype=Debug
  fi

  local _static_dir="out/static-${_buildtype}-${MSYSTEM}"
  local _shared_dir="out/shared-${_buildtype}-${MSYSTEM}"

  # install dlls from shared build
  install -d "${pkgdir}"/${MINGW_PREFIX}/bin
  install -Dm755 ${_shared_dir}/*.dll "${pkgdir}"/${MINGW_PREFIX}/bin/

  # install static libraries
  install -d "${pkgdir}"/${MINGW_PREFIX}/lib
  install -m644 "${_static_dir}"/*.a "${pkgdir}"/${MINGW_PREFIX}/lib/

  # install libraries of the shared build
  install -m644 "${_shared_dir}"/*.dll.a "${pkgdir}"/${MINGW_PREFIX}/lib/

  # install skia headers: (include),(modules) and (src)
  local _skinc="${pkgdir}${MINGW_PREFIX}/include/skia"
  install -d "${_skinc}"
  for _d in include modules src; do
    find ./${_d} -name '*.h' -print0 | xargs -0 cp --parents -t "${_skinc}"
  done

  # install [dawn-webgpu-tint] headers
  local _dawn_src="third_party/externals/dawn/include"
  local _dawn_gen="${_shared_dir}/gen/third_party/dawn/include"
  local _inc="${pkgdir}${MINGW_PREFIX}/include/skia"          # was .../include

  for _d in dawn webgpu tint; do
    install -d "${_inc}/${_d}"
    [ -d "${_dawn_src}/${_d}" ] && cp -r "${_dawn_src}/${_d}/." "${_inc}/${_d}/"
  done
  [ -d "${_dawn_gen}/dawn" ]   && cp -r "${_dawn_gen}/dawn/."   "${_inc}/dawn/"
  [ -d "${_dawn_gen}/webgpu" ] && cp -r "${_dawn_gen}/webgpu/." "${_inc}/webgpu/"


  # pkgconfig & Licenses
  install -d "${pkgdir}"/${MINGW_PREFIX}/lib/pkgconfig
  install -Dm644 "${srcdir}/skia.pc" "${pkgdir}"/${MINGW_PREFIX}/lib/pkgconfig/

  # licenses: skia,third-party
  local _lic="${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
  local _e="third_party/externals"
  local _d="${_e}/dawn/third_party"
  install -Dm644 LICENSE "${_lic}/LICENSE"
  declare -A _third=(
    [dawn]="${_e}/dawn/LICENSE"
    [abseil-cpp]="${_d}/abseil-cpp/LICENSE"
    [spirv-tools]="${_d}/spirv-tools/src/LICENSE"
    [spirv-headers]="${_d}/spirv-headers/src/LICENSE"
    [vulkan-headers]="${_d}/vulkan-headers/src/LICENSE.md"
    [vulkan-utility-libraries]="${_d}/vulkan-utility-libraries/src/LICENSE.md"
    [freetype]="${_e}/freetype/LICENSE.TXT"
    [freetype-FTL]="${_e}/freetype/docs/FTL.TXT"
  )
  for _n in "${!_third[@]}"; do
    install -Dm644 "${_third[$_n]}" "${_lic}/LICENSE.${_n}"
  done

  # install licenses
  for _n in spirv-headers vulkan-headers vulkan-utility-libraries; do
    install -d "${_lic}/${_n}-LICENSES"
    install -m644 "${_d}/${_n}/src/LICENSES"/* "${_lic}/${_n}-LICENSES/"
  done
}
