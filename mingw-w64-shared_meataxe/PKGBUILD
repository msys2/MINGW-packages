# Maintainer: Dirk Stolle

_realname=shared_meataxe
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.0.3
pkgrel=1
pkgdesc='Programs for working with matrix representations over finite fields (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://users.fmi.uni-jena.de/~king/SharedMeatAxe/'
msys2_repository_url='https://github.com/simon-king-jena/SharedMeatAxe'
msys2_references=(
  'anitya: 53831'
  'archlinux: shared_meataxe'
)
license=('spdx:GPL-2.0-or-later')
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-cc"
)
source=("https://github.com/simon-king-jena/SharedMeatAxe/releases/download/v${pkgver}/shared_meataxe-${pkgver}.tar.bz2")
sha256sums=('3b2fe10d44379e8bc749e586449dfa0ccf993bbd30490d64a99645ca4884c4c3')

prepare() {
  cd "${_realname}-${pkgver}"

  autoreconf -fiv
}

build() {
  mkdir -p "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  ../"${_realname}-${pkgver}"/configure \
    --prefix="${MINGW_PREFIX}" \
    --build="${MINGW_CHOST}" \
    --host="${MINGW_CHOST}" \
    --target="${MINGW_CHOST}" \
    --enable-static \
    --enable-shared \
    --enable-tables

  make
}

check() {
  cd "build-${MSYSTEM}"

  make check || warning "Some tests have failed."
}

package() {
  cd "build-${MSYSTEM}"

  make install DESTDIR="${pkgdir}"

  install -Dm644 "../${_realname}-${pkgver}/COPYING" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
