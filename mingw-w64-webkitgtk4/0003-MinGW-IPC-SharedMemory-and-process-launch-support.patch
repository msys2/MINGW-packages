+namespace WebCore {
+
+// Shared memory is implemented with page-file backed file mappings. Handles
+// are transferred to other processes by IPC::Connection's Windows send path,
+// which duplicates them into the destination process before sending.
+
+static inline DWORD accessModeFromProtection(SharedMemory::Protection protection)
+{
+    switch (protection) {
+    case SharedMemory::Protection::ReadOnly:
+        return FILE_MAP_READ;
+    case SharedMemory::Protection::ReadWrite:
+        return FILE_MAP_READ | FILE_MAP_WRITE;
+    }
+
+    ASSERT_NOT_REACHED();
+    return FILE_MAP_READ | FILE_MAP_WRITE;
+}
+
+SharedMemoryHandle::SharedMemoryHandle(const SharedMemoryHandle& handle)
+{
+    m_handle = handle.m_handle.duplicate();
+    m_size = handle.m_size;
+}
+
+Win32Handle SharedMemoryHandle::releaseHandle()
+{
+    return std::exchange(m_handle, Win32Handle { });
+}
+
+RefPtr<SharedMemory> SharedMemory::allocate(size_t size)
+{
+    if (!size)
+        return nullptr;
+
+    HANDLE mapping = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE,
+        static_cast<DWORD>(static_cast<uint64_t>(size) >> 32), static_cast<DWORD>(size & 0xFFFFFFFF), nullptr);
+    if (!mapping)
+        return nullptr;
+
+    void* data = MapViewOfFile(mapping, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, size);
+    if (!data) {
+        CloseHandle(mapping);
+        return nullptr;
+    }
+
+    RefPtr<SharedMemory> instance = adoptRef(new SharedMemory());
+    instance->m_data = data;
+    instance->m_size = size;
+    instance->m_handle = Win32Handle { mapping, Win32Handle::Adopt };
+    return instance;
+}
+
+RefPtr<SharedMemory> SharedMemory::map(Handle&& handle, Protection protection, CopyOnWrite copyOnWrite)
+{
+    ASSERT_UNUSED(copyOnWrite, copyOnWrite == CopyOnWrite::No);
+
+    if (!handle.m_handle)
+        return nullptr;
+
+    void* data = MapViewOfFile(handle.m_handle.get(), accessModeFromProtection(protection), 0, 0, handle.size());
+    if (!data)
+        return nullptr;
+
+    RefPtr<SharedMemory> instance = adoptRef(new SharedMemory());
+    instance->m_data = data;
+    instance->m_size = handle.size();
+    return instance;
+}
+
+SharedMemory::~SharedMemory()
+{
+    if (m_data)
+        UnmapViewOfFile(m_data);
+}
+
+auto SharedMemory::createHandle(Protection protection) -> std::optional<Handle>
+{
+    UNUSED_PARAM(protection);
+
+    HANDLE duplicate = nullptr;
+    if (!m_handle || !DuplicateHandle(GetCurrentProcess(), m_handle.get(), GetCurrentProcess(), &duplicate, 0, FALSE, DUPLICATE_SAME_ACCESS)) {
+        ASSERT_NOT_REACHED();
+        return std::nullopt;
+    }
+    return { Handle(Win32Handle { duplicate, Win32Handle::Adopt }, m_size) };
+}
+
