+// MinGW: emulate a socket pair over two connected UDP sockets on the loopback
+// interface. IPC messages are capped at IPC::s_messageMaxSize bytes, which
+// comfortably fits into a single datagram, so message boundaries are preserved
+// just like with SOCK_SEQPACKET.
+//
+// The "server" descriptor is the bound socket itself (a raw SOCKET value kept
+// in a UnixFileDescriptor). The "client" descriptor carries the UDP port
+// number of the server socket; the process launcher passes it to the child
+// process, which creates its own socket, connects back to the server and
+// exchanges a credentials datagram so both sides know their peer's port.
+
+SocketPair createPlatformConnection(int socketType, unsigned options)
+{
+    UNUSED_PARAM(socketType);
+    UNUSED_PARAM(options);
+
+    SOCKET server = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (server == INVALID_SOCKET)
+        return { };
+
+    sockaddr_in address = { };
+    address.sin_family = AF_INET;
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    address.sin_port = 0;
+    if (::bind(server, reinterpret_cast<sockaddr*>(&address), sizeof(address)) == SOCKET_ERROR) {
+        closesocket(server);
+        return { };
+    }
+
+    sockaddr_in boundAddress = { };
+    int boundAddressLength = sizeof(boundAddress);
+    if (::getsockname(server, reinterpret_cast<sockaddr*>(&boundAddress), &boundAddressLength) == SOCKET_ERROR) {
+        closesocket(server);
+        return { };
+    }
+
+    int serverPort = ntohs(boundAddress.sin_port);
+
+    // Sockets are OS handles; store the raw value. GLib's g_socket_new_from_fd()
+    // treats the value as a SOCKET on Windows.
+    return {
+        { static_cast<int>(server), UnixFileDescriptor::Adopt },
+        { serverPort, UnixFileDescriptor::Adopt },
