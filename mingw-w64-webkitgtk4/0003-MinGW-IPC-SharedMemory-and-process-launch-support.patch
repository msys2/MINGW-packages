+void ArgumentCoder<Win32Handle>::encode(Encoder& encoder, const Win32Handle& handle)
+{
+    if (!handle) {
+        encoder.addAttachment(Attachment { });
+        return;
+    }
+
+    HANDLE duplicate = nullptr;
+    if (!DuplicateHandle(GetCurrentProcess(), handle.get(), GetCurrentProcess(), &duplicate, 0, FALSE, DUPLICATE_SAME_ACCESS)) {
+        ASSERT_NOT_REACHED();
+        encoder.addAttachment(Attachment { });
+        return;
+    }
+    encoder.addAttachment(Attachment { duplicate });
+}
+
+void ArgumentCoder<Win32Handle>::encode(Encoder& encoder, Win32Handle&& handle)
+{
+    if (!handle) {
+        encoder.addAttachment(Attachment { });
+        return;
+    }
+
+    // The handle is adopted by the attachment, which closes it on destruction.
+    encoder.addAttachment(Attachment { handle.release() });
+}
+
+std::optional<Win32Handle> ArgumentCoder<Win32Handle>::decode(Decoder& decoder)
+{
+    auto attachment = decoder.takeLastAttachment();
+    if (!attachment)
+        return std::nullopt;
+
+    return Win32Handle { attachment->handle, Win32Handle::Adopt };
+}
+#endif // OS(WINDOWS)
