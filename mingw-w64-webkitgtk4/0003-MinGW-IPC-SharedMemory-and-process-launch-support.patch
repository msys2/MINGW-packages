+static HANDLE duplicateHandleForProcess(HANDLE handle, DWORD processID)
+{
+    if (!handle || handle == INVALID_HANDLE_VALUE)
+        return nullptr;
+
+    HANDLE remoteProcess = OpenProcess(PROCESS_DUP_HANDLE, FALSE, processID);
+    if (!remoteProcess)
+        return nullptr;
+
+    HANDLE target = nullptr;
+    BOOL result = DuplicateHandle(GetCurrentProcess(), handle, remoteProcess, &target, 0, FALSE, DUPLICATE_SAME_ACCESS);
+    CloseHandle(remoteProcess);
+    return result ? target : nullptr;
