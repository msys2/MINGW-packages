 namespace IPC {
 
 // IPC::Attachment is a type representing objects that cannot be transferred as data,
 // rather they are transferred via operating system cross-process communication primitives.
 #if OS(DARWIN)
 using Attachment = MachSendRight;
-#elif OS(WINDOWS)
-struct Attachment { }; // Windows does not need attachments at the moment.
+#elif OS(WINDOWS) && !USE(UNIX_DOMAIN_SOCKETS)
+// Windows attachments carry a raw HANDLE value that the connection's send path
+// has already duplicated into the destination process. The attachment owns the
+// handle and closes it on destruction.
+struct Attachment {
+    Attachment() = default;
+    explicit Attachment(HANDLE value)
+        : handle(value)
+    {
+    }
+    Attachment(Attachment&& other)
+        : handle(std::exchange(other.handle, nullptr))
+    {
+    }
+    Attachment& operator=(Attachment&& other)
+    {
+        if (this != &other) {
+            closeIfNeeded();
+            handle = std::exchange(other.handle, nullptr);
+        }
+        return *this;
+    }
+    ~Attachment()
+    {
+        closeIfNeeded();
+    }
+    explicit operator bool() const { return handle && handle != INVALID_HANDLE_VALUE; }
+    HANDLE handle { nullptr };
+
+private:
+    void closeIfNeeded()
+    {
+        if (handle && handle != INVALID_HANDLE_VALUE)
+            CloseHandle(handle);
+        handle = nullptr;
+    }
+};
 #elif OS(ANDROID)
 using Attachment = Variant<UnixFileDescriptor, RefPtr<AHardwareBuffer>>;
 #elif USE(UNIX_DOMAIN_SOCKETS)
