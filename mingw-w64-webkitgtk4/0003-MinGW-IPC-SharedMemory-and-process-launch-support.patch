+bool createServerAndClientIdentifiers(HANDLE& serverIdentifier, HANDLE& clientIdentifier)
+{
+    serverIdentifier = nullptr;
+    clientIdentifier = nullptr;
+
+    SOCKET server = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (server == INVALID_SOCKET)
+        return false;
+
+    sockaddr_in address = { };
+    address.sin_family = AF_INET;
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    address.sin_port = 0;
+    if (::bind(server, reinterpret_cast<sockaddr*>(&address), sizeof(address)) == SOCKET_ERROR) {
+        closesocket(server);
+        return false;
+    }
+
+    sockaddr_in boundAddress = { };
+    int boundAddressLength = sizeof(boundAddress);
+    if (::getsockname(server, reinterpret_cast<sockaddr*>(&boundAddress), &boundAddressLength) == SOCKET_ERROR) {
+        closesocket(server);
+        return false;
+    }
+
+    SOCKET client = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (client == INVALID_SOCKET) {
+        closesocket(server);
+        return false;
+    }
+
+    if (::connect(client, reinterpret_cast<sockaddr*>(&boundAddress), sizeof(boundAddress)) == SOCKET_ERROR) {
+        closesocket(client);
+        closesocket(server);
+        return false;
+    }
+
+    serverIdentifier = reinterpret_cast<HANDLE>(server);
+    clientIdentifier = reinterpret_cast<HANDLE>(client);
+    return true;
+}
