+ *    documentation and/or other materials provided with the distribution.
+ *
+ * THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS
+ * "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT
+ * LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR
+ * A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT
+ * HOLDER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
+ * SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT
+ * LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE,
+ * DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY
+ * THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT
+ * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE
+ * OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+/*
+ * MinGW compat shim: the BSD <err.h> diagnostics API.
+ *
+ * The MinGW-w64 CRT does not provide <err.h> (err/errx/warn/warnx and
+ * their v-variants are BSD/glibc extensions), but vendored build tools
+ * such as ThirdParty/unifdef rely on it. This header implements the
+ * complete family as static inline functions on top of plain stdio,
+ * matching the BSD semantics:
+ *
+ *   warn(fmt, ...)   <message>: <strerror(errno)> + newline
+ *   warnx(fmt, ...)  <message> + newline
+ *   err(eval, ...)   warn() followed by exit(eval)
+ *   errx(eval, ...)  warnx() followed by exit(eval)
+ *
+ * errno is captured before any stdio call so that the vfprintf() inside
+ * the implementation cannot clobber the value being reported. If the
+ * format string is empty or NULL, the ": " separator is suppressed as
+ * on BSD. All functions are static inline, so no err* symbols are ever
+ * referenced or defined and the header can safely be included from any
+ * number of translation units (C or C++). The v-variants carry the same
+ * format(printf, N, 0) attributes glibc uses, so both -Wmissing-format-attribute
+ * and format-string checking behave as they would against the BSD header.
+ */
+
+#ifndef MINGW_COMPAT_ERR_H
+#define MINGW_COMPAT_ERR_H
+
+#include <errno.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Under MinGW gcc the plain printf archetype checks against the MSVCRT
+   printf (ms_printf), while the C runtime's vfprintf() itself is declared
+   with the gnu_printf archetype (C99-conformant __mingw_printf is used at
+   runtime thanks to __USE_MINGW_ANSI_STDIO). Mirror mingw-w64's own
+   stdio.h mapping so these attributes match the implementations called
+   below; clang already checks the plain printf archetype as C99, and
+   non-MinGW hosts keep it too. */
+#if defined(__MINGW32__) && defined(__GNUC__) && !defined(__clang__) \
+    && (defined(_UCRT) || __USE_MINGW_ANSI_STDIO)
+#define MINGW_COMPAT_PRINTF_ARCHETYPE __gnu_printf__
+#else
+#define MINGW_COMPAT_PRINTF_ARCHETYPE printf
+#endif
+
+/* The v-variants carry the format(printf, N, 0) attribute exactly like
+   glibc does. Callers that forward their own format parameter to them
+   (e.g. unifdef's debug() wrapper, which is declared with
+   format(printf, 1, 2)) are then exempt from -Wformat-nonliteral and
+   -Wformat-security for the forwarded format. */
+
+__attribute__((format(MINGW_COMPAT_PRINTF_ARCHETYPE, 1, 0)))
+static inline void vwarnx(const char* fmt, va_list ap)
+{
+    if (fmt && *fmt)
+        vfprintf(stderr, fmt, ap);
+    fputc('\n', stderr);
+}
+
+__attribute__((format(MINGW_COMPAT_PRINTF_ARCHETYPE, 1, 0)))
+static inline void vwarn(const char* fmt, va_list ap)
+{
+    int saved_errno = errno;
+
+    if (fmt && *fmt) {
+        vfprintf(stderr, fmt, ap);
+        fputs(": ", stderr);
+    }
+    fputs(strerror(saved_errno), stderr);
+    fputc('\n', stderr);
+}
+
+__attribute__((format(MINGW_COMPAT_PRINTF_ARCHETYPE, 1, 2)))
+static inline void warnx(const char* fmt, ...)
+{
+    va_list ap;
+
+    va_start(ap, fmt);
+    vwarnx(fmt, ap);
+    va_end(ap);
+}
+
+__attribute__((format(MINGW_COMPAT_PRINTF_ARCHETYPE, 1, 2)))
+static inline void warn(const char* fmt, ...)
+{
+    va_list ap;
+
+    va_start(ap, fmt);
+    vwarn(fmt, ap);
+    va_end(ap);
+}
+
+__attribute__((format(MINGW_COMPAT_PRINTF_ARCHETYPE, 2, 3)))
+static inline void errx(int eval, const char* fmt, ...)
+{
+    va_list ap;
+
+    va_start(ap, fmt);
+    vwarnx(fmt, ap);
+    va_end(ap);
+    exit(eval);
+}
+
+__attribute__((format(MINGW_COMPAT_PRINTF_ARCHETYPE, 2, 3)))
+static inline void err(int eval, const char* fmt, ...)
+{
+    va_list ap;
+
+    va_start(ap, fmt);
+    vwarn(fmt, ap);
+    va_end(ap);
+    exit(eval);
+}
+
+__attribute__((format(MINGW_COMPAT_PRINTF_ARCHETYPE, 2, 0)))
+static inline void verrx(int eval, const char* fmt, va_list ap)
+{
+    vwarnx(fmt, ap);
+    exit(eval);
+}
+
+__attribute__((format(MINGW_COMPAT_PRINTF_ARCHETYPE, 2, 0)))
+static inline void verr(int eval, const char* fmt, va_list ap)
+{
+    vwarn(fmt, ap);
+    exit(eval);
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* MINGW_COMPAT_ERR_H */
diff --git a/Source/ThirdParty/mingw-compat/include/fnmatch.h b/Source/ThirdParty/mingw-compat/include/fnmatch.h
new file mode 100644
index 0000000..847cf02
--- /dev/null
+++ b/Source/ThirdParty/mingw-compat/include/fnmatch.h
@@ -0,0 +1,157 @@
+/*
+ * Copyright (C) 2025 Tao Zuhong
+ *
+ * This library is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or (at
+ * your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful, but WITHOUT
+ * ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE. See the GNU Lesser General Public License
+ * for more details.
+ *
+ * Minimal <fnmatch.h> emulation for MinGW: the mingw-w64 CRT does not provide
+ * the POSIX fnmatch(3). Implementations used inside WebKit (xdgmime glob
+ * matching, GStreamer pattern checks) always pass flags = 0, so the matcher
+ * below implements the classic glob subset (*, ?, [...], backslash escaping)
+ * and defines the standard flag constants for completeness.
+ */
+
+#pragma once
+
+#include <ctype.h>
+
+#define FNM_NOMATCH     1
+#define FNM_PATHNAME    2
+#define FNM_PERIOD      4
+#define FNM_NOESCAPE    8
+#define FNM_CASEFOLD    16
+#define FNM_LEADING_DIR 32
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+inline static int fnmatchInternal(const char *pattern, const char *string, int flags)
+{
+    int fold = flags & FNM_CASEFOLD;
+
+    while (*pattern) {
+        char c = *pattern++;
+
+        if (c == '*') {
+            while (*pattern == '*')
+                pattern++;
+            if (!*pattern)
+                return 0;
+            for (; *string; string++) {
+                if (fnmatchInternal(pattern, string, flags) == 0)
+                    return 0;
+            }
+            return FNM_NOMATCH;
+        }
+
+        if (!*string)
+            return FNM_NOMATCH;
+
+        if (c == '?') {
+            if ((flags & FNM_PATHNAME) && *string == '/')
+                return FNM_NOMATCH;
+            string++;
+            continue;
+        }
+
+        if (c == '\\') {
+            if (flags & FNM_NOESCAPE)
+                goto literal;
+            if (!*pattern)
+                return FNM_NOMATCH;
+            c = *pattern++;
+            if (fold) {
+                if (tolower((unsigned char)c) != tolower((unsigned char)*string))
+                    return FNM_NOMATCH;
+            } else if (c != *string) {
+                return FNM_NOMATCH;
+            }
+            string++;
+            continue;
+        }
+
+        if (c == '[') {
+            int negate = 0;
+            int matched = 0;
+            char sc = *string++;
+
+            if ((flags & FNM_PATHNAME) && sc == '/')
+                return FNM_NOMATCH;
+
+            if (*pattern == '!' || *pattern == '^') {
+                negate = 1;
+                pattern++;
+            }
+
+            char pc = *pattern++;
+            if (pc == ']') {
+                /* A ']' in leading position is a literal member. */
+                if (fold) {
+                    if (tolower((unsigned char)sc) == tolower((unsigned char)pc))
+                        matched = 1;
+                } else if (sc == pc)
+                    matched = 1;
+                pc = *pattern++;
+            }
+            while (pc && pc != ']') {
+                if (*pattern == '-' && pattern[1] && pattern[1] != ']') {
+                    char lo = pc;
+                    char hi = pattern[1];
+                    pattern += 2;
+                    if (lo > hi) {
+                        char tmp = lo;
+                        lo = hi;
+                        hi = tmp;
+                    }
+                    if (fold) {
+                        char fsc = tolower((unsigned char)sc);
+                        if (fsc >= tolower((unsigned char)lo) && fsc <= tolower((unsigned char)hi))
+                            matched = 1;
+                    } else if (sc >= lo && sc <= hi)
+                        matched = 1;
+                } else {
+                    if (fold) {
+                        if (tolower((unsigned char)sc) == tolower((unsigned char)pc))
+                            matched = 1;
+                    } else if (sc == pc)
+                        matched = 1;
+                }
+                pc = *pattern++;
+            }
+            /* Unterminated class is a literal-failure, not a crash. */
+            if (!pc)
+                return FNM_NOMATCH;
+            if (negate ? matched : !matched)
+                return FNM_NOMATCH;
+            continue;
+        }
+
+literal:
+        if (fold) {
+            if (tolower((unsigned char)c) != tolower((unsigned char)*string))
+                return FNM_NOMATCH;
+        } else if (c != *string) {
+            return FNM_NOMATCH;
+        }
+        string++;
+    }
+
+    return *string ? FNM_NOMATCH : 0;
+}
+
+inline static int fnmatch(const char *pattern, const char *string, int flags)
+{
+    return fnmatchInternal(pattern, string, flags);
+}
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/Source/ThirdParty/mingw-compat/include/netinet/in.h b/Source/ThirdParty/mingw-compat/include/netinet/in.h
new file mode 100644
index 0000000..3762db2
--- /dev/null
+++ b/Source/ThirdParty/mingw-compat/include/netinet/in.h
@@ -0,0 +1,54 @@
+/*
+ * Copyright (C) 2025 Tao Zuhong
+ *
+ * This library is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or (at
+ * your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful, but WITHOUT
+ * ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE. See the GNU Lesser General Public License
+ * for more details.
+ *
+ * Minimal <netinet/in.h> emulation for MinGW: the mingw-w64 CRT does not
+ * provide the POSIX header. winsock2.h does declare ntohl/ntohs, but as
+ * dllimport symbols requiring the ws2_32 import library at link time; the
+ * inline implementations below keep the byte-order conversions
+ * dependency-free. Windows only runs on little-endian hosts.
+ */
+
+#pragma once
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+inline static uint32_t ntohl(uint32_t value)
+{
+    return ((value & 0x000000ffu) << 24)
+         | ((value & 0x0000ff00u) << 8)
+         | ((value & 0x00ff0000u) >> 8)
+         | ((value & 0xff000000u) >> 24);
+}
+
+inline static uint16_t ntohs(uint16_t value)
+{
+    return (uint16_t)((value >> 8) | (value << 8));
+}
+
+inline static uint32_t htonl(uint32_t value)
+{
+    return ntohl(value);
+}
+
+inline static uint16_t htons(uint16_t value)
+{
+    return ntohs(value);
+}
+
+#ifdef __cplusplus
+}
+#endif
