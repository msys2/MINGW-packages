From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Taozuhong <taozuhong@hotmail.com>
Date: Mon, 12 Oct 2026 07:22:50 +0000
Subject: [PATCH 5/6] MinGW: Skia FreeType backend and GTK font manager

- ThirdParty/skia: build the FreeType/Fontconfig branch under MinGW
  (the release tarball lacks all four skia/src/utils/win/ files needed
  by the DirectWrite backend); file IO via SkOSFile_win.cpp instead of
  the sys/mman.h-requiring posix variant; SK_TYPEFACE_FACTORY=FREETYPE.
- FontCacheSkia.cpp: the GTK platform uses SkFontMgr_New_FontConfig
  (same shape as Linux GTK) instead of DirectWrite.

  Update 18 (fixing one UCRT64 and one CLANG64 Skia failure):
  include/private/SkAttributes.h maps SK_ALWAYS_INLINE to
  __forceinline whenever SK_BUILD_FOR_WIN is set, and both MinGW
  compilers trigger that branch via _WIN32. MinGW GCC only survives
  the keyword when a CRT header happens to be included first - the
  mingw-w64 _mingw.h defines __forceinline as a macro and libstdc++
  pulls one in before SkAssert.h:191 - but clang64's libc++ headers
  pull no CRT header on that path, so the token reached the parser
  and SkAssert.h:191 died with "unknown type name '__forceinline'".
  The keyword is now reserved to real MSVC-family compilers
  (SK_BUILD_FOR_WIN && _MSC_VER), matching the guard SkFeatures.h
  already applies to SK_RESTRICT; MinGW compilers fall back to the
  portable SK_ATTRIBUTE(always_inline) inline form.
  src/core/SkRasterPipeline.h enables SK_HAS_MUSTTAIL whenever
  __has_cpp_attribute(clang::musttail) fires, and GCC 15 understands
  [[clang::musttail]]. The Win64 ABI passes Skia's 16-byte vector
  values by invisible reference, so GCC rejects every highp stage
  tail call with "cannot tail-call: argument must be passed by
  copying" (first hit at sse3::set_base_pointer while compiling
  SkOpts.cpp; 20 errors before -fmax-errors cut it off). The flag now
  also requires !(__MINGW32__ && !__clang__): MinGW clang folds the
  same tail calls successfully (verified against the emitted objects,
  since clang passes the vectors by value there) and keeps them,
  while MinGW GCC compiles the stages as regular calls, which is also
  how MSVC builds behave.

  Update 20 (fixing one CLANG64 and one CLANGARM64 Skia failure):
  src/ports/SkFontHost_FreeType.cpp includes <dlfcn.h> whenever the
  default SK_FREETYPE_MINIMUM_RUNTIME_VERSION carries the
  SK_FREETYPE_DLOPEN flag (SkFontHost_FreeType.cpp:91), and mingw-w64
  does not ship <dlfcn.h>, so both CLANG64 and CLANGARM64 died on the
  first FreeType translation unit with "fatal error: 'dlfcn.h' file
  not found". The dl*() symbols are not referenced anywhere in the
  file - that include is the flag's only remaining consumer - so the
  include is now guarded with !defined(_WIN32). Windows builds simply
  use the FreeType library they link against, which is what the
  dlopen fallback would have handed them anyway.
---
 Source/ThirdParty/skia/CMakeLists.txt            | 16 ++++++++++++----
 .../skia/include/private/SkAttributes.h          |  6 +++++-
 .../ThirdParty/skia/src/core/SkRasterPipeline.h  |  6 ++++++
 .../platform/graphics/skia/FontCacheSkia.cpp     |  4 ++--
 .../skia/src/ports/SkFontHost_FreeType.cpp       |  4 +++-
 5 files changed, 28 insertions(+), 8 deletions(-)

diff --git a/Source/ThirdParty/skia/CMakeLists.txt b/Source/ThirdParty/skia/CMakeLists.txt
index 49b9262..6d826bf 100644
--- a/Source/ThirdParty/skia/CMakeLists.txt
+++ b/Source/ThirdParty/skia/CMakeLists.txt
@@ -1,7 +1,7 @@
 set_property(DIRECTORY . PROPERTY FOLDER "skia")
 
 # Skia dependencies not used directly in WebKit.
-if (NOT WIN32 AND NOT PLAYSTATION)
+if ((NOT WIN32 OR MINGW) AND NOT PLAYSTATION)
     find_package(Freetype 2.9.0 REQUIRED)
     find_package(Fontconfig 2.13.0 REQUIRED)
 endif ()
@@ -811,7 +811,7 @@ add_library(Skia STATIC
     modules/skcms/src/skcms_TransformSkx.cc
 )
 
-if (WIN32)
+if (WIN32 AND NOT MINGW)
     target_sources(Skia PRIVATE
         src/ports/SkFontHost_win.cpp
         src/ports/SkFontMgr_win_dw.cpp
@@ -825,10 +825,18 @@ if (WIN32)
         src/utils/win/SkHRESULT.cpp
     )
 else ()
+    if (MINGW)
+        target_sources(Skia PRIVATE
+            src/ports/SkOSFile_win.cpp
+        )
+    else ()
+        target_sources(Skia PRIVATE
+            src/ports/SkOSFile_posix.cpp
+        )
+    endif ()
     target_sources(Skia PRIVATE
         src/ports/SkFontHost_FreeType.cpp
         src/ports/SkFontHost_FreeType_common.cpp
-        src/ports/SkOSFile_posix.cpp
         src/ports/SkTypeface_proxy.cpp
     )
     target_link_libraries(Skia PRIVATE Freetype::Freetype)
@@ -1082,7 +1090,7 @@ target_compile_definitions(Skia PUBLIC
     SK_ASSUME_WEBGL=0
 )
 
-if (WIN32)
+if (WIN32 AND NOT MINGW)
     target_compile_definitions(Skia PRIVATE SK_TYPEFACE_FACTORY_DIRECTWRITE)
 else ()
     target_compile_definitions(Skia PRIVATE SK_TYPEFACE_FACTORY_FREETYPE)
diff --git a/Source/ThirdParty/skia/include/private/SkAttributes.h b/Source/ThirdParty/skia/include/private/SkAttributes.h
index 6c189ee..febfe5f 100644
--- a/Source/ThirdParty/skia/include/private/SkAttributes.h
+++ b/Source/ThirdParty/skia/include/private/SkAttributes.h
@@ -24,7 +24,11 @@
  *     SK_ALWAYS_INLINE void someMethod() { ... }   // should always be inlined
  */
 #if !defined(SK_ALWAYS_INLINE)
-#  if defined(SK_BUILD_FOR_WIN)
+#  if defined(SK_BUILD_FOR_WIN) && defined(_MSC_VER)
+// Real MSVC-family compilers only. MinGW GCC and MinGW clang do not know
+// the __forceinline keyword, and GCC only survives it when a CRT header
+// (which defines the keyword as a macro) happens to be included first, so
+// fall back to the portable attribute form on those toolchains.
 #    define SK_ALWAYS_INLINE __forceinline
 #  else
 #    define SK_ALWAYS_INLINE SK_ATTRIBUTE(always_inline) inline
diff --git a/Source/ThirdParty/skia/src/core/SkRasterPipeline.h b/Source/ThirdParty/skia/src/core/SkRasterPipeline.h
index feb9cc0..f5d9a70 100644
--- a/Source/ThirdParty/skia/src/core/SkRasterPipeline.h
+++ b/Source/ThirdParty/skia/src/core/SkRasterPipeline.h
@@ -29,9 +29,15 @@ struct skcms_TransferFunction;
 
 #if __has_cpp_attribute(clang::musttail) && !defined(__EMSCRIPTEN__) && !defined(SK_CPU_ARM32) && \
         !defined(SK_CPU_LOONGARCH) && !defined(SK_CPU_PPC) && \
+        !(defined(__MINGW32__) && !defined(__clang__)) && \
         !(defined(_WIN32) && defined(SK_BUILD_FOR_ANDROID_FRAMEWORK))
     // [[clang::musttail]] is disabled for the Android version of Skia running on Windows as it
     // causes crashes (This is probably related to http://crbug.com/1505442).
+    // It is also disabled for MinGW GCC: the Win64 ABI passes Skia's 16-byte
+    // vector values by invisible reference, so GCC 15+ (which understands
+    // [[clang::musttail]]) rejects every stage tail call with
+    // "cannot tail-call: argument must be passed by copying". MinGW clang
+    // folds the same calls successfully, so it keeps the tail calls.
     #define SK_HAS_MUSTTAIL 1
 #else
     #define SK_HAS_MUSTTAIL 0
diff --git a/Source/WebCore/platform/graphics/skia/FontCacheSkia.cpp b/Source/WebCore/platform/graphics/skia/FontCacheSkia.cpp
index e5885cc..c7ec06d 100644
--- a/Source/WebCore/platform/graphics/skia/FontCacheSkia.cpp
+++ b/Source/WebCore/platform/graphics/skia/FontCacheSkia.cpp
@@ -44,7 +44,7 @@ WTF_IGNORE_WARNINGS_IN_THIRD_PARTY_CODE_BEGIN
 
 #if OS(ANDROID)
 #include <skia/ports/SkFontMgr_android.h>
-#elif PLATFORM(WIN)
+#elif OS(WINDOWS) && !PLATFORM(GTK)
 #include <dwrite.h>
 #include <skia/ports/SkTypeface_win.h>
 #else
@@ -63,7 +63,7 @@ SkFontMgr& FontCache::fontManager() const
     if (!m_fontManager) {
 #if OS(ANDROID)
         m_fontManager = SkFontMgr_New_Android(nullptr, SkFontScanner_Make_FreeType());
-#elif OS(WINDOWS)
+#elif OS(WINDOWS) && !PLATFORM(GTK)
         auto result = createDWriteFactory();
         m_fontManager = SkFontMgr_New_DirectWrite(result.factory.get(), result.fontCollection.get());
 #else
diff --git a/Source/ThirdParty/skia/src/ports/SkFontHost_FreeType.cpp b/Source/ThirdParty/skia/src/ports/SkFontHost_FreeType.cpp
index f8043f25e91e..7d75e17be6b5 100644
--- a/Source/ThirdParty/skia/src/ports/SkFontHost_FreeType.cpp
+++ b/Source/ThirdParty/skia/src/ports/SkFontHost_FreeType.cpp
@@ -88,7 +88,9 @@
 #  endif
 #endif
 #if SK_FREETYPE_MINIMUM_RUNTIME_VERSION & SK_FREETYPE_DLOPEN
-#  include <dlfcn.h>
+#  if !defined(_WIN32)
+#    include <dlfcn.h>
+#  endif
 #endif
 
 #ifdef TT_SUPPORT_COLRV1
