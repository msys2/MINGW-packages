diff --git a/Source/cmake/FindGLib.cmake b/Source/cmake/FindGLib.cmake
index b6ff9283..5e6e097d 100644
--- a/Source/cmake/FindGLib.cmake
+++ b/Source/cmake/FindGLib.cmake
@@ -206,7 +206,13 @@ GLib_DeclareComponent(Module  gmodule-2.0  gmodule-2.0)
 GLib_DeclareComponent(Object  gobject-2.0  gobject-2.0)
 GLib_DeclareComponent(Thread  gthread-2.0  gthread-2.0)
 GLib_DeclareComponent(Gio     gio-2.0      gio-2.0 Object)
-GLib_DeclareComponent(GioUnix gio-unix-2.0 gio-2.0 Gio)
+# MinGW: there is no gio-unix-2.0 module; use the gio-2.0 library directly so
+# that code asking for the GioUnix component still links on Windows.
+if (WIN32)
+    GLib_DeclareComponent(GioUnix gio-2.0 gio-2.0 Gio)
+else ()
+    GLib_DeclareComponent(GioUnix gio-unix-2.0 gio-2.0 Gio)
+endif ()
 
 foreach (component IN LISTS GLib_FIND_COMPONENTS)
     GLib_HandleComponent(${component})
