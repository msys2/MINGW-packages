+#include <windows.h>
+#include <utility>
+
+namespace WTF {
+
+class Win32Handle {
+public:
+    Win32Handle() = default;
+
+    enum AdoptionTag { Adopt };
+    explicit Win32Handle(HANDLE handle, AdoptionTag)
+        : m_handle(handle)
+    {
+    }
+
+    Win32Handle(Win32Handle&& other)
+        : m_handle(other.release())
+    {
+    }
+
+    Win32Handle& operator=(Win32Handle&& other)
+    {
+        if (&other != this)
+            m_handle = other.release();
+        return *this;
+    }
+
+    ~Win32Handle()
+    {
+        clear();
+    }
+
+    explicit operator bool() const { return m_handle && m_handle != INVALID_HANDLE_VALUE; }
+
+    HANDLE get() const { return m_handle; }
+
+    void clear()
+    {
+        if (HANDLE handle = std::exchange(m_handle, nullptr)) {
+            if (handle != INVALID_HANDLE_VALUE)
+                CloseHandle(handle);
+        }
+    }
+
+    [[nodiscard]] HANDLE release() { return std::exchange(m_handle, nullptr); }
+
+    Win32Handle duplicate() const
+    {
+        if (!m_handle || m_handle == INVALID_HANDLE_VALUE)
+            return { };
+
+        HANDLE duplicate = nullptr;
+        if (!DuplicateHandle(GetCurrentProcess(), m_handle, GetCurrentProcess(), &duplicate, 0, FALSE, DUPLICATE_SAME_ACCESS))
+            return { };
+
+        return Win32Handle { duplicate, Adopt };
+    }
+
+private:
+    HANDLE m_handle { nullptr };
+};
+
+} // namespace WTF
+
+using WTF::Win32Handle;
