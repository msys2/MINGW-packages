+    if (!DuplicateHandle(GetCurrentProcess(), handle.get(), GetCurrentProcess(), &duplicate, 0, FALSE, DUPLICATE_SAME_ACCESS)) {
+        ASSERT_NOT_REACHED();
+        encoder.addAttachment(Attachment { });
+        return;
+    }
+    encoder.addAttachment(Attachment { WTF::intFromHandleValue(duplicate), Attachment::Adopt });
+}
+
+void ArgumentCoder<Win32Handle>::encode(Encoder& encoder, Win32Handle&& handle)
+{
+    if (!handle) {
+        encoder.addAttachment(Attachment { });
+        return;
+    }
+
+    // The handle is adopted by the attachment, which closes it on destruction.
+    encoder.addAttachment(Attachment { WTF::intFromHandleValue(handle.release()), Attachment::Adopt });
+}
+
+std::optional<Win32Handle> ArgumentCoder<Win32Handle>::decode(Decoder& decoder)
+{
+    auto attachment = decoder.takeLastAttachment();
+    if (!attachment)
+        return std::nullopt;
+
+    // release() disowns the packed value so the attachment's destructor does
+    // not close the handle that the returned Win32Handle now owns.
+    return Win32Handle { WTF::handleFromIntValue(attachment->release()), Win32Handle::Adopt };
+}
