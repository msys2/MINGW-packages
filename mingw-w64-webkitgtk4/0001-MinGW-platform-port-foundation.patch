+// MinGW builds force USE_UNIX_DOMAIN_SOCKETS (PlatformUse.h) because the GLib
+// IPC layer encodes SharedMemoryHandle through WTF::UnixFileDescriptor. The
+// int payload of that class carries Win32 handles (only the lower 32 bits are
+// significant per the Windows interop guarantee; see UnixFileDescriptor.h),
+// so this file backs the Unix-flavored SharedMemory API with page-file backed
+// file mappings and MapViewOfFile. The mapping handle itself travels inside
+// the UnixFileDescriptor of the handle; IPC::Connection's Windows send path
+// duplicates handles into the destination process before sending.
+
+static inline DWORD accessModeFromProtection(SharedMemory::Protection protection)
+{
+    switch (protection) {
+    case SharedMemory::Protection::ReadOnly:
+        return FILE_MAP_READ;
+    case SharedMemory::Protection::ReadWrite:
+        return FILE_MAP_READ | FILE_MAP_WRITE;
+    }
+
+    ASSERT_NOT_REACHED();
+    return FILE_MAP_READ | FILE_MAP_WRITE;
+}
+
+SharedMemoryHandle::SharedMemoryHandle(const SharedMemoryHandle& handle)
+{
+    m_handle = handle.m_handle.duplicate();
+    m_size = handle.m_size;
+}
+
+UnixFileDescriptor SharedMemoryHandle::releaseHandle()
+{
+    return WTF::move(m_handle);
+}
+
+RefPtr<SharedMemory> SharedMemory::allocate(size_t size)
+{
+    if (!size)
+        return nullptr;
+
+    HANDLE mapping = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE,
+        static_cast<DWORD>(static_cast<uint64_t>(size) >> 32), static_cast<DWORD>(size & 0xFFFFFFFF), nullptr);
+    if (!mapping)
+        return nullptr;
+
+    void* data = MapViewOfFile(mapping, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, size);
+    if (!data) {
+        CloseHandle(mapping);
+        return nullptr;
+    }
+
+    RefPtr<SharedMemory> instance = adoptRef(new SharedMemory());
+    instance->m_data = data;
+    instance->m_size = size;
+    instance->m_fileDescriptor = UnixFileDescriptor { WTF::intFromHandleValue(mapping), UnixFileDescriptor::Adopt };
+    return instance;
+}
+
+RefPtr<SharedMemory> SharedMemory::map(Handle&& handle, Protection protection, CopyOnWrite copyOnWrite)
+{
+    // Copy-on-write is not supported on this platform.
+    // FIXME: https://bugs.webkit.org/show_bug.cgi?id=305633
+    ASSERT_UNUSED(copyOnWrite, copyOnWrite == CopyOnWrite::No);
+
+    if (!handle.m_handle)
+        return nullptr;
+
+    void* data = MapViewOfFile(WTF::handleFromIntValue(handle.m_handle.value()), accessModeFromProtection(protection), 0, 0, handle.size());
+    if (!data)
+        return nullptr;
+
+    RefPtr<SharedMemory> instance = adoptRef(new SharedMemory());
+    instance->m_data = data;
+    instance->m_size = handle.size();
+    return instance;
+}
+
+RefPtr<SharedMemory> SharedMemory::wrapMap(void* data, size_t size, int fileDescriptor)
+{
+    RefPtr<SharedMemory> instance = adoptRef(new SharedMemory());
+    instance->m_data = data;
+    instance->m_size = size;
+    instance->m_fileDescriptor = UnixFileDescriptor { fileDescriptor, UnixFileDescriptor::Adopt };
+    instance->m_isWrappingMap = true;
+    return instance;
+}
+
+SharedMemory::~SharedMemory()
+{
+    if (m_isWrappingMap) {
+        auto wrapped = m_fileDescriptor.release();
+        UNUSED_VARIABLE(wrapped);
+        return;
+    }
+
+    UnmapViewOfFile(m_data);
+}
+
+auto SharedMemory::createHandle(Protection) -> std::optional<Handle>
+{
+    // FIXME: Handle the case where the passed Protection is ReadOnly.
+    // See https://bugs.webkit.org/show_bug.cgi?id=131542.
+
+    UnixFileDescriptor duplicate { m_fileDescriptor.value(), UnixFileDescriptor::Duplicate };
+    if (!duplicate) {
+        ASSERT_NOT_REACHED();
+        return std::nullopt;
+    }
+    return { Handle(WTF::move(duplicate), m_size) };
+}
+
