+inline void SignalHandlers::forEachHandler(Signal signal, NOESCAPE const Func& func) const
+{
+    size_t signalIndex = static_cast<size_t>(signal);
+    size_t handlerIndex = numberOfHandlers[signalIndex];
+    while (handlerIndex--) {
+        auto* memory = const_cast<SignalHandlerMemory*>(&handlers[signalIndex][handlerIndex]);
+        const SignalHandler& handler = *std::bit_cast<SignalHandler*>(memory);
+        func(handler);
+    }
+}
+
+void addSignalHandler(Signal signal, SignalHandler&& handler)
+{
+    g_wtfConfig.signalHandlers.add(signal, WTF::move(handler));
+}
+
+void activateSignalHandlersFor(Signal signal)
+{
+    // Vectored exception handlers are active as soon as they are installed,
+    // so activation is a no-op on Windows (mirroring the non-Mach POSIX
+    // path, where handlers are installed once in SignalHandlers::finalize()).
+    const SignalHandlers& handlers = g_wtfConfig.signalHandlers;
+    RELEASE_ASSERT(handlers.initState >= SignalHandlers::InitState::Initializing);
+    ASSERT_UNUSED(signal, signal < Signal::Unknown);
+}
+
+static Signal NODELETE fromWindowsException(DWORD exceptionCode)
+{
+    switch (exceptionCode) {
+    case EXCEPTION_ACCESS_VIOLATION:
+    case EXCEPTION_IN_PAGE_ERROR:
+        return Signal::AccessFault;
+    case EXCEPTION_ILLEGAL_INSTRUCTION:
+    case EXCEPTION_PRIV_INSTRUCTION:
+        return Signal::IllegalInstruction;
+    case EXCEPTION_FLT_DENORMAL_OPERAND:
+    case EXCEPTION_FLT_DIVIDE_BY_ZERO:
+    case EXCEPTION_FLT_INEXACT_RESULT:
+    case EXCEPTION_FLT_INVALID_OPERATION:
+    case EXCEPTION_FLT_OVERFLOW:
+    case EXCEPTION_FLT_STACK_CHECK:
+    case EXCEPTION_FLT_UNDERFLOW:
+        return Signal::FloatingPoint;
+    default:
+        return Signal::Unknown;
+    }
+}
+
+static LONG CALLBACK wtfVectoredExceptionHandler(PEXCEPTION_POINTERS exceptionPointers)
+{
+    Signal signal = fromWindowsException(exceptionPointers->ExceptionRecord->ExceptionCode);
+    if (signal == Signal::Unknown)
+        return EXCEPTION_CONTINUE_SEARCH;
+
+    SignalHandlers& handlers = g_wtfConfig.signalHandlers;
+    if (!handlers.numberOfHandlers[static_cast<size_t>(signal)])
+        return EXCEPTION_CONTINUE_SEARCH;
+
+    SigInfo sigInfo;
+    if (signal == Signal::AccessFault && exceptionPointers->ExceptionRecord->NumberParameters >= 2)
+        sigInfo.faultingAddress = reinterpret_cast<void*>(exceptionPointers->ExceptionRecord->ExceptionInformation[1]);
+
+    PlatformRegisters& registers = *exceptionPointers->ContextRecord;
+
+    bool didHandle = false;
+    handlers.forEachHandler(signal, [&] (const SignalHandler& handler) {
+        SignalAction handlerResult = handler(signal, sigInfo, registers);
+        didHandle |= handlerResult == SignalAction::Handled;
+    });
+
+    return didHandle ? EXCEPTION_CONTINUE_EXECUTION : EXCEPTION_CONTINUE_SEARCH;
+}
+
+void SignalHandlers::initialize()
+{
+    SignalHandlers& handlers = g_wtfConfig.signalHandlers;
+    RELEASE_ASSERT(handlers.initState == SignalHandlers::InitState::Uninitialized);
+    handlers.initState = SignalHandlers::InitState::Initializing;
+}
+
+void SignalHandlers::finalize()
+{
+    Config::AssertNotFrozenScope assertScope;
+    SignalHandlers& handlers = g_wtfConfig.signalHandlers;
+    RELEASE_ASSERT(handlers.initState == SignalHandlers::InitState::Initializing);
+    handlers.initState = SignalHandlers::InitState::Finalized;
+
+    bool hasHandlers = false;
+    for (unsigned i = 0; i < numberOfSignals; ++i)
+        hasHandlers |= handlers.numberOfHandlers[i] != 0;
+    if (!hasHandlers)
+        return;
+
+    // First-handler registration: WTF handlers run before the CRT and any
+    // C++ exception machinery sees the exception.
+    RELEASE_ASSERT(AddVectoredExceptionHandler(1 /* First */, wtfVectoredExceptionHandler));
+}
+
+} // namespace WTF
+
+#endif // OS(UNIX) || OS(WINDOWS)
