diff --git a/Source/JavaScriptCore/CMakeLists.txt b/Source/JavaScriptCore/CMakeLists.txt
index 0cd2c74..6a684b1 100644
--- a/Source/JavaScriptCore/CMakeLists.txt
+++ b/Source/JavaScriptCore/CMakeLists.txt
@@ -1832,14 +1832,28 @@ endif ()
 # Windows ARM64: Disable unwind tables to work around LLVM bug #47432
 # (alignment directives in inline asm break SEH unwind info calculation)
 if (WIN32 AND WTF_CPU_ARM64)
-    target_compile_options(LowLevelInterpreterLib PRIVATE /clang:-fno-unwind-tables)
-
-    # Also disable for other files with alignment directives in inline asm
-    set_source_files_properties(
-        assembler/MacroAssemblerARM64.cpp
-        jit/ThunkGenerators.cpp
-        PROPERTIES COMPILE_FLAGS "/clang:-fno-unwind-tables"
-    )
+    if (MINGW)
+        # MSYS2 clangarm64 drives clang through the GNU frontend (clang++),
+        # which does not understand the clang-cl /clang: routing prefix and
+        # treats it as an input file name.
+        target_compile_options(LowLevelInterpreterLib PRIVATE -fno-unwind-tables)
+
+        # Also disable for other files with alignment directives in inline asm
+        set_source_files_properties(
+            assembler/MacroAssemblerARM64.cpp
+            jit/ThunkGenerators.cpp
+            PROPERTIES COMPILE_FLAGS "-fno-unwind-tables"
+        )
+    else ()
+        target_compile_options(LowLevelInterpreterLib PRIVATE /clang:-fno-unwind-tables)
+
+        # Also disable for other files with alignment directives in inline asm
+        set_source_files_properties(
+            assembler/MacroAssemblerARM64.cpp
+            jit/ThunkGenerators.cpp
+            PROPERTIES COMPILE_FLAGS "/clang:-fno-unwind-tables"
+        )
+    endif ()
 endif ()
 
 # When building JavaScriptCore as an object library, we need to make sure the
@@ -1869,7 +1883,20 @@ if (NOT "${PORT}" STREQUAL "Mac")
     if (${JavaScriptCore_LIBRARY_TYPE} STREQUAL "SHARED")
         WEBKIT_POPULATE_LIBRARY_VERSION(JAVASCRIPTCORE)
         set_target_properties(JavaScriptCore PROPERTIES VERSION ${JAVASCRIPTCORE_VERSION} SOVERSION ${JAVASCRIPTCORE_VERSION_MAJOR})
-        install(TARGETS JavaScriptCore DESTINATION "${LIB_INSTALL_DIR}")
+        if (WIN32)
+            # PE layout (MinGW): the single-DESTINATION form would land the
+            # libjavascriptcoregtk-6.0.dll RUNTIME artifact in lib, where
+            # nothing on Windows ever searches for it (DLLs are resolved
+            # via the importing executable's directory and PATH, and MSYS2
+            # packaging requires runtime DLLs in bin); the import library
+            # stays in lib next to javascriptcoregtk-6.0.pc.
+            install(TARGETS JavaScriptCore
+                RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}"
+                ARCHIVE DESTINATION "${LIB_INSTALL_DIR}"
+            )
+        else ()
+            install(TARGETS JavaScriptCore DESTINATION "${LIB_INSTALL_DIR}")
+        endif ()
     endif ()
 endif ()
 
