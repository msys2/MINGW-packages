+ * LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND
+ * ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT
+ * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF
+ * THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include <wtf/win/DbgHelperWin.h>
+
+#if OS(WINDOWS)
+
+// The 2.54.1 release tarball strips wtf/win/ implementation files, but
+// StackTrace.h calls this from its Windows symbolization path, so restore
+// the dbghelp-backed entry point declared in wtf/win/DbgHelperWin.h.
+
+namespace WTF {
+
+namespace DbgHelper {
+
+bool SymFromAddress(HANDLE hProc, DWORD64 address, DWORD64* displacement, SYMBOL_INFO* symbolInfo)
+{
+    // SymInitialize() must run once per process before the first query;
+    // magic statics make the lazy initialization thread-safe. Symbols are
+    // loaded synchronously since callers only symbolize during logging.
+    static bool symInitialized = !!SymInitialize(hProc, nullptr, TRUE);
+    if (!symInitialized)
+        return false;
+
+    DWORD64 localDisplacement = 0;
+    // StackTrace.h passes nullptr for the displacement out-parameter.
+    DWORD64* displacementOut = displacement ? displacement : &localDisplacement;
+    return !!SymFromAddr(hProc, address, displacementOut, symbolInfo);
+}
+
+} // namespace DbgHelper
+
+} // namespace WTF
+
+#endif // OS(WINDOWS)
