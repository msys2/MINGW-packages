From 7c44a66e5fe5768153c9e6737699063a041963cc Mon Sep 17 00:00:00 2001
From: Taozuhong <taozuhong@hotmail.com>
Date: Sun, 11 Oct 2026 10:05:53 +0000
Subject: [PATCH] libpas/MinGW: windows.h for futex/Sleep, guard clang bitfield
 attribute

- pas_lock.c: mingw-w64's <synchapi.h> declares WaitOnAddress but does
  not pull in winbase.h, leaving INFINITE undeclared; include
  <windows.h> which brings both (this is the fatal error at
  [2137/8552]-[2148/8562] in all four environments).
- pas_status_reporter.c: pas_sleep() calls Sleep() under
  PAS_OS(WINDOWS) without any Windows header; include it (would be the
  next compile failure in the bmalloc batch).
- pas_large_sharing_pool.h: keep the [[clang::preferred_type]] debug
  annotations for clang only; GCC emits 'scoped attribute directive
  ignored' for every TU including the header on Windows.
- bmalloc/CMakeLists.txt: mingw-w64 exposes WaitOnAddress and
  WakeByAddress* through libsynchronization.a, which the default linker
  spec does not include; add it as a PRIVATE dependency so the final
  JavaScriptCore link resolves the futex symbols.
---
 Source/bmalloc/CMakeLists.txt                            | 8 ++++++++
 .../bmalloc/libpas/src/libpas/pas_large_sharing_pool.h   | 9 +++++++++
 Source/bmalloc/libpas/src/libpas/pas_lock.c              | 4 +++-
 Source/bmalloc/libpas/src/libpas/pas_status_reporter.c   | 4 ++++
 4 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/Source/bmalloc/CMakeLists.txt b/Source/bmalloc/CMakeLists.txt
index b9eedea3..12b71406 100644
--- a/Source/bmalloc/CMakeLists.txt
+++ b/Source/bmalloc/CMakeLists.txt
@@ -725,6 +725,14 @@ endif ()
 
 WEBKIT_FRAMEWORK(bmalloc)
 
+if (MINGW)
+    # pas_lock.c emulates futexes through the Windows 8+ WaitOnAddress API
+    # set. mingw-w64 exposes those symbols through libsynchronization.a,
+    # which is not part of the default linker spec; bmalloc is a static
+    # library, so the dependency propagates to the consuming targets.
+    target_link_libraries(bmalloc PRIVATE synchronization)
+endif ()
+
 # bmalloc is statically linked into JavaScriptCore, so it uses JSC's PGO profile.
 if (USE_APPLE_INTERNAL_SDK)
     WEBKIT_TARGET_USE_PGO(bmalloc PROFILE JavaScriptCore)
diff --git a/Source/bmalloc/libpas/src/libpas/pas_large_sharing_pool.h b/Source/bmalloc/libpas/src/libpas/pas_large_sharing_pool.h
index 2840c9c0..e4a81178 100644
--- a/Source/bmalloc/libpas/src/libpas/pas_large_sharing_pool.h
+++ b/Source/bmalloc/libpas/src/libpas/pas_large_sharing_pool.h
@@ -61,9 +61,18 @@ struct pas_large_sharing_node {
     Until then - on Windows we'll use unsigned on these types, but add the clang::preferred_type annotation for better debug information
     */
 
+    /* GCC warns "scoped attribute directive ignored" for every translation
+       unit that includes this header; the annotation only affects clang's
+       debug info, so keep it there. */
+#if defined(__clang__)
     [[clang::preferred_type(pas_commit_mode)]] unsigned is_committed : 1;
     [[clang::preferred_type(pas_physical_memory_synchronization_style)]] unsigned synchronization_style : 1;
     [[clang::preferred_type(pas_page_flags)]] unsigned page_flags : 2;
+#else
+    unsigned is_committed : 1;
+    unsigned synchronization_style : 1;
+    unsigned page_flags : 2;
+#endif
 #else
     pas_commit_mode is_committed : 1;
     pas_physical_memory_synchronization_style synchronization_style : 1;
diff --git a/Source/bmalloc/libpas/src/libpas/pas_lock.c b/Source/bmalloc/libpas/src/libpas/pas_lock.c
index 9ac11002..7dd41555 100644
--- a/Source/bmalloc/libpas/src/libpas/pas_lock.c
+++ b/Source/bmalloc/libpas/src/libpas/pas_lock.c
@@ -40,7 +40,9 @@
 #include <sys/syscall.h>
 #include <unistd.h>
 #elif PAS_OS(WINDOWS)
-#include <synchapi.h>
+/* mingw-w64's synchapi.h declares WaitOnAddress but does not pull in
+   winbase.h, so INFINITE would be undeclared; windows.h brings both. */
+#include <windows.h>
 #elif PAS_OS(FREEBSD)
 #include <sys/umtx.h>
 #endif
diff --git a/Source/bmalloc/libpas/src/libpas/pas_status_reporter.c b/Source/bmalloc/libpas/src/libpas/pas_status_reporter.c
index 61580e8e..bc367680 100644
--- a/Source/bmalloc/libpas/src/libpas/pas_status_reporter.c
+++ b/Source/bmalloc/libpas/src/libpas/pas_status_reporter.c
@@ -29,6 +29,10 @@
 
 #include "pas_status_reporter.h"
 
+#if PAS_OS(WINDOWS)
+#include <windows.h> /* for Sleep */
+#endif
+
 #include "pas_all_heaps.h"
 #include "pas_baseline_allocator_table.h"
 #include "pas_bitfit_directory.h"
-- 
