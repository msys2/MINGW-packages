            "${MINGW_PACKAGE_PREFIX}-gst-libav: media codec plugins")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-gperf"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-perl"
             # Unprefixed "perl" is the MSYS2 POSIX perl (/usr/bin/perl.exe);
             # makepkg -s installs it explicitly because the CI images cannot
             # be relied on to ship it. It is a hard requirement: the
             # forwarding-header pre-generation in build() runs through it
             # (the native Win32 perl stalls on that step), and the build
             # aborts right away when it is missing instead of silently
             # falling back to the stalling path.
             perl
             "${MINGW_PACKAGE_PREFIX}-pkgconf"
             "${MINGW_PACKAGE_PREFIX}-python"
             "${MINGW_PACKAGE_PREFIX}-ruby")
source=("https://webkitgtk.org/releases/webkitgtk-${pkgver}.tar.xz"
        "0001-MinGW-build-system-and-WTF-win-headers.patch"
        "0002-MinGW-WTF-threading-and-compiler-compatibility.patch"
        "0003-MinGW-IPC-SharedMemory-and-process-launch-support.patch"
        "0004-MinGW-cmake-discovery-and-harfbuzz-icu-shim.patch"
        "0005-MinGW-Skia-FreeType-backend-and-GTK-font-manager.patch"
        "0006-MinGW-libpas-and-compat-shims.patch")
