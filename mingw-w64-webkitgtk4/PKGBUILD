# Tarball ships one dangling symlink (skia/ports/fontations/Cargo.toml) whose target is absent; MSYS2 bsdtar aborts extraction on it, so we skip auto-extract and drop the entry in prepare().
noextract=("webkitgtk-${pkgver}.tar.xz")

prepare() {
  # Locate the source tarball across SRCDEST / startdir / srcdir.
  local _tarball=""
  local _cand
  for _cand in "${SRCDEST}/webkitgtk-${pkgver}.tar.xz" \
               "${startdir}/webkitgtk-${pkgver}.tar.xz" \
               "${srcdir}/webkitgtk-${pkgver}.tar.xz"; do
    if [[ -f "${_cand}" ]]; then
      _tarball="${_cand}"
      break
    fi
  done
  if [[ -z "${_tarball}" ]]; then
    echo "webkitgtk-${pkgver}.tar.xz not found in SRCDEST/startdir/srcdir" >&2
    return 1
  fi

  rm -rf "webkitgtk-${pkgver}"
  bsdtar -xpf "${_tarball}" \
    --exclude "webkitgtk-${pkgver}/Source/ThirdParty/skia/src/ports/fontations/Cargo.toml"
  if [[ ! -d "webkitgtk-${pkgver}" ]]; then
    echo "failed to extract webkitgtk source tarball" >&2
    return 1
  fi

  cd webkitgtk-${pkgver}

  patch -Np1 -i "${startdir}/0001-MinGW-build-system-and-WTF-win-headers.patch"
  patch -Np1 -i "${startdir}/0002-MinGW-WTF-threading-and-compiler-compatibility.patch"
  patch -Np1 -i "${startdir}/0003-MinGW-IPC-SharedMemory-and-process-launch-support.patch"
  patch -Np1 -i "${startdir}/0004-MinGW-cmake-discovery-and-harfbuzz-icu-shim.patch"
  patch -Np1 -i "${startdir}/0005-MinGW-Skia-FreeType-backend-and-GTK-font-manager.patch"
  patch -Np1 -i "${startdir}/0006-MinGW-libpas-and-compat-shims.patch"
  patch -Np1 -i "${startdir}/0007-MinGW-WebKitPrintOperation-GtkPrinter-guard.patch"
  patch -Np1 -i "${startdir}/0008-MinGW-ProcessLauncherGLib-unix-IPC-identifier.patch"
  patch -Np1 -i "${startdir}/0009-MinGW-GLFence-unix-methods-portable-declaration.patch"
  patch -Np1 -i "${startdir}/0010-MinGW-NotificationService-write-fsync-Windows-stubs.patch"
  patch -Np1 -i "${startdir}/0011-MinGW-NetworkCacheDataGLib-skip-gfiledescriptorbased.patch"
  patch -Np1 -i "${startdir}/0012-MinGW-IPC-serialization-manifests-mutually-exclusive.patch"
  patch -Np1 -i "${startdir}/0013-MinGW-final-link-undefined-symbols.patch"
  patch -Np1 -i "${startdir}/0014-MinGW-injected-bundle-export-macros.patch"

  # Post-patch sentinels: assert each round's marker landed; abort before multi-hour recompile on regression.
  local _sentinel_fail=0
  # Round 31: GSpanExtras.h must no longer redeclare g_malloc (or -Winconsistent-dllimport fires).
  if grep -q '^void\* g_malloc(size_t);$' Source/WTF/wtf/glib/GSpanExtras.h; then
    echo "SENTINEL FAIL: GSpanExtras.h still has 'void* g_malloc(size_t);'; 0001 GSpanExtras hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 31: WebKitWebContext.cpp must use mutableSpan() (or 6 'data' is private member errors fire).
  if ! grep -q 'widePath\.mutableSpan()\.data()' Source/WebKit/UIProcess/API/glib/WebKitWebContext.cpp; then
    echo "SENTINEL FAIL: WebKitWebContext.cpp missing 'widePath.mutableSpan().data()'; 0003 mingwRealpathForSandbox hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 31: PlatformGTK.cmake must own the SKIP option (or UCRT64 forwarding-headers perl stall returns).
  if ! grep -q 'option(WEBKIT_FORWARDING_HEADERS_SKIP' Source/WebKit/PlatformGTK.cmake; then
    echo "SENTINEL FAIL: PlatformGTK.cmake missing WEBKIT_FORWARDING_HEADERS_SKIP option; 0001 PlatformGTK hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 33: WebKitPrintOperation.cpp must forward-declare GtkPrinter when GTK_UNIX_PRINTING is unset (or 13 undeclared-identifier errors fire on CLANG64/CLANGARM64).
  if ! grep -q 'typedef struct _GtkPrinter GtkPrinter;' Source/WebKit/UIProcess/API/gtk/WebKitPrintOperation.cpp; then
    echo "SENTINEL FAIL: WebKitPrintOperation.cpp missing 'typedef struct _GtkPrinter GtkPrinter;'; 0007 GtkPrinter guard hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 34: ProcessLauncherGLib.cpp must not use HANDLE-style Identifier construction (pre-Round-27 leftover); unix flavor is unified since Round 27.
  if grep -q 'reinterpret_cast<HANDLE>(static_cast<intptr_t>(serverSocketValue))' Source/WebKit/UIProcess/Launcher/glib/ProcessLauncherGLib.cpp; then
    echo "SENTINEL FAIL: ProcessLauncherGLib.cpp still constructs Identifier from HANDLE; 0008 unix-IPC migration hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 35a: GLFence.h must declare createExportable/importFD/exportFD unconditionally (or AcceleratedSurface.cpp hits 3 'no member named' errors on CLANG64).
  if ! grep -q 'WEBCORE_EXPORT static std::unique_ptr<GLFence> createExportable' Source/WebCore/platform/graphics/egl/GLFence.h || grep -q '^#if OS(UNIX)' Source/WebCore/platform/graphics/egl/GLFence.h; then
    echo "SENTINEL FAIL: GLFence.h still guards createExportable/importFD/exportFD with OS(UNIX); 0009 GLFence portable declaration hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 35b: NotificationService.cpp must use _write wrapper and _commit on Windows (or write type mismatch + fsync undeclared fire on CLANGARM64).
  if grep -q 'ssize_t (\*writeToFD)(int, const void\*, size_t) = write;' Source/WebKit/UIProcess/Notifications/glib/NotificationService.cpp && ! grep -q '#if OS(WINDOWS)' Source/WebKit/UIProcess/Notifications/glib/NotificationService.cpp; then
    echo "SENTINEL FAIL: NotificationService.cpp still has raw write alias without Windows guard; 0010 write/fsync Windows stub hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 36: NetworkCacheDataGLib.cpp must guard gio/gfiledescriptorbased.h with OS(WINDOWS) (or 'file not found' fires on CLANG64/CLANGARM64).
  if grep -q '^#if !PLATFORM(WIN)$' Source/WebKit/NetworkProcess/cache/NetworkCacheDataGLib.cpp; then
    echo "SENTINEL FAIL: NetworkCacheDataGLib.cpp still has bare '#if !PLATFORM(WIN)' guard; 0011 gfiledescriptorbased skip hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 37: 序列化清单必须携带互斥平台守卫（否则生成的 WebKitPlatformGeneratedSerializers.cpp
  # 在 CLANG64/CLANGARM64 上报 10 错误：m_handle 重复定义 / 构造参数超量）。
  if ! grep -q '#if OS(WINDOWS) && !USE(UNIX_DOMAIN_SOCKETS)' Source/WebKit/Platform/IPC/ConnectionHandle.serialization.in \
     || ! grep -q '#if OS(WINDOWS) && !USE(UNIX_DOMAIN_SOCKETS)' Source/WebKit/Shared/WebCoreArgumentCoders.serialization.in; then
    echo "SENTINEL FAIL: serialization manifests missing mutually-exclusive platform guards; 0012 hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 38: MainThreadSharedTimer 必须把 MinGW GTK 路由到 GLib RunLoop 实现（否则
  # setFireInterval/stop/invalidate 三个 vtable 条目在 CLANG64/CLANGARM64 最终链接时 undefined）。
  if ! grep -q 'USE(CF) || (OS(WINDOWS) && !USE(GLIB))' Source/WebCore/platform/MainThreadSharedTimer.cpp; then
    echo "SENTINEL FAIL: MainThreadSharedTimer.cpp missing GLib carve-out; 0013 MainThreadSharedTimer hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 38: BufferEGLImage 必须被 USE(GBM) 守卫（否则 DMABufBuffer::createEGLImage 在
  # USE_GBM=OFF 的最终 DLL 链接时 undefined）。
  if ! grep -q 'guarded because the implementation depends on DMABufBuffer::createEGLImage' Source/WebKit/UIProcess/gtk/AcceleratedBackingStore.h; then
    echo "SENTINEL FAIL: AcceleratedBackingStore.h missing BufferEGLImage USE(GBM) guard; 0013 hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 38: Skia 构建列表必须补齐 SkStrikeRef.cpp / SkPathDump.cpp，且 MinGW 分支必须
  # 编入 SkLog_win.cpp（否则 SkStrikeRef ctor / SkPath::dump / SkLogVAList 三符号 undefined）。
  if ! grep -q 'src/core/SkStrikeRef.cpp' Source/ThirdParty/skia/CMakeLists.txt \
     || ! grep -q 'src/core/SkPathDump.cpp' Source/ThirdParty/skia/CMakeLists.txt \
     || ! grep -q 'the Windows flavor must be compiled in' Source/ThirdParty/skia/CMakeLists.txt; then
    echo "SENTINEL FAIL: Skia CMakeLists missing SkStrikeRef/SkPathDump/SkLog_win entries; 0013 hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 40: WebProcessExtensionManager 的两个跨 DLL 方法必须用 WK_EXPORT 声明（否则
  # webkitgtkinjectedbundle 链接时 singleton/initialize 两符号 undefined：裸
  # visibility("default") 属性在 PE 上不产生导出，而主库已有显式 dllexport 符号
  # → 链接器 auto-export 被禁用；CI 实证 CLANG64/CLANGARM64 同报）。
  if grep -q '__attribute__((visibility("default"))) static WebProcessExtensionManager& singleton();' \
     Source/WebKit/WebProcess/InjectedBundle/API/glib/WebProcessExtensionManager.h \
     || ! grep -q 'WK_EXPORT static WebProcessExtensionManager& singleton();' \
        Source/WebKit/WebProcess/InjectedBundle/API/glib/WebProcessExtensionManager.h \
     || ! grep -q '#include "WKDeclarationSpecifiers.h"' \
        Source/WebKit/WebProcess/InjectedBundle/API/glib/WebProcessExtensionManager.h; then
    echo "SENTINEL FAIL: WebProcessExtensionManager.h missing WK_EXPORT on singleton()/initialize(); 0014 injected-bundle export hunk missing." >&2
    _sentinel_fail=1
  fi
  if (( _sentinel_fail )); then
    echo "One or more sentinels failed; aborting prepare(). Run 'rm -rf ${srcdir}/webkitgtk-${pkgver} && makepkg -f' to force a clean extraction+patch." >&2
    return 1
  fi
}

_print_archive_rule_diagnostics() {
  # $1 = rules.ninja 路径（相对当前构建目录）；$2 = 构建目录绝对路径（擦除提示用）。
  # 归档规则门禁失败时打印三方对账：缓存里的 -D 值 / 规则里实际引用的工具 /
  # 探测产物内嵌的归档器（真正的规则来源，沙盒 E2/E5 证实它会遮蔽缓存）。
  echo "  --- archive-rule diagnostics ---" >&2
  grep -E '^CMAKE_(AR|RANLIB):' CMakeCache.txt 2>/dev/null | sed 's/^/  cache:    /' >&2
  grep -m2 -A2 'rule CXX_STATIC_LIBRARY' "$1" 2>/dev/null | sed 's/^/  rule:     /' >&2
  grep -rhs 'set(CMAKE_AR ' CMakeFiles --include='CMake*Compiler.cmake' 2>/dev/null | sort -u | sed 's/^/  detected: /' >&2
  echo "  note: -DCMAKE_AR only takes effect on a fresh configure; an existing build" >&2
  echo "  directory keeps its originally-detected archiver (compiler-info shadowing)." >&2
  echo "  If the detected archiver above is GNU ar, wipe the build directory and re-run:" >&2
  echo "  rm -rf '$2'" >&2
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  # Stale build dir detection 必须在转发头预生成之前：擦除会连带删除预生成产物，而
  # -DWEBKIT_FORWARDING_HEADERS_SKIP=ON 又跳过 CMake 侧生成——先擦后生成，顺序不可颠倒。
  # 其一：Round 31 SKIP 项缺失（Round 30 或更早缓存）。
  local _build_dir="${srcdir}/build-${MSYSTEM}"
  if [[ -f "${_build_dir}/CMakeCache.txt" ]] \
     && ! grep -q '^WEBKIT_FORWARDING_HEADERS_SKIP:BOOL=ON$' "${_build_dir}/CMakeCache.txt"; then
    echo "Stale build directory at ${_build_dir} (no SKIP entry); wiping to force clean reconfigure." >&2
    rm -rf "${_build_dir}"
  fi

  # 其二（Round 37 引入，Round 39 升级判定依据）：UCRT64 旧构建目录里的 GNU ar 无法被
  # -D 覆盖——沙盒实验（cmake 4.4.4 + ninja 1.13，E2/E5）证实：命令行 -DCMAKE_AR 只写
  # 缓存，归档规则实际取自 CMakeFiles/<ver>/CMake{,CXX}Compiler.cmake 内嵌的
  # set(CMAKE_AR ...)（普通变量，遮蔽缓存），重配不更新 ⇒ 缓存看着对、规则仍旧用
  # GNU ar，静默复活 libSkia.a 卡死。判定地面真值改为探测产物；缓存值仅作辅助。
  # CLANG64/CLANGARM64 默认工具链即 LLVM binutils（msys2.org 文档："Only uses LLVM
  # tools"），通用名/LLVM 名均指向 LLVM 工具，无需擦除，保留其构建产物。
  if [[ "${MSYSTEM}" == "UCRT64" && -f "${_build_dir}/CMakeCache.txt" ]]; then
    local _detected_ar _cache_ar_ok=1
    _detected_ar="$(grep -rhs 'set(CMAKE_AR ' "${_build_dir}/CMakeFiles" --include='CMake*Compiler.cmake' | head -1)"
    grep -q '^CMAKE_AR:FILEPATH=.*llvm-ar\.exe$' "${_build_dir}/CMakeCache.txt" \
      || grep -q '^CMAKE_AR:UNINITIALIZED=.*llvm-ar\.exe$' "${_build_dir}/CMakeCache.txt" \
      || _cache_ar_ok=0
    if [[ -n "${_detected_ar}" && "${_detected_ar}" != *llvm-ar* ]] || (( ! _cache_ar_ok )); then
      echo "Stale UCRT64 build directory at ${_build_dir} (detected archiver: ${_detected_ar:-<none>}; -D cannot retarget an existing directory); wiping to switch archives to llvm-ar." >&2
      rm -rf "${_build_dir}"
    fi
  fi

  # Pre-generate forwarding headers with MSYS2 POSIX perl; native Win32 perl stalls on this step.
  local _fwd_output="${srcdir}/build-${MSYSTEM}/DerivedSources/ForwardingHeaders"
  if [[ ! -x /usr/bin/perl.exe ]]; then
    echo "ERROR: /usr/bin/perl.exe not found; MSYS2 POSIX perl is required for forwarding-header pre-generation." >&2
    return 1
  fi
  mkdir -p "${_fwd_output}"
  (
    cd "${srcdir}/webkitgtk-${pkgver}" && /usr/bin/perl.exe \
      Source/WebKit/Scripts/generate-forwarding-headers.pl \
      --include-path "${srcdir}/webkitgtk-${pkgver}/Source/WebKit" \
      --output "${_fwd_output}" \
      --platform gtk --platform soup
  )
  test -f "${_fwd_output}/WebKit/WKBase.h" || {
    echo "forwarding-header pre-generation did not produce WebKit/WKBase.h" >&2
    return 1
  }
  extra_config+=("-DWEBKIT_FORWARDING_HEADERS_SKIP=ON")

  mkdir -p "${_build_dir}" && cd "${_build_dir}"

  # Round 37: 归档工具硬门禁 —— llvm-ar 缺失时立即失败，绝不静默回落到会卡死的 GNU ar 路径
  # （Round 31 教训：已知会死锁的构建边，不允许因探测失败而静默复活）。
  if [[ ! -x "${MINGW_PREFIX}/bin/llvm-ar.exe" || ! -x "${MINGW_PREFIX}/bin/llvm-ranlib.exe" ]]; then
    echo "ERROR: ${MINGW_PREFIX}/bin/llvm-ar.exe / llvm-ranlib.exe not found." >&2
    echo "  GNU ar 归档 libSkia.a 等巨型静态库在 Windows 上病态缓慢（CI 上被判定为卡死）；" >&2
    echo "  本包要求 llvm-ar/llvm-ranlib（已列入 makedepends）。请安装: pacman -S ${MINGW_PACKAGE_PREFIX}-llvm" >&2
    return 1
  fi

  # ENABLE_INTROSPECTION stays OFF: g-ir-scanner against the WebKit DLL is untested on MSYS2 and the package has no .gir/.typelib/.vapi consumers.
  # Round 39：归档工具路径先经 cygpath -m 显式转成 Windows 混合形式（C:/…），不再依赖
  # MSYS2 参数自动转换；两个 -D 前缀同步加入排除清单双保险（值已是 Windows 形式，
  # 转换本就是空操作）。CMAKE_INSTALL_PREFIX 必须保持 MSYS 形式：DESTDIR 装配依赖它
  # 不被转换（转成绝对 Windows 路径会绕过 DESTDIR，装进真实系统目录）。
  local _llvm_ar_win _llvm_ranlib_win
  _llvm_ar_win="$(cygpath -m "${MINGW_PREFIX}/bin/llvm-ar.exe")"
  _llvm_ranlib_win="$(cygpath -m "${MINGW_PREFIX}/bin/llvm-ranlib.exe")"
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=;-DCMAKE_AR;-DCMAKE_RANLIB" \
  ${MINGW_PREFIX}/bin/cmake.exe \
    -GNinja \
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
    -DCMAKE_AR:FILEPATH="${_llvm_ar_win}" \
    -DCMAKE_RANLIB:FILEPATH="${_llvm_ranlib_win}" \
    "${extra_config[@]}" \
    -DPORT=GTK \
    -DUSE_GTK4=ON \
    -DENABLE_INTROSPECTION=OFF \
    -DENABLE_DOCUMENTATION=OFF \
    -DENABLE_MINIBROWSER=ON \
    -DENABLE_WEBDRIVER=OFF \
    -DENABLE_API_TESTS=OFF \
    -DENABLE_BUBBLEWRAP_SANDBOX=OFF \
    -DENABLE_JOURNALD_LOG=OFF \
    -DENABLE_GAMEPAD=OFF \
    -DENABLE_SPELLCHECK=OFF \
    -DENABLE_SPEECH_SYNTHESIS=OFF \
    -DENABLE_REMOTE_INSPECTOR=OFF \
    -DENABLE_WEBGL=OFF \
    -DUSE_GBM=OFF \
    -DUSE_LIBDRM=OFF \
    -DUSE_LIBBACKTRACE=OFF \
    -DUSE_LIBHYPHEN=OFF \
    -DUSE_LIBSECRET=OFF \
    -DUSE_GSTREAMER_GL=OFF \
    -DUSE_SYSPROF_CAPTURE=OFF \
    -DUSE_SYSTEM_SYSPROF_CAPTURE=OFF \
    -DUSE_SYSTEM_UNIFDEF=OFF \
    -DUSE_VULKAN=OFF \
    ../webkitgtk-${pkgver}

  # configure 必须产出 build.ninja（否则下方规则验证会给出误导性诊断）。
  if [[ ! -f build.ninja ]]; then
    echo "ERROR: cmake configure did not produce build.ninja; see configure output above." >&2
    return 1
  fi

  # Round 39（修正 Round 38 误报）：归档规则落地验证（configure 后硬门禁）。
  # CMake Ninja 生成器把全部工具命令行（编译/归档/链接）写入 CMakeFiles/rules.ninja，
  # build.ninja 只存边（edge）与目标——沙盒实验（cmake 4.4.4 + ninja 1.13，微型静态库
  # 工程，-D 覆盖生效后）复现：build.ninja 0 命中 / CMakeFiles/rules.ninja 1 命中。
  # Round 38 在 build.ninja 里 grep 工具名属检查错文件，三环境必然 100% 误报（本轮
  # CI 实证：三环境均在 configure 完成后立刻报错退出）。改为检查 rules.ninja，
  # 语义按环境区分：
  #   UCRT64：通用名 ar.exe 即 GNU binutils（libSkia.a 归档小时级卡死的根源）
  #           → 必须引用 -D 强制指派的 llvm-ar.exe / llvm-ranlib.exe。
  #   CLANG64/CLANGARM64：默认工具链即 LLVM binutils；旧目录探测产物遮蔽 -D
  #           （沙盒 E2/E5）时规则可能引用通用名 ar.exe —— 该名字在这些环境同样
  #           指向 LLVM 工具，用 --version 验明正身后放行。
  local _rules="CMakeFiles/rules.ninja"
  if [[ ! -f "${_rules}" ]]; then
    echo "ERROR: ${_rules} not found after configure; cannot verify archive rules." >&2
    return 1
  fi
  if grep -q 'llvm-ar\.exe' "${_rules}" && grep -q 'llvm-ranlib\.exe' "${_rules}"; then
    echo "archive rules verified: llvm-ar/llvm-ranlib referenced in ${_rules}." >&2
  elif [[ "${MSYSTEM}" != "UCRT64" ]]; then
    local _g_ar _g_ranlib
    _g_ar="$(grep -m1 -oE '[^ ;"]*[/\\](llvm-)?ar\.exe' "${_rules}" || true)"
    _g_ranlib="$(grep -m1 -oE '[^ ;"]*[/\\](llvm-)?ranlib\.exe' "${_rules}" || true)"
    if [[ -n "${_g_ar}" && -n "${_g_ranlib}" ]] \
       && "${_g_ar}" --version 2>/dev/null | grep -qi 'LLVM' \
       && "${_g_ranlib}" --version 2>/dev/null | grep -qi 'LLVM'; then
      echo "archive rules verified: generic names ${_g_ar} / ${_g_ranlib} resolve to LLVM tools." >&2
    else
      echo "ERROR: ${MSYSTEM} archive rules reference a non-LLVM archiver (GNU ar archives libSkia.a at hours-long stall)." >&2
      _print_archive_rule_diagnostics "${_rules}" "${_build_dir}"
      return 1
    fi
  else
    echo "ERROR: UCRT64 archive rules do not reference llvm-ar/llvm-ranlib (GNU ar archives libSkia.a at hours-long stall)." >&2
    _print_archive_rule_diagnostics "${_rules}" "${_build_dir}"
    return 1
  fi

  # Round 38: 构建可观测性强化（UCRT64 卡点定位）。
  # 关键事实：ninja 只在一条边【完成】时打印 "[n/total] <desc>"——CI 日志停在
  # [7041] 只能证明 libSkia.a 归档已完成（llvm-ar 生效后的预期行为），真正悬挂
  # 的是其后某条【从未完成也从未打印】的边。因此：
  #   1) --verbose 让每条边打印完整命令行：再发生悬挂时，日志最后一行即卡点命令；
  #   2) 后台 watchdog 每 5 分钟 dump 一次正在运行的构建子进程（含内存压力），
  #      与 --verbose 互为印证（区分"工具慢"与"进程僵死/资源耗尽"）。
  (
    while true; do
      sleep 300
      echo "[watchdog $(date '+%H:%M:%S')] live build processes:" >&2
      ps -W 2>/dev/null | grep -iE 'ninja|clang|g\+\+|gcc|llvm-(ar|ranlib)|ld\.exe|\bar\.exe|python|perl|ruby|cmake' | grep -vE 'grep -iE|watchdog' | head -20 >&2
      echo "[watchdog $(date '+%H:%M:%S')] memory: $(free -m 2>/dev/null | awk '/Mem:/{print "used "$3"MB / total "$2"MB"}' || echo n/a)" >&2
    done
  ) &
  local _watchdog_pid=$!

  ${MINGW_PREFIX}/bin/cmake.exe --build . --verbose
  local _build_status=$?

  kill "${_watchdog_pid}" 2>/dev/null
  return ${_build_status}
}

package() {
  cd "${srcdir}/build-${MSYSTEM}"

  DESTDIR="${pkgdir}" ${MINGW_PREFIX}/bin/cmake.exe --install .

  # Assert pkg-config metadata ships; dependent projects (e.g. Kangaroo) discover the library through these .pc files.
  for _pc in webkitgtk-6.0 javascriptcoregtk-6.0 webkitgtk-web-process-extension-6.0; do
    test -f "${pkgdir}${MINGW_PREFIX}/lib/pkgconfig/${_pc}.pc" || {
      echo "pkg-config file ${_pc}.pc is missing from the package" >&2
      exit 1
    }
  done

  install -Dm644 "${srcdir}/webkitgtk-${pkgver}/Source/WebCore/LICENSE-LGPL-2.1" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE-LGPL-2.1"
}
