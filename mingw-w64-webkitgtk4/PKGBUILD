# Tarball ships one dangling symlink (skia/ports/fontations/Cargo.toml) whose target is absent; MSYS2 bsdtar aborts extraction on it, so we skip auto-extract and drop the entry in prepare().
noextract=("webkitgtk-${pkgver}.tar.xz")

prepare() {
  # Locate the source tarball across SRCDEST / startdir / srcdir.
  local _tarball=""
  local _cand
  for _cand in "${SRCDEST}/webkitgtk-${pkgver}.tar.xz" \
               "${startdir}/webkitgtk-${pkgver}.tar.xz" \
               "${srcdir}/webkitgtk-${pkgver}.tar.xz"; do
    if [[ -f "${_cand}" ]]; then
      _tarball="${_cand}"
      break
    fi
  done
  if [[ -z "${_tarball}" ]]; then
    echo "webkitgtk-${pkgver}.tar.xz not found in SRCDEST/startdir/srcdir" >&2
    return 1
  fi

  rm -rf "webkitgtk-${pkgver}"
  bsdtar -xpf "${_tarball}" \
    --exclude "webkitgtk-${pkgver}/Source/ThirdParty/skia/src/ports/fontations/Cargo.toml"
  if [[ ! -d "webkitgtk-${pkgver}" ]]; then
    echo "failed to extract webkitgtk source tarball" >&2
    return 1
  fi

  cd webkitgtk-${pkgver}

  patch -Np1 -i "${startdir}/0001-MinGW-build-system-and-WTF-win-headers.patch"
  patch -Np1 -i "${startdir}/0002-MinGW-WTF-threading-and-compiler-compatibility.patch"
  patch -Np1 -i "${startdir}/0003-MinGW-IPC-SharedMemory-and-process-launch-support.patch"
  patch -Np1 -i "${startdir}/0004-MinGW-cmake-discovery-and-harfbuzz-icu-shim.patch"
  patch -Np1 -i "${startdir}/0005-MinGW-Skia-FreeType-backend-and-GTK-font-manager.patch"
  patch -Np1 -i "${startdir}/0006-MinGW-libpas-and-compat-shims.patch"
  patch -Np1 -i "${startdir}/0007-MinGW-WebKitPrintOperation-GtkPrinter-guard.patch"
  patch -Np1 -i "${startdir}/0008-MinGW-ProcessLauncherGLib-unix-IPC-identifier.patch"
  patch -Np1 -i "${startdir}/0009-MinGW-GLFence-unix-methods-portable-declaration.patch"
  patch -Np1 -i "${startdir}/0010-MinGW-NotificationService-write-fsync-Windows-stubs.patch"

  # Post-patch sentinels: assert each round's marker landed; abort before multi-hour recompile on regression.
  local _sentinel_fail=0
  # Round 31: GSpanExtras.h must no longer redeclare g_malloc (or -Winconsistent-dllimport fires).
  if grep -q '^void\* g_malloc(size_t);$' Source/WTF/wtf/glib/GSpanExtras.h; then
    echo "SENTINEL FAIL: GSpanExtras.h still has 'void* g_malloc(size_t);'; 0001 GSpanExtras hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 31: WebKitWebContext.cpp must use mutableSpan() (or 6 'data' is private member errors fire).
  if ! grep -q 'widePath\.mutableSpan()\.data()' Source/WebKit/UIProcess/API/glib/WebKitWebContext.cpp; then
    echo "SENTINEL FAIL: WebKitWebContext.cpp missing 'widePath.mutableSpan().data()'; 0003 mingwRealpathForSandbox hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 31: PlatformGTK.cmake must own the SKIP option (or UCRT64 forwarding-headers perl stall returns).
  if ! grep -q 'option(WEBKIT_FORWARDING_HEADERS_SKIP' Source/WebKit/PlatformGTK.cmake; then
    echo "SENTINEL FAIL: PlatformGTK.cmake missing WEBKIT_FORWARDING_HEADERS_SKIP option; 0001 PlatformGTK hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 33: WebKitPrintOperation.cpp must forward-declare GtkPrinter when GTK_UNIX_PRINTING is unset (or 13 undeclared-identifier errors fire on CLANG64/CLANGARM64).
  if ! grep -q 'typedef struct _GtkPrinter GtkPrinter;' Source/WebKit/UIProcess/API/gtk/WebKitPrintOperation.cpp; then
    echo "SENTINEL FAIL: WebKitPrintOperation.cpp missing 'typedef struct _GtkPrinter GtkPrinter;'; 0007 GtkPrinter guard hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 34: ProcessLauncherGLib.cpp must not use HANDLE-style Identifier construction (pre-Round-27 leftover); unix flavor is unified since Round 27.
  if grep -q 'reinterpret_cast<HANDLE>(static_cast<intptr_t>(serverSocketValue))' Source/WebKit/UIProcess/Launcher/glib/ProcessLauncherGLib.cpp; then
    echo "SENTINEL FAIL: ProcessLauncherGLib.cpp still constructs Identifier from HANDLE; 0008 unix-IPC migration hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 35a: GLFence.h must declare createExportable/importFD/exportFD unconditionally (or AcceleratedSurface.cpp hits 3 'no member named' errors on CLANG64).
  if ! grep -q 'WEBCORE_EXPORT static std::unique_ptr<GLFence> createExportable' Source/WebCore/platform/graphics/egl/GLFence.h || grep -q '^#if OS(UNIX)' Source/WebCore/platform/graphics/egl/GLFence.h; then
    echo "SENTINEL FAIL: GLFence.h still guards createExportable/importFD/exportFD with OS(UNIX); 0009 GLFence portable declaration hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 35b: NotificationService.cpp must use _write wrapper and _commit on Windows (or write type mismatch + fsync undeclared fire on CLANGARM64).
  if grep -q 'ssize_t (\*writeToFD)(int, const void\*, size_t) = write;' Source/WebKit/UIProcess/Notifications/glib/NotificationService.cpp && ! grep -q '#if OS(WINDOWS)' Source/WebKit/UIProcess/Notifications/glib/NotificationService.cpp; then
    echo "SENTINEL FAIL: NotificationService.cpp still has raw write alias without Windows guard; 0010 write/fsync Windows stub hunk missing." >&2
    _sentinel_fail=1
  fi
  if (( _sentinel_fail )); then
    echo "One or more sentinels failed; aborting prepare(). Run 'rm -rf ${srcdir}/webkitgtk-${pkgver} && makepkg -f' to force a clean extraction+patch." >&2
    return 1
  fi
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  # Pre-generate forwarding headers with MSYS2 POSIX perl; native Win32 perl stalls on this step.
  local _fwd_output="${srcdir}/build-${MSYSTEM}/DerivedSources/ForwardingHeaders"
  if [[ ! -x /usr/bin/perl.exe ]]; then
    echo "ERROR: /usr/bin/perl.exe not found; MSYS2 POSIX perl is required for forwarding-header pre-generation." >&2
    return 1
  fi
  mkdir -p "${_fwd_output}"
  (
    cd "${srcdir}/webkitgtk-${pkgver}" && /usr/bin/perl.exe \
      Source/WebKit/Scripts/generate-forwarding-headers.pl \
      --include-path "${srcdir}/webkitgtk-${pkgver}/Source/WebKit" \
      --output "${_fwd_output}" \
      --platform gtk --platform soup
  )
  test -f "${_fwd_output}/WebKit/WKBase.h" || {
    echo "forwarding-header pre-generation did not produce WebKit/WKBase.h" >&2
    return 1
  }
  extra_config+=("-DWEBKIT_FORWARDING_HEADERS_SKIP=ON")

  # Stale build dir detection: wipe if Round 31 SKIP entry is absent (Round 30 or earlier cache).
  local _build_dir="${srcdir}/build-${MSYSTEM}"
  if [[ -f "${_build_dir}/CMakeCache.txt" ]] \
     && ! grep -q '^WEBKIT_FORWARDING_HEADERS_SKIP:BOOL=ON$' "${_build_dir}/CMakeCache.txt"; then
    echo "Stale build directory at ${_build_dir} (no SKIP entry); wiping to force clean reconfigure." >&2
    rm -rf "${_build_dir}"
  fi

  mkdir -p "${_build_dir}" && cd "${_build_dir}"

  # ENABLE_INTROSPECTION stays OFF: g-ir-scanner against the WebKit DLL is untested on MSYS2 and the package has no .gir/.typelib/.vapi consumers.
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
  ${MINGW_PREFIX}/bin/cmake.exe \
    -GNinja \
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
    "${extra_config[@]}" \
    -DPORT=GTK \
    -DUSE_GTK4=ON \
    -DENABLE_INTROSPECTION=OFF \
    -DENABLE_DOCUMENTATION=OFF \
    -DENABLE_MINIBROWSER=ON \
    -DENABLE_WEBDRIVER=OFF \
    -DENABLE_API_TESTS=OFF \
    -DENABLE_BUBBLEWRAP_SANDBOX=OFF \
    -DENABLE_JOURNALD_LOG=OFF \
    -DENABLE_GAMEPAD=OFF \
    -DENABLE_SPELLCHECK=OFF \
    -DENABLE_SPEECH_SYNTHESIS=OFF \
    -DENABLE_REMOTE_INSPECTOR=OFF \
    -DENABLE_WEBGL=OFF \
    -DUSE_GBM=OFF \
    -DUSE_LIBDRM=OFF \
    -DUSE_LIBBACKTRACE=OFF \
    -DUSE_LIBHYPHEN=OFF \
    -DUSE_LIBSECRET=OFF \
    -DUSE_GSTREAMER_GL=OFF \
    -DUSE_SYSPROF_CAPTURE=OFF \
    -DUSE_SYSTEM_SYSPROF_CAPTURE=OFF \
    -DUSE_SYSTEM_UNIFDEF=OFF \
    -DUSE_VULKAN=OFF \
    ../webkitgtk-${pkgver}

  ${MINGW_PREFIX}/bin/cmake.exe --build .
}

package() {
  cd "${srcdir}/build-${MSYSTEM}"

  DESTDIR="${pkgdir}" ${MINGW_PREFIX}/bin/cmake.exe --install .

  # Assert pkg-config metadata ships; dependent projects (e.g. Kangaroo) discover the library through these .pc files.
  for _pc in webkitgtk-6.0 javascriptcoregtk-6.0 webkitgtk-web-process-extension-6.0; do
    test -f "${pkgdir}${MINGW_PREFIX}/lib/pkgconfig/${_pc}.pc" || {
      echo "pkg-config file ${_pc}.pc is missing from the package" >&2
      exit 1
    }
  done

  install -Dm644 "${srcdir}/webkitgtk-${pkgver}/Source/WebCore/LICENSE-LGPL-2.1" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE-LGPL-2.1"
}
