# Maintainer: Taozuhong <taozuhong@hotmail.com>

_realname=webkitgtk4
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2.54.1
pkgrel=1
pkgdesc="WebKitGTK web content engine for GTK 4 (API version 6.0) (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://webkitgtk.org/"
msys2_repository_url="https://github.com/WebKit/WebKit"
msys2_references=(
  "cpe: cpe:/a:webkitgtk:webkitgtk"
)
license=('spdx:LGPL-2.1-only' 'spdx:BSD-2-Clause')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs"
         "${MINGW_PACKAGE_PREFIX}-cairo"
         "${MINGW_PACKAGE_PREFIX}-fontconfig"
         "${MINGW_PACKAGE_PREFIX}-freetype"
         "${MINGW_PACKAGE_PREFIX}-gdk-pixbuf2"
         "${MINGW_PACKAGE_PREFIX}-glib2"
         "${MINGW_PACKAGE_PREFIX}-glib-networking"
         "${MINGW_PACKAGE_PREFIX}-gst-plugins-base"
         "${MINGW_PACKAGE_PREFIX}-gstreamer"
         "${MINGW_PACKAGE_PREFIX}-gtk4"
         "${MINGW_PACKAGE_PREFIX}-harfbuzz"
         "${MINGW_PACKAGE_PREFIX}-icu"
         "${MINGW_PACKAGE_PREFIX}-lcms2"
         "${MINGW_PACKAGE_PREFIX}-libavif"
         "${MINGW_PACKAGE_PREFIX}-libepoxy"
         "${MINGW_PACKAGE_PREFIX}-libgcrypt"
         "${MINGW_PACKAGE_PREFIX}-libjpeg-turbo"
         "${MINGW_PACKAGE_PREFIX}-libjxl"
         "${MINGW_PACKAGE_PREFIX}-libpng"
         "${MINGW_PACKAGE_PREFIX}-libsoup3"
         "${MINGW_PACKAGE_PREFIX}-libtasn1"
         "${MINGW_PACKAGE_PREFIX}-libwebp"
         "${MINGW_PACKAGE_PREFIX}-libxml2"
         "${MINGW_PACKAGE_PREFIX}-libxslt"
         "${MINGW_PACKAGE_PREFIX}-sqlite3")
optdepends=("${MINGW_PACKAGE_PREFIX}-gst-plugins-good: media codec plugins"
            "${MINGW_PACKAGE_PREFIX}-gst-plugins-bad: media codec plugins"
            "${MINGW_PACKAGE_PREFIX}-gst-plugins-ugly: media codec plugins"
            "${MINGW_PACKAGE_PREFIX}-gst-libav: media codec plugins")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-gperf"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-perl"
             "${MINGW_PACKAGE_PREFIX}-pkgconf"
             "${MINGW_PACKAGE_PREFIX}-python"
             "${MINGW_PACKAGE_PREFIX}-ruby")
source=("https://webkitgtk.org/releases/webkitgtk-${pkgver}.tar.xz"
        "0001-Port-WebKitGTK-to-MinGW-build-system.patch"
        "0002-MinGW-WTF-and-compiler-compatibility.patch"
        "0003-MinGW-IPC-SharedMemory-and-process-launch-support.patch")
sha256sums=('ea0bbb02dbdbc596874a4e7ad35b66645b3e0a232bd0e4081de5ed92eb0a397d'
            '1e1b5b76c70c1407cad18305766a67542b2fee9d269d0e6296305b1c2f3c753c'
            '15d115d970d08c17d1e0f30023fcc2ab6144e1ef947de12272a85db59556aba9'
            'a8ac6ca5bcc1811ac11ecb57c795af01a926967fdafb7d5cf6e7c68379904e21')

prepare() {
  cd webkitgtk-${pkgver}

  patch -Np1 -i ../0001-Port-WebKitGTK-to-MinGW-build-system.patch
  patch -Np1 -i ../0002-MinGW-WTF-and-compiler-compatibility.patch
  patch -Np1 -i ../0003-MinGW-IPC-SharedMemory-and-process-launch-support.patch
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  mkdir -p "${srcdir}/build-${MSYSTEM}" && cd "${srcdir}/build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
  ${MINGW_PREFIX}/bin/cmake.exe \
    -GNinja \
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
    "${extra_config[@]}" \
    -DPORT=GTK \
    -DUSE_GTK4=ON \
    -DENABLE_INTROSPECTION=OFF \
    -DENABLE_DOCUMENTATION=OFF \
    -DENABLE_MINIBROWSER=ON \
    -DENABLE_WEBDRIVER=OFF \
    -DENABLE_API_TESTS=OFF \
    -DENABLE_BUBBLEWRAP_SANDBOX=OFF \
    -DENABLE_JOURNALD_LOG=OFF \
    -DENABLE_GAMEPAD=OFF \
    -DENABLE_SPELLCHECK=OFF \
    -DENABLE_SPEECH_SYNTHESIS=OFF \
    -DENABLE_REMOTE_INSPECTOR=OFF \
    -DENABLE_WEBGL=OFF \
    -DUSE_GBM=OFF \
    -DUSE_LIBDRM=OFF \
    -DUSE_LIBBACKTRACE=OFF \
    -DUSE_LIBHYPHEN=OFF \
    -DUSE_LIBSECRET=OFF \
    -DUSE_GSTREAMER_GL=OFF \
    -DUSE_SYSPROF_CAPTURE=OFF \
    -DUSE_SYSTEM_SYSPROF_CAPTURE=OFF \
    -DUSE_SYSTEM_UNIFDEF=OFF \
    -DUSE_VULKAN=OFF \
    ../webkitgtk-${pkgver}

  ${MINGW_PREFIX}/bin/cmake.exe --build .
}

package() {
  cd "${srcdir}/build-${MSYSTEM}"

  DESTDIR="${pkgdir}" ${MINGW_PREFIX}/bin/cmake.exe --install .

  # Ensure the pkg-config metadata is shipped; dependent projects (e.g.
  # Kangaroo) discover the library through webkitgtk-6.0.pc.
  for _pc in webkitgtk-6.0 javascriptcoregtk-6.0 webkitgtk-web-process-extension-6.0; do
    test -f "${pkgdir}${MINGW_PREFIX}/lib/pkgconfig/${_pc}.pc" || {
      echo "pkg-config file ${_pc}.pc is missing from the package" >&2
      exit 1
    }
  done

  install -Dm644 "${srcdir}/webkitgtk-${pkgver}/Source/WebCore/LICENSE-LGPL-2.1" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE-LGPL-2.1"
}
