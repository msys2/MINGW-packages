pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2.54.1
pkgrel=1
pkgdesc="WebKitGTK web content engine for GTK 4 (API version 6.0) (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://webkitgtk.org/"
msys2_repository_url="https://github.com/WebKit/WebKit"
msys2_references=(
  "cpe: cpe:/a:webkitgtk:webkitgtk"
)
license=('spdx:LGPL-2.1-only' 'spdx:BSD-2-Clause')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs"
         "${MINGW_PACKAGE_PREFIX}-cairo"
         "${MINGW_PACKAGE_PREFIX}-dlfcn"
         "${MINGW_PACKAGE_PREFIX}-fontconfig"
         "${MINGW_PACKAGE_PREFIX}-freetype"
         "${MINGW_PACKAGE_PREFIX}-gdk-pixbuf2"
         "${MINGW_PACKAGE_PREFIX}-glib2"
         "${MINGW_PACKAGE_PREFIX}-glib-networking"
         # girepository-1.0 runtime + system girs/typelibs (Gtk-4.0 etc.) that
         # our installed WebKit-6.0 typelib resolves against at consumer runtime
         # (same convention as the MSYS2 gtk4 package, which also ships typelibs).
         "${MINGW_PACKAGE_PREFIX}-gobject-introspection"
         "${MINGW_PACKAGE_PREFIX}-gst-plugins-bad"
         "${MINGW_PACKAGE_PREFIX}-gst-plugins-base"
         "${MINGW_PACKAGE_PREFIX}-gstreamer"
         "${MINGW_PACKAGE_PREFIX}-gtk4"
         "${MINGW_PACKAGE_PREFIX}-harfbuzz"
         "${MINGW_PACKAGE_PREFIX}-icu"
         "${MINGW_PACKAGE_PREFIX}-lcms2"
         "${MINGW_PACKAGE_PREFIX}-libavif"
         "${MINGW_PACKAGE_PREFIX}-libepoxy"
         "${MINGW_PACKAGE_PREFIX}-libgcrypt"
         "${MINGW_PACKAGE_PREFIX}-libjpeg-turbo"
         "${MINGW_PACKAGE_PREFIX}-libjxl"
         "${MINGW_PACKAGE_PREFIX}-libpng"
         "${MINGW_PACKAGE_PREFIX}-libsoup3"
         "${MINGW_PACKAGE_PREFIX}-libtasn1"
         "${MINGW_PACKAGE_PREFIX}-libwebp"
         "${MINGW_PACKAGE_PREFIX}-libxml2"
         "${MINGW_PACKAGE_PREFIX}-libxslt"
         "${MINGW_PACKAGE_PREFIX}-sqlite3"
         "${MINGW_PACKAGE_PREFIX}-woff2")
optdepends=("${MINGW_PACKAGE_PREFIX}-gst-plugins-good: media codec plugins"
            "${MINGW_PACKAGE_PREFIX}-gst-plugins-ugly: media codec plugins"
            "${MINGW_PACKAGE_PREFIX}-gst-libav: media codec plugins")
makedepends=("${MINGW_PACKAGE_PREFIX}-binutils"
             # dlltool/nm: g-ir-scanner 的 resolve_windows_libs 找到 import 库后用
             # dlltool --identify 反查 DLL 名（Round 42；CLANG 环境默认不带 GNU binutils，
             # 缺失时该步骤 FileNotFoundError 中断 gir 生成）。
             "${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-gperf"
             # gobject-introspection (tools: g-ir-scanner/g-ir-compiler) comes via
             # depends - the MSYS2 package ships tools and runtime together.
             # llvm-ar/llvm-ranlib: UCRT64 的 GNU ar 归档巨型静态库（libSkia.a，~2900 个对象）在
             # Windows 上病态缓慢（文件系统开销 + Defender 实时扫描，已知 1h+ 直至被判定卡死）；
             # CLANG64/CLANGARM64 默认即 LLVM binutils（msys2.org 文档："Only uses LLVM tools"）。
             # 三环境统一显式指派 llvm-ar/llvm-ranlib（产出标准归档，GNU ld 完全兼容）。
             "${MINGW_PACKAGE_PREFIX}-llvm"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-perl"
             # POSIX perl (/usr/bin/perl.exe): hard requirement for forwarding-headers pre-generation; native Win32 perl stalls on that step.
             perl
             "${MINGW_PACKAGE_PREFIX}-pkgconf"
             "${MINGW_PACKAGE_PREFIX}-python"
             "${MINGW_PACKAGE_PREFIX}-ruby"
             # vapigen (vala 0.56.19+): ENABLE_VAPIGEN 生成 webkitgtk-6.0 / javascriptcoregtk-6.0 /
             # webkitgtk-web-process-extension-6.0 三个 .vapi（安装到未版本化的 share/vala/vapi，
             # 与 libadwaita/gtksourceview5 等 MSYS2 库包同路径，不会与 vala 包自带的
             # vala-0.56/vapi 旧拷贝冲突，且 vala 搜索优先命中我们的新文件）。
             "${MINGW_PACKAGE_PREFIX}-vala")
# Patch series (Round 44 consolidation): 18 single-round patches merged into
# 5 domain-grouped patches, byte-exact concatenations of the former series in
# order (replay-verified: fresh tarball + 5 patches == 18-step tree, diff -r
# empty). Mapping (old -> new):
#   0001+0002+0003                              -> 0001 platform port foundation
#   0004+0005+0006                              -> 0002 toolchain & third-party
#   0007+0008+0009+0010+0011+0012               -> 0003 webkit source portability guards
#   0013+0014                                   -> 0004 linkage & symbol visibility
#   0015+0016+0017+0018                         -> 0005 gobject introspection & dump program
source=("https://webkitgtk.org/releases/webkitgtk-${pkgver}.tar.xz"
        "0001-MinGW-platform-port-foundation.patch"
        "0002-MinGW-toolchain-and-thirdparty.patch"
        "0003-MinGW-webkit-source-portability-guards.patch"
        "0004-MinGW-linkage-and-symbol-visibility.patch"
        "0005-MinGW-gobject-introspection-and-dump-program.patch")
sha256sums=('ea0bbb02dbdbc596874a4e7ad35b66645b3e0a232bd0e4081de5ed92eb0a397d'
            'a675f8b8c21be551eaab11d90101af9e77757524eb855f39b3a6f21d0e64eb5a'
            '70351a7e0e831e87607c2a1e3d8ffa4cbf2873b0d7aa52de37a2af8e55845748'
            '087324f412bd32497870c7589ba40ff8cf6b5975e375db2456e4652c63d83d25'
            '7f85559ab79d7c61882e6a8185d845255e01db021f8f1ac494bc043507028b03'
            'fa371b8b955733a2a17b9b8244b398eb3bc1db3bd8f3c8b6e8c4cecadedde075')

# Tarball ships one dangling symlink (skia/ports/fontations/Cargo.toml) whose target is absent; MSYS2 bsdtar aborts extraction on it, so we skip auto-extract and drop the entry in prepare().
noextract=("webkitgtk-${pkgver}.tar.xz")

prepare() {
  # Locate the source tarball across SRCDEST / startdir / srcdir.
  local _tarball=""
  local _cand
  for _cand in "${SRCDEST}/webkitgtk-${pkgver}.tar.xz" \
               "${startdir}/webkitgtk-${pkgver}.tar.xz" \
               "${srcdir}/webkitgtk-${pkgver}.tar.xz"; do
    if [[ -f "${_cand}" ]]; then
      _tarball="${_cand}"
      break
    fi
  done
  if [[ -z "${_tarball}" ]]; then
    echo "webkitgtk-${pkgver}.tar.xz not found in SRCDEST/startdir/srcdir" >&2
    return 1
  fi

  rm -rf "webkitgtk-${pkgver}"
  bsdtar -xpf "${_tarball}" \
    --exclude "webkitgtk-${pkgver}/Source/ThirdParty/skia/src/ports/fontations/Cargo.toml"
  if [[ ! -d "webkitgtk-${pkgver}" ]]; then
    echo "failed to extract webkitgtk source tarball" >&2
    return 1
  fi

  cd webkitgtk-${pkgver}

  patch -Np1 -i "${startdir}/0001-MinGW-platform-port-foundation.patch"
  patch -Np1 -i "${startdir}/0002-MinGW-toolchain-and-thirdparty.patch"
  patch -Np1 -i "${startdir}/0003-MinGW-webkit-source-portability-guards.patch"
  patch -Np1 -i "${startdir}/0004-MinGW-linkage-and-symbol-visibility.patch"
  patch -Np1 -i "${startdir}/0005-MinGW-gobject-introspection-and-dump-program.patch"

  # Post-patch sentinels: assert each round's marker landed; abort before multi-hour recompile on regression.
  local _sentinel_fail=0
  # Round 31: GSpanExtras.h must no longer redeclare g_malloc (or -Winconsistent-dllimport fires).
  if grep -q '^void\* g_malloc(size_t);$' Source/WTF/wtf/glib/GSpanExtras.h; then
    echo "SENTINEL FAIL: GSpanExtras.h still has 'void* g_malloc(size_t);'; 0001 platform-port-foundation hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 31: WebKitWebContext.cpp must use mutableSpan() (or 6 'data' is private member errors fire).
  if ! grep -q 'widePath\.mutableSpan()\.data()' Source/WebKit/UIProcess/API/glib/WebKitWebContext.cpp; then
    echo "SENTINEL FAIL: WebKitWebContext.cpp missing 'widePath.mutableSpan().data()'; 0001 platform-port-foundation (old 0003) mingwRealpathForSandbox hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 31: PlatformGTK.cmake must own the SKIP option (or UCRT64 forwarding-headers perl stall returns).
  if ! grep -q 'option(WEBKIT_FORWARDING_HEADERS_SKIP' Source/WebKit/PlatformGTK.cmake; then
    echo "SENTINEL FAIL: PlatformGTK.cmake missing WEBKIT_FORWARDING_HEADERS_SKIP option; 0001 platform-port-foundation hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 33: WebKitPrintOperation.cpp must forward-declare GtkPrinter when GTK_UNIX_PRINTING is unset (or 13 undeclared-identifier errors fire on CLANG64/CLANGARM64).
  if ! grep -q 'typedef struct _GtkPrinter GtkPrinter;' Source/WebKit/UIProcess/API/gtk/WebKitPrintOperation.cpp; then
    echo "SENTINEL FAIL: WebKitPrintOperation.cpp missing 'typedef struct _GtkPrinter GtkPrinter;'; 0003 source-portability-guards (old 0007) GtkPrinter guard hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 34: ProcessLauncherGLib.cpp must not use HANDLE-style Identifier construction (pre-Round-27 leftover); unix flavor is unified since Round 27.
  if grep -q 'reinterpret_cast<HANDLE>(static_cast<intptr_t>(serverSocketValue))' Source/WebKit/UIProcess/Launcher/glib/ProcessLauncherGLib.cpp; then
    echo "SENTINEL FAIL: ProcessLauncherGLib.cpp still constructs Identifier from HANDLE; 0003 source-portability-guards (old 0008) unix-IPC migration hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 35a: GLFence.h must declare createExportable/importFD/exportFD unconditionally (or AcceleratedSurface.cpp hits 3 'no member named' errors on CLANG64).
  if ! grep -q 'WEBCORE_EXPORT static std::unique_ptr<GLFence> createExportable' Source/WebCore/platform/graphics/egl/GLFence.h || grep -q '^#if OS(UNIX)' Source/WebCore/platform/graphics/egl/GLFence.h; then
    echo "SENTINEL FAIL: GLFence.h still guards createExportable/importFD/exportFD with OS(UNIX); 0003 source-portability-guards (old 0009) GLFence portable declaration hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 35b: NotificationService.cpp must use _write wrapper and _commit on Windows (or write type mismatch + fsync undeclared fire on CLANGARM64).
  if grep -q 'ssize_t (\*writeToFD)(int, const void\*, size_t) = write;' Source/WebKit/UIProcess/Notifications/glib/NotificationService.cpp && ! grep -q '#if OS(WINDOWS)' Source/WebKit/UIProcess/Notifications/glib/NotificationService.cpp; then
    echo "SENTINEL FAIL: NotificationService.cpp still has raw write alias without Windows guard; 0003 source-portability-guards (old 0010) write/fsync Windows stub hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 36: NetworkCacheDataGLib.cpp must guard gio/gfiledescriptorbased.h with OS(WINDOWS) (or 'file not found' fires on CLANG64/CLANGARM64).
  if grep -q '^#if !PLATFORM(WIN)$' Source/WebKit/NetworkProcess/cache/NetworkCacheDataGLib.cpp; then
    echo "SENTINEL FAIL: NetworkCacheDataGLib.cpp still has bare '#if !PLATFORM(WIN)' guard; 0003 source-portability-guards (old 0011) gfiledescriptorbased skip hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 37: 序列化清单必须携带互斥平台守卫（否则生成的 WebKitPlatformGeneratedSerializers.cpp
  # 在 CLANG64/CLANGARM64 上报 10 错误：m_handle 重复定义 / 构造参数超量）。
  if ! grep -q '#if OS(WINDOWS) && !USE(UNIX_DOMAIN_SOCKETS)' Source/WebKit/Platform/IPC/ConnectionHandle.serialization.in \
     || ! grep -q '#if OS(WINDOWS) && !USE(UNIX_DOMAIN_SOCKETS)' Source/WebKit/Shared/WebCoreArgumentCoders.serialization.in; then
    echo "SENTINEL FAIL: serialization manifests missing mutually-exclusive platform guards; 0003 source-portability-guards (old 0012) hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 38: MainThreadSharedTimer 必须把 MinGW GTK 路由到 GLib RunLoop 实现（否则
  # setFireInterval/stop/invalidate 三个 vtable 条目在 CLANG64/CLANGARM64 最终链接时 undefined）。
  if ! grep -q 'USE(CF) || (OS(WINDOWS) && !USE(GLIB))' Source/WebCore/platform/MainThreadSharedTimer.cpp; then
    echo "SENTINEL FAIL: MainThreadSharedTimer.cpp missing GLib carve-out; 0004 linkage-and-symbol-visibility (old 0013) MainThreadSharedTimer hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 38: BufferEGLImage 必须被 USE(GBM) 守卫（否则 DMABufBuffer::createEGLImage 在
  # USE_GBM=OFF 的最终 DLL 链接时 undefined）。
  if ! grep -q 'guarded because the implementation depends on DMABufBuffer::createEGLImage' Source/WebKit/UIProcess/gtk/AcceleratedBackingStore.h; then
    echo "SENTINEL FAIL: AcceleratedBackingStore.h missing BufferEGLImage USE(GBM) guard; 0004 linkage-and-symbol-visibility (old 0013) hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 38: Skia 构建列表必须补齐 SkStrikeRef.cpp / SkPathDump.cpp，且 MinGW 分支必须
  # 编入 SkLog_win.cpp（否则 SkStrikeRef ctor / SkPath::dump / SkLogVAList 三符号 undefined）。
  if ! grep -q 'src/core/SkStrikeRef.cpp' Source/ThirdParty/skia/CMakeLists.txt \
     || ! grep -q 'src/core/SkPathDump.cpp' Source/ThirdParty/skia/CMakeLists.txt \
     || ! grep -q 'the Windows flavor must be compiled in' Source/ThirdParty/skia/CMakeLists.txt; then
    echo "SENTINEL FAIL: Skia CMakeLists missing SkStrikeRef/SkPathDump/SkLog_win entries; 0004 linkage-and-symbol-visibility (old 0013) hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 40: WebProcessExtensionManager 的两个跨 DLL 方法必须用 WK_EXPORT 声明（否则
  # webkitgtkinjectedbundle 链接时 singleton/initialize 两符号 undefined：裸
  # visibility("default") 属性在 PE 上不产生导出，而主库已有显式 dllexport 符号
  # → 链接器 auto-export 被禁用；CI 实证 CLANG64/CLANGARM64 同报）。
  if grep -q '__attribute__((visibility("default"))) static WebProcessExtensionManager& singleton();' \
     Source/WebKit/WebProcess/InjectedBundle/API/glib/WebProcessExtensionManager.h \
     || ! grep -q 'WK_EXPORT static WebProcessExtensionManager& singleton();' \
        Source/WebKit/WebProcess/InjectedBundle/API/glib/WebProcessExtensionManager.h \
     || ! grep -q '#include "WKDeclarationSpecifiers.h"' \
        Source/WebKit/WebProcess/InjectedBundle/API/glib/WebProcessExtensionManager.h; then
    echo "SENTINEL FAIL: WebProcessExtensionManager.h missing WK_EXPORT on singleton()/initialize(); 0004 linkage-and-symbol-visibility (old 0014) injected-bundle export hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 41: introspection 四件套缺一不可（否则构建数小时后在 g-ir-scanner/vapigen 阶段炸裂，
  # 或 import 库找不到导致 "ERROR: can't resolve libraries to shared libraries"）：
  #   a) FindGI.cmake 必须 --filelist 化（CreateProcess 32767 字符命令行限制）
  #   b) WebKit/JavaScriptCore 的 ARCHIVE（import 库）必须重定向到 bin（与 DLL 同目录，
  #      g-ir-scanner 的 resolve_windows_libs 只认 lib*.dll.a 候选且只搜 --library-path）
  #   c) GENERATE_VAPI 必须落在 FindGI 与三个 GI_INTROSPECT 调用点
  #   d) JSC 的 custom.vala 必须存在（GCallback 泛型 delegate 修正）
  if ! grep -q -- '--filelist=' Source/cmake/FindGI.cmake \
     || ! grep -q 'GENERATE_VAPI' Source/cmake/FindGI.cmake; then
    echo "SENTINEL FAIL: FindGI.cmake missing --filelist/GENERATE_VAPI support; 0005 introspection-and-dump-program (old 0015) FindGI hunk missing." >&2
    _sentinel_fail=1
  fi
  if ! grep -q 'ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}"' Source/WebKit/CMakeLists.txt; then
    echo "SENTINEL FAIL: WebKit CMakeLists missing import-library-to-bin redirection; 0005 introspection-and-dump-program (old 0015) hunk missing." >&2
    _sentinel_fail=1
  fi
  if ! grep -q 'GENERATE_VAPI' Source/WebKit/PlatformGTK.cmake \
     || ! grep -q 'GENERATE_VAPI' Source/JavaScriptCore/PlatformGTK.cmake \
     || ! grep -q 'ENABLE_VAPIGEN' Source/cmake/OptionsGTK.cmake; then
    echo "SENTINEL FAIL: GENERATE_VAPI/ENABLE_VAPIGEN not wired at call sites/options; 0005 introspection-and-dump-program (old 0015) hunks missing." >&2
    _sentinel_fail=1
  fi
  if [[ ! -f Source/JavaScriptCore/API/glib/JavaScriptCore-6.0-custom.vala ]]; then
    echo "SENTINEL FAIL: JavaScriptCore-6.0-custom.vala missing; 0005 introspection-and-dump-program (old 0015) new-file hunk missing." >&2
    _sentinel_fail=1
  fi
  # Round 42: g-ir-scanner 的 MSYS2 兼容三件套缺一不可（否则 gir 生成阶段以
  # FileNotFoundError: '/clang64/lib' 中断，或 dump 程序链接在 GNU ld 上挂死）：
  #   a) FindGI.cmake 必须生成 pkg-config 输出转换包装器（MSYS 路径 → Windows 路径，
  #      覆盖 giscanner.pkgconfig 的 --cflags/--libs/--libs-only-L/--variable 四类查询）
  #   b) 扫描器环境必须注入 PKG_CONFIG=<包装器>（giscanner.pkgconfig 只认该环境变量）
  #   c) 扫描器环境必须注入 LDFLAGS=-fuse-ld=lld（dump 程序链接走 lld，GNU ld 在
  #      CI 上对该链接 20 分钟零进展）
  if ! grep -q 'pkg-config-msys2.bat' Source/cmake/FindGI.cmake \
     || ! grep -q 'MSYS2_ROOT' Source/cmake/FindGI.cmake; then
    echo "SENTINEL FAIL: FindGI.cmake missing pkg-config-msys2 wrapper generation; 0005 introspection-and-dump-program (old 0016) hunk missing." >&2
    _sentinel_fail=1
  fi
  if ! grep -q 'PKG_CONFIG=${GI_PKG_CONFIG_WRAPPER}' Source/cmake/FindGI.cmake; then
    echo "SENTINEL FAIL: FindGI.cmake missing PKG_CONFIG env routing to the wrapper; 0005 introspection-and-dump-program (old 0016) hunk missing." >&2
    _sentinel_fail=1
  fi
  if ! grep -q 'LDFLAGS=-fuse-ld=lld' Source/cmake/FindGI.cmake; then
    echo "SENTINEL FAIL: FindGI.cmake missing LDFLAGS=-fuse-ld=lld for the dump-program link; 0005 introspection-and-dump-program (old 0016) hunk missing." >&2
    _sentinel_fail=1
  fi

  # Round 43（0017）：g-ir-scanner 扫描器环境三件套（全部 WIN32 限定）：
  #   a) GI_SCANNER_DISABLE_CACHE=1 —— g-i 1.86.0 的 cachestore 无跨进程锁、
  #      shutil.move 非原子、load() 只容 ENOENT；ninja 并行跑三条扫描边共享
  #      %USERPROFILE%\.cache\g-ir-scanner，CI 实测 CLANG64 启动即
  #      PermissionError [Errno 13]（杀软对新鲜多 MB pickle 的扫描窗口）。
  #   b) dump 程序链接 LDFLAGS 追加 -Wl,--stack,0x1000000（16MiB）—— PE 默认
  #      2MiB 仅为 Linux 8MiB 默认值的 1/4，dump 要在主线程驱动整个 UI-process
  #      API 的 class_init 链与属性默认值求值。
  #   c) GI_SCANNER_DEBUG=save-temps —— 扫描失败时保留 tmp-introspect*/
  #      （dump 程序 + functions.txt + 部分 dump.xml，其最后一个 <class> 即
  #      崩溃时刻正在处理的类型，崩溃现场取证的关键产物）。
  if ! grep -q 'GI_SCANNER_DISABLE_CACHE=1' Source/cmake/FindGI.cmake; then
    echo "SENTINEL FAIL: FindGI.cmake missing GI_SCANNER_DISABLE_CACHE=1 scanner env; 0005 introspection-and-dump-program (old 0017) hunk missing." >&2
    _sentinel_fail=1
  fi
  if ! grep -q -- '-Wl,--stack,0x1000000' Source/cmake/FindGI.cmake; then
    echo "SENTINEL FAIL: FindGI.cmake missing --stack dump-program link flag; 0005 introspection-and-dump-program (old 0017) hunk missing." >&2
    _sentinel_fail=1
  fi
  if ! grep -q 'GI_SCANNER_DEBUG=save-temps' Source/cmake/FindGI.cmake; then
    echo "SENTINEL FAIL: FindGI.cmake missing GI_SCANNER_DEBUG=save-temps scanner env; 0005 introspection-and-dump-program (old 0017) hunk missing." >&2
  fi

  # Round 44（0018）：dump 程序跳过重型初始化的两件套缺一不可（否则 WebKit-6.0 的
  # dump 运行回退到 0xC0000409 崩溃前沿：class_init 里的 webkitInitialize() 会在
  # 裸 C 进程内执行完整 WebKit2/JSC/Skia 初始化——Linux 上侥幸存活、本移植上崩溃；
  # WEPE dump 的 class_init 从不调 webkitInitialize 故同机成功，因果隔离实证）：
  #   a) WebKitInitialize.cpp 必须带 OS(WINDOWS) + WEBKIT_GIR_DUMP_MODE 门控
  #   b) FindGI.cmake 必须给扫描器环境导出 WEBKIT_GIR_DUMP_MODE=1
  if ! grep -q 'if (g_getenv("WEBKIT_GIR_DUMP_MODE"))' \
     Source/WebKit/UIProcess/API/glib/WebKitInitialize.cpp; then
    echo "SENTINEL FAIL: WebKitInitialize.cpp missing OS(WINDOWS)/WEBKIT_GIR_DUMP_MODE guard; 0005 introspection-and-dump-program (old 0018) hunk missing." >&2
    _sentinel_fail=1
  fi
  if ! grep -q 'WEBKIT_GIR_DUMP_MODE=1' Source/cmake/FindGI.cmake; then
    echo "SENTINEL FAIL: FindGI.cmake missing WEBKIT_GIR_DUMP_MODE=1 scanner env; 0005 introspection-and-dump-program (old 0018) hunk missing." >&2
    _sentinel_fail=1
  fi
  if (( _sentinel_fail )); then
    echo "One or more sentinels failed; aborting prepare(). Run 'rm -rf ${srcdir}/webkitgtk-${pkgver} && makepkg -f' to force a clean extraction+patch." >&2
    return 1
  fi
}

_print_archive_rule_diagnostics() {
  # $1 = rules.ninja 路径（相对当前构建目录）；$2 = 构建目录绝对路径（擦除提示用）。
  # 归档规则门禁失败时打印三方对账：缓存里的 -D 值 / 规则里实际引用的工具 /
  # 探测产物内嵌的归档器（真正的规则来源，沙盒 E2/E5 证实它会遮蔽缓存）。
  echo "  --- archive-rule diagnostics ---" >&2
  grep -E '^CMAKE_(AR|RANLIB):' CMakeCache.txt 2>/dev/null | sed 's/^/  cache:    /' >&2
  grep -m2 -A2 'rule CXX_STATIC_LIBRARY' "$1" 2>/dev/null | sed 's/^/  rule:     /' >&2
  grep -rhs 'set(CMAKE_AR ' CMakeFiles --include='CMake*Compiler.cmake' 2>/dev/null | sort -u | sed 's/^/  detected: /' >&2
  echo "  note: -DCMAKE_AR only takes effect on a fresh configure; an existing build" >&2
  echo "  directory keeps its originally-detected archiver (compiler-info shadowing)." >&2
  echo "  If the detected archiver above is GNU ar, wipe the build directory and re-run:" >&2
  echo "  rm -rf '$2'" >&2
}

_run_gir_dump_subset() {
  # Round 45: run one dump-program execution over a given functions list.
  # $1 = dump exe, $2 = DLL dir (PATH prefix), $3 = functions list file,
  # $4 = output dump.xml path. The exe's exit code lands in _GIR_DUMP_RC
  # (timeout kills surface as 124); the helper itself always returns 0 so a
  # crashing run can never abort the caller under `set -e` (makepkg runs
  # build() with -e; a bail-out here would kill the whole evidence chain).
  # WEBKIT_GIR_DUMP_MODE=1 keeps parity with the scanner-run environment
  # (the 0018 gate inside webkitInitialize).
  # NOTE: the `|| _rc=$?` idiom is load-bearing - under makepkg's `set -e`
  # a bare failing command would abort this function before the exit code
  # is even captured, killing the whole evidence chain.
  local _rc=0
  WEBKIT_GIR_DUMP_MODE=1 PATH="$2:${PATH}" timeout 300 "$1" "--introspect-dump=$3,$4" >/dev/null 2>&1 || _rc=$?
  _GIR_DUMP_RC=${_rc}
  return 0
}

_bisect_gir_dump_crash() {
  # Round 45: decisive evidence machine for the WebKit-6.0 dump-program crash
  # (0xC0000409 fail-fast, CLANG64/CLANGARM64, surviving Round 44's 0018 gate).
  #
  # What it does: GI_SCANNER_DEBUG=save-temps (Round 43) preserves each scan's
  # tmp-introspect*/ directory, which contains the dump program itself
  # (WebKit-6.0.exe), its input symbol list (functions.txt, one get_type
  # symbol per line) and the partial dump.xml. That is everything needed to
  # re-run the exact crashing binary under controlled inputs, on the exact
  # machine that crashed - no compiler, no scanner, no rebuild.
  #
  # Algorithm per dump program:
  #   1. full-set rerun: reproduces the crash standalone (if it does not, the
  #      crash needed the parallel-scan environment - reported and skipped);
  #   2. binary search over the symbol list: run [lo,mid); failure narrows
  #      into the failing half, success moves to the other half; ~log2(N)
  #      runs converge on one get_type symbol;
  #   3. verdict runs: the converged symbol alone, the prefix ending at it,
  #      and the suffix starting at it - distinguishing a single-symbol
  #      crash from a cumulative/stateful one (an earlier class_init leaving
  #      half-initialized state that a later type trips on) and from pure
  #      interaction effects;
  #   4. timeout kills (rc=124) are treated as failures too and labeled -
  #      a hang and a fail-fast are both evidence.
  # Any run that crashes writes a fresh WER event; this function therefore
  # runs BEFORE _collect_gir_crash_evidence so its WER query captures the
  # bisect's own crash events (module + offset, per-symbol).
  _GIR_BISECT_SUMMARY=""
  local _tree="${srcdir}/webkitgtk-${pkgver}"
  # libwebkitgtk DLL directory: the dump exe loads it (and its deps) at
  # startup; g-ir-scanner arranged this via os.add_dll_directory, a bare
  # rerun needs the PATH prefix.
  local _dll_dir
  _dll_dir="$(find "${srcdir}/build-${MSYSTEM}" -name 'libwebkitgtk-6.0*.dll' -printf '%h\n' 2>/dev/null | head -1)"
  if [[ -z "${_dll_dir}" ]]; then
    echo "[bisect] libwebkitgtk-6.0 DLL not found under ${srcdir}/build-${MSYSTEM}; dump reruns impossible (build failed too early?)." >&2
    return 0
  fi
  echo "[bisect] dump-program dependency DLL dir: ${_dll_dir}" >&2

  local _tdir _exe _fx _sym _rc _n _lo _hi _mid
  for _tdir in $(ls -dt "${_tree}"/tmp-introspect* 2>/dev/null | head -8); do
    _exe="$(ls "${_tdir}"/*-6.0.exe 2>/dev/null | head -1)"
    _fx="${_tdir}/functions.txt"
    [[ -f "${_exe}" && -s "${_fx}" ]] || continue

    echo "[bisect] === dump program: $(basename "${_exe}") ===" >&2
    local -a _syms=()
    while IFS= read -r _sym; do
      _sym="${_sym//$'\r'/}"
      _sym="${_sym//[[:space:]]/}"
      # if-form (not `[[ ]] &&`) so a blank line can never trip `set -e`
      if [[ -n "${_sym}" ]]; then
        _syms+=("$_sym")
      fi
    done < "${_fx}"
    _n=${#_syms[@]}
    if (( _n == 0 )); then
      echo "[bisect] functions.txt has no symbols; skipping." >&2
      continue
    fi
    echo "[bisect] ${_n} get_type symbols; full-set rerun first..." >&2

    _run_gir_dump_subset "${_exe}" "${_dll_dir}" "${_fx}" "${_tdir}/bisect-full.xml"
    _rc=${_GIR_DUMP_RC}
    if (( _rc == 0 )); then
      echo "[bisect] full-set rerun SUCCEEDED (exit 0) - the crash does not reproduce standalone for this program (needs the scanner/parallel environment); no bisection possible." >&2
      _GIR_BISECT_SUMMARY+="$(basename "${_exe}"): full-set rerun OK standalone; "
      continue
    fi
    echo "[bisect] full-set rerun FAILED rc=${_rc} (0x$(printf '%x' "${_rc}")) - reproduces standalone; bisecting..." >&2
    _GIR_BISECT_SUMMARY+="$(basename "${_exe}"): standalone repro rc=${_rc}; "

    _lo=0 _hi=$_n
    while (( _hi - _lo > 1 )); do
      _mid=$(( (_lo + _hi) / 2 ))
      printf '%s\n' "${_syms[@]:_lo:_mid-_lo}" > "${_tdir}/bisect-subset.txt"
      _run_gir_dump_subset "${_exe}" "${_dll_dir}" "${_tdir}/bisect-subset.txt" "${_tdir}/bisect-sub.xml"
      _rc=${_GIR_DUMP_RC}
      if (( _rc == 0 )); then
        echo "[bisect] symbols [${_lo},${_mid}) ok -> crash must be in [${_mid},${_hi})" >&2
        _lo=$_mid
      else
        echo "[bisect] symbols [${_lo},${_mid}) FAILED rc=${_rc} -> crash is inside this half" >&2
        _hi=$_mid
      fi
    done

    local _crash_sym="${_syms[$_lo]}"
    local _ctx_start=$(( _lo > 4 ? _lo - 4 : 0 ))
    echo "[bisect] converged on symbol #${_lo} of ${_n}: ${_crash_sym}" >&2
    echo "[bisect]   neighborhood: ${_syms[@]:_ctx_start:9}" >&2

    printf '%s\n' "${_crash_sym}" > "${_tdir}/bisect-single.txt"
    _run_gir_dump_subset "${_exe}" "${_dll_dir}" "${_tdir}/bisect-single.txt" "${_tdir}/bisect-single.xml"
    local _rc_single=${_GIR_DUMP_RC}
    printf '%s\n' "${_syms[@]:0:_lo+1}" > "${_tdir}/bisect-prefix.txt"
    _run_gir_dump_subset "${_exe}" "${_dll_dir}" "${_tdir}/bisect-prefix.txt" "${_tdir}/bisect-prefix.xml"
    local _rc_prefix=${_GIR_DUMP_RC}
    printf '%s\n' "${_syms[@]:_lo}" > "${_tdir}/bisect-suffix.txt"
    _run_gir_dump_subset "${_exe}" "${_dll_dir}" "${_tdir}/bisect-suffix.txt" "${_tdir}/bisect-suffix.xml"
    local _rc_suffix=${_GIR_DUMP_RC}
    echo "[bisect] verdict runs: single rc=${_rc_single} | prefix[0..${_lo}] rc=${_rc_prefix} | suffix[${_lo}..end] rc=${_rc_suffix}" >&2
    if (( _rc_single != 0 )); then
      echo "[bisect] VERDICT: SINGLE-SYMBOL crash confirmed - ${_crash_sym} alone kills the dump program (rc=${_rc_single})." >&2
      _GIR_BISECT_SUMMARY+="CRASH SYMBOL ${_crash_sym} (single-symbol rc=${_rc_single}); "
    elif (( _rc_prefix != 0 )); then
      echo "[bisect] VERDICT: CUMULATIVE crash - ${_crash_sym} only dies after the earlier symbols ran (prefix rc=${_rc_prefix}); an earlier class_init leaves state that this type trips on." >&2
      _GIR_BISECT_SUMMARY+="CUMULATIVE crash at ${_crash_sym} (prefix rc=${_rc_prefix}); "
    else
      echo "[bisect] VERDICT: INTERACTION effect - no single-symbol repro (single rc=0, prefix rc=0); the crash needs a combination outside the converged prefix; subsets kept in ${_tdir}/bisect-*.txt." >&2
      _GIR_BISECT_SUMMARY+="interaction-only crash near ${_crash_sym}; "
    fi
  done
  echo "[bisect] done." >&2
}

_collect_gir_crash_evidence() {
  # Round 43：g-ir dump 程序（WebKit-6.0.exe 等）崩溃/挂死时的零权限取证。
  # 三路证据：
  #   1) Windows 应用程序事件日志的 WER 记录（Event ID 1000/1001）——含异常代码、
  #      故障模块名与偏移，是把 0xC0000409 类 fail-fast 崩溃定位到具体模块的
  #      唯一零成本手段（无需 cdb/windbg，无需管理员）；
  #   2) GI_SCANNER_DEBUG=save-temps 保留的 tmp-introspect*/ 目录清单；
  #   3) 部分 dump.xml 的最后一个 <class>/<interface> 即崩溃时刻正在处理的类型。
  # Round 45：新增第 0 路——二分定位器的结论（见 _bisect_gir_dump_crash），
  # 以及醒目的 BEGIN/END 标记行（前两轮用户报告均未包含本段输出，标记行
  # 让它在长日志里不可错过：报告时请从 BEGIN 行截到 END 行）。
  # 全部 best-effort：powershell 不可用/无匹配事件时静默降级。
  echo "===== GIR CRASH EVIDENCE (BEGIN) =====" >&2
  if [[ -n "${_GIR_BISECT_SUMMARY:-}" ]]; then
    echo "--- bisect verdict (Round 45) ---" >&2
    echo "  ${_GIR_BISECT_SUMMARY}" >&2
  fi
  echo "--- gir dump crash evidence (Application event log, WER 1000/1001) ---" >&2
  powershell.exe -NoProfile -Command 'try { Get-WinEvent -FilterHashtable @{ LogName = "Application"; Id = 1000, 1001 } -MaxEvents 60 -ErrorAction Stop | Where-Object { $_.Message -match "WebKit-6\.0\.exe|WebKitWebProcessExtension-6\.0\.exe|JavaScriptCore-6\.0\.exe|g-ir-|vapigen" } | Select-Object -First 6 TimeCreated, Id, @{ n = "Message"; e = { ($_.Message -split "`r?`n" | Select-Object -First 12) -join " | " } } | Format-List } catch { "no matching WER events (or query unavailable)" }' 2>/dev/null | grep -vE '^[[:space:]]*$' | head -60 >&2
  echo "--- leftover introspection temp dirs (GI_SCANNER_DEBUG=save-temps) ---" >&2
  local _tdir
  for _tdir in $(ls -dt "${srcdir}"/webkitgtk-${pkgver}/tmp-introspect* 2>/dev/null | head -6); do
    echo "  ${_tdir}:" >&2
    ls -l "${_tdir}" 2>/dev/null | tail -n +2 | head -8 | sed 's/^/    /' >&2
    if [[ -f "${_tdir}/dump.xml" ]]; then
      echo "    last dumped type: $(grep -oE '<(class|interface|record|enumeration|bitfield) name="[^"]+"' "${_tdir}/dump.xml" 2>/dev/null | tail -1)" >&2
    fi
  done
  echo "===== GIR CRASH EVIDENCE (END) =====" >&2
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  # Stale build dir detection 必须在转发头预生成之前：擦除会连带删除预生成产物，而
  # -DWEBKIT_FORWARDING_HEADERS_SKIP=ON 又跳过 CMake 侧生成——先擦后生成，顺序不可颠倒。
  # 其一：Round 31 SKIP 项缺失（Round 30 或更早缓存）。
  local _build_dir="${srcdir}/build-${MSYSTEM}"
  if [[ -f "${_build_dir}/CMakeCache.txt" ]] \
     && ! grep -q '^WEBKIT_FORWARDING_HEADERS_SKIP:BOOL=ON$' "${_build_dir}/CMakeCache.txt"; then
    echo "Stale build directory at ${_build_dir} (no SKIP entry); wiping to force clean reconfigure." >&2
    rm -rf "${_build_dir}"
  fi

  # 其二（Round 37 引入，Round 39 升级判定依据）：UCRT64 旧构建目录里的 GNU ar 无法被
  # -D 覆盖——沙盒实验（cmake 4.4.4 + ninja 1.13，E2/E5）证实：命令行 -DCMAKE_AR 只写
  # 缓存，归档规则实际取自 CMakeFiles/<ver>/CMake{,CXX}Compiler.cmake 内嵌的
  # set(CMAKE_AR ...)（普通变量，遮蔽缓存），重配不更新 ⇒ 缓存看着对、规则仍旧用
  # GNU ar，静默复活 libSkia.a 卡死。判定地面真值改为探测产物；缓存值仅作辅助。
  # CLANG64/CLANGARM64 默认工具链即 LLVM binutils（msys2.org 文档："Only uses LLVM
  # tools"），通用名/LLVM 名均指向 LLVM 工具，无需擦除，保留其构建产物。
  if [[ "${MSYSTEM}" == "UCRT64" && -f "${_build_dir}/CMakeCache.txt" ]]; then
    local _detected_ar _cache_ar_ok=1
    _detected_ar="$(grep -rhs 'set(CMAKE_AR ' "${_build_dir}/CMakeFiles" --include='CMake*Compiler.cmake' | head -1)"
    grep -q '^CMAKE_AR:FILEPATH=.*llvm-ar\.exe$' "${_build_dir}/CMakeCache.txt" \
      || grep -q '^CMAKE_AR:UNINITIALIZED=.*llvm-ar\.exe$' "${_build_dir}/CMakeCache.txt" \
      || _cache_ar_ok=0
    if [[ -n "${_detected_ar}" && "${_detected_ar}" != *llvm-ar* ]] || (( ! _cache_ar_ok )); then
      echo "Stale UCRT64 build directory at ${_build_dir} (detected archiver: ${_detected_ar:-<none>}; -D cannot retarget an existing directory); wiping to switch archives to llvm-ar." >&2
      rm -rf "${_build_dir}"
    fi
  fi

  # Pre-generate forwarding headers with MSYS2 POSIX perl; native Win32 perl stalls on this step.
  local _fwd_output="${srcdir}/build-${MSYSTEM}/DerivedSources/ForwardingHeaders"
  if [[ ! -x /usr/bin/perl.exe ]]; then
    echo "ERROR: /usr/bin/perl.exe not found; MSYS2 POSIX perl is required for forwarding-header pre-generation." >&2
    return 1
  fi
  mkdir -p "${_fwd_output}"
  (
    cd "${srcdir}/webkitgtk-${pkgver}" && /usr/bin/perl.exe \
      Source/WebKit/Scripts/generate-forwarding-headers.pl \
      --include-path "${srcdir}/webkitgtk-${pkgver}/Source/WebKit" \
      --output "${_fwd_output}" \
      --platform gtk --platform soup
  )
  test -f "${_fwd_output}/WebKit/WKBase.h" || {
    echo "forwarding-header pre-generation did not produce WebKit/WKBase.h" >&2
    return 1
  }
  extra_config+=("-DWEBKIT_FORWARDING_HEADERS_SKIP=ON")

  mkdir -p "${_build_dir}" && cd "${_build_dir}"

  # Round 37: 归档工具硬门禁 —— llvm-ar 缺失时立即失败，绝不静默回落到会卡死的 GNU ar 路径
  # （Round 31 教训：已知会死锁的构建边，不允许因探测失败而静默复活）。
  if [[ ! -x "${MINGW_PREFIX}/bin/llvm-ar.exe" || ! -x "${MINGW_PREFIX}/bin/llvm-ranlib.exe" ]]; then
    echo "ERROR: ${MINGW_PREFIX}/bin/llvm-ar.exe / llvm-ranlib.exe not found." >&2
    echo "  GNU ar 归档 libSkia.a 等巨型静态库在 Windows 上病态缓慢（CI 上被判定为卡死）；" >&2
    echo "  本包要求 llvm-ar/llvm-ranlib（已列入 makedepends）。请安装: pacman -S ${MINGW_PACKAGE_PREFIX}-llvm" >&2
    return 1
  fi

  # Round 42: UCRT64 全部链接改走 lld（-fuse-ld=lld）。与 Round 37 的 llvm-ar 决策同一哲学：
  # GNU 工具链在本工程规模上有病态卡点——g-ir-scanner 的 dump 程序链接（gcc 驱动的
  # 小型 C 链接）在本轮 CI 上被 watchdog 实测挂死 20 分钟零进展（gcc/collect2/ld.exe
  # 三进程全程存活），而 CLANG64/CLANGARM64（默认即 lld）的同类链接秒级完成。
  # 链接器标志写进 CMAKE_*_LINKER_FLAGS（重配后随 build.ninja 边再生效；增量目录
  # 亦适用——链接命令行变化只触发重链接，lld 重链接为分钟级）。值不含路径成分，
  # 无需加入 MSYS2_ARG_CONV_EXCL。CLANG 环境默认已是 lld，不再显式叠加（避免
  # 全量重链接）。
  if [[ "${MSYSTEM}" == "UCRT64" ]]; then
    if [[ ! -x "${MINGW_PREFIX}/bin/ld.lld.exe" ]]; then
      echo "ERROR: ${MINGW_PREFIX}/bin/ld.lld.exe not found." >&2
      echo "  GNU ld 对本工程的关键链接存在挂死路径（dump 程序链接 CI 实测 20 分钟零进展）；" >&2
      echo "  本包 UCRT64 要求 lld（ld.lld 与 llvm-ar 同包，已列入 makedepends）。" >&2
      return 1
    fi
    extra_config+=(
      "-DCMAKE_EXE_LINKER_FLAGS=-fuse-ld=lld"
      "-DCMAKE_SHARED_LINKER_FLAGS=-fuse-ld=lld"
      "-DCMAKE_MODULE_LINKER_FLAGS=-fuse-ld=lld"
    )
  fi

  # Round 41: 开放 ENABLE_INTROSPECTION（.gir/.typelib）与 ENABLE_VAPIGEN（.vapi）。
  # g-ir-scanner 在 Windows 的完整链路：dump 程序以 -L<bin> -lwebkitgtk-6.0 链接（需
  # libwebkitgtk-6.0.dll.a 与 DLL 同目录，0015 已重定向 ARCHIVE_OUTPUT_DIRECTORY），
  # 运行时靠 get_internal_link_flags 把 --library-path 前插进 PATH 找 DLL。
  # Round 42（0016）：扫描器环境注入 PKG_CONFIG=<构建树内的 pkg-config-msys2 输出
  # 转换包装器>（MSYS 路径 → Windows 路径）与 LDFLAGS=-fuse-ld=lld；UCRT64 另以
  # CMAKE_*_LINKER_FLAGS 全局改走 lld（见上方 Round 42 块）。
  # Round 43（0017）：扫描器环境再注入 GI_SCANNER_DISABLE_CACHE=1（g-i 1.86.0
  # cachestore 无跨进程锁，ninja 并行扫描边共享用户级缓存目录在 CI 上实测
  # PermissionError [Errno 13]）、dump 链接 LDFLAGS 追加 -Wl,--stack,0x1000000
  # （PE 默认 2MiB 栈仅 Linux 默认 1/4）、GI_SCANNER_DEBUG=save-temps（失败时保留
  # tmp-introspect*/ 崩溃现场）。
  # ENABLE_VAPIGEN 需要 vapigen >= 0.56.18（g-i >= 1.82 的 gir 含 <doc:format> 元素，
  # 旧解析器报 "unknown child element `doc:format' in `repository'"；MSYS2 vala 现为 0.56.19）。
  # Round 39：归档工具路径先经 cygpath -m 显式转成 Windows 混合形式（C:/…），不再依赖
  # MSYS2 参数自动转换；两个 -D 前缀同步加入排除清单双保险（值已是 Windows 形式，
  # 转换本就是空操作）。CMAKE_INSTALL_PREFIX 必须保持 MSYS 形式：DESTDIR 装配依赖它
  # 不被转换（转成绝对 Windows 路径会绕过 DESTDIR，装进真实系统目录）。
  local _llvm_ar_win _llvm_ranlib_win
  _llvm_ar_win="$(cygpath -m "${MINGW_PREFIX}/bin/llvm-ar.exe")"
  _llvm_ranlib_win="$(cygpath -m "${MINGW_PREFIX}/bin/llvm-ranlib.exe")"
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=;-DCMAKE_AR;-DCMAKE_RANLIB" \
  ${MINGW_PREFIX}/bin/cmake.exe \
    -GNinja \
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
    -DCMAKE_AR:FILEPATH="${_llvm_ar_win}" \
    -DCMAKE_RANLIB:FILEPATH="${_llvm_ranlib_win}" \
    "${extra_config[@]}" \
    -DPORT=GTK \
    -DUSE_GTK4=ON \
    -DENABLE_INTROSPECTION=ON \
    -DENABLE_VAPIGEN=ON \
    -DENABLE_DOCUMENTATION=OFF \
    -DENABLE_MINIBROWSER=ON \
    -DENABLE_WEBDRIVER=OFF \
    -DENABLE_API_TESTS=OFF \
    -DENABLE_BUBBLEWRAP_SANDBOX=OFF \
    -DENABLE_JOURNALD_LOG=OFF \
    -DENABLE_GAMEPAD=OFF \
    -DENABLE_SPELLCHECK=OFF \
    -DENABLE_SPEECH_SYNTHESIS=OFF \
    -DENABLE_REMOTE_INSPECTOR=OFF \
    -DENABLE_WEBGL=OFF \
    -DUSE_GBM=OFF \
    -DUSE_LIBDRM=OFF \
    -DUSE_LIBBACKTRACE=OFF \
    -DUSE_LIBHYPHEN=OFF \
    -DUSE_LIBSECRET=OFF \
    -DUSE_GSTREAMER_GL=OFF \
    -DUSE_SYSPROF_CAPTURE=OFF \
    -DUSE_SYSTEM_SYSPROF_CAPTURE=OFF \
    -DUSE_SYSTEM_UNIFDEF=OFF \
    -DUSE_VULKAN=OFF \
    ../webkitgtk-${pkgver}

  # configure 必须产出 build.ninja（否则下方规则验证会给出误导性诊断）。
  if [[ ! -f build.ninja ]]; then
    echo "ERROR: cmake configure did not produce build.ninja; see configure output above." >&2
    return 1
  fi

  # Round 39（修正 Round 38 误报）：归档规则落地验证（configure 后硬门禁）。
  # CMake Ninja 生成器把全部工具命令行（编译/归档/链接）写入 CMakeFiles/rules.ninja，
  # build.ninja 只存边（edge）与目标——沙盒实验（cmake 4.4.4 + ninja 1.13，微型静态库
  # 工程，-D 覆盖生效后）复现：build.ninja 0 命中 / CMakeFiles/rules.ninja 1 命中。
  # Round 38 在 build.ninja 里 grep 工具名属检查错文件，三环境必然 100% 误报（本轮
  # CI 实证：三环境均在 configure 完成后立刻报错退出）。改为检查 rules.ninja，
  # 语义按环境区分：
  #   UCRT64：通用名 ar.exe 即 GNU binutils（libSkia.a 归档小时级卡死的根源）
  #           → 必须引用 -D 强制指派的 llvm-ar.exe / llvm-ranlib.exe。
  #   CLANG64/CLANGARM64：默认工具链即 LLVM binutils；旧目录探测产物遮蔽 -D
  #           （沙盒 E2/E5）时规则可能引用通用名 ar.exe —— 该名字在这些环境同样
  #           指向 LLVM 工具，用 --version 验明正身后放行。
  local _rules="CMakeFiles/rules.ninja"
  if [[ ! -f "${_rules}" ]]; then
    echo "ERROR: ${_rules} not found after configure; cannot verify archive rules." >&2
    return 1
  fi
  if grep -q 'llvm-ar\.exe' "${_rules}" && grep -q 'llvm-ranlib\.exe' "${_rules}"; then
    echo "archive rules verified: llvm-ar/llvm-ranlib referenced in ${_rules}." >&2
  elif [[ "${MSYSTEM}" != "UCRT64" ]]; then
    local _g_ar _g_ranlib
    _g_ar="$(grep -m1 -oE '[^ ;"]*[/\\](llvm-)?ar\.exe' "${_rules}" || true)"
    _g_ranlib="$(grep -m1 -oE '[^ ;"]*[/\\](llvm-)?ranlib\.exe' "${_rules}" || true)"
    if [[ -n "${_g_ar}" && -n "${_g_ranlib}" ]] \
       && "${_g_ar}" --version 2>/dev/null | grep -qi 'LLVM' \
       && "${_g_ranlib}" --version 2>/dev/null | grep -qi 'LLVM'; then
      echo "archive rules verified: generic names ${_g_ar} / ${_g_ranlib} resolve to LLVM tools." >&2
    else
      echo "ERROR: ${MSYSTEM} archive rules reference a non-LLVM archiver (GNU ar archives libSkia.a at hours-long stall)." >&2
      _print_archive_rule_diagnostics "${_rules}" "${_build_dir}"
      return 1
    fi
  else
    echo "ERROR: UCRT64 archive rules do not reference llvm-ar/llvm-ranlib (GNU ar archives libSkia.a at hours-long stall)." >&2
    _print_archive_rule_diagnostics "${_rules}" "${_build_dir}"
    return 1
  fi

  # Round 41：introspection/vapi 边落地验证（configure 后硬门禁）。三条 gir、三条 typelib、
  # 三条 vapi 边必须同时出现在 build.ninja（DESC 描述行）；任一缺失即说明
  # ENABLE_INTROSPECTION/ENABLE_VAPIGEN 未生效或旧构建目录未重配，立即失败
  # 避免数小时构建后才发现产物缺失。
  local _gi_edge
  for _gi_edge in "JavaScriptCore-6.0.gir" "WebKit-6.0.gir" "WebKitWebProcessExtension-6.0.gir" \
                  "JavaScriptCore-6.0.typelib" "WebKit-6.0.typelib" "WebKitWebProcessExtension-6.0.typelib" \
                  "javascriptcoregtk-6.0.vapi" "webkitgtk-6.0.vapi" "webkitgtk-web-process-extension-6.0.vapi"; do
    if ! grep -q "DESC = Generating ${_gi_edge}" build.ninja; then
      echo "ERROR: introspection edge 'Generating ${_gi_edge}' not found in build.ninja" >&2
      echo "  -DENABLE_INTROSPECTION=ON / -DENABLE_VAPIGEN=ON 未生效（或旧构建目录未重配）。" >&2
      echo "  若为旧目录残留：rm -rf '${_build_dir}' 后重跑。" >&2
      return 1
    fi
  done
  echo "introspection edges verified: 3 gir + 3 typelib + 3 vapi present in build.ninja." >&2

  # Round 42: UCRT64 lld 落地验证（configure 后硬门禁）。链接标志由 CMake 烘焙进
  # build.ninja 边（LINK_FLAGS/LINK_LIBRARIES）或 CMakeFiles/rules.ninja 规则，
  # 两处任一命中即通过；零命中说明旧缓存未更新（重配未生效），立即失败。
  if [[ "${MSYSTEM}" == "UCRT64" ]]; then
    if ! grep -q -- '-fuse-ld=lld' build.ninja \
       && ! grep -q -- '-fuse-ld=lld' CMakeFiles/rules.ninja; then
      echo "ERROR: UCRT64 link commands do not reference -fuse-ld=lld after configure." >&2
      echo "  旧构建目录缓存未随 -DCMAKE_*_LINKER_FLAGS 更新；rm -rf '${_build_dir}' 后重跑。" >&2
      return 1
    fi
    echo "UCRT64 linker verified: -fuse-ld=lld present in the generated build graph." >&2
  fi

  # Round 38: 构建可观测性强化（UCRT64 卡点定位）。
  # 关键事实：ninja 只在一条边【完成】时打印 "[n/total] <desc>"——CI 日志停在
  # [7041] 只能证明 libSkia.a 归档已完成（llvm-ar 生效后的预期行为），真正悬挂
  # 的是其后某条【从未完成也从未打印】的边。因此：
  #   1) --verbose 让每条边打印完整命令行：再发生悬挂时，日志最后一行即卡点命令；
  #   2) 后台 watchdog 每 5 分钟 dump 一次正在运行的构建子进程（含内存压力），
  #      与 --verbose 互为印证（区分"工具慢"与"进程僵死/资源耗尽"）。
  # Round 42 升级：ps -W 只能看到进程映像名，分辨不了"是哪条链接在挂"（本轮
  # UCRT64 的 gcc/collect2/ld 三件套只能猜）。新增 powershell Get-CimInstance
  # 抓取关键进程的【完整命令行】，下次悬挂时直接定位到具体构建边；powershell
  # 不可用时静默降级（ps -W 照常工作）。
  # Round 43 升级：introspection 尾部阶段（构建的最后几条边）加入 dump 程序与
  # gir 后处理工具画像——WebKit-6.0.exe / JavaScriptCore-6.0.exe /
  # WebKitWebProcessExtension-6.0.exe（tmp-introspect 目录里的 dump 程序）、
  # g-ir-compiler.exe、vapigen.exe。dump 运行是当前唯一未经 CI 验证的阶段
  # （CLANGARM64 已在此崩溃 0xC0000409、UCRT64 疑似在此挂死），其存活与否
  # 直接决定下一轮的修复方向。
  # Round 44: watchdog 停滞击杀（把"烧穿 CI 预算"变成"带证据的快速失败"）。
  # 短寿命工具链进程集（ld/ld.lld/collect2/g-ir-scanner/dump 程序/g-ir-compiler/
  # vapigen/llvm-ar/llvm-ranlib）在按设计都是秒级~分钟级；同一 WINPID 连续 3 次
  # 快照（15 分钟）存活即判死锁。编译器（gcc/clang）不入集：大 TU 合法地要跑
  # 数分钟，误杀风险不可接受。击杀动作：taskkill //F //T 掉悬挂 PID 与 ninja 树，
  # 让 cmake --build 返回非零 → 走 _collect_gir_crash_evidence 取证后失败退出。
  local _wd_state="${srcdir}/.watchdog_stall_state"
  rm -f "${_wd_state}"
  (
    _wd_hits=1
    while true; do
      sleep 300
      echo "[watchdog $(date '+%H:%M:%S')] live build processes:" >&2
      ps -W 2>/dev/null | grep -iE 'ninja|clang|g\+\+|gcc|llvm-(ar|ranlib)|ld\.exe|\bar\.exe|python|perl|ruby|cmake|-6\.0\.exe|g-ir|vapigen' | grep -vE 'grep -iE|watchdog' | head -20 >&2
      echo "[watchdog $(date '+%H:%M:%S')] live process command lines:" >&2
      powershell.exe -NoProfile -Command "Get-CimInstance Win32_Process -Filter \"Name='ld.exe' or Name='ld.lld.exe' or Name='lld-link.exe' or Name='collect2.exe' or Name='gcc.exe' or Name='g++.exe' or Name='clang.exe' or Name='clang++.exe' or Name='llvm-ar.exe' or Name='ninja.exe' or Name='python.exe' or Name='perl.exe' or Name='cmake.exe' or Name='g-ir-scanner.exe' or Name='sh.exe' or Name='WebKit-6.0.exe' or Name='JavaScriptCore-6.0.exe' or Name='WebKitWebProcessExtension-6.0.exe' or Name='g-ir-compiler.exe' or Name='vapigen.exe'\" | Select-Object ProcessId,CommandLine | Format-List" 2>/dev/null | grep -vE '^\s*$' | head -80 >&2 || true
      echo "[watchdog $(date '+%H:%M:%S')] memory: $(free -m 2>/dev/null | awk '/Mem:/{print "used "$3"MB / total "$2"MB"}' || echo n/a)" >&2

      # 停滞检测：短寿命集的 WINPID 清单与上一快照相同则累计，否则重置。
      _wd_cur="$(ps -W 2>/dev/null \
        | grep -iE 'ld\.exe|ld\.lld\.exe|collect2\.exe|g-ir-scanner\.exe|-6\.0\.exe|g-ir-compiler\.exe|vapigen\.exe|llvm-ar\.exe|llvm-ranlib\.exe' \
        | grep -vE 'grep |watchdog|_wd_cur' \
        | awk '{print $4}' | sort -u)"
      _wd_prev="$(cat "${_wd_state}" 2>/dev/null)"
      printf '%s\n' "${_wd_cur}" > "${_wd_state}"
      if [[ -n "${_wd_cur}" && "${_wd_cur}" == "${_wd_prev}" ]]; then
        _wd_hits=$((_wd_hits + 1))
      else
        _wd_hits=1
      fi
      if [[ -n "${_wd_cur}" && ${_wd_hits} -ge 3 ]]; then
        echo "[watchdog $(date '+%H:%M:%S')] STALL VERDICT: short-lived toolchain processes alive across 3 snapshots (15 min) with zero progress:" >&2
        ps -W 2>/dev/null | awk -v ids="$(echo ${_wd_cur} | tr '\n' ' ')" 'BEGIN{split(ids,a," "); for(i in a) want[a[i]]=1} want[$4]{print "  WINPID", $4, $NF}' >&2
        echo "[watchdog] killing stalled processes and the ninja tree; build will fail into evidence collection." >&2
        _wpid=
        for _wpid in ${_wd_cur}; do taskkill //F //T //PID "${_wpid}" >/dev/null 2>&1; done
        ps -W 2>/dev/null | awk '$NF ~ /ninja\.exe$/ {print $4}' | while read -r _npid; do
          taskkill //F //T //PID "${_npid}" >/dev/null 2>&1
        done
        break
      fi
    done
  ) &
  local _watchdog_pid=$!

  ${MINGW_PREFIX}/bin/cmake.exe --build . --verbose
  local _build_status=$?

  kill "${_watchdog_pid}" 2>/dev/null

  # Round 43：构建失败时收集 dump 程序崩溃证据（WER 事件日志 + save-temps 现场），
  # 再向 makepkg 透传失败状态。取证失败不影响退出码。
  # Round 45：先跑二分定位器再取证——二分的每次崩溃运行都会写入新的 WER 事件，
  # 后查事件日志即可拿到【按符号区分】的故障模块与偏移（比只看原始一次崩溃
  # 的 WER 记录强得多）；两段输出都以醒目的 marker 行包裹，报告时请完整截取。
  if (( _build_status != 0 )); then
    _bisect_gir_dump_crash
    _collect_gir_crash_evidence
  fi
  return ${_build_status}
}

package() {
  cd "${srcdir}/build-${MSYSTEM}"

  DESTDIR="${pkgdir}" ${MINGW_PREFIX}/bin/cmake.exe --install .

  # Assert pkg-config metadata ships; dependent projects (e.g. Kangaroo) discover the library through these .pc files.
  for _pc in webkitgtk-6.0 javascriptcoregtk-6.0 webkitgtk-web-process-extension-6.0; do
    test -f "${pkgdir}${MINGW_PREFIX}/lib/pkgconfig/${_pc}.pc" || {
      echo "pkg-config file ${_pc}.pc is missing from the package" >&2
      exit 1
    }
  done

  # Round 41：introspection 产物断言（gir 按命名空间名、typelib 同名、vapi 按包名；
  # vapi 装在未版本化的 share/vala/vapi，与 libadwaita/gtksourceview5 同路径）。
  for _ns in JavaScriptCore-6.0 WebKit-6.0 WebKitWebProcessExtension-6.0; do
    test -f "${pkgdir}${MINGW_PREFIX}/share/gir-1.0/${_ns}.gir" || {
      echo "gir file ${_ns}.gir is missing from the package" >&2
      exit 1
    }
    test -f "${pkgdir}${MINGW_PREFIX}/lib/girepository-1.0/${_ns}.typelib" || {
      echo "typelib file ${_ns}.typelib is missing from the package" >&2
      exit 1
    }
  done
  for _vapi in javascriptcoregtk-6.0 webkitgtk-6.0 webkitgtk-web-process-extension-6.0; do
    test -f "${pkgdir}${MINGW_PREFIX}/share/vala/vapi/${_vapi}.vapi" || {
      echo "vapi file ${_vapi}.vapi is missing from the package" >&2
      exit 1
    }
  done
  for _deps in webkitgtk-6.0 webkitgtk-web-process-extension-6.0; do
    test -f "${pkgdir}${MINGW_PREFIX}/share/vala/vapi/${_deps}.deps" || {
      echo "vapi deps file ${_deps}.deps is missing from the package" >&2
      exit 1
    }
  done

  install -Dm644 "${srcdir}/webkitgtk-${pkgver}/Source/WebCore/LICENSE-LGPL-2.1" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE-LGPL-2.1"
}
