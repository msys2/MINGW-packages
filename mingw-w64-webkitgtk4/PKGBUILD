# The release tarball ships exactly one symlink entry:
#
#   webkitgtk-2.54.1/Source/ThirdParty/skia/src/ports/fontations/Cargo.toml
#     -> ../../../bazel/external/fontations/Cargo.toml
#
# The target file is NOT included in the tarball, and MSYS2 emulates
# symlink(2) by deep-copying the link target, so bsdtar aborts the whole
# extraction with ENOENT when it reaches that entry on Windows:
#
#   Can't create '.../skia/src/ports/fontations/Cargo.toml':
#   No such file or directory
#
# Skip makepkg's automatic extraction for the tarball (checksums are still
# verified) and unpack it in prepare() while dropping that dangling symlink;
# the file belongs to Skia's Bazel/Rust build and is unused by the CMake
# build of the GTK port.
noextract=("webkitgtk-${pkgver}.tar.xz")

prepare() {
  # Locate the source tarball: makepkg leaves noextract'ed sources in
  # $SRCDEST (or $startdir for local sources) instead of unpacking them
  # into $srcdir.
  local _tarball=""
  local _cand
  for _cand in "${SRCDEST}/webkitgtk-${pkgver}.tar.xz" \
               "${startdir}/webkitgtk-${pkgver}.tar.xz" \
               "${srcdir}/webkitgtk-${pkgver}.tar.xz"; do
    if [[ -f "${_cand}" ]]; then
      _tarball="${_cand}"
      break
    fi
  done
  if [[ -z "${_tarball}" ]]; then
    echo "webkitgtk-${pkgver}.tar.xz not found in SRCDEST/startdir/srcdir" >&2
    return 1
  fi

  rm -rf "webkitgtk-${pkgver}"
  bsdtar -xpf "${_tarball}" \
    --exclude "webkitgtk-${pkgver}/Source/ThirdParty/skia/src/ports/fontations/Cargo.toml"
  if [[ ! -d "webkitgtk-${pkgver}" ]]; then
    echo "failed to extract webkitgtk source tarball" >&2
    return 1
  fi

  cd webkitgtk-${pkgver}

  patch -Np1 -i "${startdir}/0001-MinGW-build-system-and-WTF-win-headers.patch"
  patch -Np1 -i "${startdir}/0002-MinGW-WTF-threading-and-compiler-compatibility.patch"
  patch -Np1 -i "${startdir}/0003-MinGW-IPC-SharedMemory-and-process-launch-support.patch"
  patch -Np1 -i "${startdir}/0004-MinGW-cmake-discovery-and-harfbuzz-icu-shim.patch"
  patch -Np1 -i "${startdir}/0005-MinGW-Skia-FreeType-backend-and-GTK-font-manager.patch"
  patch -Np1 -i "${startdir}/0006-MinGW-libpas-and-compat-shims.patch"
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  # MinGW: pre-generate the WebKit forwarding headers with the MSYS2 POSIX
  # perl, straight from bash, and neutralize the ninja-side step with
  # -DWEBKIT_FORWARDING_HEADERS_SKIP=ON. The native Win32 perl
  # (${MINGW_PACKAGE_PREFIX}-perl) has hung indefinitely inside that step on
  # the CI runners in three consecutive rounds (the log stops at the perl
  # command and every remaining build edge depends on it), and both earlier
  # attempts to fix it inside the ninja graph (re-pointing the command at
  # another interpreter; skipping it via a -D flag) failed on the runner: a
  # missing /usr/bin/perl.exe used to silently fall back to the stalling
  # path. The pre-generation is therefore unconditional: /usr/bin/perl.exe
  # is a hard requirement (see makedepends), its absence aborts the build
  # immediately, and the CMake-side default for WEBKIT_FORWARDING_HEADERS_SKIP
  # is ON on Windows anyway (Update 31), so the graph never depends on the
  # stalling interpreter even if this -D flag were lost.
  local _fwd_output="${srcdir}/build-${MSYSTEM}/DerivedSources/ForwardingHeaders"
  if [[ ! -x /usr/bin/perl.exe ]]; then
    echo "ERROR: /usr/bin/perl.exe not found." >&2
    echo "The MSYS2 POSIX perl (the unprefixed 'perl' in makedepends) is required to pre-generate the WebKit forwarding headers." >&2
    echo "The native Win32 perl stalls indefinitely on that step (see the round-28..30 CI logs)." >&2
    return 1
  fi
  mkdir -p "${_fwd_output}"
  (
    cd "${srcdir}/webkitgtk-${pkgver}" && /usr/bin/perl.exe \
      Source/WebKit/Scripts/generate-forwarding-headers.pl \
      --include-path "${srcdir}/webkitgtk-${pkgver}/Source/WebKit" \
      --output "${_fwd_output}" \
      --platform gtk --platform soup
  )
  # WKBase.h is included via <WebKit/WKBase.h> from several in-tree
  # headers, so its forwarding header must exist once generation ran.
  test -f "${_fwd_output}/WebKit/WKBase.h" || {
    echo "forwarding-header pre-generation did not produce WebKit/WKBase.h" >&2
    return 1
  }
  extra_config+=("-DWEBKIT_FORWARDING_HEADERS_SKIP=ON")

  mkdir -p "${srcdir}/build-${MSYSTEM}" && cd "${srcdir}/build-${MSYSTEM}"

  # GObject introspection stays disabled on MinGW: the g-ir-scanner run
  # against the WebKit DLL is a new, untested surface on MSYS2 and this
  # package currently has no consumer for the .gir/.typelib/.vapi files.
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
  ${MINGW_PREFIX}/bin/cmake.exe \
    -GNinja \
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
    "${extra_config[@]}" \
    -DPORT=GTK \
    -DUSE_GTK4=ON \
    -DENABLE_INTROSPECTION=OFF \
    -DENABLE_DOCUMENTATION=OFF \
    -DENABLE_MINIBROWSER=ON \
    -DENABLE_WEBDRIVER=OFF \
    -DENABLE_API_TESTS=OFF \
    -DENABLE_BUBBLEWRAP_SANDBOX=OFF \
    -DENABLE_JOURNALD_LOG=OFF \
    -DENABLE_GAMEPAD=OFF \
    -DENABLE_SPELLCHECK=OFF \
    -DENABLE_SPEECH_SYNTHESIS=OFF \
    -DENABLE_REMOTE_INSPECTOR=OFF \
    -DENABLE_WEBGL=OFF \
    -DUSE_GBM=OFF \
    -DUSE_LIBDRM=OFF \
    -DUSE_LIBBACKTRACE=OFF \
    -DUSE_LIBHYPHEN=OFF \
    -DUSE_LIBSECRET=OFF \
    -DUSE_GSTREAMER_GL=OFF \
    -DUSE_SYSPROF_CAPTURE=OFF \
    -DUSE_SYSTEM_SYSPROF_CAPTURE=OFF \
    -DUSE_SYSTEM_UNIFDEF=OFF \
    -DUSE_VULKAN=OFF \
    ../webkitgtk-${pkgver}

  ${MINGW_PREFIX}/bin/cmake.exe --build .
}

package() {
  cd "${srcdir}/build-${MSYSTEM}"

  DESTDIR="${pkgdir}" ${MINGW_PREFIX}/bin/cmake.exe --install .

  # Ensure the pkg-config metadata is shipped; dependent projects (e.g.
  # Kangaroo) discover the library through webkitgtk-6.0.pc.
  for _pc in webkitgtk-6.0 javascriptcoregtk-6.0 webkitgtk-web-process-extension-6.0; do
    test -f "${pkgdir}${MINGW_PREFIX}/lib/pkgconfig/${_pc}.pc" || {
      echo "pkg-config file ${_pc}.pc is missing from the package" >&2
      exit 1
    }
  done

  install -Dm644 "${srcdir}/webkitgtk-${pkgver}/Source/WebCore/LICENSE-LGPL-2.1" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE-LGPL-2.1"
}
