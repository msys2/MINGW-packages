 #if OS(WINDOWS) && CPU(X86_64)
+/* Alias so the sysv_abi attribute lives in a position where every
+   compiler that supports it keeps it: GCC drops attributes written
+   between the return type and (*) when parsing template partial
+   specializations, which made the pointer specialization below
+   collapse into FunctionTraits<Result (*)(Args...)> and fail with a
+   redefinition error. */
 template<typename Result, typename... Args>
-struct FunctionTraits<Result SYSV_ABI(Args...)> : public FunctionTraits<Result(Args...)> {
+using SysVFunction = Result SYSV_ABI(Args...);
+
+template<typename Result, typename... Args>
+struct FunctionTraits<SysVFunction<Result, Args...>> : public FunctionTraits<Result(Args...)> {
 };
 #endif
 
@@ -92,7 +101,7 @@ struct FunctionTraits<Result(*)(Args...)> : public FunctionTraits<Result(Args...
 
 #if OS(WINDOWS) && CPU(X86_64)
 template<typename Result, typename... Args>
-struct FunctionTraits<Result SYSV_ABI (*)(Args...)> : public FunctionTraits<Result(Args...)> {
+struct FunctionTraits<SysVFunction<Result, Args...>*> : public FunctionTraits<Result(Args...)> {
 };
 #endif
 
