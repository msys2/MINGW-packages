diff --git a/Source/ThirdParty/mingw-compat/include/sys/mman.h b/Source/ThirdParty/mingw-compat/include/sys/mman.h
new file mode 100644
index 00000000..377866a3
--- /dev/null
+++ b/Source/ThirdParty/mingw-compat/include/sys/mman.h
@@ -0,0 +1,177 @@
+/*
+ * Copyright (C) 2025 Tao Zuhong
+ *
+ * This library is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or (at
+ * your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful, but WITHOUT
+ * ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE. See the GNU Lesser General Public License
+ * for more details.
+ *
+ * Minimal <sys/mman.h> emulation for MinGW, providing the mmap/munmap/
+ * mprotect/madvise subset used by WebKit. Only a single shared, read/write
+ * mapping per file descriptor is supported, which is all WebKit needs.
+ */
+
+#pragma once
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <io.h>
+#include <fcntl.h>
+#include <errno.h>
+
+#define PROT_NONE  0x0
+#define PROT_READ  0x1
+#define PROT_WRITE 0x2
+#define PROT_EXEC  0x4
+
+#define MAP_SHARED   0x01
+#define MAP_PRIVATE  0x02
+#define MAP_FIXED    0x10
+#define MAP_ANON     0x20
+#define MAP_ANONYMOUS MAP_ANON
+#define MAP_NORESERVE 0x4000
+
+#ifndef MADV_DONTNEED
+#define MADV_DONTNEED 4
+#endif
+#ifndef MADV_WILLNEED
+#define MADV_WILLNEED 3
+#endif
+#ifndef MADV_FREE
+#define MADV_FREE 8
+#endif
+
+#define MAP_FAILED ((void*)(intptr_t)-1)
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+inline static DWORD mmanProtectionFromProt(int prot)
+{
+    switch (prot & (PROT_READ | PROT_WRITE | PROT_EXEC)) {
+    case PROT_NONE:
+        return PAGE_NOACCESS;
+    case PROT_READ:
+        return PAGE_READONLY;
+    case PROT_READ | PROT_WRITE:
+        return PAGE_READWRITE;
+    case PROT_READ | PROT_EXEC:
+        return PAGE_EXECUTE_READ;
+    case PROT_READ | PROT_WRITE | PROT_EXEC:
+        return PAGE_EXECUTE_READWRITE;
+    case PROT_EXEC:
+        return PAGE_EXECUTE;
+    default:
+        return PAGE_NOACCESS;
+    }
+}
+
+inline static void* mmanMapPageFile(void* address, size_t length, int prot, int flags, int fd, long long offset)
+{
+    (void)offset;
+
+    DWORD desiredAccess = 0;
+    if (prot & PROT_WRITE)
+        desiredAccess = FILE_MAP_WRITE | FILE_MAP_READ;
+    else if (prot & PROT_READ)
+        desiredAccess = FILE_MAP_READ;
+
+    if (fd == -1)
+        return MAP_FAILED;
+
+    HANDLE osHandle = reinterpret_cast<HANDLE>(_get_osfhandle(fd));
+    if (osHandle == INVALID_HANDLE_VALUE)
+        return MAP_FAILED;
+
+    HANDLE mapping = CreateFileMappingW(osHandle, nullptr, PAGE_READWRITE, 0, 0, nullptr);
+    if (!mapping)
+        return MAP_FAILED;
+
+    void* result = MapViewOfFileEx(mapping, desiredAccess, 0, 0, length, address);
+    CloseHandle(mapping);
+    if (!result || ((flags & MAP_FIXED) && result != address)) {
+        if (result)
+            UnmapViewOfFile(result);
+        return MAP_FAILED;
+    }
+
+    DWORD pageProtection = mmanProtectionFromProt(prot);
+    if (pageProtection != PAGE_READWRITE && !VirtualProtect(result, length, pageProtection, &pageProtection)) {
+        UnmapViewOfFile(result);
+        return MAP_FAILED;
+    }
+
+    return result;
+}
+
+inline static void* mmap(void* address, size_t length, int prot, int flags, int fd, long long offset)
+{
+    if (!length) {
+        errno = EINVAL;
+        return MAP_FAILED;
+    }
+
+    if (!(flags & MAP_ANON))
+        return mmanMapPageFile(address, length, prot, flags, fd, offset);
+
+    SIZE_T reservedBytes = static_cast<SIZE_T>(length);
+    DWORD allocationType = MEM_RESERVE;
+    if (prot != PROT_NONE)
+        allocationType |= MEM_COMMIT;
+
+    void* result = VirtualAlloc(address, reservedBytes, allocationType, mmanProtectionFromProt(prot));
+    if (!result) {
+        errno = ENOMEM;
+        return MAP_FAILED;
+    }
+
+    return result;
+}
+
+inline static int munmap(void* address, size_t length)
+{
+    (void)length;
+    if (!VirtualFree(address, 0, MEM_RELEASE))
+        return -1;
+    return 0;
+}
+
+inline static int mprotect(void* address, size_t length, int prot)
+{
+    SYSTEM_INFO systemInfo;
+    GetSystemInfo(&systemInfo);
+
+    uintptr_t base = reinterpret_cast<uintptr_t>(address);
+    uintptr_t pageMask = systemInfo.dwPageSize ? (systemInfo.dwPageSize - 1) : 0xFFF;
+    uintptr_t alignedBase = base & ~pageMask;
+    size_t alignedLength = length + (base - alignedBase);
+
+    DWORD oldProtection;
+    if (!VirtualProtect(reinterpret_cast<void*>(alignedBase), alignedLength, mmanProtectionFromProt(prot), &oldProtection)) {
+        errno = ENOMEM;
+        return -1;
+    }
+    return 0;
+}
+
+inline static int madvise(void* address, size_t length, int advice)
+{
+    (void)address;
+    (void)length;
+    (void)advice;
+    /* Committed-but-untouched pages do not consume physical memory on Windows,
+     * so decommit-style advices can be safely ignored. */
+    return 0;
+}
+
+#ifdef __cplusplus
+}
+#endif
