--- /dev/null
+++ b/Source/JavaScriptCore/API/glib/JavaScriptCore-6.0-custom.vala
@@ -0,0 +1,26 @@
+// Vala API additions for the JavaScriptCore-6.0 gir.
+//
+// The gir models the JSCClass callback registration (jsc_class_add_property
+// and the constructor/method callbacks) through raw GCallback parameters,
+// which vapigen cannot express with Vala generics. This file redeclares
+// those members with proper generic delegates, matching the
+// JavaScriptCore-6.0-custom.vala that the vala project uses when generating
+// its own shipped javascriptcoregtk-6.0.vapi.
+//
+// Copyright (C) 2025 The vala project contributors
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+namespace JSC {
+	public class Class : GLib.Object {
+		public void add_property (string name, GLib.Type property_type, [CCode (delegate_target_pos = 4.33333, destroy_notify_pos = 4.66667, type = "GCallback")] owned JSC.ClassGetPropertyCb? getter, [CCode (delegate_target_pos = 4.33333, destroy_notify_pos = 4.66667, type = "GCallback")] owned JSC.ClassSetPropertyCb? setter);
+	}
+	[CCode (cname = "GCallback", instance_pos = 1.9)]
+	public delegate T ClassGetPropertyCb<T> (JSC.Class instance);
+	[CCode (cname = "GCallback", instance_pos = 2.9)]
+	public delegate void ClassSetPropertyCb<T> (JSC.Class instance, T value);
+
+	[CCode (cname = "GCallback", instance_pos = 1.9)]
+	public delegate T ClassConstructorCb<T> (GLib.GenericArray<JSC.Value> values);
+	[CCode (cname = "GCallback", instance_pos = 2.9)]
+	public delegate T ClassMethodCb<T> (JSC.Class instance, GLib.GenericArray<JSC.Value> values);
+}
From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kangaroo maintainers
Date: 2026-10-16
Subject: [PATCH] MinGW: g-ir-scanner pkg-config path wrapper + lld for the
 dump-program link

ENABLE_INTROSPECTION on MSYS2 tripped over two toolchain-specific
failures on the first GIR-enabled run of all three MINGW environments:

1. CLANG64/CLANGARM64: g-ir-scanner aborted while generating
   WebKit-6.0.gir and WebKitWebProcessExtension-6.0.gir with
     FileNotFoundError: [WinError 3] ... '/clang64/lib'
     giscanner/utils.py, add_dll_dirs -> _add_dll_directory
   The g-ir-scanner.exe launcher resolves python.exe through PATH, so
   the scanner runs under the *native* Windows Python and the
   Windows-only DLL-search setup in giscanner.utils.dll_dirs is active:
   it runs `pkg-config --static --libs-only-L <pkgs>` / `--variable
   bindir <pkgs>` at scan time and feeds the results straight into
   os.add_dll_directory(). Every MSYS2 .pc file carries POSIX-style
   paths (glib-2.0.pc: Libs: -L${libdir}, libdir=/clang64/lib), which
   are not valid Windows paths, so the scan of any package set whose
   --static --libs-only-L resolution survives pkgconf's builtin-path
   filtering aborts (JavaScriptCore-6.0.gir survived only because its
   pkg-config set produced no -L output).

2. UCRT64: the build stalled for 20+ minutes (watchdog: gcc/collect2/
   ld.exe alive, zero progress) in the g-ir-scanner dump-program link,
   which g-ir-scanner drives through the C compiler driver with GNU ld.

Fix, in Source/cmake/FindGI.cmake (WIN32 only):

- Generate a pkg-config output-conversion wrapper (pkg-config-msys2.py
  + .bat shim) into the build tree at configure time. The MSYS2
  installation root is derived from the pkg-config location
  (<root>/<prefix>/bin/pkg-config.exe), and the wrapper runs the real
  pkg-config and rewrites MSYS-style absolute paths in its output
  (-I and -L flags and bare path tokens alike) into Windows form,
  matching cygpath -m semantics. Setting PKG_CONFIG for the scanner
  routes all four giscanner.pkgconfig query shapes through it.

- Set LDFLAGS=-fuse-ld=lld for the scanner run: the dump-program link
  honors LDFLAGS, and lld (already required for llvm-ar/llvm-ranlib)
  links it instantly where GNU ld stalls indefinitely.

Linux builds are untouched (both changes are WIN32-only).
---
--- a/Source/cmake/FindGI.cmake
+++ b/Source/cmake/FindGI.cmake
@@ -140,6 +140,142 @@
     return()
 endif ()
 
+# MinGW port, introspection: make g-ir-scanner usable from a native
+# Windows toolchain (MSYS2 MINGW64/UCRT64/CLANG64/CLANGARM64).
+#
+# On MSYS2 the g-ir-scanner.exe launcher resolves python.exe through
+# PATH, so the scanner runs under the *native* Windows Python and the
+# Windows-only DLL-search setup in giscanner.utils.dll_dirs is active:
+# it queries pkg-config at scan time and feeds the resulting library
+# directories straight into os.add_dll_directory(). Every MSYS2 .pc
+# file carries POSIX-style paths (libdir=/clang64/lib,
+# bindir=${prefix}/bin), which are not valid Windows paths, so the scan
+# of any package with -L entries or path variables aborts with
+#   FileNotFoundError: [WinError 3] ... '/clang64/lib'
+# (observed with gobject-introspection 1.86.0, WebKit-6.0.gir and
+# WebKitWebProcessExtension-6.0.gir scans; JavaScriptCore-6.0.gir only
+# survived because its pkg-config set resolves to no -L output).
+#
+# Fix: generate a pkg-config output-conversion wrapper into the build
+# tree and route every scanner pkg-config query through it by setting
+# the PKG_CONFIG environment variable (giscanner.pkgconfig honors it
+# for all of its --cflags/--libs/--libs-only-L/--variable queries).
+# The wrapper runs the real pkg-config and rewrites MSYS-style absolute
+# paths in its output (-I and -L flags and bare path tokens alike) into
+# Windows form, using the MSYS2 installation root derived here at
+# configure time from the pkg-config location
+# (<msys2-root>/<prefix>/bin/pkg-config.exe or <msys2-root>/usr/bin/...).
+if (WIN32)
+    find_program(GI_PKG_CONFIG_EXE NAMES pkg-config pkgconf)
+    if (NOT GI_PKG_CONFIG_EXE)
+        message(FATAL_ERROR "introspection on MinGW requires pkg-config (pkgconf); none found")
+    endif ()
+    cmake_path(GET GI_PKG_CONFIG_EXE PARENT_PATH _gi_pkgconf_bindir)
+    cmake_path(GET _gi_pkgconf_bindir PARENT_PATH _gi_pkgconf_prefixdir)
+    cmake_path(GET _gi_pkgconf_prefixdir PARENT_PATH _gi_msys2_root)
+    cmake_path(GET _gi_pkgconf_prefixdir FILENAME _gi_msys2_prefix_name)
+    if (NOT _gi_msys2_prefix_name OR _gi_msys2_prefix_name STREQUAL "bin")
+        message(FATAL_ERROR "could not derive the MSYS2 installation root from ${GI_PKG_CONFIG_EXE}")
+    endif ()
+    # The wrapper script runs under the same interpreter flavor that
+    # runs g-ir-scanner: the MSYS2 MINGW Python, a hard dependency of
+    # the gobject-introspection package.
+    find_program(GI_WRAPPER_PYTHON_EXE
+        NAMES python3.exe python.exe python3 python
+        HINTS "${_gi_pkgconf_prefixdir}/bin"
+    )
+    if (NOT GI_WRAPPER_PYTHON_EXE)
+        message(FATAL_ERROR "introspection on MinGW requires a Python interpreter in ${_gi_pkgconf_prefixdir}/bin (shipped with gobject-introspection)")
+    endif ()
+    set(GI_PKG_CONFIG_WRAPPER "${CMAKE_BINARY_DIR}/pkg-config-msys2.bat")
+    set(_gi_wrapper_py [[import re
+import shlex
+import subprocess
+import sys
+
+"""pkg-config output converter for MSYS2 native builds (MinGW port).
+
+gobject-introspection's giscanner feeds pkg-config output into both the
+native compiler driver and os.add_dll_directory(); on MSYS2 the
+installed .pc files use POSIX-style paths (libdir=/clang64/lib) which
+are not valid Windows paths. This wrapper runs the real pkg-config and
+rewrites every MSYS-style absolute path token in its output into
+Windows form (MSYS2_ROOT + the POSIX path), matching `cygpath -m`
+semantics for paths under the installation root.
+"""
+
+REAL_PKG_CONFIG = r"@GI_REAL_PKG_CONFIG@"
+MSYS2_ROOT = r"@GI_MSYS2_ROOT@"
+
+_FLAG_PATH_RE = re.compile(r"^(-[IL])(/.+)$")
+
+
+def _to_windows(msys_path):
+    # MSYS2 path semantics: any absolute POSIX path resolves under the
+    # installation root (/<prefix-name>/... and /usr/... alike).
+    return MSYS2_ROOT + msys_path
+
+
+def _convert_token(token):
+    match = _FLAG_PATH_RE.match(token)
+    if match:
+        return match.group(1) + _to_windows(match.group(2))
+    if token.startswith("/"):
+        return _to_windows(token)
+    return token
+
+
+def _convert_line(line):
+    try:
+        tokens = shlex.split(line)
+    except ValueError:
+        tokens = line.split()
+    if not tokens:
+        return ""
+    converted = [_convert_token(token) for token in tokens]
+    return " ".join(
+        ('"%s"' % token) if " " in token else token
+        for token in converted
+    )
+
+
+def main():
+    try:
+        proc = subprocess.run(
+            [REAL_PKG_CONFIG] + sys.argv[1:],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+        )
+    except OSError as error:
+        sys.stderr.write("pkg-config-msys2: %s\n" % error)
+        return 127
+    # pkg-config failures must keep their exit status and diagnostics
+    # (g-ir-scanner prints merged output when it tolerates errors), so
+    # stderr is merged into stdout exactly like giscanner.pkgconfig
+    # does with its own subprocess calls.
+    output = proc.stdout.decode("utf-8", errors="replace")
+    converted = "\n".join(_convert_line(line) for line in output.splitlines())
+    if converted:
+        sys.stdout.write(converted + "\n")
+    return proc.returncode
+
+
+if __name__ == "__main__":
+    sys.exit(main())
+]])
+    string(REPLACE "@GI_REAL_PKG_CONFIG@" "${GI_PKG_CONFIG_EXE}" _gi_wrapper_py "${_gi_wrapper_py}")
+    string(REPLACE "@GI_MSYS2_ROOT@" "${_gi_msys2_root}" _gi_wrapper_py "${_gi_wrapper_py}")
+    file(WRITE "${CMAKE_BINARY_DIR}/pkg-config-msys2.py" "${_gi_wrapper_py}")
+    file(WRITE "${GI_PKG_CONFIG_WRAPPER}"
