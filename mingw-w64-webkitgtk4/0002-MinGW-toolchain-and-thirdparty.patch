diff --git a/Source/ThirdParty/skia/include/private/SkAttributes.h b/Source/ThirdParty/skia/include/private/SkAttributes.h
index 8499525..1aa3d41 100644
--- a/Source/ThirdParty/skia/include/private/SkAttributes.h
+++ b/Source/ThirdParty/skia/include/private/SkAttributes.h
@@ -24,7 +24,11 @@
  *     SK_ALWAYS_INLINE void someMethod() { ... }   // should always be inlined
  */
 #if !defined(SK_ALWAYS_INLINE)
-#  if defined(SK_BUILD_FOR_WIN)
+#  if defined(SK_BUILD_FOR_WIN) && defined(_MSC_VER)
+// Real MSVC-family compilers only. MinGW GCC and MinGW clang do not know
+// the __forceinline keyword, and GCC only survives it when a CRT header
+// (which defines the keyword as a macro) happens to be included first, so
+// fall back to the portable attribute form on those toolchains.
 #    define SK_ALWAYS_INLINE __forceinline
 #  else
 #    define SK_ALWAYS_INLINE SK_ATTRIBUTE(always_inline) inline
@@ -49,7 +53,21 @@
  * `B` is the (1 based) index of the first argument used by the format string.
  */
 #if !defined(SK_PRINTF_LIKE)
-#  define SK_PRINTF_LIKE(A, B) SK_ATTRIBUTE(format(printf, (A), (B)))
+#  if defined(__MINGW32__) && defined(__GNUC__) && !defined(__clang__) \
+      && (defined(_UCRT) || __USE_MINGW_ANSI_STDIO)
+   /* MinGW gcc checks the plain printf archetype against the MSVCRT
+      (ms_printf), which does not know C99 length modifiers such as %zu,
+      while the C runtime's printf family itself is declared with the
+      gnu_printf archetype (C99-conformant __mingw_printf is used at
+      runtime thanks to __USE_MINGW_ANSI_STDIO, and the UCRT supports
+      %zu natively). Mirror mingw-w64's own stdio.h mapping for
+      __MINGW_PRINTF_FORMAT so these attributes match the implementations
+      actually called; clang already checks the plain printf archetype as
+      C99, and MSVC/non-MinGW hosts keep the default. */
+#    define SK_PRINTF_LIKE(A, B) SK_ATTRIBUTE(format(__gnu_printf__, (A), (B)))
+#  else
+#    define SK_PRINTF_LIKE(A, B) SK_ATTRIBUTE(format(printf, (A), (B)))
+#  endif
 #endif
 
 /**
diff --git a/Source/ThirdParty/skia/src/core/SkRasterPipeline.h b/Source/ThirdParty/skia/src/core/SkRasterPipeline.h
