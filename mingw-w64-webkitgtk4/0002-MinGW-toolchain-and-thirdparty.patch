 Source/cmake/FindHarfBuzz.cmake               | 15 ++++
 2 files changed, 90 insertions(+)
 create mode 100644 Source/ThirdParty/mingw-compat/include/hb-icu.h

diff --git a/Source/ThirdParty/mingw-compat/include/hb-icu.h b/Source/ThirdParty/mingw-compat/include/hb-icu.h
new file mode 100644
index 0000000..84024a5
--- /dev/null
+++ b/Source/ThirdParty/mingw-compat/include/hb-icu.h
@@ -0,0 +1,75 @@
+/*
+ * Copyright (C) 2025 Taozuhong <taozuhong@hotmail.com>
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
