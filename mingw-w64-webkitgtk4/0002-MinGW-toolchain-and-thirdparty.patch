diff --git a/Source/ThirdParty/mingw-compat/include/libintl.h b/Source/ThirdParty/mingw-compat/include/libintl.h
new file mode 100644
index 0000000..879042e1
--- /dev/null
+++ b/Source/ThirdParty/mingw-compat/include/libintl.h
@@ -0,0 +1,54 @@
+/*
+ * MinGW compat shim: <libintl.h> wrapper that defuses the *printf-family
+ * redirection macros.
+ *
+ * gettext's libintl.h (>= 0.22, as shipped in MSYS2) installs object-like
+ * macros whenever it is included:
+ *
+ *     #define printf    libintl_printf   (expands to __printf__ on MinGW)
+ *     #define vprintf   libintl_vprintf
+ *     #define fprintf   libintl_fprintf
+ *     ... (sprintf, vsprintf, snprintf, vsnprintf, asprintf, vasprintf)
+ *
+ * In C++ those macros are applied blindly by the preprocessor, which knows
+ * nothing about member access: any use of the identifier "printf" after
+ * "out." (or "String::") is rewritten, so WebKit's WTF::PrintStream::printf
+ * / vprintf member calls (JSC ValueProfile.h, ScopedPrintStream.h, DataLog,
+ * ...) explode with "no member named '__printf__' in 'WTF::PrintStream'".
+ * It also silently renames member *declarations* that appear after the
+ * include, and clobbers the "printf" archetype name of
+ * __attribute__((format(printf, M, N))).
+ *
+ * gettext only installs the redirects so that printf()-family calls pick up
+ * its positional-format-aware implementations from the intl runtime. On
+ * MinGW -D__USE_MINGW_ANSI_STDIO=1 (always set by this package) the CRT
+ * printf family is already C99-conformant (the __mingw_* implementations),
+ * so dropping the macros routes the plain functions to the same CRT
+ * implementations the macros were ultimately wrapping and changes no
+ * observable behavior for the GTK port, which funnels user-visible,
+ * translatable strings through GLib's own g_strdup_printf()/g_string_*()
+ * helpers (compiled inside glib, unaffected by this header). The
+ * gettext/dgettext/... family, setlocale/newlocale and the "namespace std"
+ * using-declarations installed by libintl.h are all left untouched.
+ *
+ * include_next reaches the real <libintl.h> because mingw-compat/include is
+ * searched before the toolchain's default header directories.
+ */
+
+#ifndef MINGW_COMPAT_LIBINTL_H
+#define MINGW_COMPAT_LIBINTL_H
+
+#include_next <libintl.h>
+
+#undef printf
+#undef vprintf
+#undef fprintf
+#undef vfprintf
+#undef sprintf
+#undef vsprintf
+#undef snprintf
+#undef vsnprintf
+#undef asprintf
+#undef vasprintf
+
+#endif /* MINGW_COMPAT_LIBINTL_H */
