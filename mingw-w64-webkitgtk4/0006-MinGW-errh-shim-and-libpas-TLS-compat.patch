diff --git a/Source/ThirdParty/unifdef/unifdef.h b/Source/ThirdParty/unifdef/unifdef.h
index 2cd706d9..37a7f357 100644
--- a/Source/ThirdParty/unifdef/unifdef.h
+++ b/Source/ThirdParty/unifdef/unifdef.h
@@ -45,6 +45,11 @@ mktempmode(char *tmp, int mode)
 {
 	int fd = mkstemp(tmp);
 	if (fd < 0) return (NULL);
+#ifndef __MINGW32__
+	/* MinGW-w64 has no fchmod(), and the permission bits are
+	   meaningless for the temporary file that is renamed over the
+	   output file on Windows. */
 	fchmod(fd, mode & (S_IRWXU|S_IRWXG|S_IRWXO));
+#endif
 	return (fdopen(fd, "wb"));
 }
diff --git a/Source/bmalloc/libpas/src/libpas/pas_thread_local_cache.c b/Source/bmalloc/libpas/src/libpas/pas_thread_local_cache.c
index 0dd9fc6a..852bfb1f 100644
--- a/Source/bmalloc/libpas/src/libpas/pas_thread_local_cache.c
+++ b/Source/bmalloc/libpas/src/libpas/pas_thread_local_cache.c
@@ -62,9 +62,14 @@
 PAS_BEGIN_EXTERN_C;
 
 #if PAS_HAVE_THREAD_KEYWORD
-#if PAS_OS(WINDOWS)
+#if PAS_OS(WINDOWS) && !defined(__MINGW32__)
 __declspec(thread) void* pas_thread_local_cache_pointer = NULL;
 #else
+/* MSVC-style __declspec(thread) is not implemented by the MinGW-w64
+   toolchains: Clang on windows-gnu rejects it as an unknown attribute
+   (silently dropping thread-local storage), while __thread is supported
+   by both GCC and Clang there. Must match the declaration in
+   pas_thread_local_cache.h. */
 __thread void* pas_thread_local_cache_pointer = NULL;
 #endif
 #endif
