+ * DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY
+ * THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT
+ * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE
+ * OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+/*
+ * MinGW compat shim: the BSD <err.h> diagnostics API.
+ *
+ * The MinGW-w64 CRT does not provide <err.h> (err/errx/warn/warnx and
+ * their v-variants are BSD/glibc extensions), but vendored build tools
+ * such as ThirdParty/unifdef rely on it. This header implements the
+ * complete family as static inline functions on top of plain stdio,
+ * matching the BSD semantics:
+ *
+ *   warn(fmt, ...)   <message>: <strerror(errno)> + newline
+ *   warnx(fmt, ...)  <message> + newline
+ *   err(eval, ...)   warn() followed by exit(eval)
+ *   errx(eval, ...)  warnx() followed by exit(eval)
+ *
+ * errno is captured before any stdio call so that the vfprintf() inside
+ * the implementation cannot clobber the value being reported. If the
+ * format string is empty or NULL, the ": " separator is suppressed as
+ * on BSD. All functions are static inline, so no err* symbols are ever
+ * referenced or defined and the header can safely be included from any
+ * number of translation units (C or C++).
+ */
+
+#ifndef MINGW_COMPAT_ERR_H
+#define MINGW_COMPAT_ERR_H
+
+#include <errno.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The v-variants deliberately carry no format attribute, mirroring glibc, so
+   that passing a non-literal format with a va_list stays warning-free at
+   call sites. GCC's -Wmissing-format-attribute would still suggest adding
+   one because these functions call vfprintf(); suppress exactly that inside
+   the header. Clang neither implements the warning nor accepts the name,
+   so the pragma is kept out of Clang builds. */
+#if defined(__GNUC__) && !defined(__clang__)
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wsuggest-attribute=format"
+#endif
+
+static inline void vwarnx(const char* fmt, va_list ap)
+{
+    if (fmt && *fmt)
+        vfprintf(stderr, fmt, ap);
+    fputc('\n', stderr);
+}
+
+static inline void vwarn(const char* fmt, va_list ap)
+{
+    int saved_errno = errno;
+
+    if (fmt && *fmt) {
+        vfprintf(stderr, fmt, ap);
+        fputs(": ", stderr);
+    }
+    fputs(strerror(saved_errno), stderr);
+    fputc('\n', stderr);
+}
+
+#if defined(__GNUC__) && !defined(__clang__)
+#pragma GCC diagnostic pop
+#endif
+
+__attribute__((format(printf, 1, 2)))
+static inline void warnx(const char* fmt, ...)
+{
+    va_list ap;
+
+    va_start(ap, fmt);
+    vwarnx(fmt, ap);
+    va_end(ap);
+}
+
+__attribute__((format(printf, 1, 2)))
+static inline void warn(const char* fmt, ...)
+{
+    va_list ap;
+
+    va_start(ap, fmt);
+    vwarn(fmt, ap);
+    va_end(ap);
+}
+
+__attribute__((format(printf, 2, 3)))
+static inline void errx(int eval, const char* fmt, ...)
+{
+    va_list ap;
+
+    va_start(ap, fmt);
+    vwarnx(fmt, ap);
+    va_end(ap);
+    exit(eval);
+}
+
+__attribute__((format(printf, 2, 3)))
+static inline void err(int eval, const char* fmt, ...)
+{
+    va_list ap;
+
+    va_start(ap, fmt);
+    vwarn(fmt, ap);
+    va_end(ap);
+    exit(eval);
+}
+
+static inline void verrx(int eval, const char* fmt, va_list ap)
+{
+    vwarnx(fmt, ap);
+    exit(eval);
+}
+
+static inline void verr(int eval, const char* fmt, va_list ap)
+{
+    vwarn(fmt, ap);
+    exit(eval);
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* MINGW_COMPAT_ERR_H */
diff --git a/Source/bmalloc/libpas/src/libpas/pas_thread_local_cache.c b/Source/bmalloc/libpas/src/libpas/pas_thread_local_cache.c
index 0dd9fc6a..852bfb1f 100644
--- a/Source/bmalloc/libpas/src/libpas/pas_thread_local_cache.c
+++ b/Source/bmalloc/libpas/src/libpas/pas_thread_local_cache.c
@@ -62,9 +62,14 @@
 PAS_BEGIN_EXTERN_C;
 
 #if PAS_HAVE_THREAD_KEYWORD
-#if PAS_OS(WINDOWS)
+#if PAS_OS(WINDOWS) && !defined(__MINGW32__)
 __declspec(thread) void* pas_thread_local_cache_pointer = NULL;
 #else
+/* MSVC-style __declspec(thread) is not implemented by the MinGW-w64
+   toolchains: Clang on windows-gnu rejects it as an unknown attribute
+   (silently dropping thread-local storage), while __thread is supported
+   by both GCC and Clang there. Must match the declaration in
+   pas_thread_local_cache.h. */
 __thread void* pas_thread_local_cache_pointer = NULL;
 #endif
 #endif
