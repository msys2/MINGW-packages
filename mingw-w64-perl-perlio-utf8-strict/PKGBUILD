# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=PerlIO-utf8_strict
_realname="${_perlname,,}"
_realname="${_realname/_/-}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=0.010
pkgrel=1
pkgdesc="Fast and correct UTF-8 IO. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/PerlIO-utf8_strict"
msys2_repository_url="https://github.com/Leont/perlio-utf8_strict"
msys2_references=(
  'purl: pkg:cpan/LEONT/PerlIO-utf8_strict'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
groups=("${MINGW_PACKAGE_PREFIX}-perl-modules")
depends=("${MINGW_PACKAGE_PREFIX}-perl")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-make"
             "${MINGW_PACKAGE_PREFIX}-perl-test-exception")
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/L/LE/LEONT/${_perlname}-${pkgver}.tar.gz")
sha256sums=('bcd2848b72df290b5e984fae8b1a6ca96f6d072003cf222389a8c9e8e1c570cd')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
  install -Dm644 LICENSE "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE
}
