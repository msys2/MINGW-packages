# Maintainer: Cloud <kt286@qq.com>

_realname=dtk6widget
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=6.7.47
pkgrel=1
pkgdesc='DTK6 widget module'
arch=('any')
mingw_arch=('ucrt64')
url="https://github.com/linuxdeepin/dtkwidget"
license=('LGPL3')
depends=("${MINGW_PACKAGE_PREFIX}-gcc-libs"
         "${MINGW_PACKAGE_PREFIX}-qt6-base"
         "${MINGW_PACKAGE_PREFIX}-qt6-svg"
         "${MINGW_PACKAGE_PREFIX}-dtk6core"
         "${MINGW_PACKAGE_PREFIX}-dtk6gui")
makedepends=("${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-gcc"
             "${MINGW_PACKAGE_PREFIX}-qt6-tools")

source=("dtkwidget-${pkgver}.tar.gz::https://github.com/linuxdeepin/dtkwidget/archive/refs/tags/${pkgver}.tar.gz")
sha512sums=('e76c2aaa32c224ba6473fa23b50b087a026ef113db4f1f9600ac556c401c025a2895ec947e1cd252de03e218288eea959d4ee591d02b6c41f9a554589485cec6')

build() {
  mkdir -p "${srcdir}"/dtkwidget-${pkgver}/build-${MSYSTEM}
  cd "${srcdir}"/dtkwidget-${pkgver}/build-${MSYSTEM}

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    ${MINGW_PREFIX}/bin/cmake .. -GNinja \
      -DCMAKE_INSTALL_PREFIX=${MINGW_PREFIX} \
      -DCMAKE_PREFIX_PATH=${MINGW_PREFIX} \
      -DDTK5=OFF \
      -DBUILD_EXAMPLES=OFF \
      -DBUILD_PLUGINS=OFF \
      -DBUILD_DOCS=OFF
  ${MINGW_PREFIX}/bin/ninja
}

package() {
  cd "${srcdir}"/dtkwidget-${pkgver}/build-${MSYSTEM}
  DESTDIR="${pkgdir}" ${MINGW_PREFIX}/bin/ninja install
}
