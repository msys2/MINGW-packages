# Maintainer: florianpeter874-wq

_architecture=MINGW
pkgname=mingw-w64-shortwa
pkgver=1.0.0
pkgrel=1
pkgdesc="Ultra-lightweight single-header WinAPI wrapper for C with dark mode and input polling (ShortWinAPI)"
arch=('any')
url="https://github.com/florianpeter874-wq/ShortWA"
license=('MIT')
depends=("${MINGW_PACKAGE_PREFIX}-gcc")
source=("https://github.com{pkgver}.tar.gz")
sha256sums=('b22e40157cd6a3c7be88788515edc1fe3939c74bd6cf2def9529acf82a9bac70')

package() {
  mkdir -p "${pkgdir}${MINGW_PREFIX}/include"
  cp "${srcdir}/ShortWA-${pkgver}/ShortWA.h" "${pkgdir}${MINGW_PREFIX}/include/ShortWA.h"
}
