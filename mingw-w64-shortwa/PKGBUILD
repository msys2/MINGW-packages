# PKGBUILD példa a ShortWA-hoz
pkgname=mingw-w64-x86_64-shortwa
pkgver=1.0.0
pkgrel=1
pkgdesc="Ultrakönnyű single-header WinAPI wrapper C-hez sötét móddal és egyszerű inputkezeléssel"
arch=('any')
url="https://github.com"
license=('MIT') # Vagy amilyen licencet szeretnél
source=("https://github.com/florianpeter874-wq/ShortWA/archive/refs/tags/v1.0.0.tar.gz")
sha256sums=('b22e40157cd6a3c7be88788515edc1fe3939c74bd6cf2def9529acf82a9bac70')

package() {
  # Létrehozza a hivatalos include mappát a telepítéskor
  mkdir -p "${pkgdir}/mingw64/include"
  # Bemásolja a ShortWA.h fájlt a stdio.h mellé
  cp "${srcdir}/ShortWA-${pkgver}/ShortWA.h" "${pkgdir}/mingw64/include/ShortWA.h"
}
