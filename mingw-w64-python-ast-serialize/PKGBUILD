_realname=ast-serialize
_pyname="${_realname//-/_}"
pkgbase="mingw-w64-python-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.13.1
pkgrel=1
pkgdesc="Python bindings for mypy AST serialization (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://github.com/mypyc/ast_serialize'
msys2_repository_url='https://github.com/mypyc/ast_serialize'
msys2_references=(
  'archlinux: python-ast-serialize'
  'purl: pkg:pypi/ast-serialize'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-maturin"
  "${MINGW_PACKAGE_PREFIX}-rust"
)
options=('!strip')
source=("https://pypi.org/packages/source/${_pyname::1}/${_pyname}/${_pyname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
  cp -r "${_pyname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "build-${MSYSTEM}"

  export PYO3_USE_RAW_DYLIB=0
  export _PYTHON_HOST_PLATFORM=$(python -c "import sysconfig, sys; sys.stdout.write(sysconfig.get_platform())")

  maturin build --release --strip --frozen --target "${RUST_CHOST}"
}

check() {
  cd "build-${MSYSTEM}"

  python -m installer --prefix="${srcdir}/test-prefix" target/wheels/*.whl

  local _site_packages=$(python -c "import site; print(site.getsitepackages(['${srcdir}/test-prefix'])[0])")
  PYTHONPATH="${_site_packages}" python test_ast_serialize.py || warning "Tests failed"
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" \
    --destdir="${pkgdir}" target/wheels/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"

  if [[ -f "crates/LICENSE" ]]; then
    install -Dm644 crates/LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE-ruff"
  fi
}
