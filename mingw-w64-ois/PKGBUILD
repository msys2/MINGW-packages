# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_realname=ois
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.6.0
pkgrel=1
pkgdesc="Object Oriented Input System (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://sourceforge.net/projects/wgois/"
msys2_repository_url="https://github.com/wgois/OIS"
license=('spdx:Zlib')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=(https://github.com/wgois/OIS/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz
        001-mingw-build.patch)
sha256sums=('e3f635286c0992258d5ad85d14b90c85915794b512265bd1d67455c386fc9e5a'
            'f22329f36f8c07cb18cfa3760f1638818d186de70ff03abda61f43ca9c82052a')

prepare() {
  cd "${srcdir}"/OIS-${pkgver}

  patch -p1 -i "${srcdir}"/001-mingw-build.patch
}

build() {
  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  msg "Build shared version..."

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX=${MINGW_PREFIX} \
      -DOIS_BUILD_SHARED_LIBS=ON \
      -DOIS_BUILD_DEMOS=ON \
      "${_extra_config[@]}" \
      -S OIS-${pkgver} \
      -B build-shared-${MSYSTEM}

  cmake --build build-shared-${MSYSTEM}

  msg "Build static version..."

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX=${MINGW_PREFIX} \
      -DOIS_BUILD_SHARED_LIBS=OFF \
      -DOIS_BUILD_DEMOS=ON \
      "${_extra_config[@]}" \
      -S OIS-${pkgver} \
      -B build-static-${MSYSTEM}

  cmake --build build-static-${MSYSTEM}
}

package() {
  DESTDIR="${pkgdir}" cmake --install build-static-${MSYSTEM}
  DESTDIR="${pkgdir}" cmake --install build-shared-${MSYSTEM}

  install -Dm644 "${srcdir}"/OIS-${pkgver}/LICENSE.md \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.md
}
