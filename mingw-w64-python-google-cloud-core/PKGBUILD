# Maintainer: Sarah Ottinger <schalaalexiazeal@gmail.com>

_realname='google-cloud-core'
_pyname="${_realname//-/_}"
pkgbase="mingw-w64-python-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-python-${_realname}"
pkgver=2.8.0
pkgrel=1
pkgdesc='Google Cloud API client core library (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/googleapis/google-cloud-python/tree/main/packages/google-cloud-core'
msys2_repository_url='https://github.com/googleapis/google-cloud-python/tree/main/packages/google-cloud-core'
msys2_changelog_url='https://github.com/googleapis/google-cloud-python/blob/main/packages/google-cloud-core/CHANGELOG.md'
msys2_references=(
  'anitya: 52445'
  'aur: python-google-cloud-core'
  'purl: pkg:pypi/google-cloud-core'
)
license=('spdx:Apache-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-google-api-core"
  "${MINGW_PACKAGE_PREFIX}-python-google-auth"
  "${MINGW_PACKAGE_PREFIX}-python-googleapis-common-protos"
  "${MINGW_PACKAGE_PREFIX}-python-pytz"
  "${MINGW_PACKAGE_PREFIX}-python-requests"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
source=("https://pypi.org/packages/source/${_pyname::1}/${_realname}/${_pyname}-${pkgver}.tar.gz")
sha256sums=('365f8e4518ae81c8101b8dea5fc1c32a960badedb8b511f19db2843cbbd285d2')

build() {
  cp -r "${_pyname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
