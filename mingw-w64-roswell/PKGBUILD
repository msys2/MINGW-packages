# Maintainer: SANO Masatoshi <snmsts@gmail.com>

_realname=roswell
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=26.10.118
pkgrel=1
pkgdesc="Lisp installer and launcher (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/roswell/roswell"
msys2_repository_url='https://github.com/roswell/roswell'
license=("spdx:MIT")
depends=()
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-cc"
)
optdepends=()
source=("https://github.com/roswell/roswell/archive/v$pkgver.tar.gz")
sha256sums=('19d61198ec747bd8ee0ab0764547d95e74907ef8f73cc4a4e72c9277d22b53e3')

build() {
  cd "${_realname}-${pkgver}"

  ./bootstrap

  ./configure \
    --prefix="${MINGW_PREFIX}" \
    --build="${MINGW_CHOST}" \
    --host="${MINGW_CHOST}" \
    --target="${MINGW_CHOST}"

  make
}

package() {
  cd "${_realname}-${pkgver}"

  make install DESTDIR="${pkgdir}"

  install -Dm644 COPYING "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
