# Maintainer: Andres Pastrana <gempba@outlook.com>

_realname=gempba
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}"
         "${MINGW_PACKAGE_PREFIX}-${_realname}-mpi")
pkgver=5.0.0
pkgrel=1
_bs_thread_pool_ver=5.1.0.3
_cpm_ver=0.42.3
pkgdesc='Hybrid parallel C++23 framework for branching algorithms (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64')
url='https://github.com/rapastranac/gempba'
msys2_repository_url='https://github.com/rapastranac/gempba'
msys2_changelog_url='https://github.com/rapastranac/gempba/releases'
msys2_issue_tracker_url='https://github.com/rapastranac/gempba/issues'
msys2_references=(
  'purl: pkg:github/rapastranac/gempba'
)
license=('spdx:MIT')
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-fmt"
  "${MINGW_PACKAGE_PREFIX}-spdlog"
  "${MINGW_PACKAGE_PREFIX}-hwloc"
)
source=("https://github.com/rapastranac/gempba/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
        "https://github.com/rapastranac/thread-pool/archive/v${_bs_thread_pool_ver}/thread-pool-${_bs_thread_pool_ver}.tar.gz"
        "CPM-${_cpm_ver}.cmake::https://github.com/cpm-cmake/CPM.cmake/releases/download/v${_cpm_ver}/CPM.cmake")
sha256sums=('30ee6fad22a8e25a116c1e294fc4ddb4d1aea314e8ec0ee5a43f19bfa4b45450'
            '136e7ad700a1c29a2e697b5dd1513c57642d4e674f611e42c2ce0670a72c9230'
            'a609e875fd532b067174250f6abbc3dac22fe2d64869783fb1e80bda1625c844')

build() {
  # gempba's external/CMakeLists.txt downloads CPM.cmake unless the build tree already has it.
  install -Dm644 "CPM-${_cpm_ver}.cmake" "build-${MSYSTEM}/cmake/CPM.cmake"

  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake -Wno-dev \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${_extra_config[@]}" \
      -DCMAKE_DLL_NAME_WITH_SOVERSION=ON \
      -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
      -DFETCHCONTENT_SOURCE_DIR_BS_THREAD_POOL="${srcdir}/thread-pool-${_bs_thread_pool_ver}" \
      -DGEMPBA_BUILD_TESTS=OFF \
      -DGEMPBA_BUILD_MPI=OFF \
      -DGEMPBA_HWLOC=ON \
      -S "${_realname}-${pkgver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package_gempba() {
  depends=(
    "${MINGW_PACKAGE_PREFIX}-cc-libs"
    "${MINGW_PACKAGE_PREFIX}-hwloc"
  )

  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}" --component core

  install -Dm644 "${_realname}-${pkgver}/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
  install -Dm644 "thread-pool-${_bs_thread_pool_ver}/LICENSE.txt" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.BS_thread_pool"
}

package_gempba-mpi() {
  pkgdesc='MPI component of gempba, installed as source and compiled against MS-MPI in the consuming build (mingw-w64)'
  depends=(
    "${MINGW_PACKAGE_PREFIX}-${_realname}=${pkgver}-${pkgrel}"
    "${MINGW_PACKAGE_PREFIX}-msmpi"
  )

  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}" --component mpi

  install -Dm644 "${_realname}-${pkgver}/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}-mpi/LICENSE"
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
