
_realname=letos
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}"
         "${MINGW_PACKAGE_PREFIX}-${_realname}-plugins")
pkgver=4.0.4
pkgrel=1
pkgdesc="A free, open source, multi-platform SQLite database manager. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://letos.org/"
msys2_repository_url="https://github.com/pawelsalawa/letos"
msys2_references=(
  'aur: letos'
  'gentoo: '
)
license=("spdx:GPL-3.0-or-later AND LicenseRef-custom")
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs"
         "${MINGW_PACKAGE_PREFIX}-qt6-base"
         "${MINGW_PACKAGE_PREFIX}-qt6-declarative"
         "${MINGW_PACKAGE_PREFIX}-qt6-tools"
         "${MINGW_PACKAGE_PREFIX}-sqlite3")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-pkgconf"
             "${MINGW_PACKAGE_PREFIX}-python"
             "${MINGW_PACKAGE_PREFIX}-qt6-svg"
             "${MINGW_PACKAGE_PREFIX}-tcl")
source=("https://github.com/pawelsalawa/letos/archive/${pkgver}/${_realname}-${pkgver}.tar.gz"
        "001-fix-build-plugins.patch")
sha256sums=('3c367eb895fa0c97ccab2766f037fcfff55cfb352cc5a82a16ded2434650aca6'
            '494bf39bc1d46c97e5b3c9cdd1940cb8334c0327a2f208e07d6857369936a355')

apply_patch_with_msg() {
  for _patch in "$@"
  do
    msg2 "Applying ${_patch}"
    patch -Nbp1 --binary -i "${srcdir}/${_patch}"
  done
}

prepare() {
  cd letos-${pkgver}
  apply_patch_with_msg \
    001-fix-build-plugins.patch
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
  cmake \
    -GNinja \
    -DCMAKE_INSTALL_PREFIX=${MINGW_PREFIX} \
    "${extra_config[@]}" \
    -DWITH_UNIX_FAV=ON \
    -DBUILD_TESTING=OFF \
    -S letos-${pkgver}/letos \
    -B build-${MSYSTEM}

  ${MINGW_PREFIX}/bin/cmake --build build-${MSYSTEM}

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
  cmake \
    -GNinja \
    -DCMAKE_INSTALL_PREFIX=${MINGW_PREFIX} \
    "${extra_config[@]}" \
    -DWITH_UNIX_FAV=ON \
    -DWITH_ALL_PLUGINS=ON \
    -DWITH_DYNAMIC_PYTHON=ON \
    -DPython_FIND_REGISTRY=NEVER \
    -DLETOS_BUILD_DIR="${srcdir}"/build-${MSYSTEM} \
    -S letos-${pkgver}/Plugins \
    -B build-${MSYSTEM}-plugins

  ${MINGW_PREFIX}/bin/cmake --build build-${MSYSTEM}-plugins
}

package_letos() {
  DESTDIR="${pkgdir}" ${MINGW_PREFIX}/bin/cmake --install build-${MSYSTEM}

  install -Dm644 "${srcdir}"/letos-${pkgver}/LICENSE \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE
}

package_letos-plugins() {
  pkgdesc='Official plugins for letos (mingw-w64)'
  depends=("${MINGW_PACKAGE_PREFIX}-${_realname}"
           "${MINGW_PACKAGE_PREFIX}-cc-libs"
           "${MINGW_PACKAGE_PREFIX}-python"
           "${MINGW_PACKAGE_PREFIX}-qt6-base"
           "${MINGW_PACKAGE_PREFIX}-tcl")

  DESTDIR="${pkgdir}" ${MINGW_PREFIX}/bin/cmake --install build-${MSYSTEM}-plugins
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
