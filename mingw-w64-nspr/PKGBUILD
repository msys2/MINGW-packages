_realname=nspr
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=4.41
pkgrel=1
pkgdesc="Netscape Portable Runtime (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://developer.mozilla.org/en-US/docs/Mozilla/Projects/NSPR"
msys2_references=(
  'cpe: cpe:/a:mozilla:netscape_portable_runtime'
)
license=('spdx:MPL-2.0')
makedepends=(
  'nsinstall'
  'zip'
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-cc"
)
options=('!emptydirs')
source=(
  "https://ftp.mozilla.org/pub/mozilla.org/nspr/releases/v${pkgver}/src/${_realname}-${pkgver}.tar.gz"
  0001-fix-integer-casting.patch
  0002-fix-autotools.patch
  0003-mingw.patch
  0004-static-build.patch
  0005-fix-x64.patch
)
sha256sums=('c562b8ddfe93704b7dc077be013f01448fdc6c124b1821c0f10471a71cb2e9e6'
            '23b01b1d3f0c46b232ac3996b1990587a83fe567d6db46771f79d0e034ecedd4'
            '5fdb0e803c7651f17783d9e4c46580eeb3359defd3b11a094fd512dd770f0a19'
            'b68ccd918d0a8a4f28cc09c9e63cb5772e22af69f55576340315a933c236da94'
            '7f885bf192acde4c28cce46c47655e927e190beffb57266098980b93672a42c8'
            'd220a83c37596aa8bc96fe448e106f8a0c03b5b574e3a18175a5fbd5b2fc8eff')

apply_patch_with_msg() {
  for _patch in "$@"; do
    msg2 "Applying ${_patch}"
    patch -Nbp1 -i "${srcdir}/${_patch}"
  done
}

prepare() {
  mv "${srcdir}"/${_realname}-${pkgver}/nspr/{.,}* "${srcdir}"/${_realname}-${pkgver}
  rmdir "${srcdir}"/${_realname}-${pkgver}/nspr
  cd "${srcdir}"/${_realname}-${pkgver}

  apply_patch_with_msg \
    0001-fix-integer-casting.patch \
    0002-fix-autotools.patch \
    0003-mingw.patch \
    0004-static-build.patch \
    0005-fix-x64.patch
}

build() {
  mkdir -p "${srcdir}/build-${MSYSTEM}" && cd "${srcdir}/build-${MSYSTEM}"

  CFLAGS+=" -std=gnu17 -Wno-incompatible-pointer-types"
  "${srcdir}/${_realname}-${pkgver}/configure" \
    --prefix=${MINGW_PREFIX} \
    --build=${MINGW_CHOST} \
    --host=${MINGW_CHOST} \
    --target=${MINGW_CHOST} \
    --includedir=${MINGW_PREFIX}/include/nspr \
    --enable-optimize \
    --disable-debug \
    --enable-64bit

  make
}

package() {
  cd "${srcdir}/build-${MSYSTEM}"
  make DESTDIR="${pkgdir}" install

  mv "${pkgdir}"${MINGW_PREFIX}/lib/*.dll "${pkgdir}"${MINGW_PREFIX}/bin/

  ln -s nspr.pc "${pkgdir}${MINGW_PREFIX}/lib/pkgconfig/mozilla-nspr.pc"
  rm -r "${pkgdir}"${MINGW_PREFIX}/bin/{compile-et.pl,prerr.properties} \
    "${pkgdir}"${MINGW_PREFIX}/include/nspr/md

  install -Dm644 "${srcdir}"/${_realname}-${pkgver}/LICENSE \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
