# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=Win32-ShellQuote
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=0.003001
pkgrel=2
pkgdesc="Quote argument lists for Win32. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/Win32-ShellQuote"
msys2_repository_url="https://github.com/haarg/Win32-ShellQuote"
msys2_references=(
  'purl: pkg:cpan/HAARG/Win32-ShellQuote'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-perl")
makedepends=("${MINGW_PACKAGE_PREFIX}-make")
source=("https://cpan.metacpan.org/authors/id/H/HA/HAARG/${_perlname}-${pkgver}.tar.gz")
sha256sums=('aa74b0e3dc2d41cd63f62f853e521ffd76b8d823479a2619e22edb4049b4c0dc')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
  install -Dm644 LICENSE "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE
}
