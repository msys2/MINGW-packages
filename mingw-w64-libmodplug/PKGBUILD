# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_realname=libmodplug
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.8.9.2
pkgrel=1
pkgdesc="A MOD playing library (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://modplug-xmms.sourceforge.io/"
msys2_references=(
  'archlinux: libmodplug'
  'aur: libopenmpt-modplug' # keep this compat project for simplicity
  'cpe: cpe:/a:konstanty_bialkowski:libmodplug'
  'gentoo: media-libs/libmodplug'
)
license=("PublicDomain")
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-autotools"
)
conflicts=("${MINGW_PACKAGE_PREFIX}-libopenmpt-modplug")
source=(
  "https://downloads.sourceforge.net/modplug-xmms/${_realname}-${pkgver}.tar.gz"
)
sha256sums=('e4d9cb46da78a639d6eadb4ff3ab955f68c3099579b5310af64b37091e28957e')

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"

  # autoreconf to get updated libtool files, for clang support
  autoreconf -fiv
}

build() {
  mkdir -p "${srcdir}/build-${MSYSTEM}" && cd "${srcdir}/build-${MSYSTEM}"

  CXXFLAGS+=" -std=gnu++14" \
    "../${_realname}-${pkgver}/configure" \
    --prefix=${MINGW_PREFIX} \
    --enable-shared \
    --enable-static

  make
}

package() {
  cd "${srcdir}/build-${MSYSTEM}"

  make DESTDIR="${pkgdir}" install

  # Install license
  install -Dm644 "${srcdir}"/${_realname}-${pkgver}/COPYING \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE
}
