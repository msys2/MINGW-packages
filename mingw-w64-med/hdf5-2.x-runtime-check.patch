with H5F_LIBVER_V114 bounds, so the HDF5 minor version does not matter.

--- a/src/ci/MEDfileCompatibility.c
+++ b/src/ci/MEDfileCompatibility.c
@@ -73,7 +73,8 @@ MEDfileCompatibility(const char* const filename,
   /* ISCRUTE(HDF_VERSION_NUM_REF);*/
   if ( (_hversionMMR >= HDF_VERSION_NUM_REF) &&
        (_hmajeur == HDF_VERSION_MAJOR_REF  )  && 
-       (_hmineur == HDF_VERSION_MINOR_REF  ) ) *hdfok = MED_TRUE;
+       ( (_hmineur == HDF_VERSION_MINOR_REF) ||
+         (HDF_VERSION_MAJOR_REF >= 2) ) ) *hdfok = MED_TRUE;
 
