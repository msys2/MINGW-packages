+static char *
+quote_arg_win32 (const char *arg)
+{
+	if (arg == NULL)
+		return NULL;
+
+	if (arg[0] == '\0')
+		return strdup ("\"\"");
+
+	bool needs_quotes = false;
+	for (const char *p = arg; *p; p++) {
+		if (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\v' || *p == '\"') {
+			needs_quotes = true;
+			break;
+		}
+	}
+
+	if (!needs_quotes)
+		return strdup (arg);
+
+	size_t len = strlen (arg);
+	char *buf = malloc (len * 2 + 3);
+	if (!buf)
+		return NULL;
+
+	char *dst = buf;
+	*dst++ = '\"';
+
+	int num_backslashes = 0;
+	for (size_t i = 0; i < len; i++) {
+		char c = arg[i];
+		if (c == '\\') {
+			num_backslashes++;
+		} else if (c == '\"') {
+			for (int j = 0; j < num_backslashes * 2 + 1; j++)
+				*dst++ = '\\';
+			num_backslashes = 0;
+			*dst++ = '\"';
+		} else {
+			for (int j = 0; j < num_backslashes; j++)
+				*dst++ = '\\';
+			num_backslashes = 0;
+			*dst++ = c;
+		}
+	}
+
+	for (int j = 0; j < num_backslashes * 2; j++)
+		*dst++ = '\\';
+
+	*dst++ = '\"';
+	*dst = '\0';
+
+	return buf;
+}
+
+static intptr_t
+spawnv_quoted_win32 (const char *cmdname,
+                     char * const *argv)
+{
+	int argc = 0;
+	while (argv[argc] != NULL)
+		argc++;
+
+	char **spawn_args = calloc (argc + 1, sizeof (char *));
+	if (spawn_args == NULL) {
+		errno = ENOMEM;
+		return -1;
+	}
+
+	for (int i = 0; i < argc; i++) {
+		spawn_args[i] = quote_arg_win32 (argv[i]);
+		if (spawn_args[i] == NULL) {
+			for (int j = 0; j < i; j++)
+				free (spawn_args[j]);
+			free (spawn_args);
+			errno = ENOMEM;
+			return -1;
+		}
+	}
+	spawn_args[argc] = NULL;
+
+	intptr_t code = _spawnv (_P_WAIT, cmdname, (const char * const *)spawn_args);
+
+	for (int i = 0; i < argc; i++)
+		free (spawn_args[i]);
+	free (spawn_args);
+
+	return code;
+}
+#endif
