# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=Alien-Build
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=2.84
pkgrel=1
pkgdesc="Build external dependencies for use in CPAN. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/Alien-Build"
msys2_repository_url="https://github.com/PerlAlien/Alien-Build"
msys2_references=(
  'purl: pkg:cpan/PLICEASE/Alien-Build'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
groups=("${MINGW_PACKAGE_PREFIX}-perl-modules")
depends=("${MINGW_PACKAGE_PREFIX}-perl"
         "${MINGW_PACKAGE_PREFIX}-perl-capture-tiny"
         "${MINGW_PACKAGE_PREFIX}-perl-ffi-checklib"
         "${MINGW_PACKAGE_PREFIX}-perl-file-chdir"
         "${MINGW_PACKAGE_PREFIX}-perl-file-which"
         "${MINGW_PACKAGE_PREFIX}-perl-path-tiny")
makedepends=("${MINGW_PACKAGE_PREFIX}-make")
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/P/PL/PLICEASE/${_perlname}-${pkgver}.tar.gz")
sha256sums=('8e891fd3acbac39dd8fdc01376b9abff931e625be41e0910ca30ad59363b4477')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
  install -Dm644 LICENSE "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE
}
