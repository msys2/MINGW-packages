_realname=zlib
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}"
         "${MINGW_PACKAGE_PREFIX}-minizip")
pkgver=1.4
pkgrel=2
arch=('any')
mingw_arch=('mingw32' 'mingw64' 'ucrt64' 'clang64' 'clangarm64')
license=('spdx:Zlib')
url="https://www.zlib.net/"
msys2_repository_url="https://github.com/madler/zlib"
msys2_references=(
  "cpe: cpe:/a:gnu:zlib"
  "cpe: cpe:/a:zlib:zlib"
)
msys2_ignore_vulnerabilities=(
  "CVE-2026-22184" # only affects demo program untgz which we don't ship
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-bzip2"
)
source=("https://github.com/madler/zlib/releases/download/v${pkgver}/zlib-${pkgver}.tar.xz"{,.asc}
        01-no-extra-suffix-for-static-library.patch
        02-no-pdb-for-mingw.patch
        03-fix-output-name-for-zlib1.patch
        04-no-minizip-headers-in-zlib1.patch
        08-Add-bzip2-library-to-pkg-config-file.patch)
sha256sums=('4f11c512053d7bab8d9e9b89bde3575add3e4c50a383b42ef6cb837035fc5a7c'
            'SKIP'
            'c3d9dd52828a458b7558712dda57b4acf1ddfe9944d6c1a2675e1471e661975d'
            '3b969ab5377633fc9e66c1ae862b2d5bc37f954a2bfe56d752b280ea13e3bec2'
            'aa541a5f4c50c5355209f7f94087e5970ebb8c34100b5ad5adba690bc100c992'
            '39e63187a6bd6108ec926e7148d5a43e67ed8b8beb4e1c82e8408248c0d1f0c3'
            '0da526061789a45b53ca16405dcb9333b235d25b8bee012263ac9683559e0536')
validpgpkeys=('5ED46A6721D365587791E2AA783FCD8E58BCAFBA')

apply_patch_with_msg() {
  for _patch in "$@"
  do
    msg2 "Applying ${_patch}"
    patch -Nbp1 -i "${srcdir}/${_patch}"
  done
}

prepare() {
  cd "${srcdir}"/${_realname}-${pkgver}
  apply_patch_with_msg \
    01-no-extra-suffix-for-static-library.patch \
    02-no-pdb-for-mingw.patch \
    03-fix-output-name-for-zlib1.patch \
    08-Add-bzip2-library-to-pkg-config-file.patch

  apply_patch_with_msg 04-no-minizip-headers-in-zlib1.patch
}

build() {
  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake -Wno-author \
    -GNinja \
    -DCMAKE_INSTALL_PREFIX=${MINGW_PREFIX} \
    -DCMAKE_DLL_NAME_WITH_SOVERSION=ON \
    -DZLIB_BUILD_ZLIB1_DLL=ON \
    -DZLIB1_DLL_ENABLE_BZIP2=OFF \
    -DZLIB_BUILD_TESTING=OFF \
    -DZLIB_BUILD_MINIZIP=ON \
    -DMINIZIP_ENABLE_BZIP2=ON \
    -DMINIZIP_BUILD_TESTING=OFF \
    "${_extra_config[@]}" \
    -S ${_realname}-${pkgver} \
    -B build-${MSYSTEM}

  cmake --build build-${MSYSTEM}
}

check() {
  cmake -DZLIB_BUILD_TESTING=ON -DMINIZIP_BUILD_TESTING=ON -S${_realname}-${pkgver} -Bbuild-${MSYSTEM}
  cmake --build build-${MSYSTEM}
  ctest --test-dir build-${MSYSTEM} --output-on-failure --parallel
}

package_zlib() {
  pkgdesc="Compression library implementing the deflate compression method found in gzip and PKZIP (mingw-w64)"
  if [[ ${MSYSTEM} == MINGW32 ]]; then
    depends=("${MINGW_PACKAGE_PREFIX}-libgcc")
  fi

  # disable installing minizip
  sed -i.orig '/contrib\/minizip\/cmake_install.cmake/d' build-${MSYSTEM}/contrib/cmake_install.cmake

  DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM}

  install -Dm644 "${srcdir}"/${_realname}-${pkgver}/LICENSE \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE
}

package_minizip() {
  pkgdesc="Mini zip and unzip based on zlib (mingw-w64)"
  depends=("${MINGW_PACKAGE_PREFIX}-zlib"
           "${MINGW_PACKAGE_PREFIX}-bzip2")

  DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM}/contrib/minizip

  # Remove static-linked binaries
  rm -f "${pkgdir}"${MINGW_PREFIX}/bin/*static.exe

  install -Dm644 "${srcdir}"/${_realname}-${pkgver}/LICENSE \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/minizip/LICENSE
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
