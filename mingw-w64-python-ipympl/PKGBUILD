# Maintainer: Konstantin Podsvirov <konstantin@podsvirov.su>

_realname='ipympl'
pkgbase="mingw-w64-python-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-python-${_realname}"
pkgver=0.10.0
pkgrel=2
pkgdesc='Matplotlib Jupyter Integration (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://matplotlib.org/ipympl/'
msys2_repository_url='https://github.com/matplotlib/ipympl'
msys2_references=(
  'anitya: 57282'
  'archlinux: python-ipympl'
  'purl: pkg:pypi/ipympl'
)
license=('spdx:BSD-3-Clause')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-ipython_genutils"
  "${MINGW_PACKAGE_PREFIX}-python-ipywidgets"
  "${MINGW_PACKAGE_PREFIX}-python-matplotlib"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-nodejs"
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-hatch-jupyter-builder"
  "${MINGW_PACKAGE_PREFIX}-python-hatchling"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-jupyter-builder"
  "${MINGW_PACKAGE_PREFIX}-python-jupyterlab" # newer extensions should not depend on jupyterlab https://github.com/jupyterlab/jupyter-builder/issues/81
  "${MINGW_PACKAGE_PREFIX}-yarn"
)
source=(
  "https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz"
)
sha256sums=('eda69602a010af2a42e8ebd069b0ee0dbe8df7fc69d7c1e8b99fece0a2fe613f')

build() {
  cp -r "${_realname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=;--install-scripts=;--install-platlib=" \
    python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
