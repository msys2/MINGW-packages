# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=Text-BibTeX
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=0.91
pkgrel=1
pkgdesc="Interface to read and parse BibTeX files. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/Text-BibTeX"
msys2_repository_url="https://github.com/ambs/Text-BibTeX"
msys2_references=(
  'purl: pkg:cpan/AMBS/Text-BibTeX'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
groups=("${MINGW_PACKAGE_PREFIX}-perl-modules")
depends=("${MINGW_PACKAGE_PREFIX}-perl")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-perl-config-autoconf"
             "${MINGW_PACKAGE_PREFIX}-perl-extutils-libbuilder"
             "${MINGW_PACKAGE_PREFIX}-perl-module-build")
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/A/AM/AMBS/${_perlname}-${pkgver}.tar.gz"
        "001-fix-build-with-clang.patch")
sha256sums=('3f0113cf8fe71dc7484636dc8e2a581637ecbcc82d0be29bbd46d0bf3f8cdb37'
            'cdb8931ccf087e76116647addba6527bf23e437eb72744514378c7266631e297')

prepare() {
  cd ${_perlname}-${pkgver}
  patch -p1 -i "${srcdir}"/001-fix-build-with-clang.patch
}

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  PERL_MM_USE_DEFAULT=1 perl Build.PL
  ./Build
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="--prefix=;usrlib=" \
  ./Build install --destdir="${pkgdir}" --prefix=${MINGW_PREFIX} --install_path usrlib=${MINGW_PREFIX}/bin
}
