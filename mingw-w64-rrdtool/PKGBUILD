# Maintainer: Jeroen Ooms <jeroen@berkeley.edu>

_realname=rrdtool
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.11.0
pkgrel=1
pkgdesc="Round Robin Database (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://oss.oetiker.ch/rrdtool/'
msys2_repository_url='https://github.com/oetiker/rrdtool-1.x'
msys2_references=(
  'anitya: 4214'
  'archlinux: rrdtool'
  'cpe: cpe:/a:rrdtool_project:rrdtool'
  'gentoo: net-analyzer/rrdtool'
)
license=('GPL2')
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-cc"
)
depends=(
  "${MINGW_PACKAGE_PREFIX}-glib2"
  "${MINGW_PACKAGE_PREFIX}-libxml2"
  "${MINGW_PACKAGE_PREFIX}-pango"
)
source=("https://github.com/oetiker/rrdtool-1.x/releases/download/v${pkgver}/${_realname}-${pkgver}.tar.gz")
sha256sums=('24c345b5c077c1b2b2fcbc1a364f1da051650fb6743ad5213096adc04c862ed4')

prepare() {
  cp -Rf "${srcdir}/${_realname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  ./bootstrap
}

build() {
  cd "build-${MSYSTEM}"

  # Do not add --host and --target options, otherwise
  # executables are installed with target triplet prefixes
  ./configure \
    --prefix="${MINGW_PREFIX}" \
    --build="${MINGW_CHOST}" \
    --enable-static \
    --disable-shared \
    --disable-tcl \
    --disable-python \
    --disable-docs \
    --disable-nls \
    --disable-perl \
    --disable-mmap \
    --disable-ruby \
    --disable-rrdcached

  make
}

package() {
  cd "build-${MSYSTEM}"

  make install DESTDIR="${pkgdir}"

  cd "${_realname}-${pkgver}"

  install -Dm644 COPYRIGHT -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
