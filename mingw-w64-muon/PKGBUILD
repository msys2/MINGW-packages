# Maintainer: Maksim Bondarenkov <maksapple2306@gmail.com>

_realname=muon
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.7.0
pkgrel=1
pkgdesc="Meson implementation in C (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://muon.build'
license=('spdx:GPL-3.0-only')
msys2_references=(
  'aur: muon-meson'
)
msys2_repository_url='https://git.sr.ht/~lattis/muon'
depends=(
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-curl"
  "${MINGW_PACKAGE_PREFIX}-libarchive"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-python-yaml"
  "${MINGW_PACKAGE_PREFIX}-scdoc"
)
source=("${url}/releases/v${pkgver}/${_realname}-v${pkgver}.tar.gz")
sha256sums=('573a3137e2a478e84e71dbbaf874623f7bc9848cf3367c948016ed284e8d637c')

prepare() {
  cd "${srcdir}"/${_realname}-v${pkgver}
  CC="gcc -std=c99" ./bootstrap.sh build
}

build() {
  cd "${srcdir}"/${_realname}-v${pkgver}
  build/muon-bootstrap.exe setup \
    -Dwrap_mode=nodownload \
    -Ddefault_library=shared \
    -Dauto_features=enabled \
    -Dbuildtype=plain \
    -Dmeson-docs=disabled \
    -Dmeson-tests=disabled \
    -Dwebsite=disabled \
    -Dtracy=disabled \
    build

  build/muon-bootstrap -C build samu
}

package() {
  cd "${srcdir}"/${_realname}-v${pkgver}
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    build/muon setup \
      -Dprefix="${pkgdir}${MINGW_PREFIX}" \
      -Dwrap_mode=nodownload \
      -Ddefault_library=shared \
      -Dauto_features=enabled \
      -Dbuildtype=plain \
      -Dmeson-docs=enabled \
      -Dmeson-tests=disabled \
      -Dwebsite=disabled \
      -Dtracy=disabled \
      builddir

  build/muon -C builddir samu
  build/muon -C builddir install

  install -Dm644 "LICENSES/GPL-3.0-only.txt" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
