# Maintainer: Maksim Bondarenkov <maksapple2306@gmail.com>

_realname=muon
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.7.0
pkgrel=1
pkgdesc="Meson implementation in C (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://muon.build'
license=('spdx:GPL-3.0-only')
msys2_references=(
  'anitya: 391171'
  'aur: muon-meson'
  'gentoo: dev-build/muon'
)
msys2_repository_url='https://git.sr.ht/~lattis/muon'
depends=(
  "${MINGW_PACKAGE_PREFIX}-curl"
  "${MINGW_PACKAGE_PREFIX}-libarchive"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-scdoc"
)
source=(
  "${url}/releases/v${pkgver}/${_realname}-v${pkgver}.tar.gz"
  '0001-libpkgconf-3-api.patch'
)
sha256sums=('573a3137e2a478e84e71dbbaf874623f7bc9848cf3367c948016ed284e8d637c'
  'a6c11ce9ea870874a9a4af83e2115ba5e46e545ebe95938920e12635a9f33fbd')

prepare() {
  cd "${srcdir}/${_realname}-v${pkgver}"

  patch -Nbp1 -i "${srcdir}/0001-libpkgconf-3-api.patch"
}

build() {
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    meson setup \
    --prefix="${MINGW_PREFIX}" \
    --wrap-mode=nodownload \
    --default-library=shared \
    --auto-features=enabled \
    --buildtype=plain \
    -Dmeson-docs=disabled \
    -Dmeson-tests=disabled \
    -Dwebsite=disabled \
    -Dtracy=disabled \
    "build-${MSYSTEM}" \
    "${_realname}-v${pkgver}"

  meson compile -C "build-${MSYSTEM}"
}

check() {
  meson test -C "build-${MSYSTEM}"
}

package() {
  meson install -C "build-${MSYSTEM}" --destdir "${pkgdir}"

  install -Dm644 "${_realname}-v${pkgver}/LICENSES/GPL-3.0-only.txt" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
