# Maintainer: Mohammad Fatehi <Mohammadfatehi@outlook.com>

_realname=tasker
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.3.3
pkgrel=1
pkgdesc='Offline, keyboard-driven daily task manager for the terminal (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'mingw64')
url='https://github.com/MahdiFatehi1996/Tasker'
msys2_repository_url='https://github.com/MahdiFatehi1996/Tasker'
license=('spdx:MIT')
makedepends=("${MINGW_PACKAGE_PREFIX}-rust")
source=("${_realname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('30fd5fa4273e3474373cc5f662817c045d446e5ea029f02f87addb46597d87ee')
# Stripping a Rust binary with the MSYS2 strip is not worth the risk of
# breaking it; the same holds for the other Rust packages in the repo.
options=('!strip')

prepare() {
  cd "${srcdir}/Tasker-${pkgver}"

  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${srcdir}/Tasker-${pkgver}"

  RUSTFLAGS="${RUSTFLAGS/+crt-static/-crt-static}" \
    cargo build --release --frozen
}

check() {
  cd "${srcdir}/Tasker-${pkgver}"

  cargo test --release --frozen
}

package() {
  cd "${srcdir}/Tasker-${pkgver}"

  install -Dm755 "target/release/tasker.exe" \
    "${pkgdir}${MINGW_PREFIX}/bin/tasker.exe"

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/"
}
