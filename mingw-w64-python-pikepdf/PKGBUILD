# Maintainer: wszqkzqk <wszqkzqk@qq.com>

_realname=python-pikepdf
_pyname=pikepdf
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=10.18.1
pkgrel=1
pkgdesc='Read, write, repair, and transform PDFs in Python, powered by qpdf (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/pikepdf/pikepdf'
msys2_repository_url='https://github.com/pikepdf/pikepdf'
msys2_references=(
  "anitya: 17724"
  "archlinux: python-pikepdf"
  "cpe: cpe:2.3:a:pikepdf_project:pikepdf"
  "gentoo: dev-python/pikepdf"
  "purl: pkg:pypi/pikepdf"
)
license=('spdx:MPL-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-lxml"
  "${MINGW_PACKAGE_PREFIX}-python-packaging"
  "${MINGW_PACKAGE_PREFIX}-python-pillow"
  "${MINGW_PACKAGE_PREFIX}-qpdf"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-nanobind"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-scikit-build-core"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-attrs"
  "${MINGW_PACKAGE_PREFIX}-python-dateutil"
  "${MINGW_PACKAGE_PREFIX}-python-hypothesis"
  "${MINGW_PACKAGE_PREFIX}-python-numpy"
  "${MINGW_PACKAGE_PREFIX}-python-psutil"
  "${MINGW_PACKAGE_PREFIX}-python-pytest"
  "${MINGW_PACKAGE_PREFIX}-python-pytest-timeout"
  "${MINGW_PACKAGE_PREFIX}-python-pytest-xdist"
)
source=(
  "${url}/archive/v${pkgver}/${_pyname}-${pkgver}.tar.gz"
  '001-remove-constinit-for-gcc.patch'
  '002-fix-gcc-125359-regression.patch'
)
sha256sums=('ee9a27575f581b4d7d4a5f3b75d96f800ab8979f7904f3a11b232aa7b06477b8'
            '0b60571c040f9a8a2504d2d6d7681d3bec9d38a1c5319ea17b14493222d1d550'
            'b07bbbbcc95f0211b8bb03750b6717445336f9c54974bab7698e29cc0cb16a0b')

prepare() {
  cd "${_pyname}-${pkgver}"

  # libstdc++ with winpthreads lacks a constexpr std::mutex() constructor
  patch -Np1 -i "${srcdir}/001-remove-constinit-for-gcc.patch"

  # Prevent nanobind from adding -Os (triggers GCC 16 C++20 basic_string C4 move ctor linker error)
  # Bug: https://gcc.gnu.org/bugzilla/show_bug.cgi?id=125359
  # Our tracking: https://github.com/msys2/MINGW-packages/issues/31015
  #
  # Possible patch: https://patchwork.ozlabs.org/project/gcc/list/?submitter=80672
  patch -Np1 -i "${srcdir}/002-fix-gcc-125359-regression.patch"
}

build() {
  cp -r "${_pyname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --no-isolation --skip-dependency-check \
    -Ccmake.args=-Wno-author
}

check() {
  cd "build-${MSYSTEM}"

  rm -rf "${srcdir}/test-prefix-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${srcdir}/test-prefix-${MSYSTEM}" dist/*.whl

  local _site_packages=$(python -c "import site; print(site.getsitepackages(['${srcdir}/test-prefix-${MSYSTEM}'])[0])")
  PYTHONPATH="${_site_packages}" pytest
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE.txt -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
