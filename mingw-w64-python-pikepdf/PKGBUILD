# Maintainer: wszqkzqk <wszqkzqk@qq.com>

_realname=python-pikepdf
_pyname=pikepdf
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=10.17.0
pkgrel=1
pkgdesc='Read and write PDFs with Python, powered by qpdf (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/pikepdf/pikepdf'
msys2_repository_url='https://github.com/pikepdf/pikepdf'
msys2_references=(
  "anitya: 17724"
  "archlinux: python-pikepdf"
  "cpe: cpe:2.3:a:pikepdf_project:pikepdf"
  "gentoo: dev-python/pikepdf"
  "purl: pkg:pypi/pikepdf"
)
license=('spdx:MPL-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-deprecated"
  "${MINGW_PACKAGE_PREFIX}-python-lxml"
  "${MINGW_PACKAGE_PREFIX}-python-packaging"
  "${MINGW_PACKAGE_PREFIX}-python-pillow"
  "${MINGW_PACKAGE_PREFIX}-qpdf"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-nanobind"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-scikit-build-core"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-hypothesis"
  "${MINGW_PACKAGE_PREFIX}-python-psutil"
  "${MINGW_PACKAGE_PREFIX}-python-pytest"
  "${MINGW_PACKAGE_PREFIX}-python-pytest-xdist"
)
source=("${url}/archive/v${pkgver}/${_pyname}-${pkgver}.tar.gz")
sha256sums=('e31d86409bab8d08ec6358859dd4d3a6f0869808b983dd6eee79b29c86d6ba3a')

build() {
  cp -r "${_pyname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  # define QPDF_STATIC to strip __declspec(dllimport) annotations on GCC
  CXXFLAGS+=" -DQPDF_STATIC" \
    python -m build --wheel --no-isolation --skip-dependency-check
}

check() {
  cd "build-${MSYSTEM}"

  python -m installer --prefix="${srcdir}/test-prefix" dist/*.whl
  local _site_packages=$(python -c "import site; print(site.getsitepackages(['${srcdir}/test-prefix'])[0])")
  PYTHONPATH="${_site_packages}" pytest
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE.txt -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
