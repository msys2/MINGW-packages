# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=Encode-HanExtra
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=0.23
pkgrel=1
pkgdesc="Extra sets of Chinese encodings. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/Encode-HanExtra"
msys2_references=(
  'purl: pkg:cpan/AUDREYT/Encode-HanExtra'
)
license=('spdx:MIT')
groups=("${MINGW_PACKAGE_PREFIX}-perl-modules")
depends=("${MINGW_PACKAGE_PREFIX}-perl")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-make"
             "${MINGW_PACKAGE_PREFIX}-perl-module-install")
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/A/AU/AUDREYT/${_perlname}-${pkgver}.tar.gz")
sha256sums=('1fd4b06cada70858003af153f94c863b3b95f2e3d03ba18d0451a81d51db443a')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
}
