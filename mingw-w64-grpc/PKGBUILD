_enable_python=1

_realname=grpc
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}"
         $( (( ! _enable_python )) || echo \
           "${MINGW_PACKAGE_PREFIX}-python-grpcio" \
           "${MINGW_PACKAGE_PREFIX}-python-grpcio-tools"))
pkgver=1.85.0
pkgrel=3
_proto_ver=36.2
_grpc_proto_commit=dd549fc4ed04b60b0fdd3866b82ef0a7c87c6e4f
pkgdesc="Google's high performance, open source, general RPC framework (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://www.grpc.io/'
msys2_repository_url="https://github.com/grpc/grpc"
msys2_references=(
  'archlinux: grpc'
  "cpe: cpe:/a:grpc:grpc"
  'purl: pkg:pypi/grpcio'
)
license=('spdx:Apache-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-abseil-cpp"
  "${MINGW_PACKAGE_PREFIX}-openssl"
  "${MINGW_PACKAGE_PREFIX}-re2"
  "${MINGW_PACKAGE_PREFIX}-zlib"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-c-ares"
  "${MINGW_PACKAGE_PREFIX}-protobuf"
  $( (( ! _enable_python )) || echo \
    "${MINGW_PACKAGE_PREFIX}-cython" \
    "${MINGW_PACKAGE_PREFIX}-python-build" \
    "${MINGW_PACKAGE_PREFIX}-python-installer" \
    "${MINGW_PACKAGE_PREFIX}-python-setuptools")
)
source=("${msys2_repository_url}/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
        https://github.com/protocolbuffers/protobuf/releases/download/v${_proto_ver}/protobuf-${_proto_ver}.tar.gz
        grpc-proto-${_grpc_proto_commit}.tar.gz::https://github.com/grpc/grpc-proto/archive/${_grpc_proto_commit}.tar.gz
        "001-fix-thread_local.patch"
        "002-fix-building-python-module.patch"
        "003-fix-build-shared-libs-on-mingw.patch"
        "004-fix-build-with-clang-23.patch"
        "005-fix-python-link-response-file.patch"
        "006-fix-python-tools-system-libraries.patch")
sha256sums=('78d933f81e66d88c9f7a5ac419aa929691ef62b61d32a92f69c16aabf21ffabe'
            '3d9642a662d10e68ebae5e53f14dcce5105684212d5078f8e0d47d1ab3ae6b64'
            '6aaa807572edfe307eaddc15161ce684d02d054e3fca36b38993efc85575ddfa'
            '6695fd531478be73e9555c28d4a1242eb47b9e8c24ccf8df1b8243d81e11c8b1'
            'aaecb1f2393fe95ff05033de315b904ee757c4c3b964b8ee007bce705070c6ef'
            '3b0de744d3ff858e0a62795f7d6b05b0058cd9ff9c55b34713fa42184dccc6ce'
            '72aa322fdff5fe0c6c966a7a63d3355aee47167af30cace0f8cd25fcafb0563f'
            'fd378d02716c0baba16035b59f8bbeee27c53b7da186f338e934c687a2a0ef7e'
            'dd82461ed393da46a9873fb349c2392772c04cb6c3583335108d82cd7e672a00')
noextract=(${_realname}-${pkgver}.tar.gz)

apply_patch_with_msg() {
  for _patch in "$@"
  do
    msg2 "Applying ${_patch}"
    patch -Nbp1 -i "${srcdir}/${_patch}"
  done
}

prepare() {
  echo "Extracting ${_realname}-${pkgver}.tar.gz ..."
  ${MINGW_PREFIX}/bin/bsdtar.exe -xzf ${_realname}-${pkgver}.tar.gz || true

  mv grpc-proto-${_grpc_proto_commit}/* ${_realname}-${pkgver}/third_party/grpc-proto

  cd "${srcdir}"/${_realname}-${pkgver}
  # Suggested by @mstorsjo in https://github.com/msys2/MINGW-packages/pull/16378#issuecomment-1481002915
  apply_patch_with_msg \
    001-fix-thread_local.patch

  apply_patch_with_msg \
    002-fix-building-python-module.patch \
    003-fix-build-shared-libs-on-mingw.patch \
    004-fix-build-with-clang-23.patch \
    005-fix-python-link-response-file.patch \
    006-fix-python-tools-system-libraries.patch
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  case "${CARCH}" in
    x86_64)
      # https://github.com/msys2/MINGW-packages/issues/8984
      LDFLAGS+=" -Wl,--disable-dynamicbase,--default-image-base-low"
    ;;
  esac

  CXXFLAGS+=" -w" \
  LDFLAGS+=" -Wl,--export-all-symbols" \
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${extra_config[@]}" \
      -DBUILD_SHARED_LIBS=ON \
      -DCMAKE_DLL_NAME_WITH_SOVERSION=ON \
      -DCMAKE_SKIP_RPATH=ON \
      -DgRPC_BUILD_TESTS=OFF \
      -DgRPC_ZLIB_PROVIDER="package" \
      -DgRPC_CARES_PROVIDER="package" \
      -DgRPC_RE2_PROVIDER="package" \
      -DgRPC_SSL_PROVIDER="package" \
      -DgRPC_PROTOBUF_PROVIDER="package" \
      -DgRPC_ABSL_PROVIDER="package" \
      -S "${_realname}-${pkgver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"

  if (( _enable_python )); then

  rm -rf "${srcdir}"/python-build-${MSYSTEM}
  cp -r "${srcdir}/${_realname}-${pkgver}" "${srcdir}"/python-build-${MSYSTEM} || true
  cd "${srcdir}"/python-build-${MSYSTEM}

  export GRPC_PYTHON_BUILD_WITH_CYTHON=1

  GRPC_PYTHON_BUILD_SYSTEM_OPENSSL=1 \
  GRPC_PYTHON_BUILD_SYSTEM_ZLIB=1 \
  GRPC_PYTHON_BUILD_SYSTEM_CARES=1 \
  GRPC_PYTHON_BUILD_SYSTEM_RE2=1 \
  GRPC_PYTHON_BUILD_SYSTEM_ABSL=1 \
  GRPC_BUILD_WITH_BORING_SSL_ASM=0 \
  GRPC_PYTHON_CFLAGS="-DGPR_MSVC_EMPTY_BASE_CLASS_WORKAROUND=''" \
  LDFLAGS="${LDFLAGS} -L../build-${MSYSTEM}" \
  CXXFLAGS+=" -Wno-deprecated-declarations" \
    python -m build --wheel --skip-dependency-check --no-isolation

  cd tools/distrib/python/grpcio_tools

  # use system protobuf for grpcio_tools
  WIN_PREFIX=$(cygpath -m ${MINGW_PREFIX})
  sed -r -i \
      -e '/^CC_FILES=\[/,/\]/{/^CC_FILES=\[/n;/\]/!d;}' \
      -e '/^CC_INCLUDES=\[/,/\]/{/^CC_INCLUDES=\[/n;/\]/!d;}' \
      -e "s@^(PROTO_INCLUDE=')[^']+'@\1${WIN_PREFIX}/include'@" \
      -e '/^PROTOBUF_SUBMODULE_VERSION=/d' \
      -e "s@'.*(google/.*\.proto)@'\1@" \
      protoc_lib_deps.py
  cp -r "${srcdir}"/${_realname}-${pkgver} grpc_root || true

  GRPC_PYTHON_CFLAGS="${CFLAGS} -fno-wrapv -frtti -std=c++17 -DPROTOBUF_USE_DLLS -Wno-deprecated-declarations -isystem$(cygpath -m ${srcdir}/protobuf-${_proto_ver}/src)" \
  GRPC_PYTHON_LDFLAGS="${LDFLAGS} $(pkgconf --libs protobuf) -lprotoc" \
    python -m build --wheel --skip-dependency-check --no-isolation

  fi
}

package_grpc() {
  depends+=(
    "${MINGW_PACKAGE_PREFIX}-c-ares"
    "${MINGW_PACKAGE_PREFIX}-protobuf"
  )
  conflicts=("${MINGW_PACKAGE_PREFIX}-libgpr")

  DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM}

  install -Dm644 "${srcdir}"/${_realname}-${pkgver}/LICENSE \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE
}

package_python-grpcio() {
  pkgdesc='Python language bindings for grpc, remote procedure call (RPC) framework (mingw-w64)'
  depends+=(
    "${MINGW_PACKAGE_PREFIX}-python"
    "${MINGW_PACKAGE_PREFIX}-python-typing_extensions"
  )
  optdepends=("${MINGW_PACKAGE_PREFIX}-python-grpcio-tools")
  options=('!strip')

  cd "${srcdir}"/python-build-${MSYSTEM}

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix=${MINGW_PREFIX} --destdir="${pkgdir}" dist/*.whl

  install -Dm644 "${srcdir}"/${_realname}-${pkgver}/LICENSE \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/python-grpcio/LICENSE
}

package_python-grpcio-tools() {
  pkgdesc='Python protobuf generator for GRPC (mingw-w64)'
  depends+=(
    "${MINGW_PACKAGE_PREFIX}-python"
    "${MINGW_PACKAGE_PREFIX}-python-grpcio"
    "${MINGW_PACKAGE_PREFIX}-python-protobuf"
    "${MINGW_PACKAGE_PREFIX}-python-setuptools"
  )
  options=('!strip')

  cd "${srcdir}"/python-build-${MSYSTEM}/tools/distrib/python/grpcio_tools

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix=${MINGW_PREFIX} --destdir="${pkgdir}" dist/*.whl

  install -Dm644 "${srcdir}"/${_realname}-${pkgver}/LICENSE \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/python-grpcio-tools/LICENSE
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
