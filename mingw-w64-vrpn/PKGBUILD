# Maintainer: Philippe Renon <philippe.renon@yahoo.fr>

_realname='vrpn'
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=7.36
_ver="0${pkgver}"
pkgrel=1
pkgdesc='The Virtual-Reality Peripheral Network (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/vrpn/vrpn'
msys2_repository_url='https://github.com/vrpn/vrpn'
msys2_documentation_url='https://github.com/vrpn/vrpn/wiki'
msys2_references=(
  'anitya: 10433'
  'aur: vrpn'
)
license=('spdx:BSL-1.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-freeglut"
  "${MINGW_PACKAGE_PREFIX}-hidapi"
  "${MINGW_PACKAGE_PREFIX}-jsoncpp"
  "${MINGW_PACKAGE_PREFIX}-libusb"
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-swig"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=(
  "https://github.com/${_realname}/${_realname}/archive/v${_ver}/${_realname}-${pkgver}.tar.gz"
  '0001-fix-shared-build.patch'
  '0002-fix-includes.patch'
)
sha256sums=('bed00ae060fc7c0cfdaa2fa01f6f2db4976d431971e8824b710eb63cfbba0df7'
            '14855180b0f6612b548ccf56a4b66de3fb1ef69b4b6418ab76e39fd643e9e609'
            '6ca0f53e90463093a114a62b4aae6b64e5dc1b3dc084e31e0f284fa2a0919804')

prepare() {
  cd "${_realname}-${_ver}"

  patch -Np1 -i "${srcdir}/0001-fix-shared-build.patch"
  patch -Np1 -i "${srcdir}/0002-fix-includes.patch"
}

build() {
  local _extra_config=()
  if check_option 'debug' 'n'; then
    _extra_config+=('-DCMAKE_BUILD_TYPE=Release')
  else
    _extra_config+=('-DCMAKE_BUILD_TYPE=Debug')
  fi

  local _pyver
  _pyver="$(python -c "import sys;sys.stdout.write('.'.join(map(str, sys.version_info[:2])))")"

  local _cmake_options=(
    -S "${_realname}-${_ver}"
    -B "build-${MSYSTEM}"
    -G Ninja
    -W no-author
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}"
    -DDIRECTX_ROOT_DIR="${MINGW_PREFIX}"
    -DWINHID_ROOT_DIR="${MINGW_PREFIX}"
    -DBUILD_TESTING=OFF
    -DVRPN_USE_SHARED_LIBRARY=ON
    -DVRPN_USE_WINSOCK2=ON
    -DVRPN_BUILD_JAVA=OFF
    -DVRPN_BUILD_TEST_RPC_GENERATION=OFF
    -DVRPN_USE_MPI=OFF
    -DPYTHON_LIBRARY="${MINGW_PREFIX}/bin/libpython${_pyver}.dll"
    -DPYTHON_INCLUDE_DIR="${MINGW_PREFIX}/include/python${_pyver}"
    "${_extra_config[@]}"
  )

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" cmake "${_cmake_options[@]}"
  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  cd "${_realname}-${_ver}"

  install -Dm644 README.Legal "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
