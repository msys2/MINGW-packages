_realname='soapyrtlsdr'
_pkgname='SoapyRTLSDR'
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.3.3
_gitver="soapy-rtl-sdr-${pkgver}"
pkgrel=3
pkgdesc='Soapy SDR plugin for RTL-SDR devices (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/pothosware/SoapyRTLSDR'
msys2_repository_url='https://github.com/pothosware/SoapyRTLSDR'
msys2_references=(
  'anitya: 14537'
  'archlinux: soapyrtlsdr'
  'aur:' # ignore soapyrtlsdr-git
  'gentoo: net-wireless/soapyrtlsdr'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-rtl-sdr"
  "${MINGW_PACKAGE_PREFIX}-soapysdr"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=("${url}/archive/${_gitver}/${_realname}-${pkgver}.tar.gz")
sha512sums=('a43511c8644a8dbec8e0b7d8f114c4955ba9407727680680cef446a12a9ee27bfe892cab49aa77ce82d52e4272075f4e6f2ee38350675f5508601ff24ff82081')

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
      "${extra_config[@]}" \
      -S "${_pkgname}-${_gitver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "${_pkgname}-${_gitver}/LICENSE.txt" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
