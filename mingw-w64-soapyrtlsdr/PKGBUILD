_realname='soapyrtlsdr'
_pkgname='SoapyRTLSDR'
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.3.4
_gitver="soapy-rtlsdr-${pkgver}"
pkgrel=1
pkgdesc='Soapy SDR plugin for RTL-SDR devices (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/pothosware/SoapyRTLSDR'
msys2_repository_url='https://github.com/pothosware/SoapyRTLSDR'
msys2_references=(
  'anitya: 14537'
  'archlinux: soapyrtlsdr'
  'aur:' # ignore soapyrtlsdr-git
  'gentoo: net-wireless/soapyrtlsdr'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-rtl-sdr"
  "${MINGW_PACKAGE_PREFIX}-soapysdr"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=("${url}/archive/${_gitver}/${_realname}-${pkgver}.tar.gz")
sha512sums=('a5c5ec262eacf3f7f4d8d2efaa8aaf2421e291e2716b0ea9b375cde45bf99057b73b87eb3ca01fd2f0d7530c13c396981068fbb05d6d6a8f8e2388e7350c86cf')

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake -Wno-author \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
      "${extra_config[@]}" \
      -S "${_pkgname}-${_gitver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "${_pkgname}-${_gitver}/LICENSE.txt" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
