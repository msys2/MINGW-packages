# Maintainer: Sebastian Ehlert <awvwgk@disroot.org>

_realname=fypp
pkgbase="mingw-w64-python-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=3.3
pkgrel=1
pkgdesc="Python powered Fortran preprocessor (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://fypp.readthedocs.io/"
msys2_repository_url="https://github.com/aradi/fypp"
msys2_references=(
  'anitya: 13652'
  'purl: pkg:pypi/fypp'
)
license=('spdx:BSD-2-Clause')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-hatchling"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
)
options=('!strip')
source=("https://github.com/aradi/fypp/archive/${pkgver}/${_realname}-${pkgver}.tar.gz")
noextract=("${_realname}-${pkgver}.tar.gz")
sha256sums=('2f93472595c6f008922a71f0fefddd8d0088e1f5d8c2746d9ddda7854a87ffdd')

prepare() {
  tar -xzf "${_realname}-${pkgver}.tar.gz" || tar -xzf "${_realname}-${pkgver}.tar.gz"
}

build() {
  cp -r "${_realname}-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "python-build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
