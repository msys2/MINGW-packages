# Based on the Arch package
# Don't building with installed jbigkit package as we build tiff without jbigkit support

_realname='tkimg'
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=2.1.2
pkgrel=1
pkgdesc='Adds support to Tk for many image formats: BMP, XBM, XPM, GIF, PNG, JPEG, TIFF and postscript (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://tkimg.sourceforge.io/'
license=('BSD')
depends=(
  "${MINGW_PACKAGE_PREFIX}-libjpeg"
  "${MINGW_PACKAGE_PREFIX}-libpng"
  "${MINGW_PACKAGE_PREFIX}-libtiff"
  "${MINGW_PACKAGE_PREFIX}-tk"
  "${MINGW_PACKAGE_PREFIX}-zlib"
)
# Uses dtplite for generating the man pages:
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-tcllib"
)
source=(
  "https://downloads.sourceforge.net/project/tkimg/tkimg/${pkgver:0:3}/tkimg%20${pkgver}/Img-${pkgver}.tar.gz"
  '002-dtplite_tcl.patch'
)
sha256sums=('932d386142e5aaff74add63da283d0547f0515d6155b9a2b69b433f9c353271a'
            'eb39aa5f628852b8030041c082e1ede89e2516930125572e5b1f8bc1bcbe8fca')

prepare() {
  cd "Img-${pkgver}"

  patch -Np1 -i "${srcdir}/002-dtplite_tcl.patch"

  autoreconf -fiv
}

build() {
  local extra_config=()
  if check_option 'debug' 'y'; then
    extra_config+=(--enable-symbols)
  fi

  mkdir -p "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  "../Img-${pkgver}/configure" \
    --build="${MINGW_CHOST}" \
    --host="${MINGW_CHOST}" \
    --target="${MINGW_CHOST}" \
    --prefix="${MINGW_PREFIX}" \
    --mandir="${MINGW_PREFIX}/share/man" \
    "${extra_config[@]}"

  make
}

package() {
  cd "build-${MSYSTEM}"

  make INSTALL_ROOT="${pkgdir}" install-libraries
  make INSTALL_ROOT="${pkgdir}" install-man

  rm -f "${pkgdir}${MINGW_PREFIX}/lib/"*.sh
}
