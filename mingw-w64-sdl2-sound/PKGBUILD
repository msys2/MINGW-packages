# Maintainer: Biswapriyo Nath <nathbappai@gmail.com>

_realname=sdl2-sound
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2.0.6
pkgrel=2
pkgdesc="A library to decode several popular sound file formats, such as .WAV and .MP3 (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
msys2_repository_url='https://github.com/icculus/SDL_sound'
url='https://icculus.org/SDL_sound/'
msys2_references=(
  'anitya: 10262'
  'aur: sdl2_sound'
)
license=('spdx:Zlib')
conflicts=("${MINGW_PACKAGE_PREFIX}-SDL2_sound")
provides=("${MINGW_PACKAGE_PREFIX}-SDL2_sound=${pkgver}-${pkgrel}")
replaces=("${MINGW_PACKAGE_PREFIX}-SDL2_sound")
depends=("${MINGW_PACKAGE_PREFIX}-sdl2")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=("${msys2_repository_url}/releases/download/v${pkgver}/SDL2_sound-${pkgver}.tar.gz") # {,.sig}
sha256sums=('63be57cc80bcd29aeed6c29700759871c44c90251a7508b8d0eacd8d9cece30c')
# validpgpkeys=('50F91FB550EC32AB4A710286FA148B892AB48044') # icculus@icculus.org

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -Wno-author \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${extra_config[@]}" \
      -S "SDL_sound-${pkgver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "SDL_sound-${pkgver}/LICENSE.txt" -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/"
}
