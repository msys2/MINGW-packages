# Maintainer: Glarboy <Nahida1027@aliyun.com>

_realname=wails
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=3.1.0
pkgrel=1
pkgdesc="Create beautiful applications using Go"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://wails.io/"
msys2_repository_url="https://github.com/wailsapp/wails"
msys2_issue_tracker_url="https://github.com/wailsapp/wails/issues"
msys2_documentation_url="https://wails.io/quick-start/installation/"
msys2_changelog_url="https://wails.io/changelog/"
msys2_references=(
  'aur: wails'
)
license=('spdx: MIT')
depends=("${MINGW_PACKAGE_PREFIX}-go")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc")
checkdepends=("${MINGW_PACKAGE_PREFIX}-go-task")
optdepends=(
  "${MINGW_PACKAGE_PREFIX}-nsis: generate installer"
  "${MINGW_PACKAGE_PREFIX}-nodejs: frontend tool"  
)
source=(${msys2_repository_url}/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz)
sha256sums=('d98866b5f7a2e2378a3cc5ca76422bcef27d669bbe1dd5792a35db2589262e1f')


build() {
  cd "${_realname}-${pkgver}/v3"

  export GOOS=windows
  export GOROOT=${MINGW_PREFIX}/lib/go
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-trimpath -ldflags=-linkmode=external -mod=readonly -modcacherw"
  case "${CARCH}" in
  x86_64)
    GOFLAGS+=" -buildmode=pie"
    ;;
  esac

  go build -o build/wails.exe ./cmd/wails3
}

check() {
  cd "${_realname}-${pkgver}/v3"
  go-task test:examples
}

package() {
  install -vDm 755 ${_realname}-${pkgver}/v3/build/wails.exe -t "${pkgdir}${MINGW_PREFIX}/bin/"
  install -vDm 644 ${_realname}-${pkgver}/README*.md \
    ${_realname}-${pkgver}/v3/release_notes.md \
    -t "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}/"
  install -vDm 644 ${_realname}-${pkgver}/LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/"
}
