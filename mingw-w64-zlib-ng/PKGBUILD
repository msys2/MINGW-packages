# Maintainer: Christoph Reiter <reiter.christoph@gmail.com>

_realname=zlib-ng
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}" "${MINGW_PACKAGE_PREFIX}-${_realname}-compat")
pkgver=2.3.3
pkgrel=5
pkgdesc='zlib replacement with optimizations for next generation systems (mingw-w64)'
url='https://github.com/zlib-ng/zlib-ng'
msys2_repository_url='https://github.com/zlib-ng/zlib-ng'
msys2_references=(
  'anitya: 115592'
  'archlinux: zlib-ng'
  'gentoo: sys-libs/zlib-ng'
)
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
license=("spdx:Zlib")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=(
  "${url}/archive/refs/tags/${pkgver}/${_realname}-${pkgver}.tar.gz"
  "0001-match-existing-zlib-naming.patch"
  "0002-separate-cmake-lib-types.patch"
  "0003-fix-mingw-compat-largefile-abi.patch"
)
sha256sums=('f9c65aa9c852eb8255b636fd9f07ce1c406f061ec19a2e7d508b318ca0c907d1'
            '373e5a5d81c63aaca85ae3335f6c3a35e8ae87fcada284ec3bb6407db75430a9'
            'e2b7e954fc6d8110fcc8ee05665a421e21d0c9aeb69500b101d72e63223382f7'
            'd0cac981d2d42a6326dc0cdafc1cce0f93c2fe1f9719139ddb3586e37d7da3e9')

prepare() {
  cd "${_realname}-${pkgver}"
  # 1) Fix the zlib-ng naming to match the .pc file
  # 2) Make the compat naming the same as our current zlib
  # 3) (compat) Fix 64-suffixed symbols, see #33986
  patch -p1 -i "${srcdir}/0001-match-existing-zlib-naming.patch"
  patch -p1 -i "${srcdir}/0002-separate-cmake-lib-types.patch"
  patch -p1 -i "${srcdir}/0003-fix-mingw-compat-largefile-abi.patch"
}

build() {
  cd "${_realname}-${pkgver}"

  declare -a _extra_config
  _extra_config=(
    -G Ninja
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}"
    -Wno-author
    -DWITH_GTEST=OFF
  )

  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  # gcc 15.1 toolchain crashes sometimes when linking tests
  # Should be fine once we have gcc 17
  if [[ ${MSYSTEM} != CLANG* ]]; then
    _extra_config+=("-DZLIB_ENABLE_TESTS=OFF")
  fi

  echo "Building zlib-ng"
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake -B build-static-${MSYSTEM} \
      -DBUILD_SHARED_LIBS=OFF \
      "${_extra_config[@]}"
  cmake --build build-static-${MSYSTEM}

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake -B build-${MSYSTEM} \
      -DBUILD_SHARED_LIBS=ON \
      "${_extra_config[@]}"
  cmake --build build-${MSYSTEM}

  echo "Building zlib-ng-compat"
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake -B build-compat-static-${MSYSTEM} \
      -DBUILD_SHARED_LIBS=OFF \
      "${_extra_config[@]}" \
      -DZLIB_COMPAT=ON
  cmake --build build-compat-static-${MSYSTEM}

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake -B build-compat-${MSYSTEM} \
      -DBUILD_SHARED_LIBS=ON \
      "${_extra_config[@]}" \
      -DZLIB_COMPAT=ON
  cmake --build build-compat-${MSYSTEM}
}

check() {
  cd "${_realname}-${pkgver}"
  echo "Checking zlib-ng"
  ctest --output-on-failure --test-dir build-${MSYSTEM}
  echo "Checking zlib-ng-compat"
  ctest --output-on-failure --test-dir build-compat-${MSYSTEM}
}

package_zlib-ng() {
  cd "${_realname}-${pkgver}"

  DESTDIR="${pkgdir}" cmake --install build-static-${MSYSTEM}
  DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM}
  install -Dm644 LICENSE.md -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
  install -Dm644 README.md -t "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}"
}

package_zlib-ng-compat() {
  pkgdesc+=" (zlib compat)"
  provides=("${MINGW_PACKAGE_PREFIX}-zlib")
  conflicts=("${MINGW_PACKAGE_PREFIX}-zlib")

  cd "${_realname}-${pkgver}"
  DESTDIR="${pkgdir}" cmake --install build-compat-static-${MSYSTEM}
  DESTDIR="${pkgdir}" cmake --install build-compat-${MSYSTEM}
  install -Dm644 LICENSE.md -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}-compat"
  install -Dm644 README.md -t "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}-compat"

  # Hardlink for compatibility until the transition from zlib1.dll to libz-1.dll is finished
  ln -vf "${pkgdir}${MINGW_PREFIX}/bin/libz-1.dll" "${pkgdir}${MINGW_PREFIX}/bin/zlib1.dll"
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
