
_realname=sass
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.108.2
pkgrel=1
pkgdesc="Dart Sass compiled to pure JavaScript (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://sass-lang.com/"
# sometimes node-sass
msys2_references=(
  'anitya: 326670'
  'archlinux: dart-sass' # it is not dart-sass but the version is the same
  'gentoo:' # ignore dev-ruby/sass
  'purl: pkg:npm/sass'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-nodejs"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-nodejs"
)
source=("${_realname}-${pkgver}.tgz::https://registry.npmjs.org/${_realname}/-/${_realname}-${pkgver}.tgz")
sha256sums=('a3398fa194c3379174bac6650bdaad077d1fbe71c4e58e817b2e213d1479bbfe')


package() {
  cd "${srcdir}"

  export npm_config_cache="${srcdir}/npm-cache"

  npm install -g --prefix="${pkgdir}${MINGW_PREFIX}" "${srcdir}/${_realname}-${pkgver}.tgz"

  install -Dm644 "${pkgdir}${MINGW_PREFIX}/lib/node_modules/${_realname}/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${pkgname}/LICENSE"

  # 3. Remove build directory references left by npm
  find "${pkgdir}${MINGW_PREFIX}" -name "package.json" -exec sed -i "s|${pkgdir}||g" {} +
}
