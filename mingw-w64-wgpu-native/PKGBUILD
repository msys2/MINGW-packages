# Maintainer: Konstantin Podsvirov <konstantin@podsvirov.su>

_realname=wgpu-native
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=29.0.1.1
_webgpuhver=673658bc2bd70ec39fc55ebe6bb0173cf6d0a603
pkgrel=1
pkgdesc="Native WebGPU implementation based on wgpu-core (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/gfx-rs/wgpu-native'
msys2_repository_url="${url}"
license=('spdx:MIT OR Apache-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-rust"
             "${MINGW_PACKAGE_PREFIX}-clang")
options=('!strip')
source=("${msys2_repository_url}/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
        "https://github.com/webgpu-native/webgpu-headers/archive/${_webgpuhver}/webgpu-headers-${_webgpuhver}.tar.gz")
sha256sums=('6008651e1d10022d4ded15b69405b4ba88577be5d623938ba98ad241b2cbf818'
            '6754c6c2465c79a954f7c04c7890c9f00b7ecce8addbe01b5056e860ba3933e6')

prepare() {
  cd "${_realname}-${pkgver}"

  rm -rf ffi/webgpu-headers && cp -a "${srcdir}/webgpu-headers-${_webgpuhver}" ffi/webgpu-headers

  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${_realname}-${pkgver}"

  CARGO_TARGET_DIR=target \
    make lib-native-release
}

check() {
  cd "${_realname}-${pkgver}"

  cargo test --release --frozen --all-features
}

package() {
  cd "${_realname}-${pkgver}"

  install -Dm644 -t "${pkgdir}${MINGW_PREFIX}/bin" target/release/wgpu_native.dll
  install -Dm644 -t "${pkgdir}${MINGW_PREFIX}/lib" target/release/libwgpu_native{,.dll}.a
  install -Dm644 -t "${pkgdir}${MINGW_PREFIX}/include/webgpu" ffi/{wgpu.h,webgpu-headers/webgpu.h}

  install -Dm644 -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}" LICENSE.{MIT,APACHE}
}
