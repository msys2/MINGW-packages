# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=Win32-Unicode
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=0.38
pkgrel=2
pkgdesc="perl unicode-friendly wrapper for win32api. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/Win32-Unicode"
msys2_repository_url="https://github.com/xaicron/p5-win32-unicode"
msys2_references=(
  'purl: pkg:cpan/XAICRON/Win32-Unicode'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-perl")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-make"
             "${MINGW_PACKAGE_PREFIX}-perl-module-install")
source=("https://cpan.metacpan.org/authors/id/X/XA/XAICRON/${_perlname}-${pkgver}.tar.gz")
sha256sums=('c52cd9049c51edc5cfbd065ac92a4327e7b878cae764e40c6a8db1c89ee2838d')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX} \
    CCFLAGS="-Wno-incompatible-pointer-types"
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
}
