_realname=yyjson
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.13.0
pkgrel=1
pkgdesc='The fastest JSON library in C (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/ibireme/yyjson'
msys2_repository_url='https://github.com/ibireme/yyjson'
msys2_documentation_url='https://ibireme.github.io/yyjson/doc/doxygen/html/'
msys2_references=(
  'archlinux: yyjson'
)
license=('spdx:MIT')
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=("https://github.com/ibireme/yyjson/archive/${pkgver}/${_realname}-${pkgver}.tar.gz")
sha256sums=('34e0f62a2bc11ab20d601e8ca1cc2b2079503aa45119a19133d89d19b94a0fae')

build() {
  declare -a _cmake_opts=(
    -GNinja
    -DCMAKE_INSTALL_PREFIX=${MINGW_PREFIX}
    -DCMAKE_DLL_NAME_WITH_SOVERSION=ON
    -S ${_realname}-${pkgver}
  )
  if check_option "debug" "n"; then
    _cmake_opts+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _cmake_opts+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      "${_cmake_opts[@]}" \
      -DBUILD_SHARED_LIBS=OFF \
      -B build-${MSYSTEM}-static

  cmake --build build-${MSYSTEM}-static

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      "${_cmake_opts[@]}" \
      -DBUILD_SHARED_LIBS=ON \
      -B build-${MSYSTEM}-shared

  cmake --build build-${MSYSTEM}-shared
}

check() {
  cmake -DYYJSON_BUILD_TESTS=ON -S ${_realname}-${pkgver} -B build-${MSYSTEM}-shared
  cmake --build build-${MSYSTEM}-shared
  PATH="$PWD/build-${MSYSTEM}-shared:$PATH" \
    ctest --test-dir build-${MSYSTEM}-shared --output-on-failure
}

package() {
  DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM}-static
  DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM}-shared

  # make the .pc file relocatable
  sed -e "/^prefix=/!s|${MINGW_PREFIX}|\${prefix}|g" \
    -i "${pkgdir}${MINGW_PREFIX}/lib/pkgconfig/yyjson.pc"

  install -Dm644 "${srcdir}/${_realname}-${pkgver}/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
