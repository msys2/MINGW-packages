_realname='hatch-jupyter-builder'
_pyname="${_realname//-/_}"
pkgbase="mingw-w64-python-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-python-${_realname}"
pkgver=0.10.0
pkgrel=1
pkgdesc='A hatch plugin to help build Jupyter packages (mingw-w64)'
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://github.com/jupyterlab/hatch-jupyter-builder'
msys2_repository_url='https://github.com/jupyterlab/hatch-jupyter-builder'
msys2_references=(
  'anitya: 243626'
  'archlinux: python-hatch-jupyter-builder'
  'gentoo: dev-python/hatch-jupyter-builder'
  'purl: pkg:pypi/hatch-jupyter-builder'
)
license=('spdx:BSD-3-Clause')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-hatchling"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-pytest"
)
options=('!strip')
source=(
  "https://pypi.org/packages/source/${_pyname::1}/${_realname}/${_pyname}-${pkgver}.tar.gz"
)
sha256sums=('144f6a7afd7f837071eca81141313d736643be4f6734b45f30661bcb922bd80a')

build() {
  cp -r "${_pyname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "build-${MSYSTEM}"

  python -m pytest
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE.txt -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
