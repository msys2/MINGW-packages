# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=IO-Stringy
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=2.113
pkgrel=1
pkgdesc="I/O on in-core objects like strings and arrays. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/IO-Stringy"
msys2_repository_url="https://github.com/Perl-Toolchain-Gang/IO-Stringy"
msys2_references=(
  'purl: pkg:cpan/CAPOEIRAB/IO-Stringy'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-perl")
makedepends=("${MINGW_PACKAGE_PREFIX}-make")
source=("https://cpan.metacpan.org/authors/id/C/CA/CAPOEIRAB/${_perlname}-${pkgver}.tar.gz")
sha256sums=('51220fcaf9f66a639b69d251d7b0757bf4202f4f9debd45bdd341a6aca62fe4e')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
  install -Dm644 LICENSE "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE
}
