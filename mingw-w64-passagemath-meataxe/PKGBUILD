# Maintainer: Dirk Stolle

_realname=passagemath-meataxe
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
provides=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=10.8.13
pkgrel=1
pkgdesc="passagemath: Matrices over small finite fields with meataxe (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/passagemath/passagemath'
msys2_repository_url='https://github.com/passagemath/passagemath'
msys2_references=(
  'purl: pkg:pypi/passagemath-meataxe'
)
license=('spdx:GPL-2.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-passagemath-modules"
  "${MINGW_PACKAGE_PREFIX}-shared_meataxe"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cython"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-cysignals"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-passagemath-environment"
  "${MINGW_PACKAGE_PREFIX}-python-passagemath-setup"
  "${MINGW_PACKAGE_PREFIX}-python-pkgconfig"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
optdepends=(
  # Optional dependencies which are not packaged yet are commented out.
  # "${MINGW_PACKAGE_PREFIX}-python-passagemath-pari"
  "${MINGW_PACKAGE_PREFIX}-python-passagemath-repl"
)
options=('!strip')
source=("https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname/-/_}-${pkgver}.tar.gz")
sha256sums=('39d850cbe6ee5f0711a58e129b65a9fca652c0182b5e8c63b9ee83d0b4d120f2')

build() {
  cp -r "${_realname/-/_}-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "python-build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl
}
