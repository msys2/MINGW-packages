# Maintainer: Christoph Reiter <reiter.christoph@gmail.com>

_realname=glycin
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2.2.6
pkgrel=3
pkgdesc="Sandboxed image decoding library (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://gitlab.gnome.org/GNOME/glycin"
msys2_repository_url="https://gitlab.gnome.org/GNOME/glycin"
msys2_references=(
  'anitya: 371932'
  'purl: pkg:cargo/glycin'
)
license=('spdx:MPL-2.0 OR LGPL-2.1-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-glib2"
  "${MINGW_PACKAGE_PREFIX}-gtk4"
  "${MINGW_PACKAGE_PREFIX}-librsvg"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-gobject-introspection"
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-rust"
)
source=(
  "https://download.gnome.org/sources/${_realname}/2.2/${_realname}-${pkgver}.tar.xz"
  "0001-meson-fix-windows-gnu-import-libraries.patch"
  "0002-meson-fix-windows-executable-suffix.patch"
  "515.patch"
  "515-core.patch"
  "https://static.crates.io/crates/glycin-core/glycin-core-4.0.5.crate"
)
noextract=("${_realname}-${pkgver}.tar.xz" "glycin-core-4.0.5.crate")
sha256sums=('6a114aa1117ec2d7bd578c8cefd235d993304dedfd1a62575dc31be9a146b791'
            '59b613de86b7bcd412e793bf3a3edb236a6ca571f412ff0ba762cbe73b7b7ba9'
            '4e402f6d73b26b61c48be238b1d639421aac87cc842dcdc00e5bab5c089dfa80'
            '11064b0c340d9fa4fca445f4dd0eaf9db7c994541af721fb2dede9bec93e610d'
            'da1fcb16e4208def46a8de109b71792720cf4cce1194e2107830bcd938f70bea'
            'fdade20eb67ac75b5c306a99c594155e1096ea7aa536741f64158afa1ffdeb36')

prepare() {
  bsdtar --exclude="${_realname}-${pkgver}/benches/test-images" \
    -xf "${srcdir}/${_realname}-${pkgver}.tar.xz" -C "${srcdir}"
  bsdtar -xf "${srcdir}/glycin-core-4.0.5.crate" -C "${srcdir}"

  cd "${srcdir}/${_realname}-${pkgver}"

  # https://gitlab.gnome.org/GNOME/glycin/-/merge_requests/515
  patch -d "${srcdir}/glycin-core-4.0.5" -Np2 -i "${srcdir}/515-core.patch"
  # https://gitlab.gnome.org/GNOME/glycin/-/merge_requests/515
  patch -Np1 -i "${srcdir}/515.patch"

  cat >> Cargo.toml <<END

[patch.crates-io]
glycin-core.path = "../glycin-core-4.0.5"
glycin-svg.path = "glycin-loaders/glycin-svg"
END
  cargo update -p glycin-core

  patch -Np1 -i "${srcdir}/0001-meson-fix-windows-gnu-import-libraries.patch"
  patch -Np1 -i "${srcdir}/0002-meson-fix-windows-executable-suffix.patch"
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("--buildtype=release" "-Dprofile=release")
  else
    extra_config+=("--buildtype=debug" "-Dprofile=dev")
  fi

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    meson setup \
      --prefix="${MINGW_PREFIX}" \
      --wrap-mode=nodownload \
      --auto-features=enabled \
      "${extra_config[@]}" \
      -Dtests=false \
      -Dglycin-loaders=false \
      -Dintrospection=true \
      -Dvapi=false \
      -Dlibglycin=true \
      -Dlibglycin-gtk4=true \
      -Dglycin-thumbnailer=true \
      "${srcdir}/build-${MSYSTEM}" \
      "${srcdir}/${_realname}-${pkgver}"

  meson compile -C "${srcdir}/build-${MSYSTEM}"
}

package() {
  meson install -C "${srcdir}/build-${MSYSTEM}" --destdir "${pkgdir}"

  install -Dm644 "${srcdir}/${_realname}-${pkgver}/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
