diff --git a/libglycin/meson.build b/libglycin/meson.build
index 5521a89..bcb80a4 100644
--- a/libglycin/meson.build
+++ b/libglycin/meson.build
@@ -59,6 +59,7 @@ if get_option('libglycin-gtk4')
 endif
 
 global_libglycin_gir = 'non-existent'
+global_libglycin_import_lib = []
 
 cc = meson.get_compiler('c')
 if host_machine.system() == 'darwin'
@@ -102,17 +103,24 @@ foreach package : packages
         cargo_output = cargo_artifact_dir / rust_target / win_dll_name
         cargo_implib_output = cargo_artifact_dir / rust_target / win_implib_name
     elif windows_gnu
-        cargo_output = cargo_artifact_dir / rust_target / f'glycin@suffix@.dll'
+        cargo_output = cargo_artifact_dir / rust_target / f'lib@libglycin_target_name@-0.dll'
+        cargo_implib_output = cargo_artifact_dir / rust_target / f'lib@libglycin_target_name@.dll.a'
+        win_implib_name = f'lib@libglycin_target_name@.dll.a'
     else
         cargo_output = cargo_artifact_dir / rust_target / (f'libglycin@suffix@'.replace('-', '_') + '.' + lib_ext)
     endif
 
+    cargo_depends = link_with
+    if suffix != '' and (windows_msvc or windows_gnu)
+        cargo_depends += global_libglycin_import_lib
+    endif
+
     # Build library with Rust
     libglycin = custom_target(
         f'libglycin@suffix@-cargo',
         build_always_stale: true,
         build_by_default: true,
-        depends: link_with,
+        depends: cargo_depends,
         output: f'Meson-does-not-support-sub-dir-output@suffix@',
         console: true,
         env: cargo_env_module,
@@ -181,7 +189,7 @@ foreach package : packages
 
     copy_deps = [libglycin_copy_library]
 
-    if windows_msvc
+    if windows_msvc or windows_gnu
         shim_import_lib = meson.current_build_dir() / win_implib_name
         libglycin_copy_import_lib = custom_target(
             f'libglycin@suffix@-copy-import-lib',
@@ -196,6 +204,10 @@ foreach package : packages
             ],
         )
         copy_deps += libglycin_copy_import_lib
+
+        if suffix == ''
+            global_libglycin_import_lib = libglycin_copy_import_lib
+        endif
     endif
 
     install_headers(f'include/glycin@suffix@.h', subdir: f'glycin@suffix@-2')
diff --git a/libglycin/build.rs b/libglycin/build.rs
--- a/libglycin/build.rs
+++ b/libglycin/build.rs
@@ -32,3 +32,20 @@
         }
-        ("windows", "gnu") => {}
+        ("windows", "gnu") => {
+            let out_dir = std::env::var("OUT_DIR").unwrap();
+            let profile_dir = std::path::Path::new(&out_dir).ancestors().nth(3).unwrap();
+            println!(
+                "cargo:rustc-cdylib-link-arg=-Wl,-o,{}",
+                profile_dir
+                    .join(format!("libglycin-{major}-0.dll"))
+                    .to_str()
+                    .unwrap()
+            );
+            println!(
+                "cargo:rustc-cdylib-link-arg=-Wl,--out-implib,{}",
+                profile_dir
+                    .join(format!("libglycin-{major}.dll.a"))
+                    .to_str()
+                    .unwrap()
+            );
+        }
         _ => {}
