# Maintainer: Sarah Ottinger

_realname=pytest-timeout
_pyname="${_realname/-/_}"
pkgbase="mingw-w64-python-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=2.5.0
pkgrel=1
pkgdesc='py.test plugin to abort hanging tests (mingw-w64)'
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://github.com/pytest-dev/pytest-timeout'
msys2_repository_url='https://github.com/pytest-dev/pytest-timeout'
msys2_references=(
  'anitya: 15174'
  'archlinux: python-pytest-timeout'
  'gentoo: dev-python/pytest-timeout'
  'purl: pkg:pypi/pytest-timeout'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python-pytest"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
source=("https://pypi.org/packages/source/${_realname::1}/${_pyname}/${_pyname}-${pkgver}.tar.gz")
sha256sums=('68c9d82dfe95fa65712e107010c9344e7d8b4afe8c975a7be0d273d939583a93')

build() {
  cp -r "${_pyname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
