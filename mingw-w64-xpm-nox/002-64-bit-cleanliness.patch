 #define HashAtomData(i) ((void *)(long long)i)
 #define HashColorIndex(slot) ((unsigned long long)((*slot)->data))
 #else
-#define HashAtomData(i) ((void *)(long)i)
-#define HashColorIndex(slot) ((unsigned long)((*slot)->data))
