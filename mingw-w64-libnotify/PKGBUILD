# Maintainer: Jan de Groot <jgc@archlinux.org>
# Maintainer: Zach Bacon <11doctorwhocanada@gmail.com>

_realname=libnotify
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.8.8
pkgrel=1
pkgdesc="Desktop notification library (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://gitlab.gnome.org/GNOME/libnotify/"
msys2_repository_url='https://gitlab.gnome.org/GNOME/libnotify/'
license=('spdx:LGPL-2.1')
depends=(
  "${MINGW_PACKAGE_PREFIX}-gdk-pixbuf2"
  "${MINGW_PACKAGE_PREFIX}-glib2"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-docbook-xsl"
  "${MINGW_PACKAGE_PREFIX}-libxslt"
  "${MINGW_PACKAGE_PREFIX}-gi-docgen"
  "${MINGW_PACKAGE_PREFIX}-gobject-introspection"
  "${MINGW_PACKAGE_PREFIX}-gtk4"
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
)
source=("https://download.gnome.org/sources/${_realname}/${pkgver%.*}/${_realname}-${pkgver}.tar.xz"
        "test-fix.patch"
        '0001-fix-gio-unix.patch'
        '0002-fix-header.patch')
sha256sums=('23420ef619dc2cb5aebad613f4823a2fa41c07e5a1d05628d40f6ec4b35bfddd'
            '185e7885512106172627525a4ec1fc18c2f95844f733e49cece325874a55f8e6'
            '6dcf93fa389a646bd6a62689a55c0367906fc259230a6d98daa4f572236136ad'
            'c6adec97b02836185f5f5ac2d2d22e31bdeac7e84f9013bd127a11481060b442')

source "$(dirname ${BASH_SOURCE[0]})"/../mingw-w64-PKGBUILD-common/patch.sh

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"

  apply_patch_with_msg \
    test-fix.patch \
    0001-fix-gio-unix.patch \
    0002-fix-header.patch
}

build() {
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    meson \
      --prefix="${MINGW_PREFIX}" \
      --wrap-mode=nodownload \
      --default-library=both \
      --buildtype=plain \
      -Dtests=false \
      -Dintrospection=enabled \
      -Dman=true \
      -Dgtk_doc=true \
      -Ddocbook_docs=disabled \
      "build-${MSYSTEM}" \
      "${_realname}-${pkgver}"

  meson compile -C "build-${MSYSTEM}"
}

package() {
  meson install -C "build-${MSYSTEM}" --destdir="${pkgdir}"

  install -Dm644 "${srcdir}"/${_realname}-${pkgver}/COPYING \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}/COPYING
}
