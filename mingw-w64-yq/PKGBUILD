# Maintainer: Christoph Reiter <reiter.christoph@gmail.com>

_realname=yq
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=4.53.3
pkgrel=1
pkgdesc="Portable command-line YAML, JSON, INI and XML processor (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://mikefarah.gitbook.io/yq/"
msys2_repository_url="https://github.com/mikefarah/yq"
msys2_references=(
  'anitya: 303696'
  'archlinux: go-yq'
  'gentoo: app-misc/yq-go'
  'purl: pkg:golang/github.com/mikefarah/yq/v4'
)
license=('spdx:MIT')
makedepends=("${MINGW_PACKAGE_PREFIX}-go")
source=("https://github.com/mikefarah/yq/archive/v${pkgver}.tar.gz")
sha256sums=('fadf86d0ae3988bb40fa8aad424d0c71658493f6377285e711c7e7e313b3b238')

build() {
  cd "${_realname}-${pkgver}"
  export GOOS=windows
  export GOROOT=${MINGW_PREFIX}/lib/go
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GO_LDFLAGS="-s -w"
  export GOFLAGS="-trimpath -mod=readonly -modcacherw -ldflags=-linkmode=external"
  case "${CARCH}" in
    x86_64)
      GOFLAGS+=" -buildmode=pie"
      ;;
  esac
  go build -ldflags "${GO_LDFLAGS}" -trimpath -o yq.exe .
}

check() {
  cd "${_realname}-${pkgver}"
  go test ./...
}

package() {
  cd "${_realname}-${pkgver}"
  install -Dm755 yq.exe "${pkgdir}${MINGW_PREFIX}/bin/yq.exe"
  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
  install -Dm644 README.md "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}/README.md"

  local _complete="./${_realname} shell-completion"
  install -Dm644 <($_complete bash) "${pkgdir}${MINGW_PREFIX}/share/bash-completion/completions/${_realname}"
  install -Dm644 <($_complete fish) "${pkgdir}${MINGW_PREFIX}/share/fish/vendor_completions.d/${_realname}.fish"
  install -Dm644 <($_complete zsh) "${pkgdir}${MINGW_PREFIX}/share/zsh/site-functions/_${_realname}"
}
