# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_realname='libjaylink'
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.5.0
pkgrel=1
pkgdesc='Shared library written in C to access SEGGER J-Link and compatible devices (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://gitlab.zapb.de/libjaylink/libjaylink'
msys2_repository_url='https://gitlab.zapb.de/libjaylink/libjaylink'
msys2_changelog_url='https://gitlab.zapb.de/libjaylink/libjaylink/-/blob/master/NEWS'
msys2_references=(
  'anitya: 372323'
  'archlinux: libjaylink'
  'aur:' # ignore libjaylink-git
  'gentoo: dev-embedded/libjaylink'
)
license=('spdx:GPL-2.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-libusb"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
)
conflicts=("${MINGW_PACKAGE_PREFIX}-${_realname}-git")
replaces=("${MINGW_PACKAGE_PREFIX}-${_realname}-git")
source=(
  "https://gitlab.zapb.de/libjaylink/libjaylink/-/archive/${pkgver}/${_realname}-${pkgver}.tar.bz2"
  '010-socket.patch'
  '011-avoid-hidden-visibility.patch'
)
sha256sums=('6c03a9c4d9d781c41ca0f5203e46bebe47ecd5857c6a7d75cbc52accc7be73f8'
            '8b115661829842711c6060afebbf279e2c214a657c92e4a8426ee189ad0d91bd'
            '204e6082b8e55b4ee2d0b3196bf56193fca95e9e6b83ca36478a246b3de24afc')

prepare() {
  cd "${_realname}-${pkgver}"

  patch -Np1 -i "${srcdir}/010-socket.patch"
  patch -Np1 -i "${srcdir}/011-avoid-hidden-visibility.patch"
}

build() {
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    meson setup \
    --prefix="${MINGW_PREFIX}" \
    --wrap-mode=nodownload \
    --buildtype=plain \
    "build-${MSYSTEM}" \
    "${_realname}-${pkgver}"

  meson compile -C "build-${MSYSTEM}"
}

check() {
  meson test -C "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" meson install -C "build-${MSYSTEM}"

  install -Dm644 "${_realname}-${pkgver}/COPYING" -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
