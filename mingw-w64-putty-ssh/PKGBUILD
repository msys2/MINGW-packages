# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=putty-ssh
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.0
pkgrel=5
pkgdesc="A wrapper around plink with some nice features (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://www.wischik.com/lu/programmer/unison-ssh.html"
license=('unknown') # todo: ask author about it
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-putty" # for plink.exe
)
makedepends=("${MINGW_PACKAGE_PREFIX}-cc")
source=("https://www.wischik.com/lu/programmer/unison-ssh.zip")
sha256sums=('2abe49c6df1697de2a31c30d60e680c0a3e5180aa181576250901bda28f63924')

build() {
  ${CXX} ${CXXFLAGS} -o plink-ssh.exe ssh.cpp
}

package() {
  install -Dm755 plink-ssh.exe "${pkgdir}"${MINGW_PREFIX}/bin/plink-ssh.exe
}
