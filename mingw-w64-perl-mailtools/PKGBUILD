# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=MailTools
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=2.22
pkgrel=1
pkgdesc="Bundle of ancient email modules. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/MailTools"
msys2_repository_url="https://github.com/markov2/perl5-MailTools"
msys2_references=(
  'purl: pkg:cpan/MARKOV/MailTools'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-perl"
         "${MINGW_PACKAGE_PREFIX}-perl-timedate")
makedepends=("${MINGW_PACKAGE_PREFIX}-make")
source=("https://cpan.metacpan.org/authors/id/M/MA/MARKOV/${_perlname}-${pkgver}.tar.gz")
sha256sums=('3bf68bb212298fa699a52749dddff35583a74f36a92ca89c843b854f29d87c77')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
}
