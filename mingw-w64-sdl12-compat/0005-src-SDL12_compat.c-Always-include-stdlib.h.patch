From 00a4b7485439fba795f57409ef3e6189a05b3aea Mon Sep 17 00:00:00 2001
From: Zhongteng Gui <dragon-archer@outlook.com>
Date: Wed, 11 Nov 2026 01:30:21 +0800
Subject: [PATCH] src/SDL12_compat.c: Always include <stdlib.h>

Windows static builds now may call abort() as well, so include it
unconditionally to avoid abort() being undeclared.

Signed-off-by: Zhongteng Gui <dragon-archer@outlook.com>
---
 src/SDL12_compat.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/SDL12_compat.c b/src/SDL12_compat.c
index db76421..8212059 100644
--- a/src/SDL12_compat.c
+++ b/src/SDL12_compat.c
@@ -46,9 +46,9 @@
 #include <windows.h>
 #else
 #include <stdio.h> /* fprintf(), etc. */
-#include <stdlib.h>    /* for abort() */
 #include <string.h>
 #endif
+#include <stdlib.h>    /* for abort() */
 
 /* mingw headers may define these ... */
 #undef strtod
-- 
2.56.0.windows.4

