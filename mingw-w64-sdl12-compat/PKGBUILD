# Maintainer: Christoph Reiter <reiter.christoph@gmail.com>

_realname=sdl12-compat
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.2.74
pkgrel=5
pkgdesc="SDL 1.2 runtime compatibility library using SDL 2.0"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://github.com/libsdl-org/sdl12-compat"
msys2_repository_url='https://github.com/libsdl-org/sdl12-compat'
msys2_references=(
  "gentoo: media-libs/libsdl"
)
license=('spdx:Zlib')
conflicts=("${MINGW_PACKAGE_PREFIX}-SDL")
provides=(
  "${MINGW_PACKAGE_PREFIX}-SDL=${pkgver}-${pkgrel}"
  "${MINGW_PACKAGE_PREFIX}-sdl=${pkgver}-${pkgrel}"
)
replaces=("${MINGW_PACKAGE_PREFIX}-SDL")
depends=("${MINGW_PACKAGE_PREFIX}-sdl2")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=(
  "https://github.com/libsdl-org/sdl12-compat/archive/release-${pkgver}.tar.gz"
  "0001-just-build-normal.patch"
  "0002-sdl-config-win-paths.patch"
  '0003-Enable-static-library-support-for-Windows.patch'
  '0004-Make-static-library-really-static-for-MinGW.patch'
  '0005-src-SDL12_compat.c-Always-include-stdlib.h.patch'
  '0006-SDL_stdinc.h-Enable-iconv-support-only-if-both-HAVE_.patch'
  '0007-sdl12_compat.pc.in-Avoid-duplicate-in-Libs.private.patch'
)
sha256sums=('2588686c0972e1785829dc3bf436b543c317e6afa30a9b91d48013dd9c110e81'
            'a368e638dd050042c3811087a63670d61c0234ac252b1f5c10212b4eb835c47c'
            '731f9475c171b034c10d57d2c13fb822cf46fba61b5fc938365c11ca70b2fba7'
            'c4a7ba01c2b33ae2f68ac349f1f4c61afdf02e93f75b98b83ce213b9f1e48f4f'
            '7400147642da70080b74707793b451827604af941294a5362d14c8178b4308a5'
            'fe08cb1209cca3b5cb99a62e72b6da2855758140e623282f054caa6cc461c4e6'
            '55b49a27fab94a21c5901957316a4b6e9357705b0586f5ba69137ebecf6918ff'
            '1795fcc6237842b77615911ae6d884b0ccde5189132301f51ec6637fe4cf750a')

prepare() {
  cd "${_realname}-release-${pkgver}"

  patch -Np1 -i "${srcdir}/0001-just-build-normal.patch"
  patch -Np1 -i "${srcdir}/0002-sdl-config-win-paths.patch"
  # https://github.com/libsdl-org/sdl12-compat/pull/406
  patch -Np1 -i "${srcdir}/0003-Enable-static-library-support-for-Windows.patch"
  patch -Np1 -i "${srcdir}/0004-Make-static-library-really-static-for-MinGW.patch"
  patch -Np1 -i "${srcdir}/0005-src-SDL12_compat.c-Always-include-stdlib.h.patch"
  # https://github.com/libsdl-org/sdl12-compat/pull/407
  patch -Np1 -i "${srcdir}/0006-SDL_stdinc.h-Enable-iconv-support-only-if-both-HAVE_.patch"
  # https://github.com/libsdl-org/sdl12-compat/pull/409
  patch -Np1 -i "${srcdir}/0007-sdl12_compat.pc.in-Avoid-duplicate-in-Libs.private.patch"
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -Wno-author \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${extra_config[@]}" \
      -DBUILD_SHARED_LIBS=ON \
      -DSTATICDEVEL=ON \
      -S "${_realname}-release-${pkgver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

check() {
  ctest --test-dir "build-${MSYSTEM}" --output-on-failure
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "${_realname}-release-${pkgver}/LICENSE.txt" -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/"
}
