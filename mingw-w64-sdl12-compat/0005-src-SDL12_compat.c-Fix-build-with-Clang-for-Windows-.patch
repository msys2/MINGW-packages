From d88d50e9c08277324184f7b4a0ff4dad4468e0f0 Mon Sep 17 00:00:00 2001
From: Zhongteng Gui <dragon-archer@outlook.com>
Date: Wed, 11 Nov 2026 01:30:21 +0800
Subject: [PATCH] src/SDL12_compat.c: Fix build with Clang for Windows on Arm

<windows.h> doesn't guarantee to include <stdlib.h>. Include it unconditonally to avoid abort() being undeclared

Signed-off-by: Zhongteng Gui <dragon-archer@outlook.com>
---
 src/SDL12_compat.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/SDL12_compat.c b/src/SDL12_compat.c
index d86066e..9aa8d46 100644
--- a/src/SDL12_compat.c
+++ b/src/SDL12_compat.c
@@ -46,9 +46,9 @@
 #include <windows.h>
 #else
 #include <stdio.h> /* fprintf(), etc. */
-#include <stdlib.h>    /* for abort() */
 #include <string.h>
 #endif
+#include <stdlib.h>    /* for abort() */
 
 /* mingw headers may define these ... */
 #undef strtod
-- 
2.56.0.windows.4

