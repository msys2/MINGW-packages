From 2e28a17a073952bfd1ec73772933146b81f67e11 Mon Sep 17 00:00:00 2001
From: Zhongteng Gui <dragon-archer@outlook.com>
Date: Wed, 11 Nov 2026 01:22:28 +0800
Subject: [PATCH] SDL_stdinc.h: Enable iconv support only if both HAVE_ICONV
 and HAVE_ICONV_H are defined

Same as https://github.com/libsdl-org/SDL-1.2/commit/f55e9f86591840ea8bf0a0cd25d0126c9a4e6c9d

HAVE_ICONV may be defined by external build system, with HAVE_ICONV_H
not defined, e.g. when building VLC. This will cause errors like:

  In file included from D:/M/msys64/ucrt64/include/SDL/SDL_main.h:29,
                   from D:/M/msys64/ucrt64/include/SDL/SDL.h:29,
                   from D:/M/msys64/ucrt64/include/SDL/SDL_image.h:27,
                   from D:/_/B/src/vlc-3.0.24/modules/codec/sdl_image.c:36:
  D:/M/msys64/ucrt64/include/SDL/SDL_stdinc.h:125:21: error: unknown type name 'iconv_t'; did you mean 'ino_t'?
    125 | #define SDL_iconv_t iconv_t
        |                     ^~~~~~~
  D:/M/msys64/ucrt64/include/SDL/SDL_stdinc.h:133:42: note: in expansion of macro 'SDL_iconv_t'
    133 | extern DECLSPEC size_t SDLCALL SDL_iconv(SDL_iconv_t cd, const char **inbuf, size_t *inbytesleft, char **outbuf, size_t *outbytesleft);
        |                                          ^~~~~~~~~~~

Signed-off-by: Zhongteng Gui <dragon-archer@outlook.com>
---
 include/SDL/SDL_stdinc.h | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/include/SDL/SDL_stdinc.h b/include/SDL/SDL_stdinc.h
index 5f832de..31f8f14 100644
--- a/include/SDL/SDL_stdinc.h
+++ b/include/SDL/SDL_stdinc.h
@@ -108,7 +108,7 @@ SDL_COMPILE_TIME_ASSERT(enum, sizeof(SDL_DUMMY_ENUM) == sizeof(int));
 #ifdef HAVE_CTYPE_H
 #include <ctype.h>
 #endif
-#ifdef HAVE_ICONV_H
+#if defined(HAVE_ICONV) && defined(HAVE_ICONV_H)
 #include <iconv.h>
 #endif
 #ifdef HAVE_ALLOCA_H
@@ -121,7 +121,7 @@ SDL_COMPILE_TIME_ASSERT(enum, sizeof(SDL_DUMMY_ENUM) == sizeof(int));
 not, so we try to #define them to be the C runtime equivalents as possible,
 so things built with these headers will still run against the real SDL 1.2. */
 
-#ifdef HAVE_ICONV
+#if defined(HAVE_ICONV) && defined(HAVE_ICONV_H)
 #define SDL_iconv_t iconv_t
 #define SDL_iconv_open iconv_open
 #define SDL_iconv_close iconv_close
-- 
