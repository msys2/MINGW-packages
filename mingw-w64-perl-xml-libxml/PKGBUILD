# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=XML-LibXML
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=2.0213
pkgrel=1
pkgdesc="Perl Binding for libxml2. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/XML-LibXML"
msys2_repository_url="https://github.com/cpan-authors/XML-LibXML"
msys2_references=(
  'purl: pkg:cpan/TODDR/XML-LibXML'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
groups=("${MINGW_PACKAGE_PREFIX}-perl-modules")
depends=("${MINGW_PACKAGE_PREFIX}-perl"
         "${MINGW_PACKAGE_PREFIX}-perl-alien-libxml2"
         "${MINGW_PACKAGE_PREFIX}-perl-xml-namespacesupport"
         "${MINGW_PACKAGE_PREFIX}-perl-xml-sax"
         "${MINGW_PACKAGE_PREFIX}-libxml2")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-make")
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/T/TO/TODDR/${_perlname}-${pkgver}.tar.gz")
sha256sums=('2af21c5d61ac34ea26a5fabf15ba5a5841e648f7189db3e33b6f28b5489802ab')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  # A hack
  WIN_PREFIX=$(cygpath -m ${MINGW_PREFIX})
  sed -i -e "s|libxml2.a|libxml2.dll.a|g" -e "s|${MINGW_PREFIX}/include|${WIN_PREFIX}/include|g" Makefile
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
  install -Dm644 LICENSE "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE
}
