# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_realname=opensubdiv
pkgbase="mingw-w64-${_realname}"
pkgname=(
  "${MINGW_PACKAGE_PREFIX}-${_realname}"
  "${MINGW_PACKAGE_PREFIX}-${_realname}-docs"
)
pkgver=3.8.0
pkgrel=1
pkgdesc="An Open-Source subdivision surface library (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="http://graphics.pixar.com/opensubdiv"
msys2_repository_url="https://github.com/PixarAnimationStudios/OpenSubdiv"
msys2_references=(
  'anitya: 96394'
  'archlinux: opensubdiv'
  'gentoo: media-libs/opensubdiv'
)
license=('custom:TOST-1.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-omp"
  "${MINGW_PACKAGE_PREFIX}-tbb"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-doxygen"
  "${MINGW_PACKAGE_PREFIX}-glfw"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-opencl-headers"
  "${MINGW_PACKAGE_PREFIX}-opencl-icd"
  "${MINGW_PACKAGE_PREFIX}-ptex"
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-docutils"
  "${MINGW_PACKAGE_PREFIX}-python-pygments"
)
_dirname="OpenSubdiv-${pkgver//./_}"
source=(
  "https://github.com/PixarAnimationStudios/OpenSubdiv/archive/v${pkgver//./_}/OpenSubdiv-${pkgver}.tar.gz"
  002-Fix-building-on-mingw-w64.patch
)
sha256sums=('e5eab30a97c7cce6b5a9905ae488981759c3d86cbce01d58a6c75e1fd9857a2b'
            '36eb46c97db9303a6b8604134a7e92df90ba4495709a73acd5f9419f5927fdd0')

prepare() {
  cd "${_dirname}"

  patch -Np1 -i "${srcdir}/002-Fix-building-on-mingw-w64.patch"

  # Fix missing std::abs definition for Clang
  # https://github.com/PixarAnimationStudios/OpenSubdiv/pull/1407
  sed -i '1i #include <cstdlib>' opensubdiv/bfr/tessellation.cpp
}

build() {
  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  CXXFLAGS+=" -w" \
    MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
    -Wno-author \
    -GNinja \
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
    "${_extra_config[@]}" \
    -DBUILD_SHARED_LIBS=ON \
    -DNO_CLEW=ON \
    -DNO_CUDA=ON \
    -DNO_EXAMPLES=ON \
    -DNO_REGRESSION=ON \
    -DNO_TUTORIALS=ON \
    -DNO_TESTS=ON \
    -DNO_GLTESTS=ON \
    -DPython_EXECUTABLE="${MINGW_PREFIX}/bin/python" \
    -DDXSDK_ROOT="${MINGW_PREFIX}" \
    -S "${_dirname}" \
    -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package_opensubdiv() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  # remove path reference in cmake
  local PREFIX_WIN=$(cygpath -wm "${MINGW_PREFIX}")
  for _f in "${pkgdir}${MINGW_PREFIX}"/lib/cmake/OpenSubdiv/*.cmake; do
    sed -e "s|${PREFIX_WIN}|\$\{_IMPORT_PREFIX\}|g" -i "${_f}"
  done

  # split docs
  mkdir -p "${srcdir}/docs-dest${MINGW_PREFIX}/share"
  mv "${pkgdir}${MINGW_PREFIX}/share/doc" "${srcdir}/docs-dest${MINGW_PREFIX}/share/doc"
}

package_opensubdiv-docs() {
  pkgdesc+=" (documentation)"
  depends=()

  mkdir -p "${pkgdir}${MINGW_PREFIX}/share"
  mv "${srcdir}/docs-dest${MINGW_PREFIX}/share/doc" "${pkgdir}${MINGW_PREFIX}/share/"
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
