# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_realname=sdl-net
_pkgname=SDL_net
pkgbase=mingw-w64-${_realname}
pkgname=${MINGW_PACKAGE_PREFIX}-${_realname}
pkgver=1.2.8
pkgrel=5
pkgdesc="A small sample cross-platform networking library (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://github.com/libsdl-org/SDL_net'
msys2_repository_url="${url}"
license=('spdx:Zlib')
conflicts=("${MINGW_PACKAGE_PREFIX}-SDL_net")
provides=("${MINGW_PACKAGE_PREFIX}-SDL_net=${pkgver}-${pkgrel}")
replaces=("${MINGW_PACKAGE_PREFIX}-SDL_net")
depends=("${MINGW_PACKAGE_PREFIX}-sdl")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-cc"
)
source=(
  "https://libsdl.org/projects/SDL_net/release/${_pkgname}-${pkgver}.tar.gz"
  '001-aarch64.patch'
)
sha256sums=('5f4a7a8bb884f793c278ac3f3713be41980c5eedccecff0260411347714facb4'
            '60048f2cc46720409b42f3b61e6544d24dca69870e059550115f04a842ab1617')

apply_patch_with_msg() {
  for _fname in "$@"
  do
    msg2 "Applying ${_fname}"
    patch -Nbp1 -i "${srcdir}"/${_fname}
  done
}

prepare() {
  cd "${_pkgname}-${pkgver}"

  apply_patch_with_msg \
    001-aarch64.patch
}

build() {
  mkdir -p "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  ../${_pkgname}-${pkgver}/configure \
    --prefix=${MINGW_PREFIX} \
    --enable-shared \
    --enable-static

  make
}

package() {
  cd "build-${MSYSTEM}"

  make DESTDIR="${pkgdir}" install
  install -Dm644 "${srcdir}/${_pkgname}-${pkgver}/COPYING" -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/"
}
