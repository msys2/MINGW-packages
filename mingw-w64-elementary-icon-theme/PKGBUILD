# Maintainer: Alberto Fanjul Alonso <albfan@gnome.org>

_realname=elementary-icon-theme
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=9.0.0
pkgrel=1
pkgdesc="Named, vector icons for elementary OS (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://github.com/elementary/icons"
msys2_repository_url='https://github.com/elementary/icons'
license=('spdx:GPL-3.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-hicolor-icon-theme")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-librsvg"
)
source=("${msys2_repository_url}/archive/refs/tags/${pkgver}.tar.gz"
        0001-Avoid-xcursorgen.patch
        0002-hard-copy-symlinks.patch)
sha256sums=('c8b43a6208145b87355c5d5d3e8b72e35bd1337e8bf76739c6a6e1a691de2b9c'
            '90f03ece84d65bb42aea822cdddcfe61e3cd811d43af44198b73a7e385a54ccf'
            'f5d14abc8bd7eaf16249852b746f77bc80ad7bfd26e6304569c15ff22d693892')
noextract=("${pkgver}.tar.gz")

prepare() {
  bsdtar -xf "${pkgver}.tar.gz" || true

  mv "icons-${pkgver}" "${_realname}-${pkgver}" && cd "${_realname}-${pkgver}"

  patch -p1 -i "${srcdir}/0001-Avoid-xcursorgen.patch"
  patch -p1 -i "${srcdir}/0002-hard-copy-symlinks.patch"
}

build() {
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    meson setup \
      --prefix="${MINGW_PREFIX}" \
      --wrap-mode=nodownload \
      --auto-features=enabled \
      --buildtype=plain \
      -Dvolume_icons=false \
      "build-${MSYSTEM}" \
      "${_realname}-${pkgver}"

  meson compile -C "build-${MSYSTEM}"
}

package() {
  meson install -C "build-${MSYSTEM}" --destdir "${pkgdir}"

  install -Dm644 "${srcdir}/${_realname}-${pkgver}/COPYING" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYING"
}
