# Maintainer: Glarboy <Nahida1O27@aliyun.com>
# Contributor: Tim Stahlhut

_realname=tvision
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=r778.g4ebc188
pkgrel=1
pkgdesc="Modern port of Turbo Vision 2.0 with cross-platform and Unicode support (mingw-w64)"
arch=(any)
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/magiblot/tvision"
license=('spdx:MIT' 'custom:publicdomain')
depends=("${MINGW_PACKAGE_PREFIX}-ncurses")
makedepends=('git'
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-cc")
checkdepends=("${MINGW_PACKAGE_PREFIX}-gtest")
_commit="4ebc188ac88c6dc1bd2d8f122e918f68236d10ee"
source=("${_realname}::git+${url}.git#commit=${_commit}"
        "001-include-stdlib.patch")
sha256sums=('ac32e55c2f11833cb564f77fdb40cffd1dbb36c188717755bb3a2d1ef555275d'
            '64cbf152a09b7848968f6540f785c56130744fe675af3d2195b57337d0438d9b')
msys2_references=(
  "aur: tvision"
)

pkgver() {
  git -C "${_realname}" describe --long --tags | sed 's/^r//;s/-/.r/;s/-/./;s/^[^.]*\.//'
}

prepare() {
  if [[ ${MSYSTEM} == 'CLANGARM64' ]]; then
    cd "${srcdir}/${_realname}"
    patch -p1 -i "${srcdir}/001-include-stdlib.patch"
  fi
}

build() {
  if check_option "debug" "n"; then
    _cmake_opts+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _cmake_opts+=("-DCMAKE_BUILD_TYPE=Debug")
  fi
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -B build-${MSYSTEM} \
      -S "${_realname}" \
      -DCMAKE_INSTALL_PREFIX=${MINGW_PREFIX} \
      "${_cmake_opts[@]}" \
      -DTV_BUILD_AVSCOLOR=ON \
      -DTV_BUILD_EXAMPLES=OFF \
      -DTV_REDUCE_APP_SIZE=ON
  cmake --build build-${MSYSTEM}
}

check() {
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -B build-${MSYSTEM} \
      -DTV_BUILD_TESTS=ON \
      -S "${_realname}"
  cmake --build build-${MSYSTEM}
}

package() {
  DESTDIR="$pkgdir" cmake --install build-${MSYSTEM}
  cd "${_realname}"
  install -Dvm644 COPYRIGHT -t "$pkgdir${MINGW_PREFIX}/share/licenses/${_realname}/"
  install -Dvm644 README.md -t "$pkgdir${MINGW_PREFIX}/share/doc/${_realname}/"
}
