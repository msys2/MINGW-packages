diff --git a/cmake/ssl.cmake b/cmake/ssl.cmake
index 26ebbb17..d62a7cfe 100644
--- a/cmake/ssl.cmake
+++ b/cmake/ssl.cmake
@@ -375,7 +375,10 @@ MACRO (MYSQL_CHECK_SSL)
       HINTS ${OPENSSL_ROOT_DIR}/include
     )
 
-    IF (WIN32)
+    IF (WIN32 AND NOT MINGW AND NOT WIN32_CLANG)
+      # MSVC-only requirement: MSYS2/MinGW OpenSSL is built against the
+      # same CRT as the application, so applink.c is not needed and is
+      # not shipped by the mingw-w64-openssl package.
       FIND_FILE(OPENSSL_APPLINK_C
         NAMES openssl/applink.c
         NO_DEFAULT_PATH
@@ -528,7 +531,13 @@ ENDMACRO(MYSQL_CHECK_SSL)
 # or INSTALL_LIBDIR      (Mac)
 # or INSTALL_PRIV_LIBDIR (Linux)
 MACRO(MYSQL_CHECK_SSL_DLLS)
-  IF (WITH_SSL_PATH AND (APPLE OR WIN32 OR LINUX_STANDALONE OR LINUX_RPM))
+  # Copying OpenSSL DLLs and the openssl binary next to the build
+  # products is an MSVC-only packaging convention. MinGW-w64 builds use
+  # the system OpenSSL package, which already installs the DLLs and the
+  # executable into the prefix; bundling copies here would collide with
+  # the mingw-w64-openssl package and pull my_openssl.exe into the
+  # install rules of a client-only build.
+  IF (WITH_SSL_PATH AND (APPLE OR MSVC OR LINUX_STANDALONE OR LINUX_RPM))
     MESSAGE(STATUS "WITH_SSL_PATH ${WITH_SSL_PATH}")
     IF(LINUX)
       GET_FILENAME_COMPONENT(CRYPTO_EXT "${CRYPTO_LIBRARY}" EXT)
