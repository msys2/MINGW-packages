diff --git a/mysys/my_thr_init.cc b/mysys/my_thr_init.cc
index 0dd4e6a4..27b8d1eb 100644
--- a/mysys/my_thr_init.cc
+++ b/mysys/my_thr_init.cc
@@ -401,8 +401,14 @@ CODE_STATE **my_thread_var_dbug() {
 static void my_sigabrt_handler(int sig [[maybe_unused]]) { __debugbreak(); }
 
 static void install_sigabrt_handler() {
+#if defined(_MSC_VER)
   /*abort() should not override our exception filter*/
   _set_abort_behavior(0, _CALL_REPORTFAULT);
+#endif
+  /*
+    MinGW uses the classic msvcrt import library, which does not export
+    _set_abort_behavior(). The signal() override below is sufficient there.
+  */
   signal(SIGABRT, my_sigabrt_handler);
 }
 #endif
diff --git a/mysys/my_thread.cc b/mysys/my_thread.cc
index 60dfb4d1..0503887e 100644
--- a/mysys/my_thread.cc
+++ b/mysys/my_thread.cc
@@ -240,6 +240,11 @@ void my_thread_self_setname(const char *name [[maybe_unused]]) {
   debuggee & debugger using the special values used below. We use it always in
   case there is a debugger attached, even if the new Win10 API for thread names
   is available. */
+  /* MSVC-style SEH statements: mingw-w64 GCC supports them, but the GNU
+  driver of clang (MSYS2 CLANG64 / CLANGARM64) does not. The thread name
+  has already been set via SetThreadDescription above, so skip the
+  legacy debugger handshake where __try is not available. */
+#if defined(_MSC_VER) || (defined(__GNUC__) && !defined(__clang__))
   constexpr DWORD MS_VC_EXCEPTION = 0x406D1388;
 #pragma pack(push, 8)
   struct THREADNAME_INFO {
@@ -264,6 +269,7 @@ void my_thread_self_setname(const char *name [[maybe_unused]]) {
   } __except (EXCEPTION_EXECUTE_HANDLER) {
   }
 #pragma warning(pop)
+#endif /* _MSC_VER || (GNUC && !clang) */
 
 #else
   /* Do nothing for this platform. */
diff --git a/mysys/stacktrace.cc b/mysys/stacktrace.cc
index 3c69ad3c..8c60662e 100644
--- a/mysys/stacktrace.cc
+++ b/mysys/stacktrace.cc
@@ -620,12 +620,22 @@ void my_create_minidump(const char *name, HANDLE process, DWORD pid) {
 }
 
 void my_safe_puts_stderr(const char *val, size_t len) {
+#if defined(_MSC_VER)
   __try {
     my_write_stderr(val, len);
     my_safe_printf_stderr("%s", "\n");
   } __except (EXCEPTION_EXECUTE_HANDLER) {
     my_safe_printf_stderr("%s", "is an invalid string pointer\n");
   }
+#else
+  /*
+    MinGW GCC does not support MSVC-style __try/__except statements.
+    Fall back to a plain call; the SEH guard only protects against
+    unmapped memory during crash handling.
+  */
+  my_write_stderr(val, len);
+  my_safe_printf_stderr("%s", "\n");
+#endif
 }
 #endif /* _WIN32 */
 
