diff --git a/extra/zstd/CMakeLists.txt b/extra/zstd/CMakeLists.txt
index 483397b8..50ade5de 100644
--- a/extra/zstd/CMakeLists.txt
+++ b/extra/zstd/CMakeLists.txt
@@ -47,7 +47,13 @@ SET(ZSTD_SRCS
 )
 
 IF((LINUX AND NOT LINUX_ARM) OR
-    (APPLE AND NOT APPLE_ARM))
+    (APPLE AND NOT APPLE_ARM) OR
+    (WIN32 AND MY_COMPILER_IS_GNU_OR_CLANG AND
+     CMAKE_SYSTEM_PROCESSOR MATCHES "AMD64|x86_64"))
+  # MinGW GCC/Clang on x86 enable ZSTD_ENABLE_ASM_X86_64_BMI2 on Windows
+  # just like on Linux, so the assembly loop must be built there as well.
+  # MSVC disables the asm code path (no __GNUC__) and needs no assembler,
+  # and Windows on ARM (e.g. MSYS2 CLANGARM64) must use the C loop too.
   ENABLE_LANGUAGE(ASM)
   LIST(APPEND ZSTD_SRCS
     ${ZSTD_VERSION_DIR}/lib/decompress/huf_decompress_amd64.S
