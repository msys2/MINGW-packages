diff --git a/cmake/maintainer.cmake b/cmake/maintainer.cmake
index d5320094..4bcac29f 100644
--- a/cmake/maintainer.cmake
+++ b/cmake/maintainer.cmake
@@ -48,8 +48,10 @@ IF(SIZEOF_VOIDP EQUAL 8)
   STRING_APPEND(MY_WARNING_FLAGS " -Wmissing-format-attribute")
 ENDIF()
 
-# Clang 6.0 and newer on Windows treat -Wall as -Weverything; use /W4 instead
-IF(WIN32_CLANG)
+# clang-cl (MSVC frontend) treats -Wall as -Weverything; use /W4 instead.
+# GNU-frontend clang (MinGW-w64, e.g. MSYS2 CLANG64) uses regular
+# -Wall/-Wextra options; /W4 would be parsed as an input file there.
+IF(WIN32_CLANG AND MSVC)
   STRING(REPLACE "-Wall -Wextra" "/W4" MY_WARNING_FLAGS "${MY_WARNING_FLAGS}")
 ENDIF()
 
diff --git a/cmake/os/Windows.cmake b/cmake/os/Windows.cmake
index aefb9828..b9e7fcea 100644
--- a/cmake/os/Windows.cmake
+++ b/cmake/os/Windows.cmake
@@ -35,8 +35,14 @@ INCLUDE (CheckTypeSize)
 
 IF(MY_COMPILER_IS_CLANG)
   SET(WIN32_CLANG 1)
-  SET(CMAKE_INCLUDE_SYSTEM_FLAG_C "/imsvc ")
-  SET(CMAKE_INCLUDE_SYSTEM_FLAG_CXX "/imsvc ")
+  IF(MSVC)
+    # clang-cl keeps the MSVC driver convention for SYSTEM include
+    # directories. GNU-frontend clang (MinGW-w64, e.g. MSYS2 CLANG64)
+    # keeps the default -isystem flags set up by CMake; /imsvc would be
+    # parsed as an input file there.
+    SET(CMAKE_INCLUDE_SYSTEM_FLAG_C "/imsvc ")
+    SET(CMAKE_INCLUDE_SYSTEM_FLAG_CXX "/imsvc ")
+  ENDIF()
   ADD_DEFINITIONS(-DWIN32_CLANG)
 ENDIF()
 
