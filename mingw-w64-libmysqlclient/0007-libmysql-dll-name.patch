+  # Windows names used across the MySQL client ecosystem: libmysql.dll
+  # and its import library libmysql.dll.a.
+  SET_TARGET_PROPERTIES(libmysql PROPERTIES PREFIX "" IMPORT_PREFIX "")
+ENDIF()
