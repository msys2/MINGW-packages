# Contributer: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_realname=gftl-shared
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.12.0
pkgrel=1
pkgdesc="Provides common gFTL containers of Fortran intrinsic types that are encountered frequently. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/Goddard-Fortran-Ecosystem/gFTL-shared'
license=('spdx:Apache-2.0')
depends=("${MINGW_PACKAGE_PREFIX}-fc-libs"
         "${MINGW_PACKAGE_PREFIX}-gftl") # required by CMake config
makedepends=("${MINGW_PACKAGE_PREFIX}-fc"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja")
source=("${url}/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
        "001-fix-install-destinations.patch")
sha256sums=('38f0353c4d53d474db9d6b301223c2848ac19e5e8c83b136d4c03605ac4bd768'
            '8fb91b50664b8dc6a354c0c5fbca53e1f381b3e66b1979d38439e8bd915ccdca')

prepare() {
  cd "${_realname}-${pkgver}"

  patch -Np1 -i ../001-fix-install-destinations.patch
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${extra_config[@]}" \
      -DBUILD_SHARED_LIBS=ON \
      -S "${_realname}-${pkgver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "${_realname}-${pkgver}"/LICENSE \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE
}
