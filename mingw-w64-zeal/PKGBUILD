# Maintainer: <matheus-catarino@hotmail.com>

_realname=zeal
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.6.1
pkgrel=5
pkgdesc="Offline documentation browser inspired by Dash (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64')
url="https://zealdocs.org"
msys2_repository_url="https://github.com/zealdocs/zeal"
msys2_references=(
  'anitya: 7839'
  'archlinux: zeal'
  'aur:' # ignore zeal-git
  'gentoo: app-text/zeal'
)
license=("spdx:GPL-3.0-only")
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-libarchive"
  "${MINGW_PACKAGE_PREFIX}-qt5-base" # remove for 0.9.2+
  "${MINGW_PACKAGE_PREFIX}-qtwebkit" # remove for 0.9.2+

  # "${MINGW_PACKAGE_PREFIX}-qt6-base" # use for 0.9.2+
  # "${MINGW_PACKAGE_PREFIX}-qt6-svg" # use for 0.9.2+
  # "${MINGW_PACKAGE_PREFIX}-qt6-webchannel" # use for 0.9.2+
  # "${MINGW_PACKAGE_PREFIX}-qt6-webengine" # missing
  "${MINGW_PACKAGE_PREFIX}-sqlite"
  "${MINGW_PACKAGE_PREFIX}-tomlplusplus"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-extra-cmake-modules"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=(
  "https://github.com/zealdocs/${_realname}/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
  "https://github.com/zealdocs/zeal/commit/064aaa05.patch" # remove for 0.9.2+
)
sha256sums=('095c08f9903071849d5c79878abd48237ce1615f16d324afff1873ab6b5f0026'
            '52cb83e1142cf66f572d042e70fe6b07bcc090c25ac6e572eda0ae6e9a429313')


prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"
  patch -p1 -i "${srcdir}/064aaa05.patch"
}

build() {
  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
    -Wno-author \
    -G "Ninja" \
    "${_extra_config[@]}" \
    -DCMAKE_INSTALL_PREFIX=${MINGW_PREFIX} \
    -DZEAL_PORTABLE_BUILD=OFF \
    -S "${_realname}-${pkgver}" \
    -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  # until 0.9.2+
  cd "${srcdir}/build-${MSYSTEM}"
  install -Dm755 bin/zeal.exe "${pkgdir}"${MINGW_PREFIX}/bin/zeal.exe
  # --- until 0.9.2+

  # DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}" # use for 0.9.2+

  cd "${srcdir}/${_realname}-${pkgver}"
  install -Dm644 COPYING -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
