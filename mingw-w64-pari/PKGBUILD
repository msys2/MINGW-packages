# Maintainer: Dirk Stolle

_realname=pari
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2.19.0
pkgrel=1
pkgdesc="Computer algebra system designed for fast computations in number theory (mingw-w64)"
arch=('any')
# There are some problems with ASM code on clang, so no clang environments for now.
mingw_arch=('ucrt64') # 'clang64' 'clangarm64'
url='https://pari.math.u-bordeaux.fr/'
msys2_references=(
  'anitya: 2594'
  'archlinux: pari'
  'gentoo: sci-mathematics/pari'
)
license=('spdx:GPL-2.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-gmp"
  "${MINGW_PACKAGE_PREFIX}-readline"
  # Perl is required for gphelp / interactive help in gp.
  'perl'
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-cc"
)
source=(https://pari.math.u-bordeaux.fr/pub/pari/unix/${_realname}-${pkgver}.tar.gz{,.asc})
sha256sums=('f317b9722eb5d9094a60303774f066f3a83e3ec1f170be8546c44d7583f30b6d'
            'SKIP')

# Bill Allombert <Bill.Allombert@math.u-bordeaux.fr>
validpgpkeys=('42028EA404A2E9D80AC453148F0E7C2B4522E387')

build() {
  # build in place
  cd "${_realname}-${pkgver}"

  # Not using --host="${MINGW_CHOST}" here, because it prevents pari's self-
  # patching for LLP64.

  ./Configure \
    --prefix="${MINGW_PREFIX}" \
    --mt=pthread \
    --with-readline \
    --with-gmp \
    --time=ftime

  make all

  cd Omingw*
  # Somehow pari accidentally defines UNIX, making the compiler run into all sorts of Linux/Unix
  # code that does not work here.
  sed -i 's/#define UNIX/#define _WIN32 1/' paricfg.h
  sed -i '/#define USE_GETTIMEOFDAY 1/c\' paricfg.h
  make lib-sta
  make gp-sta
}

check() {
  cd "${_realname}-${pkgver}"
  cd Omingw*

  # Note #1: Those tests can take a long time to complete.
  # Note #2: Running 'make test-all' would also run tests for the dynamically
  #          linked executable, but we don't package / build that here, so it's
  #          just 'make statest-all' instead.
  make statest-all
}

package() {
  cd "${_realname}-${pkgver}"

#  make install DESTDIR="${pkgdir}"

  cd Omingw*

  make install-doc DESTDIR="${pkgdir}"
  make install-lib-dyn DESTDIR="${pkgdir}"
  make install-lib-sta DESTDIR="${pkgdir}"
  make install-include DESTDIR="${pkgdir}"
  make install-man DESTDIR="${pkgdir}"
  make install-misc DESTDIR="${pkgdir}"
  make install-examples DESTDIR="${pkgdir}"
  make install-cfg DESTDIR="${pkgdir}"
  make install-bin-sta DESTDIR="${pkgdir}"

  install -Dm644 "${srcdir}/${_realname}-${pkgver}/COPYING" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYING"
  install -Dm644 "${srcdir}/${_realname}-${pkgver}/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
