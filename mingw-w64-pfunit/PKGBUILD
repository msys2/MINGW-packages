# Contributer: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_realname=pfunit
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=4.21.0
pkgrel=1
pkgdesc="Parallel Fortran Unit Testing Framework. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/Goddard-Fortran-Ecosystem/pFUnit'
license=('spdx:Apache-2.0')
depends=("${MINGW_PACKAGE_PREFIX}-fc-libs"
         "${MINGW_PACKAGE_PREFIX}-fargparse" # For CMake config
         "${MINGW_PACKAGE_PREFIX}-gftl" # For CMake config
         "${MINGW_PACKAGE_PREFIX}-gftl-shared"
         $([[ ${MINGW_PACKAGE_PREFIX} == *-clang-* ]] || echo "${MINGW_PACKAGE_PREFIX}-libquadmath")
         "${MINGW_PACKAGE_PREFIX}-omp"
         "${MINGW_PACKAGE_PREFIX}-python") # For scripts
makedepends=("${MINGW_PACKAGE_PREFIX}-fc"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja")
checkdepends=("${MINGW_PACKAGE_PREFIX}-pfunit")
source=("${url}/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
        "001-fix-install-destinations.patch")
sha256sums=('e7db886f3512783b9afdf0412bdb9ebec23acded394060752d3746e131bd3e71'
            'a97ffafd2620a7f6e53b46d1d0b61a7378ca004d7345ca6edd4e01c0dfea256d')

prepare() {
  cd "${_realname}-${pkgver}"

  patch -Np1 -i ../001-fix-install-destinations.patch
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${extra_config[@]}" \
      -DBUILD_SHARED_LIBS=ON \
      -DENABLE_TESTS=OFF \
      -DPython_EXECUTABLE=${MINGW_PREFIX}/bin/python \
      -S "${_realname}-${pkgver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

check() {
  cmake -DENABLE_TESTS=ON -S "${_realname}-${pkgver}" -B "build-${MSYSTEM}"
  PATH="${srcdir}"/build-${MSYSTEM}/src/funit:${PATH} \
  cmake --build "build-${MSYSTEM}" --target tests || true
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="-p" python -m compileall \
    -o 0 -o 1 -q -s"${pkgdir}" -p"/" "${pkgdir}${MINGW_PREFIX}"

  install -Dm644 "${_realname}-${pkgver}"/LICENSE \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE
}
