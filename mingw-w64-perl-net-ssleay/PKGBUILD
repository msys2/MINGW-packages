# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=Net-SSLeay
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=1.96
pkgrel=1
pkgdesc="Perl bindings for OpenSSL and LibreSSL. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/Net-SSLeay"
msys2_repository_url="https://github.com/radiator-software/p5-net-ssleay"
msys2_references=(
  'purl: pkg:cpan/CHRISN/Net-SSLeay'
)
license=('spdx:Artistic-2.0')
groups=("${MINGW_PACKAGE_PREFIX}-perl-modules")
depends=("${MINGW_PACKAGE_PREFIX}-perl"
         "${MINGW_PACKAGE_PREFIX}-openssl")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-make")
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/C/CH/CHRISN/${_perlname}-${pkgver}.tar.gz"
        "001-fix-link-to-openssl.patch")
sha256sums=('ab213691685fb2a576c669cbc8d9266f8165a31563ad15b7c4030b94adfc0753'
            'a6c73c35e0d755d5ec8db73b3bf75c15daeeea67c7e083822015b75817c489e7')

prepare() {
  cd ${_perlname}-${pkgver}
  patch -p1 -i "${srcdir}"/001-fix-link-to-openssl.patch
}

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
  install -Dm644 LICENSE "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE
}
