

_realname=pnpm
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=12.8.2
pkgrel=1
pkgdesc='Fast, disk space efficient package manager (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://pnpm.io/'
msys2_repository_url='https://github.com/pnpm/pnpm'
msys2_references=(
  'archlinux: pnpm'
  'aur:' # ignore pnpm-corepack
)
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-nodejs")
test "$MSYSTEM" != "UCRT64" && depends+=("${MINGW_PACKAGE_PREFIX}-libunwind")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-git"
  "${MINGW_PACKAGE_PREFIX}-rust"
)
source=("${_realname}-${pkgver}.tar.gz::${msys2_repository_url}/archive/refs/tags/v${pkgver}.tar.gz"
        'disable-sha2-asm-on-windows.patch')
sha256sums=('80afff26cab9c4cac61a229ae4f5b981ac1feb25206b782c3f0eb7b9c19936c1'
            'fb6bea019138200e0d3bf61711d4e487026bc436f6b077c644d413c2c9182b42')

prepare() {
  cd "${_realname}-${pkgver}"
  rm .cargo/config.toml # remove pnpm managed cargo sources
  patch -Np1 -i "${srcdir}/disable-sha2-asm-on-windows.patch"
  cargo fetch --locked --target "${RUST_CHOST}" --config='net.git-fetch-with-cli=true'
}

build() {
  cd "${_realname}-${pkgver}"

  export RUSTFLAGS="${RUSTFLAGS/+crt-static/-crt-static}"
  cargo build --release --frozen -p pnpm-cli --bin pnpm
}

package() {
  cd "${_realname}-${pkgver}"

  install -Dm755 target/release/pnpm.exe "${pkgdir}${MINGW_PREFIX}/bin/pnpm.exe"
  for alias in pn pnpx pnx; do
    install -Dm755 "pnpm/npm/pnpm/${alias}" -t "${pkgdir}${MINGW_PREFIX}/bin"
  done
  install -Dm644 <(target/release/pnpm completion bash) "${pkgdir}${MINGW_PREFIX}/share/bash-completion/completions/${_realname}"
  install -Dm644 <(target/release/pnpm completion fish) "${pkgdir}${MINGW_PREFIX}/share/fish/vendor_completions.d/${_realname}.fish"
  install -Dm644 <(target/release/pnpm completion zsh) "${pkgdir}${MINGW_PREFIX}/share/zsh/site-functions/_${_realname}"
  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
