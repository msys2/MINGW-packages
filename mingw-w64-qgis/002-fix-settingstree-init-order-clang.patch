+/**
+ * \ingroup core
+ * \brief Pointer-like holder for a statically declared settings tree node.
+ *
+ * It is constant-initialized and only creates the node on first use, so static
+ * settings nodes and entries do not depend on the order in which static
+ * initializers run across translation units. This matters on MinGW with Clang,
+ * where inline variable initializers are emitted as COMDAT constructors that
+ * do not run in declaration order.
+ *
+ * \note Not available in Python bindings
+ */
+template<class T>
+class QgsSettingsTreeNodeLazyPtr
+{
+  public:
+    using Factory = T *( * )();
+
+    constexpr QgsSettingsTreeNodeLazyPtr( Factory factory )
+      : mFactory( factory )
+    {}
+
+    T *get() const
+    {
+      if ( !mNode )
+        mNode = mFactory();
+      return mNode;
+    }
+
+    T *operator->() const { return get(); }
+    operator T *() const { return get(); }
+
+  private:
+    Factory mFactory = nullptr;
+    mutable T *mNode = nullptr;
+};
+
+#endif
