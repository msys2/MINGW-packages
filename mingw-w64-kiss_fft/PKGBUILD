# Maintainer: Alexey Pavlov <alexpux@gmail.com>
# Contributor: Sandro Cumerlato <sandro.cumerlato@gmail.com>

_realname=kiss_fft
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=131.2.0
pkgrel=1
pkgdesc="A Fast Fourier Transform based up on the principle: Keep It Simple, Stupid (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://github.com/mborgerding/kissfft"
msys2_repository_url='https://github.com/mborgerding/kissfft'
license=('spdx:BSD-3-Clause')
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-libpng"
             "${MINGW_PACKAGE_PREFIX}-omp")
optdepends=("${MINGW_PACKAGE_PREFIX}-libpng: for psdpng"
            "${MINGW_PACKAGE_PREFIX}-omp: OpenMP variants")
source=(https://github.com/mborgerding/kissfft/archive/${pkgver}/${_realname}-${pkgver}.tar.gz
        001-fix-build-on-mingw.patch)
sha256sums=('205a8f6a448ef12b091f8ac6a514b5091bb5f6b0b543431ed75f673116cf5cbf'
            'a212aa5b8e73b57ad2cfaf5c496ae8a95d58a49a609745364e02cc08d48b16e0')
datatypes=()
if [[ ${CARCH} == x86_64 ]]; then
  datatypes+=(simd)
fi
datatypes+=(int16_t int32_t double float)

prepare() {
  cd "kissfft-${pkgver}"
  patch -p1 -i ${srcdir}/001-fix-build-on-mingw.patch
}

build() {
  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  for _openmp in OFF ON; do
   for _datatype in ${datatypes[@]}; do
    MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
      "${MINGW_PREFIX}"/bin/cmake.exe \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      -DBUILD_SHARED_LIBS=ON \
      -DKISSFFT_OPENMP=${_openmp} \
      -DKISSFFT_TEST=OFF \
      -DKISSFFT_DATATYPE=${_datatype} \
      "${_extra_config[@]}" \
      -S "kissfft-${pkgver}" \
      -B "build-${MSYSTEM}-${_datatype}-${_openmp}"

    cmake --build build-${MSYSTEM}-${_datatype}-${_openmp}
   done
  done
}

package() {
  for _openmp in OFF ON; do
   for _datatype in ${datatypes[@]}; do
    DESTDIR="${pkgdir}" PREFIX=${MINGW_PREFIX} cmake --install build-${MSYSTEM}-${_datatype}-${_openmp}
   done
  done

  install -Dm644 "${srcdir}"/kissfft-${pkgver}/LICENSES/BSD-3-Clause \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE
}
