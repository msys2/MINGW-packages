# Maintainer: fauxpark <fauxpark@gmail.com>

_realname=libc
_target=avr

pkgbase="mingw-w64-${_target}-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_target}-${_realname}"
pkgver=2.3.2
pkgrel=1
pkgdesc='The C runtime library for the AVR family of microcontrollers (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64')
license=('spdx:BSD-3-Clause')
url='https://github.com/avrdudes/avr-libc'
msys2_repository_url='https://github.com/avrdudes/avr-libc'
groups=("${MINGW_PACKAGE_PREFIX}-${_target}-toolchain")
depends=(
  "${MINGW_PACKAGE_PREFIX}-${_target}-gcc"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
)
options=('!strip')
source=("https://github.com/avrdudes/avr-libc/releases/download/avr-libc-${pkgver//./_}-release/${_target}-${_realname}-${pkgver}.tar.bz2")
sha256sums=('92eb253d30cec94f2861a82d40d0b17ad79c0d95fce32b74ffccc26a70afb150')
validpgpkeys=(
  '56628323218C669FF578705C7E9EADC3030D34EB' # Joerg Wunsch <j.gnu@uriah.heep.sax.de>
)

build() {
  mkdir -p "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  CC=avr-gcc \
    "../${_target}-${_realname}-${pkgver}/configure" \
    --build="${MINGW_CHOST}" \
    --host="${_target}" \
    --prefix="${MINGW_PREFIX}"

  make
}

package() {
  cd "build-${MSYSTEM}"

  make DESTDIR="${pkgdir}" install

  cd "${srcdir}/${_target}-${_realname}-${pkgver}"
  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_target}-${_realname}"
}
