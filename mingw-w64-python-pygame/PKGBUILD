_realname=pygame
pkgbase=mingw-w64-python-${_realname}
pkgname=${MINGW_PACKAGE_PREFIX}-python-${_realname}
pkgver=2.6.1
pkgrel=10
pkgdesc='A Python library for making multimedia applications like games (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://www.pygame.org'
msys2_repository_url="https://github.com/pygame/pygame"
msys2_references=(
  'purl: pkg:pypi/pygame'
)
license=('spdx:LGPL-2.1-only')
depends=(
  # Need cleanup, some may no longer be needed
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-flac"
  "${MINGW_PACKAGE_PREFIX}-freetype"
  "${MINGW_PACKAGE_PREFIX}-libjpeg-turbo"
  "${MINGW_PACKAGE_PREFIX}-libmodplug"
  "${MINGW_PACKAGE_PREFIX}-libogg"
  "${MINGW_PACKAGE_PREFIX}-libpng"
  "${MINGW_PACKAGE_PREFIX}-libtiff"
  "${MINGW_PACKAGE_PREFIX}-libvorbis"
  "${MINGW_PACKAGE_PREFIX}-libwebp"
  "${MINGW_PACKAGE_PREFIX}-mpg123"
  "${MINGW_PACKAGE_PREFIX}-opus"
  "${MINGW_PACKAGE_PREFIX}-opusfile"
  "${MINGW_PACKAGE_PREFIX}-portmidi"
  "${MINGW_PACKAGE_PREFIX}-sdl2"
  "${MINGW_PACKAGE_PREFIX}-sdl2-image"
  "${MINGW_PACKAGE_PREFIX}-sdl2-mixer"
  "${MINGW_PACKAGE_PREFIX}-sdl2-ttf"
  "${MINGW_PACKAGE_PREFIX}-zlib"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cython"
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
  $([[ ${CARCH} == aarch64 ]] && echo "${MINGW_PACKAGE_PREFIX}-sse2neon")
)
source=(
  "https://github.com/pygame/pygame/archive/${pkgver}/${_realname}-${pkgver}.tar.gz"
  '001-setup-fixes.patch'
  '002-aarch64-sse-mmx.patch'
  '003-do-not-redefine-WINVER.patch'
  '004-fix-cython-dict-init.patch'
)
sha256sums=('6a5dd68af93a11ba6eb35c971fa220bf253cebf63b1f54cbe697b30fae9c7c72'
            '1567a433fc8bb60e8bafafd92169372e181907e397736200c8f950a39a4722de'
            '0d03053e33fb794d7eea2a907a015af05a0770f64d30f7bde41b2165bba9fb60'
            'e99eeabb1e506b6932b6e1a40fc771dadfe63ab25dacad25a2bd4d9052eef5c3'
            'e194be812c537e2e28105449db592e1857bf451a28bd4aa1711c28dd46825d53')

apply_patch_with_msg() {
  for _fname in "$@"
  do
    msg2 "Applying ${_fname}"
    patch -Nbp1 -i "${srcdir}"/${_fname}
  done
}

prepare() {
  cd "${_realname}-${pkgver}"

  apply_patch_with_msg \
    001-setup-fixes.patch \
    003-do-not-redefine-WINVER.patch \
    004-fix-cython-dict-init.patch

  if [ "${CARCH}" == "aarch64" ]; then
    apply_patch_with_msg \
      002-aarch64-sse-mmx.patch
  fi
}

build() {
  cp -r "${_realname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  if [ "${CC}" == "clang" ]; then
    CFLAGS+=" -Wno-incompatible-function-pointer-types"
  fi

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix=${MINGW_PREFIX} --destdir="${pkgdir}" dist/*.whl

  install -Dm644 docs/LGPL.txt "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE.txt"
}
