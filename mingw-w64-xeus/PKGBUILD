# Contributor: Dirk Stolle

_realname=xeus
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=6.0.6
pkgrel=1
pkgdesc="Implementation of the Jupyter kernel protocol in C++ (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://xeus.readthedocs.io/'
msys2_repository_url='https://github.com/jupyter-xeus/xeus'
license=('spdx:BSD-3-Clause')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-nlohmann-json"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=(
  "${_realname}-${pkgver}.tar.gz::https://github.com/jupyter-xeus/xeus/archive/$pkgver.tar.gz"
  "0001-cmake.patch"
)
sha256sums=(
  '2cf58d5466a541f7acf668e3500507ca54eb2393780ba3743d94308c24d6ca80'
  'b55fca575cddc9b012bb87cea0a9606bbf4e0ed359e723b0b19270e092c740c9'
)

prepare() {
  cd "${_realname}-${pkgver}"

  patch -Np2 -i ../0001-cmake.patch
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${extra_config[@]}" \
      -DBUILD_{SHARED,STATIC}_LIBS=ON \
      -S "${_realname}-${pkgver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

check() {
  cmake --build "build-${MSYSTEM}" --target test
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "${_realname}-${pkgver}/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
