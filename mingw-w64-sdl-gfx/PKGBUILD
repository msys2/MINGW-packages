# Maintainer: Marty Plummer (The_NetZ) <ntzrmtthihu777 (at) gmail (dot) com>

_realname=sdl-gfx
_pkgname=SDL_gfx
pkgbase=mingw-w64-${_realname}
pkgname=${MINGW_PACKAGE_PREFIX}-${_realname}
pkgver=2.0.27
pkgrel=2
pkgdesc="SDL Graphic Primitives (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://www.ferzkopp.net/wordpress/2016/01/02/sdl_gfx-sdl2_gfx/'
license=('spdx:Zlib')
conflicts=("${MINGW_PACKAGE_PREFIX}-SDL_gfx")
provides=("${MINGW_PACKAGE_PREFIX}-SDL_gfx=${pkgver}-${pkgrel}")
replaces=("${MINGW_PACKAGE_PREFIX}-SDL_gfx")
depends=("${MINGW_PACKAGE_PREFIX}-sdl")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-cc"
)
source=("https://www.ferzkopp.net/Software/SDL_gfx-2.0/${_pkgname}-${pkgver}.tar.gz")
sha256sums=('dfb15ac5f8ce7a4952dc12d2aed9747518c5e6b335c0e31636d23f93c630f419')

prepare() {
  cd "${_pkgname}-${pkgver}"

  autoreconf -fiv
}

build() {
  mkdir -p "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  declare -a _extra_config

  if [[ $CARCH == "aarch64" ]]; then
    _extra_config+=("--disable-mmx")
  fi

  ../${_pkgname}-${pkgver}/configure \
    --prefix=${MINGW_PREFIX} \
    "${_extra_config[@]}" \
    --enable-shared \
    --enable-static

  make
}

package() {
  cd "build-${MSYSTEM}"

  make DESTDIR="${pkgdir}" install
  install -Dm644 "${srcdir}/${_pkgname}-${pkgver}/COPYING" -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/"
}
