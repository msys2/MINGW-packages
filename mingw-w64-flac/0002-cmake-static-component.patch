--- flac-1.5.0.orig/CMakeLists.txt
+++ flac-1.5.0/CMakeLists.txt
@@ -255,8 +255,14 @@
 configure_file(config.cmake.h.in config.h)
 
 if(INSTALL_CMAKE_CONFIG_MODULE)
+    if(BUILD_SHARED_LIBS)
+        set(FLAC_TARGETS_FILE shared-targets.cmake)
+    else()
+        set(FLAC_TARGETS_FILE static-targets.cmake)
+    endif()
     install(
         EXPORT targets
+        FILE ${FLAC_TARGETS_FILE}
         DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/${PROJECT_NAME}"
         NAMESPACE FLAC::)
     export(EXPORT targets NAMESPACE FLAC:: FILE FLACTargets.cmake)
--- flac-1.5.0.orig/flac-config.cmake.in
+++ flac-1.5.0/flac-config.cmake.in
@@ -9,7 +9,18 @@
     find_dependency(Threads)
 endif()
 
-include("${CMAKE_CURRENT_LIST_DIR}/targets.cmake")
+if("static" IN_LIST FLAC_FIND_COMPONENTS)
+    if(NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/static-targets.cmake")
+        set(FLAC_FOUND FALSE)
+        return()
+    endif()
+    include("${CMAKE_CURRENT_LIST_DIR}/static-targets.cmake")
+    set(FLAC_static_FOUND TRUE)
+elseif(EXISTS "${CMAKE_CURRENT_LIST_DIR}/shared-targets.cmake")
+    include("${CMAKE_CURRENT_LIST_DIR}/shared-targets.cmake")
+else()
+    include("${CMAKE_CURRENT_LIST_DIR}/static-targets.cmake")
+endif()
 
 if(TARGET FLAC::FLAC)
     set(FLAC_FLAC_FOUND 1)
