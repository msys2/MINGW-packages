# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_realname=flac
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=1.5.0
pkgrel=3
pkgdesc="Free Lossless Audio Codec (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://xiph.org/flac/"
msys2_repository_url='https://github.com/xiph/flac'
msys2_references=(
  "cpe: cpe:/a:flac_project:flac"
)
license=('spdx:BSD-3-Clause AND GPL-2.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-libogg"
  "${MINGW_PACKAGE_PREFIX}-libwinpthread"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-gettext-tools"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=(
  "https://github.com/xiph/flac/releases/download/${pkgver}/flac-${pkgver}.tar.xz"
  '0001-cmake-fix-find-threads.patch::https://github.com/xiph/flac/commit/100792e9289b4557690f16eb6a40a220977c2e33.patch'
  '0002-cmake-static-component.patch'
)
sha256sums=('f2c1c76592a82ffff8413ba3c4a1299b6c7ab06c734dee03fd88630485c2b920'
            'c59fc0352e5c2ce68066a20df962001d412fb30a3b00f238c33a4be99d6ccbf9'
            'bd8c8c10076fa2b05cd4789fa14ecd9a21f445331e1fcf3d05d71dd9204cc4a5')

prepare() {
  cd "${_realname}-${pkgver}"

  patch -Np1 -i "${srcdir}/0001-cmake-fix-find-threads.patch"
  patch -Np1 -i "${srcdir}/0002-cmake-static-component.patch"
}

build() {
  declare -a _cmake_opts=(
    -Wno-author
    -GNinja
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}"
    -DBUILD_DOCS=OFF
    -DBUILD_TESTING=OFF
    -S "${_realname}-${pkgver}"
  )
  if check_option "debug" "n"; then
    _cmake_opts+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _cmake_opts+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      "${_cmake_opts[@]}" \
      -DBUILD_SHARED_LIBS=OFF \
      -B "build-${MSYSTEM}-static"

  cmake --build "build-${MSYSTEM}-static"

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      "${_cmake_opts[@]}" \
      -DBUILD_SHARED_LIBS=ON \
      -B "build-${MSYSTEM}-shared"

  cmake --build "build-${MSYSTEM}-shared"
}

check() {
  cmake -DBUILD_TESTING=ON -S "${_realname}-${pkgver}" -B "build-${MSYSTEM}-static"
  cmake --build "build-${MSYSTEM}-static"
  ctest --test-dir "build-${MSYSTEM}-static" --output-on-failure

  cmake -DBUILD_TESTING=ON -S "${_realname}-${pkgver}" -B "build-${MSYSTEM}-shared"
  cmake --build "build-${MSYSTEM}-shared"
  ctest --test-dir "build-${MSYSTEM}-shared" --output-on-failure
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}-static"

  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}-shared"

  install -Dm644 "${_realname}-${pkgver}/COPYING".{GPL,Xiph} -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/"
}
