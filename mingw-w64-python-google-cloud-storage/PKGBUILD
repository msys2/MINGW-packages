# Maintainer: Sarah Ottinger <schalaalexiazeal@gmail.com>

_realname='google-cloud-storage'
_pyname="${_realname//-/_}"
pkgbase="mingw-w64-python-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-python-${_realname}"
pkgver=3.15.0
pkgrel=1
pkgdesc='Google Cloud Storage API client library (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/googleapis/google-cloud-python/tree/main/packages/google-cloud-storage'
msys2_repository_url='https://github.com/googleapis/google-cloud-python/tree/main/packages/google-cloud-storage'
msys2_changelog_url='https://github.com/googleapis/google-cloud-python/blob/main/packages/google-cloud-storage/CHANGELOG.md'
msys2_references=(
  'anitya: 34637'
  'aur: python-google-cloud-storage'
  'purl: pkg:pypi/google-cloud-storage'
)
license=('spdx:Apache-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-google-api-core"
  "${MINGW_PACKAGE_PREFIX}-python-google-auth"
  "${MINGW_PACKAGE_PREFIX}-python-google-cloud-core"
  "${MINGW_PACKAGE_PREFIX}-python-google-crc32c"
  "${MINGW_PACKAGE_PREFIX}-python-google-resumable-media" # https://github.com/googleapis/google-cloud-python/blob/google-cloud-storage-v3.14.1/packages/google-cloud-storage/setup.py#L48
  "${MINGW_PACKAGE_PREFIX}-python-requests"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
source=("https://pypi.org/packages/source/${_pyname::1}/${_realname}/${_pyname}-${pkgver}.tar.gz")
sha256sums=('110041ee1cb566114015aa7c2492f1ff18c92af528588386663f4b41b6279989')

build() {
  cp -r "${_pyname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
