# Maintainer: Glarboy <Nahida1027@aliyun.com>

_realname=resvg
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}"
         "${MINGW_PACKAGE_PREFIX}-${_realname}-docs")
pkgver=0.48.1
pkgrel=1
pkgdesc="An SVG rendering library and CLI application"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/linebender/resvg"
msys2_repository_url="https://github.com/linebender/resvg"
license=('spdx:Apache-2.0 OR MIT')
optdepends=("${MINGW_PACKAGE_PREFIX}-qt6-base: for the Qt backend")
makedepends=("${MINGW_PACKAGE_PREFIX}-rust"
             "${MINGW_PACKAGE_PREFIX}-cargo-c"
             "${MINGW_PACKAGE_PREFIX}-qt6-base"
             "${MINGW_PACKAGE_PREFIX}-qt6-tools"
             "${MINGW_PACKAGE_PREFIX}-make")
# release page provide vendor toolbar (bundle with dependencies)
source=("${url}/releases/download/v${pkgver}/${_realname}-${pkgver}.tar.xz")
sha256sums=('13ed5a2bae7a01156288ecae5bf944cf7d1c572742c19fc68027947a4d87294c')
# because a symlink in the tar.xz which lead to bsdtar uncompress fail, extract in prepare() instead
noextract=("${_realname}-${pkgver}.tar.xz")

prepare() {
  tar -xf "${_realname}-${pkgver}.tar.xz" -C "${srcdir}" || true
  cd "${_realname}-${pkgver}"
  mv .cargo/config .cargo/config.toml
}

build() {
  cd "${_realname}-${pkgver}"
  cargo build --frozen --profile production -p resvg -p usvg --all-features
  cargo cbuild --frozen --profile production -p resvg-capi --all-features
  cargo doc --frozen --profile production --no-deps -p resvg-capi --all-features

  (
    cd tools/viewsvg
    qmake PREFIX="${MINGW_PREFIX}" \
      LIBS+="-L${srcdir}/${_realname}-${pkgver}/target/${RUST_CHOST}/production/"
    mingw32-make
  )
}

check() {
  cd "${_realname}-${pkgver}"

  cargo test --frozen --profile production -p resvg -p usvg --all-features
}

package_resvg() {
  cd "${_realname}-${pkgver}"

  install -Dm755 \
    -t "${pkgdir}${MINGW_PREFIX}/bin/" \
    target/production/{resvg,usvg} \
    tools/viewsvg/release/viewsvg

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    cargo cinstall \
      --meson-paths \
      --profile production \
      --frozen \
      --all-features \
      -p resvg-capi \
      --prefix="${MINGW_PREFIX}" \
      --destdir="${pkgdir}"
  
  install -Dm644 LICENSE* -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}

package_resvg-docs() {
  cd "${_realname}-${pkgver}"

  pkgdesc+=" (documentation)"
  depends=()

  install -d "${pkgdir}${MINGW_PREFIX}/share/doc/resvg"
	cp -r target/doc/* "${pkgdir}${MINGW_PREFIX}/share/doc/resvg"
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
