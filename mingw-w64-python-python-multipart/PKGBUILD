# Maintainer: Konstantin Podsvirov <konstantin@podsvirov.su>

_realname=python-multipart
_pyname="${_realname/-/_}"
pkgbase="mingw-w64-python-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.0.33
pkgrel=1
pkgdesc='A streaming multipart parser for Python (mingw-w64)'
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://multipart.fastapiexpert.com/'
msys2_repository_url='https://github.com/Kludex/python-multipart'
msys2_changelog_url='https://multipart.fastapiexpert.com/changelog/'
msys2_references=(
  'cpe: cpe:2.3:a:fastapiexpert:python-multipart'
  'purl: pkg:pypi/python-multipart'
)
license=('spdx:Apache-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-hatchling"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
)
source=("https://pypi.org/packages/source/${_realname::1}/${_realname}/${_pyname}-${pkgver}.tar.gz")
sha256sums=('b8112424a6abd162ec08d390565dd113ad699f2fe6fef3c987b8bbcbfe9e390d')

prepare() {
  cp -r "${_pyname}-${pkgver}" "build-${MSYSTEM}"
}

build() {
  cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    "${MINGW_PREFIX}"/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE.txt -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
