# Maintainer: Joel Holdsworth <jholdsworth@nvidia.com>

_realname=test2ref
pkgbase="mingw-w64-python-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-python-${_realname}"
pkgver=1.3.0
pkgrel=1
pkgdesc='Python Testing Against Learned Reference Data (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/nbiotcloud/test2ref'
msys2_repository_url='https://github.com/nbiotcloud/test2ref'
msys2_issue_tracker_url='https://github.com/nbiotcloud/test2ref/issues'
msys2_documentation_url='https://test2ref.readthedocs.io/en/stable/'
msys2_references=(
  'archlinux: python-test2ref'
  'gentoo: dev-python/test2ref'
  'purl: pkg:pypi/test2ref'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-binaryornot"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-pdm-backend"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-binaryornot"
  "${MINGW_PACKAGE_PREFIX}-python-pytest"
  "${MINGW_PACKAGE_PREFIX}-python-pytest-cov"
)
options=('!strip')
source=(
  "https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz"
)
sha256sums=('c00bb026734164eb02945289e6388215497dad8a648c138ecd4b19d0ef53e6a5')

build() {
  cp -r "${_realname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "build-${MSYSTEM}"

  python -m pytest || warning "Tests failed"
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
