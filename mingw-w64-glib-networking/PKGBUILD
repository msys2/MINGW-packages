# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_realname=glib-networking
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=2.90.1
pkgrel=1
pkgdesc="Network-related GIO modules for glib (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://gitlab.gnome.org/GNOME/glib-networking"
msys2_repository_url='https://gitlab.gnome.org/GNOME/glib-networking'
msys2_references=(
  'archlinux: glib-networking'
  'aur:' # ignore glib-networking-gnutls-openssl
  'cpe: cpe:/a:gnome:glib-networking'
  'gentoo: net-libs/glib-networking'
)
license=('spdx:LGPL-2.1-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-gettext-runtime"
  "${MINGW_PACKAGE_PREFIX}-glib2"
  "${MINGW_PACKAGE_PREFIX}-gnutls"
  "${MINGW_PACKAGE_PREFIX}-gsettings-desktop-schemas"
  "${MINGW_PACKAGE_PREFIX}-libproxy"
  "${MINGW_PACKAGE_PREFIX}-openssl"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-gettext-tools"
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
)
source=(
  "https://download.gnome.org/sources/${_realname}/${pkgver%.*}/${_realname}-${pkgver}.tar.xz"
)
sha256sums=('ea95636590098355a05e3027579dba1a9a950b05e456b2488ea03d82e4b6c18a')

build() {
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    meson setup \
    --prefix="${MINGW_PREFIX}" \
    --buildtype=plain \
    --wrap-mode=nodownload \
    --auto-features=enabled \
    -Dopenssl=enabled \
    -Dtests=false \
    "build-${MSYSTEM}" \
    "${_realname}-${pkgver}"

  meson compile -C "build-${MSYSTEM}"
}

check() {
  meson test -C "build-${MSYSTEM}" || true
}

package() {
  meson install -C "build-${MSYSTEM}" --destdir "${pkgdir}"

  rm -f "${pkgdir}${MINGW_PREFIX}/lib/gio/modules/"*.a
  # Remove non-applicable systemd files
  rm -rf "${pkgdir}${MINGW_PREFIX}/lib/systemd"

  if [[ -f "${pkgdir}${MINGW_PREFIX}/share/dbus-1/services/org.gtk.GLib.PACRunner.service" ]]; then
    local _prefix_win
    _prefix_win=$(cygpath -wm "${MINGW_PREFIX}")

    sed -i -e "s|${_prefix_win}|${MINGW_PREFIX}|g" \
      "${pkgdir}${MINGW_PREFIX}/share/dbus-1/services/org.gtk.GLib.PACRunner.service"
  fi

  cd "${srcdir}/${_realname}-${pkgver}"
  install -Dm644 COPYING -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
