_realname=mfem
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=4.10
pkgrel=1
pkgdesc='Lightweight, general, scalable C++ library for finite element methods (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://mfem.org/'
msys2_repository_url='https://github.com/mfem/mfem'
license=('spdx:BSD-3-Clause')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-adios2"
  "${MINGW_PACKAGE_PREFIX}-ginkgo"
  "${MINGW_PACKAGE_PREFIX}-hdf5"
  #$([[ ${CARCH} == aarch64 ]] || echo "${MINGW_PACKAGE_PREFIX}-hypre")
  "${MINGW_PACKAGE_PREFIX}-netcdf"
  "${MINGW_PACKAGE_PREFIX}-metis"
  "${MINGW_PACKAGE_PREFIX}-mpfr"
  #$([[ ${CARCH} == aarch64 ]] || echo "${MINGW_PACKAGE_PREFIX}-mumps")
  "${MINGW_PACKAGE_PREFIX}-omp"
  "${MINGW_PACKAGE_PREFIX}-openblas"
  #$([[ ${CARCH} == aarch64 ]] || echo \
    #"${MINGW_PACKAGE_PREFIX}-petsc" \
    #"${MINGW_PACKAGE_PREFIX}-slepc" \
  #$([[ ${CARCH} == aarch64 ]] || echo "${MINGW_PACKAGE_PREFIX}-strumpack")
  "${MINGW_PACKAGE_PREFIX}-suitesparse"
  #"${MINGW_PACKAGE_PREFIX}-sundials"
  #$([[ ${CARCH} == aarch64 ]] || echo "${MINGW_PACKAGE_PREFIX}-superlu")
  "${MINGW_PACKAGE_PREFIX}-zlib"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  #"${MINGW_PACKAGE_PREFIX}-fc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  #$([[ ${CARCH} == aarch64 ]] || echo "${MINGW_PACKAGE_PREFIX}-msmpi")
)
source=("$msys2_repository_url/archive/v$pkgver/${_realname}-${pkgver}.tar.gz")
sha256sums=('d5aabe991b8b5569aa26e2b5d4b59ac617ee10ebac3d45fd6ff9c74b2c1a47dd')

apply_patch_with_msg() {
  for _patch in "$@"; do
    msg2 "Applying ${_patch}"
    patch -Np1 -i "${srcdir}/$_patch"
  done
}

build() {
  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
    -GNinja \
    "${_extra_config[@]}" \
    -DCMAKE_INSTALL_PREFIX=${MINGW_PREFIX} \
    -DBUILD_SHARED_LIBS=ON \
    -DMFEM_USE_ADIOS2=ON \
    -DMFEM_USE_HDF5=ON \
    -DMFEM_USE_HYPRE=OFF \
    -DMFEM_USE_LAPACK=ON \
    -DMFEM_USE_MEMALLOC=ON \
    -DMFEM_USE_METIS=ON \
    -DMFEM_USE_MPFR=ON \
    -DMFEM_USE_MPI=OFF \
    -DMFEM_USE_MUMPS=OFF \
    -DMFEM_USE_NETCDF=ON \
    -DMFEM_USE_OPENMP=ON \
    -DMFEM_USE_PETSC=OFF \
    -DMFEM_USE_SLEPC=OFF \
    -DMFEM_USE_STRUMPACK=OFF \
    -DMFEM_USE_SUITESPARSE=ON \
    -DMFEM_USE_SUNDIALS=OFF \
    -DMFEM_USE_SUPERLU=OFF \
    -DMFEM_USE_GINKGO=ON \
    -DMFEM_USE_ZLIB=ON \
    -DMFEM_ENABLE_TESTING=OFF \
    -DMFEM_ENABLE_EXAMPLES=OFF \
    -DMFEM_ENABLE_MINIAPPS=OFF \
    -DBLA_VENDOR=OpenBLAS \
    -DHDF5_DIR=${MINGW_PREFIX} \
    -DADIOS2_LIBRARY=${MINGW_PREFIX}/lib/libadios2_cxx.dll.a \
    -S ${_realname}-${pkgver} \
    -B build-${MSYSTEM}

  cmake --build build-${MSYSTEM}
}

package() {
  #Shared Install
  DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM}

  install -Dm644 "${srcdir}"/${_realname}-${pkgver}/LICENSE "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE
  install -Dm644 "${srcdir}"/${_realname}-${pkgver}/README.md "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}/README
  install -Dm644 "${srcdir}"/${_realname}-${pkgver}/NOTICE "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}/NOTICE

  local PREFIX_WIN=$(cygpath -wm ${MINGW_PREFIX})
  for _f in $(find "${pkgdir}${MINGW_PREFIX}"/lib/cmake -type f); do
    sed -e "s|${PREFIX_WIN}|\$\{_IMPORT_PREFIX\}|g" -i ${_f}
    sed -e "s|${MINGW_PREFIX}|\$\{_IMPORT_PREFIX\}|g" -i ${_f}
  done
}
