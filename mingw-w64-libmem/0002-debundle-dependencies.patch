+			INPUT "${CMAKE_CURRENT_BINARY_DIR}/libmem-static.pc.cf")
+		install(
+			FILES "${CMAKE_CURRENT_BINARY_DIR}/libmem-static.pc"
+			DESTINATION "lib/pkgconfig")
+	else()
