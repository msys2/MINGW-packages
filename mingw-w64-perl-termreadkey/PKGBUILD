# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=TermReadKey
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=2.38
pkgrel=1
pkgdesc="A perl module for simple terminal control. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/TermReadKey"
msys2_repository_url="https://github.com/jonathanstowe/TermReadKey"
msys2_references=(
  'purl: pkg:cpan/JSTOWE/TermReadKey'
  'archlinux: perl-term-readkey'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-perl")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-make")
source=("https://cpan.metacpan.org/authors/id/J/JS/JSTOWE/${_perlname}-${pkgver}.tar.gz")
sha256sums=('5a645878dc570ac33661581fbb090ff24ebce17d43ea53fd22e105a856a47290')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
}
