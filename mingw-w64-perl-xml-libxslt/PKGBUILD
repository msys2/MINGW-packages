# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=XML-LibXSLT
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=2.003000
pkgrel=1
pkgdesc="Interface to the GNOME libxslt library. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/XML-LibXSLT"
msys2_repository_url="https://github.com/shlomif/perl-XML-LibXSLT"
msys2_references=(
  'purl: pkg:cpan/SHLOMIF/XML-LibXSLT'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
groups=("${MINGW_PACKAGE_PREFIX}-perl-modules")
depends=("${MINGW_PACKAGE_PREFIX}-perl"
         "${MINGW_PACKAGE_PREFIX}-perl-xml-libxml"
         "${MINGW_PACKAGE_PREFIX}-libxml2"
         "${MINGW_PACKAGE_PREFIX}-libxslt")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-make"
             "${MINGW_PACKAGE_PREFIX}-pkgconf")
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/S/SH/SHLOMIF/${_perlname}-${pkgver}.tar.gz"
        "001-fix-build-on-mingw.patch")
sha256sums=('7caa5aee72f53be59d8b84eecb6864a07c612a12ea6b27d5c706960edcd54587'
            '16b91766856340841dfc4a6d6ec4ba349bf5e2be52476d7fb45c0c7be31aac7b')

prepare() {
  cd ${_perlname}-${pkgver}
  patch -p1 -i "${srcdir}"/001-fix-build-on-mingw.patch
}

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  # A hack
  sed -i -e "s|libxml2.a|libxml2.dll.a|g" -e "s|libxslt.a|libxslt.dll.a|g" -e "s|libexslt.a|libexslt.dll.a|g" Makefile
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
  install -Dm644 LICENSE "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE
}
