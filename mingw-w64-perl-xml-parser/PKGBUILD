# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=XML-Parser
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=2.59
pkgrel=1
pkgdesc="A perl module for parsing XML documents. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/XML-Parser"
msys2_repository_url="https://github.com/cpan-authors/XML-Parser"
msys2_references=(
  'purl: pkg:cpan/TODDR/XML-Parser'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-perl"
         "${MINGW_PACKAGE_PREFIX}-perl-file-sharedir"
         "${MINGW_PACKAGE_PREFIX}-expat")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-make"
             "${MINGW_PACKAGE_PREFIX}-pkgconf"
             "${MINGW_PACKAGE_PREFIX}-perl-file-sharedir-install")
source=("https://cpan.metacpan.org/authors/id/T/TO/TODDR/${_perlname}-${pkgver}.tar.gz")
sha256sums=('a358fd7c49f5e27717a644a9102bd21dc7fc25a415983279c59b1580e2b62a58')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  # A hack
  sed -i -e "s|libexpat.a|libexpat.dll.a|g" Expat/Makefile
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
  install -Dm644 LICENSE "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE
}
