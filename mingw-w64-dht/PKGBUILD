# Contributor: fauxpark <fauxpark@gmail.com>

_realname=dht
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.28
pkgrel=1
pkgdesc='BitTorrent DHT library (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/jech/dht'
msys2_repository_url='https://github.com/jech/dht'
msys2_references=(
  'anitya: 242783'
  'archlinux: dht'
)
license=('spdx:MIT')
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=(
  "https://github.com/jech/dht/archive/${_realname}-${pkgver}.tar.gz"
  "dht-cmake.patch::https://github.com/transmission/dht/commit/b02da598.patch"
)
sha256sums=('2f91db29636ca84503b4bb59d7a4a6a681c3a547e12ef775f83e99b69be92f2d'
            '91fb75029bf04456bb7fd9c7cc14d544e906d35a309cc8de5be081049aeb7649')

prepare() {
  mv "${_realname}-${_realname}-${pkgver}" "${_realname}-${pkgver}"
  cd "${_realname}-${pkgver}"

  patch -Np1 -i "${srcdir}/dht-cmake.patch"
}

build() {
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      -DCMAKE_INSTALL_INCLUDEDIR='include/dht' \
      -DCMAKE_BUILD_TYPE='Release' \
      -S "${_realname}-${pkgver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  cd "${_realname}-${pkgver}"
  install -Dm644 LICENCE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
