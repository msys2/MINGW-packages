diff --git a/libsecret/secret-file-collection.c b/libsecret/secret-file-collection.c
index d528023..5b4d6f0 100644
--- a/libsecret/secret-file-collection.c
+++ b/libsecret/secret-file-collection.c
@@ -21,8 +21,14 @@
 
 #include <glib/gstdio.h>
 
+#ifndef _WIN32
 #include <sys/file.h>
+#else
+#include <windows.h>
+#include <io.h>
+#endif
 #include <errno.h>
+#include <fcntl.h>
 
 EGG_SECURE_DECLARE (secret_file_collection);
 
@@ -833,7 +839,11 @@ secret_file_collection_lock (SecretFileCollection *self,
 	path = g_file_peek_path (self->file);
 	lock_path = g_strdup_printf ("%s.lock", path);
 
+#ifdef _WIN32
+	fd = g_open (lock_path, O_CREAT | O_RDWR | _O_BINARY | _O_NOINHERIT, 0600);
+#else
 	fd = g_open (lock_path, O_CREAT | O_RDWR, 0600);
+#endif
 	if (fd < 0) {
 		errsv = errno;
 		g_set_error (error, G_IO_ERROR,
@@ -843,6 +853,25 @@ secret_file_collection_lock (SecretFileCollection *self,
 		g_free (lock_path);
 		return -1;
 	}
+#ifdef _WIN32
+	{
+		HANDLE h = (HANDLE) _get_osfhandle (fd);
+		OVERLAPPED ov;
+
+		memset (&ov, 0, sizeof ov);
+		if (h == INVALID_HANDLE_VALUE ||
+		    !LockFileEx (h, LOCKFILE_EXCLUSIVE_LOCK, 0, 1, 0, &ov)) {
+			gchar *msg = g_win32_error_message (GetLastError ());
+			g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+			             "couldn't lock keyring file %s: %s",
+			             lock_path, msg);
+			g_free (msg);
+			g_free (lock_path);
+			close (fd);
+			return -1;
+		}
+	}
+#else
 	do {
 		ret = flock (fd, LOCK_EX);
 	} while (ret < 0 && errno == EINTR);
@@ -857,6 +886,7 @@ secret_file_collection_lock (SecretFileCollection *self,
 		close (fd);
 		return -1;
 	}
+#endif
 	g_free (lock_path);
 
 	/* Force reload regardless of mtime, since mtime has only
@@ -872,5 +902,15 @@ void
 secret_file_collection_unlock (int lock_fd)
 {
 	if (lock_fd >= 0)
-		close (lock_fd);
+		return;
+#ifdef _WIN32
+	{
+		HANDLE h = (HANDLE) _get_osfhandle (lock_fd);
+		OVERLAPPED ov;
+		memset (&ov, 0, sizeof ov);
+		if (h != INVALID_HANDLE_VALUE)
+			UnlockFileEx (h, 0, 1, 0, &ov);
+	}
+#endif
+	close (lock_fd);
 }
