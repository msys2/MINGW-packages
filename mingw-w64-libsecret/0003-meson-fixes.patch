diff --git a/meson.build b/meson.build
index 7ba80f8..6fc49ed 100644
--- a/meson.build
+++ b/meson.build
@@ -23,13 +23,17 @@ libsecret_prefix = get_option('prefix')
 po_dir = meson.source_root() / 'po'
 cc = meson.get_compiler('c')
 
+is_windows = host_machine.system() == 'windows'
+
 # Dependencies
 min_glib_version = '2.44'
 glib_deps = [
   dependency('glib-2.0', version: '>=' + min_glib_version),
   dependency('gio-2.0', version: '>=' + min_glib_version),
-  dependency('gio-unix-2.0', version: '>=' + min_glib_version),
 ]
+if not is_windows
+  glib_deps += dependency('gio-unix-2.0', version: '>=' + min_glib_version)
+endif
 
 with_gcrypt = false
 with_gnutls = false
diff --git a/egg/meson.build b/egg/meson.build
index 79608de..f3d7dee 100644
--- a/egg/meson.build
+++ b/egg/meson.build
@@ -1,10 +1,12 @@
 libegg_sources = [
   'egg-hex.c',
   'egg-secure-memory.c',
-  'egg-unix-credentials.c',
   'egg-buffer.c',
   'egg-testing.c',
 ]
+if not is_windows
+libegg_sources += [ 'egg-unix-credentials.c' ]
+endif
 
 libegg_deps = [
   glib_deps,
