# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=libwww-perl
_realname=libwww
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=6.83
pkgrel=2
pkgdesc="The World-Wide Web library for Perl. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/libwww-perl"
msys2_repository_url="https://github.com/libwww-perl/libwww-perl"
msys2_references=(
  'purl: pkg:cpan/OALDERS/libwww-perl'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-perl"
         "${MINGW_PACKAGE_PREFIX}-perl-encode-locale"
         "${MINGW_PACKAGE_PREFIX}-perl-file-listing"
         "${MINGW_PACKAGE_PREFIX}-perl-html-parser"
         "${MINGW_PACKAGE_PREFIX}-perl-http-cookiejar"
         "${MINGW_PACKAGE_PREFIX}-perl-http-cookies"
         "${MINGW_PACKAGE_PREFIX}-perl-http-daemon"
         "${MINGW_PACKAGE_PREFIX}-perl-http-date"
         "${MINGW_PACKAGE_PREFIX}-perl-http-negotiate"
         "${MINGW_PACKAGE_PREFIX}-perl-lwp-mediatypes"
         "${MINGW_PACKAGE_PREFIX}-perl-net-http"
         "${MINGW_PACKAGE_PREFIX}-perl-try-tiny"
         "${MINGW_PACKAGE_PREFIX}-perl-uri"
         "${MINGW_PACKAGE_PREFIX}-perl-www-robotrules")
makedepends=("${MINGW_PACKAGE_PREFIX}-make")
source=("https://cpan.metacpan.org/authors/id/O/OA/OALDERS/${_perlname}-${pkgver}.tar.gz")
sha256sums=('e75f0fa9d3c6f0daf5a5a72fa9f8b1c9c0d23e3a84a8522ccb4f835232b95505')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
  install -Dm644 LICENSE "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE
}
