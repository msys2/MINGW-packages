# Maintainer: Dirk Stolle

_realname=gmp-ecm
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=7.0.7
pkgrel=1
pkgdesc='Elliptic Curve Method for Integer Factorization (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://gitlab.inria.fr/zimmerma/ecm'
msys2_repository_url='https://gitlab.inria.fr/zimmerma/ecm'
msys2_changelog_url='https://gitlab.inria.fr/zimmerma/ecm/-/blob/master/NEWS'
msys2_references=(
  'anitya: 231466'
  'archlinux: gmp-ecm'
  'gentoo: sci-mathematics/gmp-ecm'
)
license=('spdx:GPL-3.0-or-later' 'spdx:LGPL-3.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-gmp"
  "${MINGW_PACKAGE_PREFIX}-omp"
  "${MINGW_PACKAGE_PREFIX}-primesieve"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-cc"
  "git"
)
source=("git+https://gitlab.inria.fr/zimmerma/ecm.git#tag=git-${pkgver}")
sha256sums=('681d8c5d5922d33da39a510de11494b247dace926fe4bac8f75cda37e7e7bae8')

prepare() {
  cd ecm

  autoreconf -fiv
}

build() {
  cd ecm

  ./configure \
    --prefix="${MINGW_PREFIX}" \
    --build="${MINGW_CHOST}" \
    --host="${MINGW_CHOST}" \
    --target="${MINGW_CHOST}" \
    --enable-openmp \
    --enable-static \
    --enable-shared

  make
}

check() {
  cd ecm

  make check
}

package() {
  cd ecm

  make install DESTDIR="${pkgdir}"

  install -Dm644 COPYING "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYING"
  install -Dm644 COPYING.LIB "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYING.LIB"
}
