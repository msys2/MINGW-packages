# Maintainer: Wu, Zhenyu <wuzhenyu@ustc.edu>

_realname=panache
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=3.16.0
pkgrel=1
pkgdesc="A language server, formatter, and linter for Pandoc, Quarto, and R Markdown (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/jolars/panache'
msys2_repository_url='https://github.com/jolars/panache'
msys2_references=(
  'purl: pkg:cargo/panache'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-rust"
)
source=("${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('6f2fe2fba47313585d62ef2546a746c738757306fd2337f7022ce9e16eca5fbf')

prepare() {
  cd "${_realname}-${pkgver}"

  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${_realname}-${pkgver}"

  export RUSTFLAGS="${RUSTFLAGS/+crt-static/-crt-static}"
  cargo build --release --frozen
}

package() {
  cd "${_realname}-${pkgver}"

  install -Dm755 target/release/panache.exe -t "${pkgdir}${MINGW_PREFIX}/bin"

  install -Dm644 target/completions/panache.bash "${pkgdir}${MINGW_PREFIX}/share/bash-completion/completions/panache"
  install -Dm644 target/completions/panache.fish "${pkgdir}${MINGW_PREFIX}/share/fish/vendor_completions.d/panache.fish"
  install -Dm644 target/completions/_panache "${pkgdir}${MINGW_PREFIX}/share/zsh/site-functions/_panache"

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
