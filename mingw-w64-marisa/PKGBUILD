# Maintainer: Feng Shu <tumashu@163.com>

_realname=marisa
_archive=marisa-trie
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.3.1
pkgrel=1
pkgdesc="Matching Algorithm with Recursively Implemented StorAge (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/s-yata/marisa-trie"
msys2_repository_url='https://github.com/s-yata/marisa-trie'
msys2_references=(
  'anitya: 242978'
  'archlinux: marisa'
  'gentoo: dev-libs/marisa'
)
license=('spdx:BSD-2-Clause OR LGPL-2.1-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=(
  "https://github.com/s-yata/marisa-trie/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
  "0001-fix-pkgconfig.patch"
  "0002-fix-dll-install-destination.patch"
)
sha256sums=('986ed5e2967435e3a3932a8c95980993ae5a196111e377721f0849cad4e807f3'
            '6ad3c8359111feb1bc99aa4f007e2d60cf7c1b094bce247c8bd9d6e291316f44'
            'ac517722c78262a7e26ab0b89ebb3406067cac04c9f7f82f2f1f569960972f52')

prepare() {
  cd "${_archive}-${pkgver}"

  patch -Np1 -i "${srcdir}/0001-fix-pkgconfig.patch"
  patch -Np1 -i "${srcdir}/0002-fix-dll-install-destination.patch"
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  if [[ ${CARCH} == x86_64 ]]; then
    extra_config+=("-DENABLE_SSE3=ON")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
    -G "Ninja" \
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
    -DBUILD_SHARED_LIBS=ON \
    -DCMAKE_DLL_NAME_WITH_SOVERSION=ON \
    "${extra_config[@]}" \
    -S "${_archive}-${pkgver}" \
    -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  cd "${srcdir}/${_archive}-${pkgver}"

  install -Dm644 COPYING.md -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
