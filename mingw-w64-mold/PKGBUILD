# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_realname=mold
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=3.0.0
pkgrel=1
pkgdesc='A Modern Linker (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/rui314/mold'
msys2_repository_url='https://github.com/rui314/mold'
license=('spdx:MIT')
msys2_references=(
  'anitya: 241732'
  'archlinux: mold'
  'gentoo: sys-devel/mold'
)
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-dlfcn"
  "${MINGW_PACKAGE_PREFIX}-zlib"
  "${MINGW_PACKAGE_PREFIX}-zstd"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-rust"
)
source=(
  "https://github.com/rui314/mold/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
  "zstd-sys.tar.gz::https://static.crates.io/crates/zstd-sys/2.1.0+zstd.1.5.7/download"
)
sha256sums=('1dee837e227b0c3f2661def602ef8ddc0b889ae5b1d28c1ddec5f29e08e5ceb5'
            '0ef0a8027ec3ee71300ab3bcbcd0393f434aa72b91ca6d635a39941deae8eea0')

prepare() {
  cd "${_realname}-${pkgver}"

  sed -i "s/statik(true)/statik(false)/" "../zstd-sys-2.1.0+zstd.1.5.7/build.rs"
  cat >> Cargo.toml <<END

[patch.crates-io]
zstd-sys.path = "../zstd-sys-2.1.0+zstd.1.5.7"
END
  cargo update -p zstd-sys
  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${_realname}-${pkgver}"
  export ZSTD_SYS_USE_PKG_CONFIG=1
  export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 # release profile lacks codegen-units=1
  cargo build --release --frozen --package mold-cli --no-default-features --features="x86_64,arm64"
}

check() {
  cd "${_realname}-${pkgver}"
  cargo test --frozen --package mold-cli --no-default-features --features="x86_64,arm64"
}

package() {
  # install-mold.sh is not useful for Windows
  cd "${_realname}-${pkgver}"
  install -Dm755 "target/release/${_realname}.exe" -t "${pkgdir}${MINGW_PREFIX}/bin"
  install -Dm644 "docs/${_realname}.1" -t "${pkgdir}${MINGW_PREFIX}/share/man/man1"
  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
