

_realname=jaq
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=3.1.2
pkgrel=2
pkgdesc="A jq clone (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/01mf02/jaq"
msys2_repository_url="https://github.com/01mf02/jaq"
msys2_references=(
  'archlinux: jaq'
  'aur:' # ignore jaq-git
  'cygwin:' # ignore jq
  'gentoo: app-misc/jaq'
  'purl: pkg:cargo/jaq'
)
license=('spdx:MIT')
test "$MSYSTEM" != "UCRT64" && depends=("${MINGW_PACKAGE_PREFIX}-libunwind")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-rust"
)
conflicts=("${MINGW_PACKAGE_PREFIX}-jq")
provides=("${MINGW_PACKAGE_PREFIX}-jq")
source=(
  "${url}/archive/refs/tags/v${pkgver}.tar.gz"
  "${url}/releases/download/v${pkgver}/jaq.1"
)
sha256sums=('54ac66fac30a1d28c54f19716215cf4256877c69964c1c0150c3976bde618b93'
            '897aa15830beae6a357b4ff6f576dc5c76aa6ca79ad05cc16b47c809c58a9572')

prepare() {
  cd "${_realname}-${pkgver}"

  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${_realname}-${pkgver}"

  export RUSTFLAGS="${RUSTFLAGS/+crt-static/-crt-static}"
  cargo build --frozen --release
}

package() {
  cd "${_realname}-${pkgver}"

  install -Dm755 "target/release/jaq" "${pkgdir}${MINGW_PREFIX}/bin/jaq"
  install -Dm644 ../jaq.1 -t "${pkgdir}${MINGW_PREFIX}/share/man/man1"
  install -Dm644 LICENSE-MIT "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"

  cd "${pkgdir}${MINGW_PREFIX}/bin"
  ln jaq jq
}
