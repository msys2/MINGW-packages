
_realname=fzssh
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
# update together with filezilla and libfilezilla
# rebuild filezilla
pkgver=1.5.1
pkgrel=1
pkgdesc="A SSH/SFTP library based on libfilezilla (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://fzssh.filezilla-project.org"
msys2_references=(
  'anitya: 391139'
  'archlinux: fzssh'
  'gentoo: net-libs/fzssh'
)
license=('spdx:AGPL-3.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-argon2"
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-gmp"
  "${MINGW_PACKAGE_PREFIX}-libfilezilla"
  "${MINGW_PACKAGE_PREFIX}-nettle"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-meson"
)
source=(
  "https://sources.archlinux.org/other/packages/${_realname}/${_realname}-${pkgver}.tar.xz"
)
sha256sums=('b5467eb648f5a5e35a20dcd4b428a51be59d6d0375327f746d153ffe912ac17c')

build() {
  MSYS2_ARG_CONV_EXCL="--prefix=" \
  meson setup \
    --prefix="${MINGW_PREFIX}" \
    --wrap-mode=nodownload \
    --auto-features=enabled \
    --buildtype=plain \
    "${_realname}-${pkgver}" \
    "build-${MSYSTEM}"

  meson compile -C "build-${MSYSTEM}"
}

check() {
  meson test -C "build-${MSYSTEM}" || warning "Tests failed"
}

package() {
  meson install -C "build-${MSYSTEM}" --destdir "${pkgdir}"

  cd "${srcdir}/${_realname}-${pkgver}"
  install -Dm644 README -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
