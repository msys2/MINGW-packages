# Maintainer: Cloud <kt286@qq.com>

_realname=dtk6declarative
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=6.7.47
pkgrel=1
pkgdesc='DTK6 declarative module'
arch=('any')
mingw_arch=('ucrt64')
url="https://github.com/linuxdeepin/dtkdeclarative"
license=('LGPL3')
depends=("${MINGW_PACKAGE_PREFIX}-gcc-libs"
         "${MINGW_PACKAGE_PREFIX}-qt6-base"
         "${MINGW_PACKAGE_PREFIX}-qt6-declarative"
         "${MINGW_PACKAGE_PREFIX}-qt6-shadertools"
         "${MINGW_PACKAGE_PREFIX}-dtk6gui")
makedepends=("${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-gcc"
             "${MINGW_PACKAGE_PREFIX}-qt6-tools"
             "${MINGW_PACKAGE_PREFIX}-qt6-shadertools")

source=("dtkdeclarative-${pkgver}.tar.gz::https://github.com/linuxdeepin/dtkdeclarative/archive/refs/tags/${pkgver}.tar.gz")
sha512sums=('04a37f22a7625d655ded2d109721bc0f8b7eeb9049a613a4f1506ded13b3191cfc0f14af0085ffa9c01353ebb57dfbba26e0c5369f844576cac96de8366958d5')

build() {
  cd "${srcdir}"/dtkdeclarative-${pkgver}

  # On Windows/MinGW, no gl.pc exists - replace pkg-config GL with direct opengl32 linkage
  sed -i '/pkg_check_modules(GL REQUIRED IMPORTED_TARGET gl)/d' src/targets.cmake
  sed -i 's|$<BUILD_INTERFACE:PkgConfig::GL>|$<BUILD_INTERFACE:opengl32>|' src/targets.cmake

  mkdir -p build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    ${MINGW_PREFIX}/bin/cmake .. -GNinja \
      -DCMAKE_INSTALL_PREFIX=${MINGW_PREFIX} \
      -DCMAKE_PREFIX_PATH=${MINGW_PREFIX} \
      -DDTK5=OFF \
      -DBUILD_DOCS=OFF
  ${MINGW_PREFIX}/bin/ninja
}

package() {
  cd "${srcdir}"/dtkdeclarative-${pkgver}/build-${MSYSTEM}
  DESTDIR="${pkgdir}" ${MINGW_PREFIX}/bin/ninja install
}
