_realname=drogon
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.9.14
pkgrel=1
pkgdesc="A C++14/17/20 based HTTP web application framework (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64') # 'clang64' 'clangarm64')
url='https://drogon.org/'
# https://repology.org/project/drogon/versions
msys2_references=('aur: drogon')
msys2_changelog_url='https://github.com/drogonframework/drogon/blob/master/ChangeLog.md'
msys2_documentation_url='https://drogonframework.github.io/drogon-docs/#/'
msys2_repository_url='https://github.com/drogonframework/drogon'
# There is a issue needed to track: https://github.com/drogonframework/drogon/issues/1845
msys2_issue_tracker_url='https://github.com/drogonframework/drogon/issues'
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-brotli"
         "${MINGW_PACKAGE_PREFIX}-cc-libs"
         "${MINGW_PACKAGE_PREFIX}-c-ares"
         "${MINGW_PACKAGE_PREFIX}-jsoncpp"
         #"${MINGW_PACKAGE_PREFIX}-mariadb-libs"
         "${MINGW_PACKAGE_PREFIX}-postgresql"
         "${MINGW_PACKAGE_PREFIX}-sqlite3"
         "${MINGW_PACKAGE_PREFIX}-hiredis"
         # trantor's dependency
         "${MINGW_PACKAGE_PREFIX}-openssl")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             #"${MINGW_PACKAGE_PREFIX}-mariadb"
             "${MINGW_PACKAGE_PREFIX}-postgresql"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja")

trantor_ver=1.5.29

source=("${msys2_repository_url}/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
       "https://github.com/an-tao/trantor/archive/v${trantor_ver}/v${trantor_ver}.tar.gz")
sha256sums=('3831bfae74eb6b47965a424e5c9d593d5efa31e9f7e6a5e02d4754039facff5e'
            '0e6b9cc32720cbca61ac2e04d4d9b8e1afac3f4007b5978a91461d3eb21d653b')
noextract=("v${trantor_ver}.tar.gz")

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"
  tar -xzf "${srcdir}/v${trantor_ver}.tar.gz" --strip-components=1 -C trantor || true
}

build() {
  declare -a _cmake_opts=(
    -GNinja
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}"
    -DCMAKE_PREFIX_PATH="${MINGW_PREFIX}"
    -DCMAKE_MODULE_PATH="${MINGW_PREFIX}"/lib/cmake
    -DBUILD_EXAMPLES=OFF
    -DCMAKE_DLL_NAME_WITH_SOVERSION=ON
    #-DUSE_SUBMODULE=OFF
    #if we sperate trantor as standalone package, disable USE_SUBMODULE, default ON
    -S "${_realname}-${pkgver}"
  )
  if check_option "debug" "n"; then
    _cmake_opts+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _cmake_opts+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  msg2 "Building static library"
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      "${_cmake_opts[@]}" \
      -B "build-${MSYSTEM}-static"
      #-DBUILD_SHARED_LIBS=OFF
      #default OFF
  
  cmake --build "build-${MSYSTEM}-static"


  msg2 "Building shared library"
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      "${_cmake_opts[@]}" \
      -DBUILD_SHARED_LIBS=ON \
      -DCMAKE_DLL_NAME_WITH_SOVERSION=ON \
      -B "build-${MSYSTEM}-shared"

  cmake --build "build-${MSYSTEM}-shared"
}

#check() {
#   cmake -DLITEHTML_BUILD_TESTING=ON -S ${_realname}-${pkgver} -B "build-${MSYSTEM}"
#   cmake --build "build-${MSYSTEM}"
#   ctest --test-dir "build-${MSYSTEM}" --output-on-failure || true
#}

package() {
  DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM}-static
  DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM}-shared

  # Don't search for non-existant gumbo cmake config
  # sed -e '/gumbo/d' -i "${pkgdir}${MINGW_PREFIX}"/lib/cmake/litehtml/litehtmlConfig.cmake

  install -Dm644 "${srcdir}/${_realname}-${pkgver}/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
  install -Dm644 "${srcdir}/${_realname}-${pkgver}/trantor/License" "${pkgdir}${MINGW_PREFIX}/share/licenses/trantor/License"
}
