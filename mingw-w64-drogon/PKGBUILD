# Maintainer: Glarboy <Nahida1027@aliyun.com>

_realname=drogon
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}"
         "${MINGW_PACKAGE_PREFIX}-${_realname}-docs")
pkgver=1.9.14
pkgrel=2
pkgdesc="A C++14/17/20 based HTTP web application framework (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://drogon.org/'
provides=("${MINGW_PACKAGE_PREFIX}-trantor")
# https://repology.org/project/drogon/versions
msys2_references=(
  'aur: drogon'
)
msys2_changelog_url='https://github.com/drogonframework/drogon/blob/master/ChangeLog.md'
msys2_documentation_url='https://drogonframework.github.io/drogon-docs/#/'
msys2_repository_url='https://github.com/drogonframework/drogon'
msys2_issue_tracker_url='https://github.com/drogonframework/drogon/issues'
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-jsoncpp"
  "${MINGW_PACKAGE_PREFIX}-hiredis"
  "${MINGW_PACKAGE_PREFIX}-c-ares"
  "${MINGW_PACKAGE_PREFIX}-yaml-cpp"
  "${MINGW_PACKAGE_PREFIX}-curl"
  "${MINGW_PACKAGE_PREFIX}-brotli"
  "${MINGW_PACKAGE_PREFIX}-postgresql"
  "${MINGW_PACKAGE_PREFIX}-sqlite3"
)
optdepends=("${MINGW_PACKAGE_PREFIX}-libmariadbclient: develop MariaDB backend")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-libmariadbclient"
  "${MINGW_PACKAGE_PREFIX}-doxygen"
)

trantor_ver=1.5.29

source=(
  "${msys2_repository_url}/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
  "https://github.com/an-tao/trantor/archive/v${trantor_ver}/v${trantor_ver}.tar.gz"
  "001-fix-thread_local-dll-export.patch::${msys2_repository_url}/commit/f63cf4953dfb495eaece459a3acc0895604537ce.patch"
)
sha256sums=('3831bfae74eb6b47965a424e5c9d593d5efa31e9f7e6a5e02d4754039facff5e'
            '0e6b9cc32720cbca61ac2e04d4d9b8e1afac3f4007b5978a91461d3eb21d653b'
            'e4d31ccc88b9fd12ffcc5890d9270199819c18f013a90bdaa759e074dc271f47')
noextract=("v${trantor_ver}.tar.gz")

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"
  tar -xzf "${srcdir}/v${trantor_ver}.tar.gz" --strip-components=1 -C trantor || true

  # prepare to build shared library
  if [[ ${MSYSTEM} == CLANG* ]]; then
    patch -Np1 -i "${srcdir}/001-fix-thread_local-dll-export.patch"
  fi
}

build() {
  declare -a _cmake_opts=(
    -GNinja
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}"
    -DCMAKE_PREFIX_PATH="${MINGW_PREFIX}"
    -DCMAKE_MODULE_PATH="${MINGW_PREFIX}"/lib/cmake
    -DBUILD_EXAMPLES=OFF
    #-DUSE_SUBMODULE=OFF
    # if we sperate trantor as standalone package, disable USE_SUBMODULE, default ON
    -S "${_realname}-${pkgver}"
  )
  if check_option "debug" "n"; then
    _cmake_opts+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _cmake_opts+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  msg2 "Building static library"
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      "${_cmake_opts[@]}" \
      -DBUILD_SHARED_LIBS=OFF \
      -B "build-${MSYSTEM}-static"

  cmake --build "build-${MSYSTEM}-static"

  msg2 "Building shared library"
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      "${_cmake_opts[@]}" \
      -DBUILD_SHARED_LIBS=ON \
      -DBUILD_DOC=ON \
      -B "build-${MSYSTEM}-shared"

  cmake --build "build-${MSYSTEM}-shared"
}

package_drogon() {
  DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM}-static
  mv -vf "${pkgdir}${MINGW_PREFIX}/lib/cmake/Drogon" "${pkgdir}${MINGW_PREFIX}/lib/cmake/Drogon-static"
  mv -vf "${pkgdir}${MINGW_PREFIX}/lib/cmake/Trantor" "${pkgdir}${MINGW_PREFIX}/lib/cmake/Trantor-static"

  DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM}-shared
  mv -vf "${pkgdir}${MINGW_PREFIX}/lib/cmake/Drogon" "${pkgdir}${MINGW_PREFIX}/lib/cmake/Drogon-shared"
  mv -vf "${pkgdir}${MINGW_PREFIX}/lib/cmake/Trantor" "${pkgdir}${MINGW_PREFIX}/lib/cmake/Trantor-shared"

  # unneed, only need drogon_ctl.exe
  rm -vf "${pkgdir}${MINGW_PREFIX}/bin/_drogon_ctl.exe"

  install -Dm644 "${srcdir}/${_realname}-${pkgver}/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
  install -Dm644 "${srcdir}/${_realname}-${pkgver}/trantor/License" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/trantor/License"
}

package_drogon-docs() {
  pkgdesc+=" (documentation)"
  depends=()
  optdepends=()

  install -d "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}"
  cp -r ${srcdir}/build-${MSYSTEM}-shared/docs/${_realname}/html/* "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}"
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
