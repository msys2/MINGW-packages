# Maintainer: Bjoern Lemke <lemke@lemke-it.com>

_realname=cego
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2.54.46
pkgrel=1
pkgdesc="Cego database system (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://www.lemke-it.com/'
msys2_references=(
  'anitya: 264'
)
license=('spdx:GPL-3.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-lfcbase"
  "${MINGW_PACKAGE_PREFIX}-lfcxml"
  "${MINGW_PACKAGE_PREFIX}-readline"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-cc"
)
source=("https://www.lemke-it.com/${_realname}-${pkgver}.tar.bz2")
sha256sums=('4deec2e45f22e6bb11c2d1a93e89dbc34c01bc4c0f4a83a6b8214b73aa829095')

build() {
  mkdir -p "${srcdir}"/build-${MSYSTEM} && cd "${srcdir}"/build-${MSYSTEM}

  ../${_realname}-${pkgver}/configure \
    --prefix=${MINGW_PREFIX} \
    --enable-static \
    --enable-shared

  make

  ${CXX} -shared \
    -Wl,--out-implib,libcego.dll.a \
    -o libcego-0.dll \
    -Wl,--whole-archive "${srcdir}"/build-${MSYSTEM}/src/libcego.a -Wl,--no-whole-archive \
    -llfcxml -llfcbase -lsystre -lws2_32 -lpthread
}

check() {
  cd "${srcdir}"/build-${MSYSTEM}
  make check
}

package() {
  cd "${srcdir}"/build-${MSYSTEM}
  make install DESTDIR="${pkgdir}"

  mkdir -p "${pkgdir}"${MINGW_PREFIX}/{bin,lib}
  install -m 0755 libcego-0.dll "${pkgdir}${MINGW_PREFIX}/bin"
  install -m 0644 libcego.dll.a "${pkgdir}${MINGW_PREFIX}/lib"
}
