_perlname='Params-SomeUtil'
_realname="${_perlname,,}"
pkgbase="mingw-w64-perl-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=1.09
pkgrel=1
pkgdesc='Simple, compact and correct param-checking functions. (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://metacpan.org/release/Params-SomeUtil'
msys2_repository_url='https://github.com/uperl/Params-SomeUtil'
msys2_changelog_url='https://metacpan.org/dist/Params-SomeUtil/changes'
msys2_references=(
  'archlinux: perl-params-someutil'
  'purl: pkg:cpan/PLICEASE/Params-SomeUtil'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-perl")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-make"
)
source=("https://cpan.metacpan.org/authors/id/P/PL/PLICEASE/${_perlname}-${pkgver}.tar.gz")
sha256sums=('dd4b2286137560fc905c5e2db0bcae19fef20614ac4238dbcb2a4e78f82eb560')

build() {
  cp -r "${_perlname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="PREFIX=" \
    PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX="${MINGW_PREFIX}"

  mingw32-make CC=${CC} CXX=${CXX} LD=${CXX}
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="PREFIX=" \
    mingw32-make DESTDIR="${pkgdir}/" install

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE"
}
