_perlname=Alien-Libxml2
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=0.20
pkgrel=1
pkgdesc="Install the C libxml2 library on your system. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/Alien-Libxml2"
msys2_repository_url="https://github.com/PerlAlien/Alien-Libxml2"
msys2_references=(
  'purl: pkg:cpan/PLICEASE/Alien-Libxml2'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
groups=("${MINGW_PACKAGE_PREFIX}-perl-modules")
depends=("${MINGW_PACKAGE_PREFIX}-perl"
         "${MINGW_PACKAGE_PREFIX}-perl-alien-build"
         "${MINGW_PACKAGE_PREFIX}-libxml2")
makedepends=("${MINGW_PACKAGE_PREFIX}-make"
             "${MINGW_PACKAGE_PREFIX}-perl-alien-build-plugin-download-gitlab"
             "${MINGW_PACKAGE_PREFIX}-perl-html-parser"
             "${MINGW_PACKAGE_PREFIX}-perl-pkgconfig"
             "${MINGW_PACKAGE_PREFIX}-perl-sort-versions"
             "${MINGW_PACKAGE_PREFIX}-perl-uri")
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/P/PL/PLICEASE/${_perlname}-${pkgver}.tar.gz")
sha256sums=('56aae7b339bbeb02f77c5801f57a821be5791b51f43bf7f9062bb3bfa444c328')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
  install -Dm644 LICENSE "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE
}
