# Maintainer: Dirk Stolle

_realname=mathilda
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.433
pkgrel=1
pkgdesc="A small, highly efficient computer algebra system written in C99 (mingw-w64)"
arch=('any')
# Mathilda currently refused to be built with clang, so the package will not be
# built for 'clang64' and 'clangarm64' environments.
mingw_arch=('ucrt64')
url='https://github.com/stblake/mathilda'
msys2_repository_url='https://github.com/stblake/mathilda'
license=('spdx:GPL-3.0-only')
depends=(
  # "${MINGW_PACKAGE_PREFIX}-cblas"
  # "${MINGW_PACKAGE_PREFIX}-lapacke"
  "${MINGW_PACKAGE_PREFIX}-gmp"
  "${MINGW_PACKAGE_PREFIX}-flint"
  "${MINGW_PACKAGE_PREFIX}-mpfr"
  "${MINGW_PACKAGE_PREFIX}-pcre2"
  "${MINGW_PACKAGE_PREFIX}-readline"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-cc"
)
source=(
 "${_realname}-${pkgver}.tar.gz::https://github.com/stblake/mathilda/archive/refs/tags/v${pkgver}.tar.gz"
)
sha256sums=('60573bd2f55f23fc61ffc028501d9a7cb421dd436fcf4f3c92a5191c3715a8e4')

build() {
  cd "${_realname}-${pkgver}"

  make -j4 PREFIX="${MINGW_PREFIX}" USE_ECM=0 USE_GRAPHICS=0 USE_LAPACK=0
}

check() {
  cd "${_realname}-${pkgver}"

  # Run smoke tests from Mathilda's CI.
  out=$(printf '%s\n' \
      '{"id": 1, "expr": "2 + 3"}' \
      '{"id": 2, "expr": "TimeConstrained[While[True, Null], 0.3]"}' \
      '{"id": 3, "expr": "MaxMemoryUsed[] > 0"}' \
      '{"type": "quit"}' | ./Mathilda.exe)
  echo "$out" | grep -q '"payload":"5"' || {
    warning "Windows build did not evaluate 2 + 3."
    exit 1
  }
  echo "$out" | grep -q '"payload":"\$Aborted"' || {
    warning "TimeConstrained did not abort via the cooperative deadline."
    exit 1
  }
  echo "$out" | grep -q '"payload":"True"' || {
    echo "MaxMemoryUsed[] (GetProcessMemoryInfo) did not return a positive value."
    exit 1
  }
}

package() {
  cd "${_realname}-${pkgver}"

  make install DESTDIR="${pkgdir}" PREFIX="${MINGW_PREFIX}" USE_ECM=0 USE_GRAPHICS=0 USE_LAPACK=0

  install -Dm644 "../${_realname}-${pkgver}/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
