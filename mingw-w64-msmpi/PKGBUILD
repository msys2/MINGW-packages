build() {
  mkdir -p "${srcdir}"/build-${MSYSTEM} && cd "${srcdir}"/build-${MSYSTEM}

  # Import library (.dll.a)
  mkdir -p lib
  ${MINGW_PREFIX}/bin/dlltool -k -d "$srcdir/msmpi.def.${CARCH}" -l lib/libmsmpi.dll.a

  # Headers
  mkdir -p include
  cp $srcdir/mpi.h include
  cp $srcdir/{mpif.h,mpi.F90} include
  cp $srcdir/mpifptr.h.${CARCH} include/mpifptr.h

  # C/C++ Compiler wrappers
  mkdir -p bin
  mpic="$srcdir/mpi.c"
  if [[ ${MSYSTEM} == CLANG64 ]]; then
    FC=flang
  else
    FC=gfortran
  fi
  $CC ${CFLAGS} -o bin/mpicc.exe -DCC -DDRV=\"cc.exe\" -DENV=\"MPICC\" "${mpic}"
  $CC ${CFLAGS} -o bin/mpicxx.exe -DCXX -DDRV=\"c++.exe\" -DENV=\"MPICXX\" "${mpic}"
  cp bin/mpicxx.exe bin/mpic++.exe

  # Fortran Compiler wrappers
  $CC ${CFLAGS} -o bin/mpifort.exe -DFC -DDRV=\"${FC}.exe\" -DENV=\"MPIFORT\" "${mpic}"
  cp bin/mpifort.exe bin/mpif77.exe
  cp bin/mpifort.exe bin/mpif90.exe

  # FORTRAN90 MPI modules
  bin/mpifort -c -Jinclude "${srcdir}"/mpi.F90

  # Helper library with sentinel variables (not in COMMON blocks)
  # and replacement functions
  # Replace some functions to avoid shared variables in COMMON blocks with
  # Intel Fortran layout. They are not supported by GFortran or LLVM Flang.
  $FC -c -o msmpif.o $srcdir/msmpif.f90
  $CC ${CFLAGS} -c -o msmpifec.o -Iinclude $srcdir/msmpifec.c
  if [[ ${MSYSTEM} == CLANG64 ]]; then
    _extra_linker_flags="-Wl,$srcdir/msmpifec.def"
  fi
  $FC -shared -o bin/libmsmpifec.dll -Wl,--out-implib,lib/libmsmpifec.dll.a \
    $_extra_linker_flags msmpif.o msmpifec.o -Llib -l:libmsmpi.dll.a

  # Remove temporary object and module files.
  rm *.o *.mod
}

package() {
  cd "${srcdir}"

  cp -r "build-${MSYSTEM}" "${pkgdir}${MINGW_PREFIX}"

  mkdir -p "${pkgdir}${MINGW_PREFIX}/share/test/msmpi"
  cp msmpi.tcl {testme-0,buildme-0}.tm hello_mpi.{c,cpp,F,f90} "${pkgdir}${MINGW_PREFIX}/share/test/msmpi"

  mkdir -p "${pkgdir}${MINGW_PREFIX}/lib/pkgconfig"
  echo "
    prefix=${MINGW_PREFIX}
    libdir=\${prefix}/lib
    includedir=\${prefix}/include
    Name: ${_realname}
    URL: ${url}
    Version: ${pkgver}
    Description: ${pkgdesc}
    Cflags: -I\${includedir}
    Libs: -L\${libdir} -l:libmsmpi.dll.a -l:libmsmpifec.dll.a
  " | sed '/^\s*$/d;s/^\s*//' > "${pkgdir}${MINGW_PREFIX}/lib/pkgconfig/${_realname}.pc"

}

check() {
  # This is the default installation location for Microsoft MPI.
  # It might need to be adjusted dependent on the system where the tests are run.
  : "${MSMPI_BIN:="/c/Program\ Files/Microsoft\ MPI/Bin"}"

  PATH="${srcdir}/build-${MSYSTEM}/bin:${MSMPI_BIN}:${PATH}" \
    tclsh "${srcdir}"/msmpi.tcl
}
