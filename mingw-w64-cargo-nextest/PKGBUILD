

_realname=cargo-nextest
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.9.145
pkgrel=1
pkgdesc="A next-generation test runner for Rust (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/nextest-rs/nextest"
msys2_repository_url="${url}"
msys2_references=(
  "archlinux: ${_realname}"
)
license=('spdx:Apache-2.0' 'spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-rust" "${MINGW_PACKAGE_PREFIX}-zstd")
makedepends=("${MINGW_PACKAGE_PREFIX}-pkgconf")
source=("$url/archive/refs/tags/${_realname}-${pkgver}.tar.gz"
        "zstd-sys.tar.gz::https://static.crates.io/crates/zstd-sys/2.1.0+zstd.1.5.7/download")
sha256sums=('6ba31b7dace0cfa57a7f9f534a82732d037481e161e076bd713c3edf1fdf6a63'
            '0ef0a8027ec3ee71300ab3bcbcd0393f434aa72b91ca6d635a39941deae8eea0')
noextract=("${_realname}-${pkgver}.tar.gz") # contains symlinks
prepare() {
  bsdtar -xf ${_realname}-${pkgver}.tar.gz || :
  cd "nextest-${_realname}-$pkgver"

  sed -i "s/statik(true)/statik(false)/" "../zstd-sys-2.1.0+zstd.1.5.7/build.rs"
  echo zstd-sys.path = \"../zstd-sys-2.1.0+zstd.1.5.7\" >> Cargo.toml

  cargo update -p zstd-sys
  cargo fetch --locked --target "${RUST_CHOST}"
}

build(){
  cd "nextest-${_realname}-$pkgver"
  export ZSTD_SYS_USE_PKG_CONFIG=1
  cargo build --release --frozen
}

package() {
  cd "nextest-${_realname}-$pkgver"
  install -Dm755 "target/release/${_realname}" -t "${pkgdir}${MINGW_PREFIX}/bin"
  install -Dm644 LICENSE-MIT -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
