From ba1ecc970ffc3faae38d0323e45dd86a3c0cd51e Mon Sep 17 00:00:00 2001
From: "Jonatan R. Fischer" <jonafischer@gmail.com>
Date: Tue, 24 Nov 2026 11:49:10 -0300
Subject: [PATCH] setup.py: only pass MSVC C11 atomics flags to MSVC builds

Unconditionally passing "/std:c11 /experimental:c11atomics" on win32
breaks MinGW (GCC) builds, where C11 atomics work out of the box and
the MSVC-style flags are rejected as linker inputs. Gate the flags on
the compiler reported by sysconfig not being gcc/clang.

Forwarded: https://github.com/msgspec/msgspec/pull/1363
---
 setup.py | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/setup.py b/setup.py
index 79fdbaf..3a0c7e8 100644
--- a/setup.py
+++ b/setup.py
@@ -1,6 +1,7 @@
 import os
 import platform
 import sys
+import sysconfig

 from setuptools import setup
 from setuptools.extension import Extension
@@ -44,7 +45,11 @@ elif sys.platform != "win32":
         extra_link_args.extend(["-flto=thin"])

 # from https://py-free-threading.github.io/faq/#im-trying-to-build-a-library-on-windows-but-msvc-says-c-atomic-support-is-not-enabled
-if sys.platform == "win32":
+# MSVC needs explicit flags to enable C11 atomics support; MinGW GCC
+# provides them by default and rejects the MSVC-style "/std:..." flags.
+# Only pass them when the configured compiler is MSVC.
+cc = sysconfig.get_config_var("CC") or ""
+if sys.platform == "win32" and "gcc" not in cc and "clang" not in cc:
     extra_compile_args.extend(
         [
             "/std:c11",
