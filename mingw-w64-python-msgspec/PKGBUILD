# Maintainer: Oleg Tolmatcev <oleg.tolmatcev@gmail.com>
# Contributor: Jonatan R. Fischer <jonafischer at gmail dot com>

_realname=msgspec
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.22.0
pkgrel=1
pkgdesc="A fast serialization and validation library, with builtin support for JSON, MessagePack, YAML, and TOML. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/jcrist/msgspec"
msys2_repository_url='https://github.com/jcrist/msgspec'
msys2_references=(
  'anitya: 374335'
  'aur: python-msgspec'
  'gentoo: dev-python/msgspec'
  'purl: pkg:pypi/msgspec'
)
license=('spdx:BSD-3-Clause')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-attrs"
  "${MINGW_PACKAGE_PREFIX}-python-msgpack"
  "${MINGW_PACKAGE_PREFIX}-python-pytest"
  "${MINGW_PACKAGE_PREFIX}-python-pyaml"
  "${MINGW_PACKAGE_PREFIX}-python-tomli-w"
)
source=(
  "https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz"
  # upstream PR: https://github.com/msgspec/msgspec/pull/1363
  '0001-mingw_skip_msvc_c11_flags.patch'
  # upstream PR: https://github.com/msgspec/msgspec/pull/1362
  '0002-mingw_generic_getattr_iat.patch'
)
sha256sums=('0a13624a4969159fe35d8c2a3d377b2b61bbd8585e327440d5e52725affcce38'
            '0d135747656bf3f951deb37342fbf2313f2503ca26168ffb2a58181b01add3fd'
            '2c81a8426492dced28378c5fda83521a8a45614c857e6583757f46180a67ac24'
)

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"

  patch -Np1 -i "${srcdir}/0001-mingw_skip_msvc_c11_flags.patch"
  patch -Np1 -i "${srcdir}/0002-mingw_generic_getattr_iat.patch"
}

build() {
  cp -r "${_realname}-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"

  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"

  # The wheel is not installed into the build environment by `build`, so test
  # it from a throwaway venv instead of the source tree (src/ layout, no
  # compiled extension importable in place).
  rm -rf test-env
  ${MINGW_PREFIX}/bin/python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest tests/unit
}

package() {
  cd "python-build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
