+// The t_nBufferLength parameter is part of the published interface, but not
+// used here.
+template <int t_nBufferLength = 128> class CW2AEX {
+public:
+  CW2AEX(LPCWSTR psz) : m_psz(nullptr) {
+    if (!psz)
+      return;
+
+    // Query the exact UTF-8 size (including the terminating NUL).
+    int len = WideCharToMultiByte(CP_UTF8, 0, psz, -1, nullptr, 0, nullptr,
+                                  nullptr);
+    if (len <= 0) {
+      m_psz = new char[1];
+      m_psz[0] = '\0';
+      return;
+    }
+
+    m_psz = new char[len];
+    if (WideCharToMultiByte(CP_UTF8, 0, psz, -1, m_psz, len, nullptr,
+                            nullptr) <= 0)
+      m_psz[0] = '\0';
+  }
+
+  ~CW2AEX() { delete[] m_psz; }
+
+  CW2AEX(const CW2AEX &) = delete;
+  CW2AEX &operator=(const CW2AEX &) = delete;
+
+  operator LPSTR() const { return m_psz; }
+
+  char *m_psz;
+};
+typedef CW2AEX<> CW2A;
+
+// The t_nBufferLength parameter is part of the published interface, but not
+// used here.
+template <int t_nBufferLength = 128> class CA2WEX {
+public:
+  CA2WEX(LPCSTR psz) : m_psz(nullptr) {
+    if (!psz)
+      return;
+
+    // Query the exact UTF-16 size in wchar_t units (including the NUL).
+    int len = MultiByteToWideChar(CP_UTF8, 0, psz, -1, nullptr, 0);
+    if (len <= 0) {
+      m_psz = new wchar_t[1];
+      m_psz[0] = L'\0';
+      return;
+    }
+
+    m_psz = new wchar_t[len];
+    if (MultiByteToWideChar(CP_UTF8, 0, psz, -1, m_psz, len) <= 0)
+      m_psz[0] = L'\0';
+  }
+
+  ~CA2WEX() { delete[] m_psz; }
+
+  CA2WEX(const CA2WEX &) = delete;
+  CA2WEX &operator=(const CA2WEX &) = delete;
+
+  operator LPWSTR() const { return m_psz; }
+
+  wchar_t *m_psz;
+};
+typedef CA2WEX<> CA2W;
