# Maintainer: Christoph Reiter <reiter.christoph@gmail.com>

_realname=markdown
pkgbase="mingw-w64-python-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=3.11.1
pkgrel=1
pkgdesc="Python implementation of John Gruber's Markdown (mingw-w64)"
arch=('any')
mingw_arch=('mingw32' 'mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://python-markdown.github.io'
msys2_repository_url='https://github.com/Python-Markdown/markdown'
msys2_changelog_url='https://python-markdown.github.io/changelog'
msys2_references=(
  'anitya: 3916'
  'archlinux:' # ignore python-markdown bad versioning
  'gentoo: dev-python/markdown'
  'purl: pkg:pypi/markdown'
)
license=('spdx:BSD-3-Clause')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-yaml"
)
options=('!strip')
source=("https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz")
sha256sums=('496f4f80f9ebd3395a04c8ec9595c40bbe8ec19e9c67d21fe071a1643e876606')

build() {
  cp -r "${_realname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "build-${MSYSTEM}"

  python -m unittest discover tests
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE.md -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
