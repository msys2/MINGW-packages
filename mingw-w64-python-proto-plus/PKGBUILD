# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_realname='proto-plus'
_pyname="${_realname//-/_}"
pkgbase="mingw-w64-python-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-python-${_realname}"
pkgver=1.29.0
pkgrel=1
pkgdesc='Beautiful, Pythonic protocol buffers (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/googleapis/proto-plus-python'
msys2_repository_url='https://github.com/googleapis/proto-plus-python'
msys2_changelog_url='https://github.com/googleapis/google-cloud-python/blob/main/packages/proto-plus/CHANGELOG.md'
msys2_references=(
  'archlinux: python-proto-plus'
  'purl: pkg:pypi/proto-plus'
)
license=('spdx:Apache-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-protobuf"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
options=('!strip')
source=("https://pypi.org/packages/source/${_pyname::1}/${_realname}/${_pyname}-${pkgver}.tar.gz")
sha256sums=('cfb4e62ad7e13dd18f346cabbda00cab39930d36a05791fd81ddb074d6ee884f')

build() {
  cp -r "${_pyname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
