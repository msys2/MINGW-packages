# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_realname=yuview
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2.15
pkgrel=1
pkgdesc="YUView is a Qt based, cross-platform YUV player with an advanced analytic toolset. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://ient.github.io/YUView/'
msys2_repository_url='https://github.com/IENT/YUView'
license=('spdx:GPL-3.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-qt6-base"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-qt6-base"
)
source=(
  "https://github.com/IENT/YUView/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
  '001-fix-clang-constexpr-evaluation.patch'
)
sha256sums=('7c701c25bd0470af313fef095cd81b76c2d3e92dac5bd8a6eb781025d1a65050'
            '1842467645bc09d8cb633433db6dae9a35d7c910c75aaf152f91f3a0250bdbcd')

prepare() {
  cd "YUView-${pkgver}"

  patch -Np1 -i "${srcdir}/001-fix-clang-constexpr-evaluation.patch"
}

build() {
  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
    -Wno-author \
    -GNinja \
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
    "${_extra_config[@]}" \
    -S "YUView-${pkgver}" \
    -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  cd "${srcdir}/build-${MSYSTEM}"
  install -Dm755 YUViewApp/YUView.exe "${pkgdir}${MINGW_PREFIX}/bin/YUView.exe"

  cd "${srcdir}/YUView-${pkgver}"
  install -Dm644 LICENSE.GPL3 "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
