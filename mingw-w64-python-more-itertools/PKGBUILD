# Maintainer: Andrew Sun <adsun701@gmail.com>

_realname='more-itertools'
_pyname="${_realname//-/_}"
pkgbase="mingw-w64-python-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=11.2.0
pkgrel=1
pkgdesc='More routines for operating on iterables, beyond itertools (mingw-w64)'
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://more-itertools.readthedocs.io'
msys2_repository_url='https://github.com/more-itertools/more-itertools'
msys2_documentation_url='https://more-itertools.readthedocs.io'
msys2_changelog_url='https://more-itertools.readthedocs.io/en/stable/versions.html'
msys2_references=(
  'anitya: 12201'
  'archlinux: python-more-itertools'
  'gentoo: dev-python/more-itertools'
  'purl: pkg:pypi/more-itertools'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-flit-core"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-pytest"
)
source=("https://pypi.org/packages/source/${_pyname::1}/${_pyname}/${_pyname}-${pkgver}.tar.gz")
sha256sums=('59960f488835254863a857eb501f69e4ec92fdc8822f098c0f48dba530afd487')

build() {
  cp -r "${_pyname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "build-${MSYSTEM}"

  python -m pytest
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
