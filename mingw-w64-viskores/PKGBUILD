# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_realname=viskores
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.2.0
pkgrel=1
pkgdesc="A visualization library for many-threaded devices. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://viskores.org/'
msys2_repository_url='https://github.com/Viskores/viskores'
msys2_documentation_url='https://viskores.readthedocs.io/'
msys2_references=(
  'archlinux: viskores'
)
license=('spdx:BSD-3-Clause')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-hdf5"
  "${MINGW_PACKAGE_PREFIX}-omp"
  "${MINGW_PACKAGE_PREFIX}-tbb"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-anari-sdk"
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-glew"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
optdepends=(
  "${MINGW_PACKAGE_PREFIX}-anari-sdk: for ANARI rendering support"
)
source=(
  "https://github.com/Viskores/viskores/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
)
sha256sums=('932480746ea516bc1091326e4de37a9d75f963aa52c5708d89d0d546d6df6c77')

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  CXXFLAGS+=" -w -Wa,-mbig-obj" \
    MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
    -Wno-author \
    -GNinja \
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
    -DCMAKE_DLL_NAME_WITH_SOVERSION=ON \
    "${extra_config[@]}" \
    -DBUILD_SHARED_LIBS=ON \
    -DViskores_INSTALL_CMAKE_MODULE_DIR=lib/cmake \
    -DViskores_CUSTOM_LIBRARY_SUFFIX="" \
    -DViskores_ENABLE_DEVELOPER_FLAGS=OFF \
    -DViskores_ENABLE_GL_CONTEXT=ON \
    -DViskores_ENABLE_ANARI=OFF \
    -DViskores_ENABLE_HDF5_IO=ON \
    -DViskores_ENABLE_OPENMP=ON \
    -DViskores_ENABLE_TBB=ON \
    -DViskores_ENABLE_TESTING=OFF \
    -DViskores_USE_DEFAULT_TYPES_FOR_VTK=ON \
    -S "${_realname}-${pkgver}" \
    -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "${srcdir}/${_realname}-${pkgver}/LICENSE.txt" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"

  # Fix CMake config file
  local _build_dir
  _build_dir=$(cygpath -m "${srcdir}/build-${MSYSTEM}")
  sed -e "s|${_build_dir}|A:/_|g" \
    -i "${pkgdir}${MINGW_PREFIX}/lib/cmake/viskores-${pkgver%.*}/ViskoresConfig.cmake"
}
