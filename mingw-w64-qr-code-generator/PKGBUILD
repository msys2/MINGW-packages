# Maintainer: luadebug <lin@sz.cn.eu.org>

_realname=qr-code-generator
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.8.0
pkgrel=1
pkgdesc="High-quality QR Code generator libraries in C and C++ (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/nayuki/QR-Code-generator'
msys2_repository_url='https://github.com/nayuki/QR-Code-generator'
msys2_references=(
  'anitya: 112687'
  'gentoo: dev-libs/qr-code-generator'
)
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=("${_realname}-${pkgver}.tar.gz::https://github.com/nayuki/QR-Code-generator/archive/refs/tags/v${pkgver}.tar.gz"
        'CMakeLists.txt'
        'qr-code-generator-config.cmake.in'
        'qrcodegen.pc.in')
sha256sums=('2ec0a4d33d6f521c942eeaf473d42d5fe139abcfa57d2beffe10c5cf7d34ae60'
            '7ff0bb4bb9e18f03d4dc1ddaa252a05935f645a7a12f6ebb723b25f7ba8dc7e5'
            '600acbe9eb347ef6b46eb5d9be31d3bd67ab7c488452045b08d3a011e9eb3eb5'
            '91ef728b2c4eebfffa3cb9743e49e194fb615df4ac23473b8381dae822bfed19')

prepare() {
  cp "${srcdir}/CMakeLists.txt" \
     "${srcdir}/qr-code-generator-config.cmake.in" \
     "${srcdir}/qrcodegen.pc.in" "QR-Code-generator-${pkgver}/"
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${extra_config[@]}" \
      -DBUILD_SHARED_LIBS=ON \
      -S "QR-Code-generator-${pkgver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -d "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
  sed -n '1,/^ \*\//p' "QR-Code-generator-${pkgver}/cpp/qrcodegen.hpp" \
    > "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
