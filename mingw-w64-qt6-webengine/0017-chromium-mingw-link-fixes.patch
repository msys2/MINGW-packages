diff --git a/cmake/Functions.cmake b/cmake/Functions.cmake
index 0a60bef73f..0eaef54d8d 100644
--- a/cmake/Functions.cmake
+++ b/cmake/Functions.cmake
@@ -182,12 +182,30 @@ function(add_linker_options target buildDir completeStatic)
             endif()
         endif()
         target_link_options(${cmakeTarget} PRIVATE "$<$<CONFIG:${config}>:@${objects_rsp}>")
-        if(NOT completeStatic)
-            get_copy_of_response_file(archives_rsp ${target} archives)
-            target_link_options(${cmakeTarget} PRIVATE "$<$<CONFIG:${config}>:@${archives_rsp}>")
-        endif()
         get_copy_of_response_file(libs_rsp ${target} libs)
-        target_link_options(${cmakeTarget} PRIVATE "$<$<CONFIG:${config}>:@${libs_rsp}>")
+        if(MINGW)
+            # GNU ld is single-pass over static archives; Chromium has cyclic
+            # dependencies among its static libs and between archives and the
+            # system import libraries (-lcrypt32, -licuuc, -lpng, -lwebp, ...).
+            # Wrap both archives and libs in --start-group/--end-group so the
+            # linker iterates until all references are resolved.
+            if(NOT completeStatic)
+                get_copy_of_response_file(archives_rsp ${target} archives)
+                target_link_libraries(${cmakeTarget} PRIVATE
+                    "$<1:-Wl,--start-group $<$<CONFIG:${config}>:@${archives_rsp}> $<$<CONFIG:${config}>:@${libs_rsp}> -Wl,--end-group>"
+                )
+            else()
+                target_link_libraries(${cmakeTarget} PRIVATE
+                    "$<1:-Wl,--start-group $<$<CONFIG:${config}>:@${libs_rsp}> -Wl,--end-group>"
+                )
+            endif()
+        else()
+            if(NOT completeStatic)
+                get_copy_of_response_file(archives_rsp ${target} archives)
+                target_link_options(${cmakeTarget} PRIVATE "$<$<CONFIG:${config}>:@${archives_rsp}>")
+            endif()
+            target_link_options(${cmakeTarget} PRIVATE "$<$<CONFIG:${config}>:@${libs_rsp}>")
+        endif()
         # we need libs rsp also when linking process with sandbox lib
         set_property(TARGET ${cmakeTarget} PROPERTY LIBS_RSP ${libs_rsp})
     endif()
