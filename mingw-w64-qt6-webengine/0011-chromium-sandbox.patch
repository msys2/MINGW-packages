+
+// Array forms. Required so MinGW/clang can compile placement
+// `new (NT_ALLOC) T[N]` / `new (NT_PAGE, base) T[N]`. Without these,
+// `T[N]` resolves to libstdc++'s ::operator new[] which is unsafe inside
+// the early NtMapViewOfSection interceptor (target's CRT/IAT not ready).
+void* __cdecl operator new[](size_t size,
+                             sandbox::AllocationType type,
+                             void* near_to = nullptr);
+void __cdecl operator delete[](void* memory, sandbox::AllocationType type);
+void __cdecl operator delete[](void* memory,
