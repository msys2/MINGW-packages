+# The reduced (packaged third-party) build only compiles a subset of Chromium.
+# Mojom generator actions reference sibling generated files -- parsed
+# *.mojom-module data, C++ *__type_mappings metadata, *.mojom*.ts TypeScript
+# bindings -- through runtime arguments without declaring them as Ninja inputs,
+# so Ninja never schedules them first and the action aborts with a missing-file
+# error. Generate the shippable mojom surface up front by building every
+# parser action's first *mojom-module output, every module's __generator phony,
+# and every __type_mappings target. Qt release archives omit Chromium test
+# mojom inputs, so exclude targets below a test path component. Many
+# cross-module dependencies are themselves undeclared, so retry until a full
+# pass succeeds and the ordering converges.
+function(_qwe_ninja_multipass _targets _what)
+    list(LENGTH _targets _total)
+    if(_total EQUAL 0)
+        return()
+    endif()
+    set(_done FALSE)
+    foreach(_pass RANGE 1 12)
+        set(_pass_ok TRUE)
+        set(_batch)
+        set(_batch_size 0)
+        set(_index 0)
+        foreach(_target IN LISTS _targets)
+            list(APPEND _batch "${_target}")
+            math(EXPR _batch_size "${_batch_size} + 1")
+            math(EXPR _index "${_index} + 1")
+            if(_batch_size GREATER_EQUAL 300 OR _index EQUAL _total)
+                execute_process(
+                    COMMAND "${CMAKE_COMMAND}" -E env
+                        "NODEJS_EXECUTABLE=${NODEJS_EXECUTABLE}"
+                        "${NINJA_EXECUTABLE}" -k 0 -C "${BUILDDIR}" ${_batch}
+                    RESULT_VARIABLE _result)
+                if(NOT _result EQUAL 0)
+                    set(_pass_ok FALSE)
+                endif()
+                set(_batch)
+                set(_batch_size 0)
+            endif()
+        endforeach()
+        if(_pass_ok)
+            set(_done TRUE)
+            break()
+        endif()
+    endforeach()
+    if(NOT _done)
+        message(FATAL_ERROR "Failed to generate QtWebEngineCore ${_what}")
+    endif()
