+        target_link_libraries(${qtWebEngineProcessName} PRIVATE
+            "$<1:-Wl,--start-group ${_qtwe_sandbox_lib} @${libs_rsp} -Wl,--end-group>")
+        target_link_options(${qtWebEngineProcessName} PRIVATE "@${archives_rsp}" "-Wl,--stack,800000")
