+    if(MINGW)
+        # GNU ld is single-pass; libQtWebEngineCoreSandbox.a references symbols
+        # from system import libs in libs_rsp, so wrap them in --start-group so
+        # the linker iterates until all references resolve. The whole group is
+        # passed as one $<1:...>-wrapped string starting with -Wl so CMake does
+        # not split it and prepend -l to the @response_file argument (which
+        # would yield "-l@CMakeFiles_..._libs.rsp"). $<TARGET_FILE:> can't be
+        # used on WebEngineCoreSandbox because IMPORTED_CONFIGURATIONS is not
