+
+# Strip debug info from chromium archives and loose objects pulled into
+# the Qt6WebEngineCore.dll link, so .debug_info stays under the COFF
+# 4 GiB section limit. Runs as a PRE_LINK step on WebEngineCore. Driven
+# by the linker rsp files (archives.rsp, objects.rsp, libs.rsp), which
+# CMake regenerates before each link, so the universe matches exactly
+# what the linker sees. Two CMake list vars decide what to keep:
+#   CHROMIUM_DEBUG_STRIP_KEEP_PREFIXES - chromium-relative source paths
+#   CHROMIUM_DEBUG_STRIP_KEEP_ARCHIVES - globs against archive paths
+# Both vars are CMake lists; separate multiple entries with ';'.
+# Activated when CHROMIUM_DEBUG_STRIP_TOOL and CHROMIUM_DEBUG_STRIP_BUILD_DIR
+# are set. Orphan archives/objects (Qt-built, not in chromium GN) are kept.
+if(MINGW AND DEFINED CHROMIUM_DEBUG_STRIP_TOOL)
+    set(_qtwe_keep_args "")
+    foreach(_qtwe_keep_prefix ${CHROMIUM_DEBUG_STRIP_KEEP_PREFIXES})
+        list(APPEND _qtwe_keep_args --keep-prefix "${_qtwe_keep_prefix}")
+    endforeach()
+    foreach(_qtwe_keep_archive ${CHROMIUM_DEBUG_STRIP_KEEP_ARCHIVES})
+        list(APPEND _qtwe_keep_args --keep-archive "${_qtwe_keep_archive}")
+    endforeach()
+    set(_qtwe_rsp_base "${CMAKE_BINARY_DIR}/CMakeFiles_QtWebEngineCore_${CMAKE_BUILD_TYPE}")
+    add_custom_command(TARGET WebEngineCore PRE_LINK
+        COMMAND "${Python3_EXECUTABLE}"
+                "${CHROMIUM_DEBUG_STRIP_TOOL}"
+                --build-dir "${CHROMIUM_DEBUG_STRIP_BUILD_DIR}"
+                --rsp-file "${_qtwe_rsp_base}_archives.rsp"
+                --rsp-file "${_qtwe_rsp_base}_objects.rsp"
+                --rsp-file "${_qtwe_rsp_base}_libs.rsp"
+                ${_qtwe_keep_args}
+                --quiet
+        COMMENT "Stripping chromium debug info (PRE_LINK on WebEngineCore)"
+        VERBATIM)
+endif()
