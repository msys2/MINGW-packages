apply_patch_with_msg() {
  for _patch in "$@"
  do
    msg2 "Applying ${_patch}"
    patch -Np1 -i "${srcdir}/${_patch}"
  done
}

prepare() {
  # Place missing WRL headers for mingw-w64
  mkdir -p ${srcdir}/${_pkgfn}/src/3rdparty/chromium/wrl
  cp -f ${srcdir}/{async,event,ftm,implements,module}.h ${srcdir}/${_pkgfn}/src/3rdparty/chromium/wrl/
  # Windows SDK declarations missing from mingw-w64, one header per SDK area.
  # Patched sources include them as "mingw_compat/<area>.h" under __MINGW32__.
  mkdir -p ${srcdir}/${_pkgfn}/src/3rdparty/chromium/mingw_compat
  local _h
  for _h in audioclient camera crypto d3d12video dcomp directml geolocation \
            graphics_capture ksmedia mf net win winrt; do
    cp -f ${srcdir}/mingw_compat_${_h}.h \
      ${srcdir}/${_pkgfn}/src/3rdparty/chromium/mingw_compat/${_h}.h
  done

  cd ${_pkgfn}

  apply_patch_with_msg \
    0001-cmake-configure-fixes.patch \
    0002-chromium-add-mingw-toolchain.patch \
    0003-chromium-base.patch \
    0004-chromium-chrome.patch \
    0005-chromium-components.patch \
    0006-chromium-content.patch \
    0007-chromium-device.patch \
    0008-chromium-gpu.patch \
    0009-chromium-media.patch \
    0010-chromium-net.patch \
    0011-chromium-sandbox.patch \
    0012-chromium-services.patch \
    0013-chromium-tools.patch \
    0014-chromium-ui.patch \
    0015-chromium-v8.patch \
    0016-chromium-others.patch \
    0017-chromium-mingw-link-fixes.patch \
    0018-cmake-mingw-process-and-tools.patch

  apply_patch_with_msg \
    0101-chromium-third-party-angle.patch \
    0102-chromium-third-party-blink.patch \
    0103-chromium-third-party-breakpad.patch \
    0104-chromium-third-party-crashpad.patch \
    0105-chromium-third-party-ffmpeg.patch \
    0106-chromium-third-party-pdfium.patch \
    0107-chromium-third-party-perfetto.patch \
    0108-chromium-third-party-skia.patch \
    0109-chromium-third-party-vulkan.patch \
    0110-chromium-third-party-webrtc.patch \
    0111-chromium-third-party-others.patch

  apply_patch_with_msg \
    0201-gn-mingw-fixes.patch

  apply_patch_with_msg \
    0019-chromium-boringssl-mingw-fixes.patch

  apply_patch_with_msg \
    0020-chromium-viz-bfs-uaf.patch

  apply_patch_with_msg \
    0025-chromium-clang-mingw-fcomplete-member-pointers.patch

  apply_patch_with_msg \
    0027-chromium-clang-mingw-libatomic.patch

  apply_patch_with_msg \
    0028-chromium-v8-clang-mingw-icu-template-stubs.patch

  apply_patch_with_msg \
    0029-chromium-build-config-clang-mingw-libstdcxx-catch.patch

  apply_patch_with_msg \
    0030-chromium-base-protected-memory-mingw.patch

  apply_patch_with_msg \
    0031-chromium-precompile-add-future-forward-list.patch

  apply_patch_with_msg \
    0032-chromium-skcms-disable-musttail-mingw-gcc.patch

  apply_patch_with_msg \
    0033-chromium-base-strong-alias-spaceship.patch

  apply_patch_with_msg \
    0034-chromium-mingw-tls-callbacks.patch

  apply_patch_with_msg \
    0035-chromium-libcxx-unique-ptr-deref-projection.patch

  rm -rf ../../${_pkgfn}.tar.xz

}

build() {
  # The PRE_LINK hook added by 0001-cmake-configure-fixes.patch runs the
  # strip script automatically before each Qt6WebEngineCore.dll link.
  # Debug info is kept only for chromium sources whose path starts with
  # one of CHROMIUM_DEBUG_STRIP_KEEP_PREFIXES; everything else is
  # stripped to keep .debug_info under the COFF 4 GiB section limit.
  # Qt-side libraries and objects (including libQtWebEngineCoreSandbox.a)
  # are kept by default - they're not in the chromium GN ninja index, so
  # the strip script treats them as orphans.
  #
  # NOTE: --compress-debug-sections=zlib is ELF-only; GAS and the linker
  # both reject it on PE/COFF targets, so we don't pass any compress flag.
  # Force GNU binutils objcopy: llvm-objcopy chokes on Qt6WebEngineCore.dll
  # with "invalid SymbolTableIndex" during the --only-keep-debug step that
  # QtSeparateDebugInfo.cmake runs after the link. GNU objcopy from
  # mingw-w64 binutils handles the same DLL fine.
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
  cmake -Wno-dev \
    -GNinja \
    -DCMAKE_BUILD_TYPE=Release \
    -DQT_GENERATE_SBOM=OFF \
    -DCMAKE_INSTALL_PREFIX=${MINGW_PREFIX} \
    -DCMAKE_OBJCOPY=${MINGW_PREFIX}/bin/objcopy.exe \
    -DPython3_EXECUTABLE=${MINGW_PREFIX}/bin/python \
    -DQT_FEATURE_qtpdf_build=OFF \
    -DQT_FEATURE_webengine_system_icu=ON \
    -DQT_FEATURE_webengine_proprietary_codecs=ON \
    -DQT_FEATURE_webengine_system_libvpx=ON \
    -DQT_SHOW_EXTRA_IDE_SOURCES=OFF \
    -S ${_pkgfn} \
    -B build-${MSYSTEM}

  cmake --build build-${MSYSTEM}
}

package_qt6-webengine() {
  depends+=("${MINGW_PACKAGE_PREFIX}-qt6-base"
            "${MINGW_PACKAGE_PREFIX}-qt6-declarative"
            "${MINGW_PACKAGE_PREFIX}-qt6-httpserver"
            "${MINGW_PACKAGE_PREFIX}-qt6-positioning"
            "${MINGW_PACKAGE_PREFIX}-qt6-webchannel")
  groups=("${MINGW_PACKAGE_PREFIX}-qt6")
  pkgdesc+=' (mingw-w64)'

  DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM}

  # Separate debug-info files
  rsync -armR --remove-source-files --include="*/" --include="*.debug" --exclude="*" \
    --prune-empty-dirs "${pkgdir}"/.${MINGW_PREFIX} "${srcdir}"/${MSYSTEM}-debug/

  install -d "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
  install -Dm644 ${_pkgfn}/LICENSES/* -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"

  # Fix paths in *.pri, *prl and *.pc files:
  #   $(cygpath -m ${MINGW_PREFIX}) -> $(cygpath -m "${pkgdir}"${MINGW_PREFIX})
  local PREFIX_WIN=$(cygpath -m ${MINGW_PREFIX})
  local PKGDIR_PREFIX_WIN=$(cygpath -m "${pkgdir}"${MINGW_PREFIX})

  find "${pkgdir}${MINGW_PREFIX}/share/qt6" -type f \( -name '*.pri' -o -name '*.prl' \) \
      -exec sed -i -e "s|${PREFIX_WIN}|${MINGW_PREFIX}|g" {} \;
      
  find "${pkgdir}${MINGW_PREFIX}/lib/cmake" -type f \( -name '*.cmake' \) \
      -exec sed -i -e "s|${PREFIX_WIN}|${MINGW_PREFIX}|g" {} \;
      
  find "${pkgdir}${MINGW_PREFIX}/lib" -type f \( -name '*.pri' -o -name '*.prl' \) \
      -exec sed -i -e "s|${PREFIX_WIN}|${MINGW_PREFIX}|g" {} \;

  find "${pkgdir}${MINGW_PREFIX}/lib/pkgconfig" -type f -name '*.pc' \
      -exec sed -i -e "s|${PREFIX_WIN}|${MINGW_PREFIX}|g" {} \;

  find "${pkgdir}${MINGW_PREFIX}/lib/pkgconfig" -type f -name '*.pc' \
      -exec sed -i -e "s|${PKGDIR_PREFIX_WIN}|${MINGW_PREFIX}|g" {} \;

  # Temporarly remove this file while qt6-pdf handle it
  rm -f "${pkgdir}${MINGW_PREFIX}"/lib/cmake/Qt6BuildInternals/StandaloneTests/QtWebEngineTestsConfig.cmake
}

package_qt6-webengine-debug() {
  depends=("${MINGW_PACKAGE_PREFIX}-qt6-base-debug"
           "${MINGW_PACKAGE_PREFIX}-qt6-declarative-debug"
           "${MINGW_PACKAGE_PREFIX}-qt6-httpserver-debug"
           "${MINGW_PACKAGE_PREFIX}-qt6-positioning-debug"
           "${MINGW_PACKAGE_PREFIX}-qt6-webchannel-debug"
           "${MINGW_PACKAGE_PREFIX}-${_realname}")
  groups=("${MINGW_PACKAGE_PREFIX}-qt6-debug")
  pkgdesc+=' (debug) (mingw-w64)'
  options=('!strip')

  cp -rf "${srcdir}"/${MSYSTEM}-debug${MINGW_PREFIX} "${pkgdir}"/
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
