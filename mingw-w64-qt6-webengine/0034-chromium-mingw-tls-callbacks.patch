 }
 
-#ifdef _WIN64
+#if defined(__MINGW32__)
+
+// MinGW compilers ignore #pragma comment(linker)/const_seg/data_seg, so the
+// variable would land in .rdata and never be called. Place it explicitly;
+// `used` keeps it alive through --gc-sections.
+extern const PIMAGE_TLS_CALLBACK perfetto_thread_callback_base;
+__attribute__((section(".CRT$XLP"), used))
+const PIMAGE_TLS_CALLBACK perfetto_thread_callback_base = PerfettoOnThreadExit;
+
+#elif defined(_WIN64)
 
 // .CRT section is merged with .rdata on x64 so it must be constant data.
 #pragma const_seg(".CRT$XLP")
