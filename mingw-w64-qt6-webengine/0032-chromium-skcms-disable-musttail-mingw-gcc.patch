Disable [[clang::musttail]] in skcms for GCC on Windows.

GCC 15 accepts [[clang::musttail]], so skcms enables tail-call stages
for every non-clang compiler. On the Win64 ABI the 16-byte vector
arguments (F r, g, b, a) are passed by reference, so GCC fails with
"cannot tail-call: argument must be passed by copying". The clang
branch already excludes _WIN32; do the same for GCC.

--- a/src/3rdparty/chromium/third_party/skia/modules/skcms/src/skcms_internals.h
+++ b/src/3rdparty/chromium/third_party/skia/modules/skcms/src/skcms_internals.h
@@ -57,7 +57,7 @@
             #define SKCMS_HAS_MUSTTAIL 1
         #endif
     #elif !defined(__clang__) && !defined(SKCMS_HAS_MUSTTAIL)
-        #if __has_cpp_attribute(clang::musttail)
+        #if __has_cpp_attribute(clang::musttail) && !defined(__MINGW32__)
             #define SKCMS_HAS_MUSTTAIL 1
         #else
             #define SKCMS_HAS_MUSTTAIL 0
