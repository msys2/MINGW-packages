diff --git a/src/core/tools/qwebengine_convert_dict/CMakeLists.txt b/src/core/tools/qwebengine_convert_dict/CMakeLists.txt
index 4d36ca004f..7f8c373eaf 100644
--- a/src/core/tools/qwebengine_convert_dict/CMakeLists.txt
+++ b/src/core/tools/qwebengine_convert_dict/CMakeLists.txt
@@ -26,6 +26,14 @@ if(QT_FEATURE_webengine_spellchecker AND NOT CMAKE_CROSSCOMPILING)
     qt_internal_extend_target(${dict_target_name} CONDITION GCC OR CLANG
         COMPILE_OPTIONS -Wno-unused-parameter
     )
+    # GCC 16 libstdc++ requires exception handling enabled for template
+    # bodies that use __catch (e.g. <vector>, <istream>, <list>); Qt's
+    # default for tools is -fno-exceptions which the new -Wtemplate-body
+    # parser rejects. Toggle Qt's _qt_internal_use_exceptions property so
+    # the platform target emits -fexceptions and drops QT_NO_EXCEPTIONS.
+    set_target_properties(${dict_target_name} PROPERTIES
+        _qt_internal_use_exceptions TRUE
+    )
     set_target_properties(${dict_target_name} PROPERTIES CXX_STANDARD 20)
     if(NOT QT_FEATURE_webengine_system_icu AND QT_WILL_INSTALL)
         # tool can be called durig build so copy icu file
