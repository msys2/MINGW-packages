# Maintainer: Cloud <kt286@qq.com>

_realname=dtk6core
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=6.7.47
pkgrel=1
pkgdesc='DTK6 core module'
arch=('any')
mingw_arch=('ucrt64')
url="https://github.com/linuxdeepin/dtkcore"
license=('LGPL3')
depends=("${MINGW_PACKAGE_PREFIX}-gcc-libs"
         "${MINGW_PACKAGE_PREFIX}-qt6-base"
         "${MINGW_PACKAGE_PREFIX}-dtkcommon"
         "${MINGW_PACKAGE_PREFIX}-dtk6log"
         "${MINGW_PACKAGE_PREFIX}-icu")
makedepends=("${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-gcc"
             "${MINGW_PACKAGE_PREFIX}-uchardet")

source=("dtkcore-${pkgver}.tar.gz::https://github.com/linuxdeepin/dtkcore/archive/refs/tags/${pkgver}.tar.gz")
sha512sums=('c3f9abd4c2fab674c1a7261c2557c0cd753eff1b5c0eb597d4308d20ba6e6b20fc849639d7d471d75e811f9b4c43e2ce83ef3a2e88ebafa1e5883020e59d7b87')

build() {
  mkdir -p "${srcdir}"/dtkcore-${pkgver}/build-${MSYSTEM}
  cd "${srcdir}"/dtkcore-${pkgver}/build-${MSYSTEM}

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    ${MINGW_PREFIX}/bin/cmake .. -GNinja \
      -DCMAKE_INSTALL_PREFIX=${MINGW_PREFIX} \
      -DCMAKE_PREFIX_PATH=${MINGW_PREFIX} \
      -DDTK5=OFF \
      -DBUILD_WITH_SYSTEMD=OFF \
      -DBUILD_EXAMPLES=OFF \
      -DBUILD_DOCS=OFF
  ${MINGW_PREFIX}/bin/ninja
}

package() {
  cd "${srcdir}"/dtkcore-${pkgver}/build-${MSYSTEM}
  DESTDIR="${pkgdir}" ${MINGW_PREFIX}/bin/ninja install
}
