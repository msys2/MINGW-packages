# Maintainer: Sarah Ottinger <schalaalexiazeal@gmail.com>

_realname='google-auth-oauthlib'
_pyname="${_realname//-/_}"
pkgbase="mingw-w64-python-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-python-${_realname}"
pkgver=1.4.1
pkgrel=1
pkgdesc='oauthlib integration for Google auth. (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/googleapis/google-cloud-python/tree/main/packages/google-auth-oauthlib'
msys2_repository_url='https://github.com/googleapis/google-cloud-python/tree/main/packages/google-auth-oauthlib'
msys2_changelog_url='https://github.com/googleapis/google-cloud-python/blob/main/packages/google-auth-oauthlib/CHANGELOG.md'
msys2_references=(
  'anitya: 23895'
  'archlinux: python-google-auth-oauthlib'
  'gentoo: dev-python/google-auth-oauthlib'
  'purl: pkg:pypi/google-auth-oauthlib'
)
license=('spdx:Apache-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-google-auth"
  "${MINGW_PACKAGE_PREFIX}-python-requests-oauthlib"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-click"
  "${MINGW_PACKAGE_PREFIX}-python-mock"
  "${MINGW_PACKAGE_PREFIX}-python-pytest"
)
optdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-click"
)
options=('!strip')
source=("https://pypi.org/packages/source/${_pyname::1}/${_realname}/${_pyname}-${pkgver}.tar.gz")
sha256sums=('1a83f5f2a8421dedadaa3caf25b3a710dddf85a33a63144be41c2fc79174b106')

build() {
  cp -r "${_pyname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "build-${MSYSTEM}"

  python -m pytest || warning 'Tests failed'
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
