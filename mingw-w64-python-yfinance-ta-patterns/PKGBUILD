# Maintainer: eminsk <M_N_N@tut.by>

_realname=yfinance-ta-patterns
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.3.35
pkgrel=1
pkgdesc="Institutional-grade market candlestick pattern scanner with multi-asset backtesting (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://github.com/eminsk/yfinance-ta-patterns"
msys2_repository_url='https://github.com/eminsk/yfinance-ta-patterns'
msys2_changelog_url="https://github.com/eminsk/yfinance-ta-patterns/releases"
msys2_references=(
  'purl: pkg:pypi/yfinance-ta-patterns'
)
license=('spdx:MIT')
options=(!strip)
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-pandas"
  "${MINGW_PACKAGE_PREFIX}-python-numpy"
  "${MINGW_PACKAGE_PREFIX}-python-pytz"
  "${MINGW_PACKAGE_PREFIX}-python-rich"
)
optdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-yfinance: for live market data downloads via Yahoo Finance"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
  "${MINGW_PACKAGE_PREFIX}-python-wheel"
)
source=("https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname//-/_}-${pkgver}.tar.gz")
sha256sums=('755ba32285a37496880e7ea9567d4207d76b8c83ea5d356a94e97845869d800d')

prepare() {
  cd "${srcdir}/${_realname//-/_}-${pkgver}"
  sed -i '/"yfinance>=/d' pyproject.toml
}

build() {
  cp -r "${_realname//-/_}-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"
  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "${srcdir}/python-build-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 "${srcdir}/${_realname//-/_}-${pkgver}/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
