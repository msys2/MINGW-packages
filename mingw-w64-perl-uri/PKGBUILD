# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=URI
_realname="${_perlname,,}"
pkgbase="mingw-w64-perl-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=5.40
pkgrel=1
pkgdesc="URI - Uniform Resource Identifiers (absolute and relative). (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/URI"
msys2_repository_url="https://github.com/libwww-perl/URI"
msys2_changelog_url='https://metacpan.org/dist/URI/changes'
msys2_references=(
  'anitya: 3485'
  'archlinux: perl-uri'
  'gentoo: dev-perl/URI'
  'purl: pkg:cpan/OALDERS/URI'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-perl"
  "${MINGW_PACKAGE_PREFIX}-perl-mime-base32"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-make"
)
source=("https://cpan.metacpan.org/authors/id/O/OA/OALDERS/${_perlname}-${pkgver}.tar.gz")
sha256sums=('ef5d2ef099a1a24a6e83ffe543de73337805d3d39c00b84fa205d725ad1a1b63')

build() {
  cp -r "${_perlname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="PREFIX=" \
    PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}

  mingw32-make
}

package() {
  cd "build-${MSYSTEM}"

  mingw32-make DESTDIR="${pkgdir}/" install

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/perl-${_realname}"
}
