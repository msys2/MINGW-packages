 $gitVersionHeaderPath = Join-Path $BuildRoot 'git_version.h'
+$rootVersionHeaderPath = Join-Path $SourceRoot 'git_version.h'
+
+# Checks that the header has the two values the build needs and never rewrites it.
+function Assert-VersionHeader([string]$path) {
+  $header = Get-Content -Raw $path
+  foreach ($name in 'BUILD_GIT_VERSION_NUMBER', 'BUILD_GIT_VERSION_STRING') {
+    if ($header -notmatch "(?m)^\s*#define\s+$name\s+\S") {
+      Write-Error "invalid git_version.h: $name is missing ($path)"
+      exit 2
+    }
+  }
+}
+
+# The header exists in release tarball source: copy it into the build dir if it differs.
+if (Test-Path $rootVersionHeaderPath) {
+  New-Item -ItemType Directory -Force -Path $BuildRoot | Out-Null
+  if (!(Test-Path $gitVersionHeaderPath) -or
+      ((Get-Content -Raw $rootVersionHeaderPath) -ne (Get-Content -Raw $gitVersionHeaderPath))) {
+    Copy-Item -Force $rootVersionHeaderPath $gitVersionHeaderPath
+  }
+  Assert-VersionHeader $gitVersionHeaderPath
+  exit 0
+}
+
+# No git available or not a checkout: reuse a cached build header.
+$haveGit = (Get-Command git -ErrorAction SilentlyContinue) -and (Test-Path (Join-Path $SourceRoot '.git'))
+if (!$haveGit) {
+  if (Test-Path $gitVersionHeaderPath) {
+    Assert-VersionHeader $gitVersionHeaderPath
+    exit 0
+  }
+  Write-Error "no git repository (or git.exe) and no cached git_version.h"
+  exit 2
+}
 
