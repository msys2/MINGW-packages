# Maintainer: Wu, Zhenyu <wuzhenyu@ustc.edu>

_realname=make-ls
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.1.25
pkgrel=1
pkgdesc='Language server for Makefiles'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/owenrumney/make-ls'
msys2_repository_url='https://github.com/owenrumney/make-ls'
msys2_references=(
  'purl: pkg:golang/github.com/owenrumney/make-ls'
)
license=('spdx:MIT')
makedepends=("${MINGW_PACKAGE_PREFIX}-go")
source=("${url}/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz")
sha256sums=('69080ba66e8c4dbe050912cbffc2d2f5cec7b38e4b7a0141679c184a652ef0e7')

build() {
  cd "${_realname}-${pkgver}"

  export GOOS=windows
  export GOROOT="${MINGW_PREFIX}/lib/go"
  export CGO_ENABLED=0
  export GOFLAGS="-trimpath -mod=readonly -modcacherw"

  go build -o . ./cmd/make-ls
}

check() {
  cd "${_realname}-${pkgver}"
  go test ./...
}

package() {
  cd "${_realname}-${pkgver}"
  install -Dm755 make-ls.exe -t "${pkgdir}${MINGW_PREFIX}/bin"
  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
