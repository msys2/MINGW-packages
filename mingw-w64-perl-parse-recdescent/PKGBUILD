# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=Parse-RecDescent
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=1.967015
pkgrel=2
pkgdesc="Generate Recursive-Descent Parsers. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/Parse-RecDescent"
msys2_repository_url="https://github.com/jtbraun/Parse-RecDescent"
msys2_references=(
  'purl: pkg:cpan/JTBRAUN/Parse-RecDescent'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-perl")
makedepends=("${MINGW_PACKAGE_PREFIX}-make")
source=("https://cpan.metacpan.org/authors/id/J/JT/JTBRAUN/${_perlname}-${pkgver}.tar.gz")
sha256sums=('1943336a4cb54f1788a733f0827c0c55db4310d5eae15e542639c9dd85656e37')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
}
