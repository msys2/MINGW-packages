# Maintainer: Andrew Sun <adsun701@gmail.com>

_realname='4th'
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=3.64.2
pkgrel=1
pkgdesc='A Forth Compiler (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://www.xs4all.nl/~thebeez/4tH/index.html'
msys2_repository_url='https://sourceforge.net/p/forth-4th/code/HEAD/tree/trunk/'
license=('spdx:GPL-3.0-or-later')
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
)
options=('!strip')
source=(
  "https://downloads.sourceforge.net/sourceforge/forth-4th/${_realname}-${pkgver}-x86_64.tar.gz"
)
sha256sums=('49dae2ded0f58465743558c7a441e758cc871c2fb7dda6a605f7b95023ce66fa')

build() {
  rm -rf "build-${MSYSTEM}" && mkdir -p "build-${MSYSTEM}"

  cp -r "${_realname}-${pkgver}/sources/." "build-${MSYSTEM}"

  cd "build-${MSYSTEM}"

  CROSS="${MINGW_PREFIX}/bin/" \
    make -f Makefile.W32 CC="${CC}"
}

package() {
  cd "build-${MSYSTEM}"

  install -dm755 "${pkgdir}${MINGW_PREFIX}/"{bin,lib,share/doc/${_realname}}

  CROSS="${MINGW_PREFIX}/bin/" \
    make -f Makefile.W32 \
      CC="${CC}" \
      BINARIES="${pkgdir}${MINGW_PREFIX}/bin" \
      LIBRARIES="${pkgdir}${MINGW_PREFIX}/lib" \
      DOCDIR="${pkgdir}${MINGW_PREFIX}/share/doc" \
      MANDIR="${pkgdir}${MINGW_PREFIX}/share/man" \
      install

  cd "${srcdir}/${_realname}-${pkgver}"

  install -Dm644 COPYING -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
