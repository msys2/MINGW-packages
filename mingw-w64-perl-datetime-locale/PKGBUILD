# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname='DateTime-Locale'
_realname="${_perlname,,}"
pkgbase="mingw-w64-perl-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=1.47
pkgrel=1
pkgdesc='Localization support for DateTime.pm. (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://metacpan.org/dist/DateTime-Locale'
msys2_repository_url='https://github.com/houseabsolute/DateTime-Locale'
msys2_changelog_url='https://metacpan.org/dist/DateTime-Locale/changes'
msys2_references=(
  'anitya: 6477'
  'archlinux: perl-datetime-locale'
  'gentoo: dev-perl/DateTime-Locale'
  'purl: pkg:cpan/DROLSKY/DateTime-Locale'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-perl"
  "${MINGW_PACKAGE_PREFIX}-perl-file-sharedir"
  "${MINGW_PACKAGE_PREFIX}-perl-file-sharedir-install"
  "${MINGW_PACKAGE_PREFIX}-perl-list-moreutils"
  "${MINGW_PACKAGE_PREFIX}-perl-params-validationcompiler"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-make"
)
source=("https://cpan.metacpan.org/authors/id/D/DR/DROLSKY/${_perlname}-${pkgver}.tar.gz")
sha256sums=('c0b25e1cdb2825d4469b96c7bbd1d7f20c5fc5fc5ae7f5e2bf6e69e08bfb9ecd')

build() {
  cp -r "${_perlname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL PREFIX="${MINGW_PREFIX}"

  mingw32-make
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="PREFIX=" \
    mingw32-make DESTDIR="${pkgdir}" install

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE"
}
