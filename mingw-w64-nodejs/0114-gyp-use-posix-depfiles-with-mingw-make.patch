The Windows Python GYP generator emits invalid \\: phony targets with MSYS2's POSIX make/sed; use the POSIX depfile fixup under MSYS2.
diff --git a/tools/gyp/pylib/gyp/generator/make.py b/tools/gyp/pylib/gyp/generator/make.py
--- a/tools/gyp/pylib/gyp/generator/make.py
+++ b/tools/gyp/pylib/gyp/generator/make.py
@@ -474,5 +474,5 @@ define fixup_dep
         r"""
 sed -e "s|^$(notdir $@)|$@|" -re 's/\\\\([^$$])/\/\1/g' $(depfile).raw >> $(depfile)"""
-        if sys.platform == "win32"
+        if sys.platform == "win32" and not os.environ.get("MSYSTEM")
         else r"""
 sed -e "s|^$(notdir $@)|$@|" $(depfile).raw >> $(depfile)"""
@@ -486,5 +486,5 @@ sed -e "s|^$(notdir $@)|$@|" $(depfile).raw >> $(depfile)"""
         """
 sed -e 's/\\\\$$//' -e 's/\\\\/\//g' -e 'y| |\n|' $(depfile).raw |\"""
-        if sys.platform == "win32"
+        if sys.platform == "win32" and not os.environ.get("MSYSTEM")
         else """
 sed -e 's|\\||' -e 'y| |\n|' $(depfile).raw |\"""
