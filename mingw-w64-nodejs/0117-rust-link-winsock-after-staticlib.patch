GNU ld needs winsock after Rust's static library to resolve Rust std's sendto and GetHostNameW references; use a distinct -l: argument so GYP does not deduplicate the earlier -lws2_32.
diff --git a/deps/crates/crates.gyp b/deps/crates/crates.gyp
--- a/deps/crates/crates.gyp
+++ b/deps/crates/crates.gyp
@@ -69,2 +69,5 @@
           }],
+          ['OS=="win" and OS!="msvc"', {
+            'libraries': [ '-l:libws2_32.a' ],
+          }],
         ],
