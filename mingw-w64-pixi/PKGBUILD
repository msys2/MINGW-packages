# Contributor: dragon-archer <dragon-archer@outlook.com>

_realname=pixi
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.81.0
pkgrel=2
pkgdesc='A fast, modern, and reproducible package management tool for developers of all backgrounds. (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://pixi.sh/'
msys2_repository_url="https://github.com/prefix-dev/pixi/"
license=('spdx:BSD-3-Clause')
depends=(
  "${MINGW_PACKAGE_PREFIX}-bzip2"
  "${MINGW_PACKAGE_PREFIX}-zstd"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-rust"
)
options=('!strip')
source=("${msys2_repository_url}/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
        "bzip2-sys.tar.gz::https://static.crates.io/crates/bzip2-sys/0.1.13+1.0.8/download"
        "zstd-sys.tar.gz::https://static.crates.io/crates/zstd-sys/2.1.0+zstd.1.5.7/download"
        bzip2-pkgconf.patch)
sha256sums=('6de3f263642615b772400140562ca0a79db2ef489df2efd2499611225481ac24'
            '225bff33b2141874fe80d71e07d6eec4f85c5c216453dd96388240f96e1acc14'
            '0ef0a8027ec3ee71300ab3bcbcd0393f434aa72b91ca6d635a39941deae8eea0'
            'f73309fb98b89b2085bccee6ffb66820082628d096bc989922b25d33a1f5f378')

prepare() {
  cd "${_realname}-${pkgver}"
  
  patch -d "../bzip2-sys-0.1.13+1.0.8" -i "../bzip2-pkgconf.patch"
  sed -i "s/statik(true)/statik(false)/" "../zstd-sys-2.1.0+zstd.1.5.7/build.rs"
  sed -i '/\[patch.crates-io\]/a\
zstd-sys = { path = "../zstd-sys-2.1.0+zstd.1.5.7" }\
bzip2-sys.path = "../bzip2-sys-0.1.13+1.0.8"' Cargo.toml
  cargo update -p bzip2-sys -p zstd-sys
  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${_realname}-${pkgver}"
  export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
  export CARGO_PROFILE_RELEASE_LTO="fat"
  export CARGO_PROFILE_RELEASE_STRIP="symbols"
  export ZSTD_SYS_USE_PKG_CONFIG=1

  if [ "${MSYSTEM}" = "CLANGARM64" ]; then
    export AWS_LC_SYS_NO_JITTER_ENTROPY=1
  fi

  cargo build --frozen --release
}

check() {
  cd "${_realname}-${pkgver}"

  cargo test --frozen --release
}

package() {
  cd "${_realname}-${pkgver}"

  install -Dt "${pkgdir}${MINGW_PREFIX}/bin" target/release/${_realname}
  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
