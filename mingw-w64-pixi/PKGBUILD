# Contributor: dragon-archer <dragon-archer@outlook.com>

_realname=pixi
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.81.0
pkgrel=1
pkgdesc='A fast, modern, and reproducible package management tool for developers of all backgrounds. (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://pixi.sh/'
msys2_repository_url="https://github.com/prefix-dev/pixi/"
license=('spdx:BSD-3-Clause')
makedepends=("${MINGW_PACKAGE_PREFIX}-rust"
             "${MINGW_PACKAGE_PREFIX}-git")
options=('!strip')
source=("${msys2_repository_url}/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
        "0001-fix-msvc-style-flags.patch")
sha256sums=('6de3f263642615b772400140562ca0a79db2ef489df2efd2499611225481ac24'
            'df6bd32300a0d0b98de95a3110decf72132bc6e2c84b84ca48c43bf93f689160')

apply_patch_with_msg() {
  for _patch in "$@"
  do
    msg2 "Applying $_patch"
    patch -Nbp1 -i "${srcdir}/$_patch"
  done
}

prepare() {
  cd "${_realname}-${pkgver}"

  apply_patch_with_msg \
    0001-fix-msvc-style-flags.patch

  ${MINGW_PREFIX}/bin/cargo fetch \
    --locked \
    --config='net.git-fetch-with-cli=true' \
    --target "${RUST_CHOST}"
}

build() {
  cd "${_realname}-${pkgver}"

  if [ "${MSYSTEM}" = "CLANGARM64" ]; then
    export AWS_LC_SYS_NO_JITTER_ENTROPY=1
  fi
  
  ${MINGW_PREFIX}/bin/cargo build --frozen --profile ci
}

check() {
  cd "${_realname}-${pkgver}"

  ${MINGW_PREFIX}/bin/cargo test --frozen --profile ci
}

package() {
  cd "${_realname}-${pkgver}"

  install -Dt "${pkgdir}${MINGW_PREFIX}/bin" target/ci/${_realname}
  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
