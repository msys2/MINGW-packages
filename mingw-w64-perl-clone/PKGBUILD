# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=Clone
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=0.51
pkgrel=1
pkgdesc="Recursively copy Perl datatypes. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/Clone"
msys2_repository_url="https://github.com/garu/Clone"
msys2_changelog_url='https://metacpan.org/dist/Clone/changes'
msys2_references=(
  'anitya: 5875'
  'archlinux: perl-clone'
  'gentoo: dev-perl/Clone'
  'purl: pkg:cpan/ATOOMIC/Clone'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-perl"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-make"
)
source=("https://cpan.metacpan.org/authors/id/A/AT/ATOOMIC/${_perlname}-${pkgver}.tar.gz")
sha256sums=('f17f66fec97dacca67ac9585701d2d079cfc80539fe6e8160c201c4e55f67507')

build() {
  cp -r "${_perlname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="PREFIX=" \
    PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}

  mingw32-make CC=${CC} CXX=${CXX} LD=${CXX}
}

package() {
  cd "build-${MSYSTEM}"

  mingw32-make DESTDIR="${pkgdir}/" install
}
