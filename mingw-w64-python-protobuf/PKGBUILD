# Maintainer: gym603 <gui_yuan_miao@163.com>

_realname='protobuf'
pkgbase="mingw-w64-python-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-python-${_realname}"
pkgver=7.36.2
pkgrel=1
pkgdesc='Protocol Buffers (mingw-w64)'
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://github.com/protocolbuffers/protobuf'
msys2_repository_url='https://github.com/protocolbuffers/protobuf'
msys2_references=(
  'anitya: 46522'
  'archlinux:' # ignore
  'aur:' # ignore
  'cpe: cpe:/a:google:protobuf-python'
  'purl: pkg:pypi/protobuf'
)
license=('spdx:BSD-3-Clause')
depends=(
  "${MINGW_PACKAGE_PREFIX}-protobuf=${pkgver#*.}"
  "${MINGW_PACKAGE_PREFIX}-python"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
source=(
  "https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz"
  '001-no-python-static-lib.patch'
  '002-fix-longjmp.patch'
)
sha256sums=('497d0463ff3316681da6c0b9e8d06cb465d61abce00b613ab42226175644d1bb'
            'e864e7964ad7693e6ce8dc3b91c779184457ce82fc075d2099bfcbc18e6808a3'
            'bd38a5def883ab208f6ce136594127f3b0f070a7deb07b856a763d7d295f7612')

prepare() {
  cd "${_realname}-${pkgver}"

  patch -Np1 -i "${srcdir}/001-no-python-static-lib.patch"
  patch -Np1 -i "${srcdir}/002-fix-longjmp.patch"
}

build() {
  cp -r "${_realname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl
}
