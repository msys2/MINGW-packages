# Maintainer: Bjoern Lemke <lemke@lemke-it.com>

_realname=lfcxml
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.3.9
pkgrel=1
pkgdesc="LFC C++ xml classes (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://www.lemke-it.com/'
msys2_references=(
  'anitya: 1552'
)
license=('spdx:GPL-3.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-lfcbase"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-cc"
)
source=("https://www.lemke-it.com/${_realname}-${pkgver}.tar.bz2")
sha256sums=('1fbe9c8d57c1a8c072b838478eb7bd1d6f71f9198ba76f601f83c8aed3722e2a')

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"

  sed -i "s/LC_ALL=C/sed 's\/\\\\r\/\/g' | LC_ALL=C/" build-aux/tap-driver.sh
}

build() {
  mkdir -p "${srcdir}"/build-${MSYSTEM} && cd "${srcdir}"/build-${MSYSTEM}

  ../${_realname}-${pkgver}/configure \
    --prefix=${MINGW_PREFIX} \
    --build=${MINGW_CHOST} \
    --host=${MINGW_CHOST} \
    --target=${MINGW_CHOST} \
    --enable-static \
    --enable-shared

  make

  ${CXX} -shared \
    -Wl,--out-implib,liblfcxml.dll.a \
    -o liblfcxml-0.dll \
    "${srcdir}"/build-${MSYSTEM}/src/*.o \
    -llfcbase -lsystre -lws2_32 -lpthread
}

check() {
  cd "${srcdir}"/build-${MSYSTEM}

  make check
}

package() {
  cd "${srcdir}"/build-${MSYSTEM}

  make install DESTDIR="${pkgdir}"

  mkdir -p "${pkgdir}"${MINGW_PREFIX}/{bin,lib}
  install -m 0755 liblfcxml-0.dll "${pkgdir}${MINGW_PREFIX}/bin"
  install -m 0644 liblfcxml.dll.a "${pkgdir}${MINGW_PREFIX}/lib"
}
