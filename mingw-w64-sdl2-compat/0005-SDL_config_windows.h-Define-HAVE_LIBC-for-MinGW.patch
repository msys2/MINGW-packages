From d647b950fb7fb314fa61ea46b5e235a59c1ee057 Mon Sep 17 00:00:00 2001
From: Zhongteng Gui <dragon-archer@outlook.com>
Date: Wed, 11 Nov 2026 14:37:00 +0800
Subject: [PATCH 1/2] SDL_config_windows.h: Define HAVE_LIBC for MinGW

Real SDL2 includes lots of standard headers in SDL_stdinc.h, as long as
they're detected and writen to SDL_config.h. However, sdl2-compat
doesn't do such detection, and for Windows platforms HAVE_LIBC is not
defined, so almost all headers, espcially <stdlib.h> and <stdio.h> are
not included, which may break other projects.

Define HAVE_LIBC to 1 for MinGW platforms, as there's no additional
cost/risk, but helps make sdl2-compat more compatiable to SDL2.

Keep rwops_testFPRead and rwops_testFPWrite disabled for MinGW for now,
as they use stdio functions, but now we build with -nostdlib.
---
 include/SDL2/SDL_config_windows.h | 6 ++++++
 test/testautomation_rwops.c       | 4 ++--
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/include/SDL2/SDL_config_windows.h b/include/SDL2/SDL_config_windows.h
index 28b54b99..4fa550b3 100644
--- a/include/SDL2/SDL_config_windows.h
+++ b/include/SDL2/SDL_config_windows.h
@@ -120,6 +120,12 @@ typedef unsigned int uintptr_t;
 # endif
 #endif
 
+/* mingw-w64 always links to C runtime and have standard headers.
+ * Besides, some legacy programs may assume SDL.h to include many standard headers. */
+#ifdef __MINGW32__
+#define HAVE_LIBC 1
+#endif
+
 /* This is disabled by default to avoid C runtime dependencies and manifest requirements */
 #ifdef HAVE_LIBC
 /* Useful headers */
diff --git a/test/testautomation_rwops.c b/test/testautomation_rwops.c
index 441ba73b..2901b576 100644
--- a/test/testautomation_rwops.c
+++ b/test/testautomation_rwops.c
@@ -395,7 +395,7 @@ int rwops_testFileWrite(void)
 int
 rwops_testFPRead(void)
 {
-#ifdef HAVE_LIBC
+#if defined(HAVE_LIBC) && !defined(__MINGW32__)
    FILE *fp;
    SDL_RWops *rw;
    int result;
@@ -448,7 +448,7 @@ rwops_testFPRead(void)
 int
 rwops_testFPWrite(void)
 {
-#ifdef HAVE_LIBC
+#if defined(HAVE_LIBC) && !defined(__MINGW32__)
    FILE *fp;
    SDL_RWops *rw;
    int result;

From 921a96e365ecdf2c4587c38b0facf4f87c9d724c Mon Sep 17 00:00:00 2001
From: Zhongteng Gui <dragon-archer@outlook.com>
Date: Wed, 11 Nov 2026 22:06:23 +0800
Subject: [PATCH 2/2] test: Make sure the newly built SDL2.dll is used

There might be an existing SDL2.dll in the same directory as SDL3.dll
---
 test/CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/test/CMakeLists.txt b/test/CMakeLists.txt
index 0437b62f..d48f7546 100644
--- a/test/CMakeLists.txt
+++ b/test/CMakeLists.txt
@@ -57,10 +57,10 @@ function(test_program NAME)
       TIMEOUT ${timeout}
     )
     if(WIN32 AND CMAKE_VERSION VERSION_GREATER_EQUAL "3.27")
-      set_property(TEST ${NAME} APPEND PROPERTY ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_RUNTIME_DLL_DIRS:${NAME}>")
       if(TARGET SDL3::SDL3-shared)
         set_property(TEST ${NAME} APPEND PROPERTY ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:SDL3::SDL3-shared>")
       endif()
+      set_property(TEST ${NAME} APPEND PROPERTY ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_RUNTIME_DLL_DIRS:${NAME}>")
     endif()
     if(SDL2COMPAT_INSTALL_TESTS)
       set(exe ${NAME})