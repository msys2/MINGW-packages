From d043d75bfff876f7b86919f892f3c672e2d15eba Mon Sep 17 00:00:00 2001
From: Zhongteng Gui <dragon-archer@outlook.com>
Date: Wed, 11 Nov 2026 14:37:00 +0800
Subject: [PATCH] SDL_config_windows.h: Define HAVE_LIBC for MinGW

Signed-off-by: Zhongteng Gui <dragon-archer@outlook.com>
---
 include/SDL2/SDL_config_windows.h | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/include/SDL2/SDL_config_windows.h b/include/SDL2/SDL_config_windows.h
index 28b54b9..4fa550b 100644
--- a/include/SDL2/SDL_config_windows.h
+++ b/include/SDL2/SDL_config_windows.h
@@ -120,6 +120,12 @@ typedef unsigned int uintptr_t;
 # endif
 #endif
 
+/* mingw-w64 always links to C runtime and have standard headers.
+ * Besides, some legacy programs may assume SDL.h to include many standard headers. */
+#ifdef __MINGW32__
+#define HAVE_LIBC 1
+#endif
+
 /* This is disabled by default to avoid C runtime dependencies and manifest requirements */
 #ifdef HAVE_LIBC
 /* Useful headers */
-- 
2.56.1.windows.1

