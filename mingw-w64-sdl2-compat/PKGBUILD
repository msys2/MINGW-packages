# Maintainer: Fred Arnold <clownacy@yahoo.com>

_realname=sdl2-compat
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2.32.74
pkgrel=5
pkgdesc="An SDL2 compatibility layer that uses SDL3 behind the scenes (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://github.com/libsdl-org/sdl2-compat'
msys2_repository_url="${url}"
msys2_references=(
  "gentoo: media-libs/libsdl2"
)
license=('spdx:Zlib')
conflicts=("${MINGW_PACKAGE_PREFIX}-SDL2")
provides=(
  "${MINGW_PACKAGE_PREFIX}-SDL2=${pkgver}-${pkgrel}"
  "${MINGW_PACKAGE_PREFIX}-sdl2=${pkgver}-${pkgrel}"
)
replaces=("${MINGW_PACKAGE_PREFIX}-SDL2")
depends=("${MINGW_PACKAGE_PREFIX}-sdl3")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=(
  "${url}/releases/download/release-${pkgver}/${_realname}-${pkgver}.tar.gz"
  '0001-just-build-normal.patch'
  '0002-sdl-config-win-paths.patch'
  '0003-Enable-static-library-support-for-Windows.patch'
  '0004-Make-static-library-really-static-for-MinGW.patch'
  '0005-SDL_config_windows.h-Define-HAVE_LIBC-for-MinGW.patch'
)
sha256sums=('ec68abde77e2e459c8abc4f9587b8976b5d2a657b2bfda2fb3a079b0f8924588'
            '484cc733b3f1b8ecec23d4a60eebd20c4e645a4e085e6e26ec8142b47b68fc12'
            '0b761282e9f96a1a967b735374ec60c875aa7aefb5b99d100430c323e0b06d5c'
            '60db752646a6e919f670eb0f3eaedf0414f9ced14023b78eb81436a0aa4cac52'
            'bfc29743022780463e9ca097c33907abe2cb26e36ed081c938f93975eaa981e8'
            '509c31ea74afe697451cadd257110c5b8f2dd52a2dceb4643f8ddab0a37a10dc')

prepare() {
  cd "${_realname}-${pkgver}"

  patch -Np1 -i "${srcdir}/0001-just-build-normal.patch"
  patch -Np1 -i "${srcdir}/0002-sdl-config-win-paths.patch"
  # https://github.com/libsdl-org/sdl2-compat/pull/633
  patch -Np1 -i "${srcdir}/0003-Enable-static-library-support-for-Windows.patch"
  patch -Np1 -i "${srcdir}/0004-Make-static-library-really-static-for-MinGW.patch"

  # https://github.com/libsdl-org/sdl2-compat/pull/634
  patch -Np1 -i "${srcdir}/0005-SDL_config_windows.h-Define-HAVE_LIBC-for-MinGW.patch"
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -Wno-author \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${extra_config[@]}" \
      -DBUILD_SHARED_LIBS=ON \
      -DSDL2COMPAT_STATIC=ON \
      -S "${_realname}-${pkgver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

check() {
  ctest --test-dir "build-${MSYSTEM}" --output-on-failure
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "${_realname}-${pkgver}/LICENSE.txt" -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/"
}
