From 808412c108b51c3a956a5050583e5a53d005555a Mon Sep 17 00:00:00 2001
From: Zhongteng Gui <dragon-archer@outlook.com>
Date: Tue, 10 Nov 2026 17:28:41 +0800
Subject: [PATCH 1/2] Enable static library support for Windows

Signed-off-by: Zhongteng Gui <dragon-archer@outlook.com>
---
 CMakeLists.txt    | 6 +++---
 src/sdl2_compat.c | 2 +-
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index f6afd3e..58ae40f 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -93,8 +93,8 @@ set(SDL2COMPAT_VENDOR_INFO "" CACHE STRING "Vendor name and/or version to add to
 set(SDL2COMPAT_FRAMEWORK FALSE)
 #FIXME: should SDL2-compat modify vendor_info/revision information?
 
-if(SDL2COMPAT_STATIC AND NOT (CMAKE_SYSTEM_NAME MATCHES "Linux|QNX"))
-  message(FATAL_ERROR "Static builds are only supported on Linux or QNX.")
+if(SDL2COMPAT_STATIC AND NOT (CMAKE_SYSTEM_NAME MATCHES "Linux|QNX|Windows"))
+  message(FATAL_ERROR "Static builds are only supported on Linux or QNX or Windows.")
 endif()
 
 macro(check_add_debug_flag FLAG SUFFIX)
@@ -489,7 +489,7 @@ if(SDL2COMPAT_STATIC)
       "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>"
       "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/SDL2>"
   )
-  target_compile_definitions(SDL2-static PRIVATE _REENTRANT)
+  target_compile_definitions(SDL2-static PRIVATE _REENTRANT SDL2COMPAT_STATIC)
   target_compile_definitions(SDL2-static PRIVATE "SDL2COMPAT_REVISION=\"${SDL2COMPAT_REVISION}\"")
   target_link_libraries(SDL2-static PRIVATE ${CMAKE_DL_LIBS})
   set_target_properties(SDL2-static PROPERTIES
diff --git a/src/sdl2_compat.c b/src/sdl2_compat.c
index a19fe0d..253d0ae 100644
--- a/src/sdl2_compat.c
+++ b/src/sdl2_compat.c
@@ -1205,7 +1205,7 @@ static void error_dialog(const char *errorMsg)
 }
 #endif
 
-#if defined(__GNUC__) && !defined(_WIN32)
+#if defined(__GNUC__) && (!defined(_WIN32) || defined(SDL2COMPAT_STATIC))
 static void dllinit(void) __attribute__((constructor));
 static void dllinit(void)
 {
-- 
2.56.0.windows.4

