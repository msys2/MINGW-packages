# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_realname=sdl2-mixer
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=2.8.2
pkgrel=2
pkgdesc="A simple multi-channel audio mixer (Version 2) (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://github.com/libsdl-org/SDL_mixer'
msys2_repository_url="${url}"
msys2_references=(
  "anitya: 389478"
  "gentoo: media-libs/sdl2-mixer"
)
license=('spdx:Zlib')
conflicts=("${MINGW_PACKAGE_PREFIX}-SDL2_mixer")
provides=("${MINGW_PACKAGE_PREFIX}-SDL2_mixer=${pkgver}-${pkgrel}")
replaces=("${MINGW_PACKAGE_PREFIX}-SDL2_mixer")
depends=(
  "${MINGW_PACKAGE_PREFIX}-sdl2"
  "${MINGW_PACKAGE_PREFIX}-flac"
  "${MINGW_PACKAGE_PREFIX}-fluidsynth"
  "${MINGW_PACKAGE_PREFIX}-libgme"
  "${MINGW_PACKAGE_PREFIX}-libvorbis"
  "${MINGW_PACKAGE_PREFIX}-libxmp"
  "${MINGW_PACKAGE_PREFIX}-mpg123"
  "${MINGW_PACKAGE_PREFIX}-opusfile"
  "${MINGW_PACKAGE_PREFIX}-wavpack"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=(
  "${url}/releases/download/release-${pkgver}/SDL2_mixer-${pkgver}.tar.gz"{,.sig}
  '0001-cmake-find-flac-threads.patch'
)
sha256sums=('938dff531d00ace2296557a6599abe6f34599e2f34f0a4a08a397e2ccac8b8f7'
            'SKIP'
            '8a7f55afdf573105d67fa295d8bb09b7a0a2ed2d246e76583b2fbac2f3172575')
validpgpkeys=('0900104363B4C9D4223DE149D913FE7D4B61D39B') # Sam Lantinga <slouken@libsdl.org>

prepare() {
  cd "SDL2_mixer-${pkgver}"

  patch -Np1 -i "${srcdir}/0001-cmake-find-flac-threads.patch"
}

build() {
  declare -a _cmake_opts=(
    -Wno-author
    -GNinja
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}"
    -DSDL2MIXER_INSTALL=ON
    -DSDL2MIXER_VENDORED=OFF
    -DSDL2MIXER_DEPS_SHARED=OFF # So ntldd can find linked DLLs
    -DSDL2MIXER_FLAC_LIBFLAC=ON
    -DSDL2MIXER_GME=ON
    -DSDL2MIXER_MP3_MPG123=ON
    -DSDL2MIXER_VORBIS="VORBISFILE"
    -DSDL2MIXER_WAVPACK_DSD=ON
    -S "SDL2_mixer-${pkgver}"
  )
  if check_option "debug" "n"; then
    _cmake_opts+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _cmake_opts+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      "${_cmake_opts[@]}" \
      -DBUILD_SHARED_LIBS=OFF \
      -B "build-${MSYSTEM}-static"

  cmake --build "build-${MSYSTEM}-static"

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      "${_cmake_opts[@]}" \
      -DBUILD_SHARED_LIBS=ON \
      -B "build-${MSYSTEM}-shared"

  cmake --build "build-${MSYSTEM}-shared"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}-static"
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}-shared"
}
