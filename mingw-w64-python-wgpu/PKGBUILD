# Maintainer: Konstantin Podsvirov <konstantin@podsvirov.su>

_realname=wgpu
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.32.0
pkgrel=1
pkgdesc="WebGPU for Python (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://wgpu-py.readthedocs.io/'
msys2_repository_url='https://github.com/pygfx/wgpu-py'
license=('spdx:BSD-2-Clause')
depends=("${MINGW_PACKAGE_PREFIX}-python"
         "${MINGW_PACKAGE_PREFIX}-python-cffi"
         "${MINGW_PACKAGE_PREFIX}-python-rendercanvas"
         "${MINGW_PACKAGE_PREFIX}-wgpu-native")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-hatchling"
             "${MINGW_PACKAGE_PREFIX}-python-requests")
checkdepends=("${MINGW_PACKAGE_PREFIX}-python-pytest"
              "${MINGW_PACKAGE_PREFIX}-pyinstaller")
options=('!strip')
source=("https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz"
        '0001-wgpu-0.32.0-fix-coreutils.patch')
sha256sums=('cb23b2f225594258ccc8ba97458381e46c18e561c5d2d6fc25213e68a6d89985'
            '1a77c5eb779b9600baaba4c7be3234175903fbae47889b7ee6d4696abfda7270')

prepare() {
  cd "${_realname}-${pkgver}"

  patch -Np1 -i ../0001-wgpu-0.32.0-fix-coreutils.patch
}

build() {
  cp -r "${_realname}-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"

  WGPU_LIB_PATH="${MINGW_PREFIX}/bin/wgpu_native.dll" \
    python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"

  WGPU_LIB_PATH="${MINGW_PREFIX}/bin/wgpu_native.dll" \
    python -m pytest | true
}

package() {
  cd "python-build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
