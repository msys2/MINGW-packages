# Maintainer: tling0001

_realname=webkitgtk-6.0
pkgbase=mingw-w64-webkitgtk-6.0
pkgname=(${MINGW_PACKAGE_PREFIX}-webkitgtk-6.0)
pkgver=2.54.2
pkgrel=1
pkgdesc="Web content engine for GTK 4 (WebKitGTK API 6.0) (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://webkitgtk.org/"
msys2_repository_url="https://github.com/WebKit/WebKit"
license=('spdx:LGPL-2.1-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cairo"
  "${MINGW_PACKAGE_PREFIX}-enchant"
  "${MINGW_PACKAGE_PREFIX}-expat"
  "${MINGW_PACKAGE_PREFIX}-fontconfig"
  "${MINGW_PACKAGE_PREFIX}-freetype"
  "${MINGW_PACKAGE_PREFIX}-gdk-pixbuf2"
  "${MINGW_PACKAGE_PREFIX}-glib2"
  "${MINGW_PACKAGE_PREFIX}-gst-plugins-bad-libs"
  "${MINGW_PACKAGE_PREFIX}-gst-plugins-base-libs"
  "${MINGW_PACKAGE_PREFIX}-gstreamer"
  "${MINGW_PACKAGE_PREFIX}-gtk4"
  "${MINGW_PACKAGE_PREFIX}-harfbuzz"
  "${MINGW_PACKAGE_PREFIX}-hyphen"
  "${MINGW_PACKAGE_PREFIX}-icu"
  "${MINGW_PACKAGE_PREFIX}-lcms2"
  "${MINGW_PACKAGE_PREFIX}-libavif"
  "${MINGW_PACKAGE_PREFIX}-libepoxy"
  "${MINGW_PACKAGE_PREFIX}-libjpeg-turbo"
  "${MINGW_PACKAGE_PREFIX}-libpng"
  "${MINGW_PACKAGE_PREFIX}-libsoup3"
  "${MINGW_PACKAGE_PREFIX}-libwebp"
  "${MINGW_PACKAGE_PREFIX}-libxml2"
  "${MINGW_PACKAGE_PREFIX}-libxslt"
  "${MINGW_PACKAGE_PREFIX}-openjpeg2"
  "${MINGW_PACKAGE_PREFIX}-pango"
  "${MINGW_PACKAGE_PREFIX}-sqlite"
  "${MINGW_PACKAGE_PREFIX}-woff2"
  "${MINGW_PACKAGE_PREFIX}-zlib"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-gobject-introspection"
  "${MINGW_PACKAGE_PREFIX}-gperf"
  "${MINGW_PACKAGE_PREFIX}-gst-plugins-bad"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-perl"
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-ruby"
  "${MINGW_PACKAGE_PREFIX}-unifdef"
)
optdepends=(
  "${MINGW_PACKAGE_PREFIX}-gst-libav: additional multimedia codecs"
  "${MINGW_PACKAGE_PREFIX}-gst-plugins-good: additional multimedia codecs"
)
source=(
  "https://www.webkitgtk.org/releases/webkitgtk-${pkgver}.tar.xz"
  "0001-mingw-disable-unavailable-unix-features.patch"
)
sha256sums=('SKIP' 'SKIP')

prepare() {
  cd "${srcdir}/webkitgtk-${pkgver}"
  patch -Np1 -i "${srcdir}/0001-mingw-disable-unavailable-unix-features.patch"
}

build() {
  local -a cmake_args=(
    -GNinja
    -DPORT=GTK
    -DUSE_GTK4=ON
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}"
    -DCMAKE_INSTALL_LIBDIR=lib
    -DCMAKE_PREFIX_PATH="${MINGW_PREFIX}"
    -DENABLE_DOCUMENTATION=OFF
    -DENABLE_MINIBROWSER=OFF
    -DENABLE_INTROSPECTION=OFF
    -DENABLE_GAMEPAD=OFF
    -DENABLE_GEOLOCATION=OFF
    -DENABLE_SPELLCHECK=OFF
    -DENABLE_WEB_AUDIO=OFF
    -DENABLE_WEB_RTC=OFF
    -DENABLE_BUBBLEWRAP_SANDBOX=OFF
    -DENABLE_X11_TARGET=OFF
    -DENABLE_WAYLAND_TARGET=OFF
    -DENABLE_QUARTZ_TARGET=OFF
    -DENABLE_JOURNALD=OFF
    -DUSE_LIBBACKTRACE=OFF
    -DUSE_SYSTEM_MALLOC=ON
  )

  mkdir -p "${srcdir}/build-${MSYSTEM}"
  cd "${srcdir}/build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake "${cmake_args[@]}" "${srcdir}/webkitgtk-${pkgver}"

  cmake --build . --parallel "${NUMBER_OF_PROCESSORS:-2}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "${srcdir}/build-${MSYSTEM}"

  install -Dm644 "${srcdir}/webkitgtk-${pkgver}/Source/WebKit/LICENSE"
  install -Dm644 "${srcdir}/webkitgtk-${pkgver}/Source/JavaScriptCore/COPYING.LIB" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYING.LIB"
}
