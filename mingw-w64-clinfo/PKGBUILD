# Maintainer: Andrew Johnson <andrew.johnson@arjohnsonau.com>

_realname=clinfo
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=3.1.26.09.26
pkgrel=1
pkgdesc="Print all known information about all available OpenCL platforms and devices (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/Oblomov/clinfo'
msys2_repository_url='https://github.com/Oblomov/clinfo'
msys2_references=(
  'anitya: 10503'
  'archlinux: clinfo'
  'aur:' # ignore clinfo-git
  'gentoo: dev-util/clinfo'
)
license=('spdx:CC0-1.0')
depends=("${MINGW_PACKAGE_PREFIX}-opencl-icd")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-opencl-headers"
)
source=("https://github.com/Oblomov/clinfo/archive/${pkgver}/${_realname}-${pkgver}.tar.gz")
sha256sums=('e944132329c6613b686ba0fcd373b15ebb553c367a01a734af8519ddb095c01f')

build() {
  cp -r "${_realname}-${pkgver}" "build-${MSYSTEM}"

  make -C "build-${MSYSTEM}"
}

package() {
  install -Dm755 "build-${MSYSTEM}/clinfo.exe" "${pkgdir}${MINGW_PREFIX}/bin/clinfo.exe"
  install -Dm644 "build-${MSYSTEM}/man1/clinfo.1" "${pkgdir}${MINGW_PREFIX}/share/man/man1/clinfo.1"
  install -Dm644 "build-${MSYSTEM}/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
  install -Dm644 "build-${MSYSTEM}/legalcode.txt" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/legalcode.txt"
}
