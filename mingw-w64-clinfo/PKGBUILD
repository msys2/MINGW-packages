# Maintainer: Andrew Johnson <andrew.johnson@arjohnsonau.com>

_realname=clinfo
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=3.0.25.02.14
pkgrel=1
pkgdesc="Print all known information about all available OpenCL platforms and devices (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/Oblomov/clinfo'
msys2_repository_url='https://github.com/Oblomov/clinfo'
msys2_references=(
  'anitya: 10503'
  'archlinux: clinfo'
  'aur:' # ignore clinfo-git
  'gentoo: dev-util/clinfo'
)
license=('spdx:CC0-1.0')
depends=("${MINGW_PACKAGE_PREFIX}-opencl-icd")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-opencl-headers"
)
source=("https://github.com/Oblomov/clinfo/archive/${pkgver}/${_realname}-${pkgver}.tar.gz"
        "0001-Bug-Fix-changed-macro-to-allow-all-windows-compilers.patch"
        "0002-MinGW-compatibility-fixes.patch")
sha256sums=('48b77dc33315e6f760791a2984f98ea4bff28504ff37d460d8291585f49fcd3a'
            '440cfed7ca017576f0fa3fc77e05b2ab0c329daf96d07539a04e8613fb173e2b'
            'f0e75968f25092e4a88e3951b61661f2e54ff0b23ea6f4d04a444f16d7febd5c')

prepare() {
  cd "${_realname}-${pkgver}"

  # 3.0.25.02.14: Backports from upstream master, drop on next release:
  # https://github.com/Oblomov/clinfo/commit/04305aecf17a16b1253c7bf95751a10b80cc1c53
  patch -Np1 -i "${srcdir}/0001-Bug-Fix-changed-macro-to-allow-all-windows-compilers.patch"
  # https://github.com/Oblomov/clinfo/commit/a26972e2295849a3b04b919ab453a5dd7da96649
  patch -Np1 -i "${srcdir}/0002-MinGW-compatibility-fixes.patch"
}

build() {
  cp -r "${_realname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  make
}

package() {
  cd "build-${MSYSTEM}"

  install -Dm755 clinfo.exe "${pkgdir}${MINGW_PREFIX}/bin/clinfo.exe"
  install -Dm644 man1/clinfo.1 "${pkgdir}${MINGW_PREFIX}/share/man/man1/clinfo.1"
  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
  install -Dm644 legalcode.txt "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/legalcode.txt"
}
