From a26972e2295849a3b04b919ab453a5dd7da96649 Mon Sep 17 00:00:00 2001
From: Andrew Johnson <andrew.johnson@arjohnsonau.com>
Date: Tue, 22 Sep 2026 19:47:12 +0800
Subject: [PATCH 2/2] MinGW compatibility fixes

---
 Makefile        | 1 +
 src/fmtmacros.h | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index 719d2b4..a3654dd 100644
--- a/Makefile
+++ b/Makefile
@@ -67,6 +67,7 @@ LDLIBS__common = -lOpenCL -ldl
 # OS-specific library includes
 LDLIBS_Darwin = -framework OpenCL
 LDLIBS_Darwin_exclude = -lOpenCL
+LDLIBS_Windows_NT_exclude = -ldl
 
 LDLIBS += $(LDLIBS_${OS}) $(LDLIBS__common:$(LDLIBS_${OS}_exclude)=)
 
diff --git a/src/fmtmacros.h b/src/fmtmacros.h
index 8f541fb..92591a3 100644
--- a/src/fmtmacros.h
+++ b/src/fmtmacros.h
@@ -8,7 +8,7 @@
 #ifndef FMT_MACROS_H
 #define FMT_MACROS_H
 
-#ifdef _WIN32
+#if defined(_WIN32) && !defined(__MINGW32__)
 /* TODO FIXME WIN64 support */
 # include <stdint.h>
 # include <stddef.h> // size_t
