diff --git a/src/modules/desktop_capture/win/desktop_capture_utils.cc b/src/modules/desktop_capture/win/desktop_capture_utils.cc
index 476ddc4a..56854ebb 100644
--- a/src/modules/desktop_capture/win/desktop_capture_utils.cc
+++ b/src/modules/desktop_capture/win/desktop_capture_utils.cc
@@ -10,7 +10,11 @@
 
 #include "modules/desktop_capture/win/desktop_capture_utils.h"
 
+#if defined(__MINGW32__)
+#include <cstdio>
+#else
 #include "rtc_base/strings/string_builder.h"
+#endif
 
 namespace webrtc {
 namespace desktop_capture {
@@ -19,12 +23,32 @@ namespace utils {
 // Generates a human-readable string from a COM error.
 std::string ComErrorToString(const _com_error& error) {
   char buffer[1024];
+#if defined(__MINGW32__)
+  // Avoid _bstr_t's MSVC COM support library and always bound the output.
+#if defined(_UNICODE)
+  const int written = std::snprintf(
+      buffer, sizeof(buffer), "HRESULT: 0x%08lX, Message: %ls",
+      static_cast<unsigned long>(error.Error()), error.ErrorMessage());
+#else
+  const int written = std::snprintf(
+      buffer, sizeof(buffer), "HRESULT: 0x%08lX, Message: %s",
+      static_cast<unsigned long>(error.Error()), error.ErrorMessage());
+#endif
+  if (written < 0) {
+    // A message not representable in the C locale must not hide the HRESULT.
+    std::snprintf(buffer, sizeof(buffer), "HRESULT: 0x%08lX",
+                  static_cast<unsigned long>(error.Error()));
+  }
+  buffer[sizeof(buffer) - 1] = '\0';
+  return buffer;
+#else
   rtc::SimpleStringBuilder string_builder(buffer);
   // Use _bstr_t to simplify the wchar to char conversion for ErrorMessage().
   _bstr_t error_message(error.ErrorMessage());
   string_builder.AppendFormat("HRESULT: 0x%08X, Message: %s", error.Error(),
                               static_cast<const char*>(error_message));
   return string_builder.str();
+#endif
 }
 
 }  // namespace utils
