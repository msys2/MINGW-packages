_realname=tg_owt
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=r500.d1cf250
pkgrel=1
pkgdesc="WebRTC library for Telegram (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/desktop-app/tg_owt"
license=('spdx:BSD-3-Clause')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs"
         "${MINGW_PACKAGE_PREFIX}-abseil-cpp"
         "${MINGW_PACKAGE_PREFIX}-ffmpeg"
         "${MINGW_PACKAGE_PREFIX}-libjpeg-turbo"
         "${MINGW_PACKAGE_PREFIX}-libyuv"
         "${MINGW_PACKAGE_PREFIX}-libsrtp"
         "${MINGW_PACKAGE_PREFIX}-openssl"
         "${MINGW_PACKAGE_PREFIX}-opus"
         "${MINGW_PACKAGE_PREFIX}-openh264"
         "${MINGW_PACKAGE_PREFIX}-libvpx")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-pkgconf"
             "${MINGW_PACKAGE_PREFIX}-python"
             'git')
_commit='d1cf250ea73de26c4c1f0a3c8173eb2648efbb04'
_wrl_commit='b8e57919aaaec794be7193ebf7e0a1d6e4d8c90a'
source=("tg_owt::git+https://github.com/desktop-app/tg_owt.git#commit=${_commit}"
        "crc32c::git+https://github.com/google/crc32c"
        '001-mingw.patch'
        '002-relocatable-dependencies.patch'
        '003-debundle-libyuv.patch'
        "wrl-event.h::https://raw.githubusercontent.com/msys2/MINGW-packages/${_wrl_commit}/mingw-w64-qt6-webengine/event.h"
        "wrl-implements.h::https://raw.githubusercontent.com/msys2/MINGW-packages/${_wrl_commit}/mingw-w64-qt6-webengine/implements.h"
        "wrl-LICENSE::https://raw.githubusercontent.com/msys2/MINGW-packages/${_wrl_commit}/LICENSE")
sha256sums=('SKIP'
            'SKIP'
            '23b34466b69e710be405ddff791ed99854c4b1fbf1259f22fd8d54640c3e53f2'
            '34b0e21d75006de5c1866619a6d0661a4bc0fb47e9131fbaf97e5fd8a0c96b11'
            'c7b9bb7b35dd69cb0cf509b214d81158ad4801184981afd35c7d833b8f84ce5d'
            'SKIP'
            'SKIP'
            'SKIP')

pkgver() {
  cd tg_owt
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd tg_owt

  # Require system Abseil, SRTP, and libyuv providers
  rm -rf src/third_party/abseil-cpp src/third_party/libsrtp src/third_party/libyuv
  rm cmake/libyuv.cmake

  git submodule init src/third_party/crc32c/src
  git config submodule.src/third_party/crc32c/src.url "${srcdir}/crc32c"
  git -c protocol.file.allow=always submodule update src/third_party/crc32c/src

  # MSYS2 PR #32123 supplies the missing WRL headers for WGC
  mkdir -p src/third_party/wrl/include/wrl
  install -Dm644 "${srcdir}/wrl-event.h" src/third_party/wrl/include/wrl/event.h
  install -Dm644 "${srcdir}/wrl-implements.h" src/third_party/wrl/include/wrl/implements.h

  patch -Np1 -i "${srcdir}/001-mingw.patch"
  patch -Np1 -i "${srcdir}/002-relocatable-dependencies.patch"
  patch -Np1 -i "${srcdir}/003-debundle-libyuv.patch"
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${extra_config[@]}" \
      -DBUILD_SHARED_LIBS=OFF \
      -S tg_owt \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "${srcdir}/tg_owt/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
  install -Dm644 "${srcdir}/wrl-LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/WRL-LICENSE"
}
