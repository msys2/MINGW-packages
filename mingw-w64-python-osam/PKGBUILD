_realname=osam
pkgbase="mingw-w64-python-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-python-${_realname}"
pkgver=0.9.1
pkgrel=1
pkgdesc='Get up and running with SAM1,2,3, EfficientSAM, YOLO-World, and other promptable vision models locally. (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64')
url='https://github.com/wkentaro/osam'
msys2_repository_url='https://github.com/wkentaro/osam'
msys2_changelog_url='https://github.com/wkentaro/osam/blob/main/CHANGELOG.md'
msys2_references=(
  'aur: python-osam'
  'purl: pkg:pypi/osam'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-gdown"
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-click"
  "${MINGW_PACKAGE_PREFIX}-python-imgviz"
  "${MINGW_PACKAGE_PREFIX}-python-loguru"
  "${MINGW_PACKAGE_PREFIX}-python-onnxruntime"
  "${MINGW_PACKAGE_PREFIX}-python-pillow"
  "${MINGW_PACKAGE_PREFIX}-python-pydantic"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-hatch-fancy-pypi-readme"
  "${MINGW_PACKAGE_PREFIX}-python-hatch-vcs"
  "${MINGW_PACKAGE_PREFIX}-python-hatchling"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
)
options=('!strip')
source=("https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz")
sha256sums=('4b83c1f728a0885d0b459d3336af5b9840869748c037ded92a93461da4bab0d4')

build() {
  cp -r "${_realname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  export SETUPTOOLS_SCM_PRETEND_VERSION=${pkgver}
  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
