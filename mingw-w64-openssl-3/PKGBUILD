# Maintainer: Alexey Pavlov <Alexpux@gmail.com>

_realname=openssl
_pkgname=openssl-3
pkgbase=mingw-w64-${_pkgname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_pkgname}")
pkgver=3.6.5
pkgrel=1
pkgdesc="OpenSSL 3 compatibility libraries and development files (mingw-w64)"
arch=('any')
mingw_arch=('mingw32' 'mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://openssl-library.org'
msys2_repository_url="https://github.com/openssl/openssl"
msys2_pgp_keys_url="https://github.com/openssl/openssl/blob/master/doc/fingerprints.txt"
msys2_references=("cpe: cpe:/a:openssl:openssl")
license=("spdx:Apache-2.0")
optdepends=("${MINGW_PACKAGE_PREFIX}-ca-certificates")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-autotools")
options=('!buildflags')
source=("https://github.com/openssl/openssl/releases/download/openssl-${pkgver}/openssl-${pkgver}.tar.gz"{,.asc}
        # Relocate the default directories with the MSYS2 installation.
        '002-relocation.patch'
        # Preserve the DLL names used by existing MSYS2 OpenSSL 3 consumers.
        '004-arch-suffix.patch'
        # Keep development files separate from the default OpenSSL installation.
        '005-versioned-development-paths.patch'
        'pathtools.c'
        'pathtools.h')
sha256sums=('a2157c2830efdec3788939b00c9b0638306d3f0bbb76dc4832ee503bb397df98'
            'SKIP'
            '3e9a8abb6ff5fb7bdb450742fb7bd85513a4abbe85594228620379bcac7c02ef'
            '6a686ef69c2b196fb1420389ccd0db84582fd288942560d5eba963c11ce8595a'
            'f0c9b6634750bb731bb4fe7d38127fcde042442375b768021d5a5ec129061fbc'
            'ebf471173f5ee9c4416c10a78760cea8afaf1a4a6e653977321e8547ce7bf3c0'
            '1585ef1b61cf53a2ca27049c11d49e0834683dfda798f03547761375df482a90')
validpgpkeys=(
  'B146647E45A7B33947AB226B2A2C87D161692D40' # openssl@openssl.org
)

prepare() {
  cd "${srcdir}"/${_realname}-${pkgver}

  local _patch
  for _patch in 002-relocation.patch 004-arch-suffix.patch 005-versioned-development-paths.patch; do
    msg2 "Applying ${_patch}"
    patch -Nbp1 -i "${srcdir}/${_patch}"
  done

  test ! -d "${startdir}/../mingw-w64-pathtools" || {
    cmp "${startdir}/../mingw-w64-pathtools/pathtools.c" "${srcdir}/pathtools.c" &&
    cmp "${startdir}/../mingw-w64-pathtools/pathtools.h" "${srcdir}/pathtools.h"
  } || exit 1

  cp -fHv "${srcdir}"/pathtools.c crypto/
  cp -fHv "${srcdir}"/pathtools.h ./

  msg2 "Using sed to force makepkg-mingw CFLAGS instead of hardcoded ones"
  cd Configurations
  sed -i -e "/^[[:space:]]*\"mingw-common\"/,/release/ s/-O3/${CFLAGS}/" 10-main.conf
  grep -q --fixed-strings -- "${CFLAGS}" 10-main.conf || { echo "...sed failed"; return 1; }
}

build() {
  mkdir -p "${srcdir}/build-${MSYSTEM}" && cd "${srcdir}/build-${MSYSTEM}"

  local _mingw
  case "${CARCH}" in
    i?86) _mingw=mingw ;;
    x86_64) _mingw=mingw64 ;;
    aarch64) _mingw=mingwarm64 ;;
  esac

  MSYS2_ARG_CONV_EXCL="--prefix=" \
  /usr/bin/perl ../"${_realname}-${pkgver}"/Configure \
    --prefix="${MINGW_PREFIX}" \
    --libdir=lib/${_pkgname} \
    --openssldir=etc/ssl \
    ${_mingw} \
    shared \
    zlib-dynamic \
    enable-camellia \
    enable-capieng \
    enable-idea \
    enable-mdc2 \
    enable-rc5 \
    enable-rfc3779 \
    no-apps \
    no-docs \
    -DOPENSSLBIN=\"\\\"${MINGW_PREFIX}/bin\\\"\"

  MSYS2_ARG_CONV_EXCL="-DENGINESDIR=;-DMODULESDIR=;-DOPENSSLDIR=;-DINSTALLTOP=;-DOPENSSLBIN=" \
  make build_sw
}

package() {
  cd "${srcdir}/build-${MSYSTEM}"

  # install_dev also installs the versioned runtime DLLs into the normal bin.
  # Do not install programs, documentation, or the shared etc/ssl files.
  make -j1 install_dev install_engines install_modules DESTDIR="${pkgdir}"

  install -d "${pkgdir}${MINGW_PREFIX}/include/${_pkgname}"
  mv "${pkgdir}${MINGW_PREFIX}/include/openssl" \
     "${pkgdir}${MINGW_PREFIX}/include/${_pkgname}/"

  # https://github.com/pkgconf/pkgconf/issues/286
  # pkgconf derives the prefix as ${MINGW_PREFIX}/lib in this custom location.
  local pcfile
  for pcfile in "${pkgdir}${MINGW_PREFIX}"/lib/${_pkgname}/pkgconfig/*.pc; do
    sed -i \
      -e "s|^prefix=.*|prefix=${MINGW_PREFIX}/lib|" \
      -e 's|^exec_prefix=.*|exec_prefix=${prefix}/..|' \
      -e 's|^includedir=${prefix}/|includedir=${prefix}/../|' \
      "${pcfile}"
  done

  install -Dm644 "${srcdir}/${_realname}-${pkgver}/LICENSE.txt" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_pkgname}/LICENSE"
}
