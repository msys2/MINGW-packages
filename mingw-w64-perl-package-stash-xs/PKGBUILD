# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=Package-Stash-XS
_realname="${_perlname,,}"
pkgbase="mingw-w64-perl-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=0.32
pkgrel=1
pkgdesc="Faster and more correct implementation of the Package::Stash API. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/Package-Stash-XS"
msys2_repository_url="https://github.com/moose/Package-Stash-XS"
msys2_changelog_url='https://metacpan.org/dist/Package-Stash-XS/changes'
msys2_references=(
  'purl: pkg:cpan/ETHER/Package-Stash-XS'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-perl"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-make"
)
source=("https://cpan.metacpan.org/authors/id/E/ET/ETHER/${_perlname}-${pkgver}.tar.gz")
sha256sums=('9f961e798c01370f3834eda5f010c9d60c68a96d15c48598d8a5a25ca32f5f11')

build() {
  cp -r "${_perlname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="PREFIX=" \
    PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}

  mingw32-make CC=${CC} CXX=${CXX} LD=${CXX}
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="PREFIX=" \
    mingw32-make DESTDIR="${pkgdir}/" install

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/perl-${_realname}"
}
