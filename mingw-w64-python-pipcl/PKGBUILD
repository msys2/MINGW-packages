# Maintainer: Christoph Reiter <reiter.christoph@gmail.com>

_realname=pipcl
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=12
pkgrel=1
pkgdesc="Python packaging operations for use by a setup.py (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://github.com/ArtifexSoftware/pipcl'
msys2_repository_url='https://github.com/ArtifexSoftware/pipcl'
msys2_references=(
  'purl: pkg:pypi/pipcl'
)
license=('spdx:AGPL-3.0-only')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-packaging"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
)
options=('!strip')
source=("${url}/archive/refs/tags/v${pkgver}.tar.gz"
        "0001-fix-build-with-mingw.patch")
sha256sums=('b0f5b04b6992fbd10d1517dcde9b4e12b20bafd42b32e3f180c73a08df2ea021'
            '62365fd529b365e02ca5de11b6cf20a7353a224e59088da8107598dfbab4c3ca')

prepare() {
  cd "${_realname}-${pkgver}"
  patch -Np1 -i "${srcdir}/0001-fix-build-with-mingw.patch"
}

build() {
  cp -r "${_realname}-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"

  python -m build --wheel --no-isolation
}

package() {
  cd "python-build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 COPYING "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/COPYING"
}
