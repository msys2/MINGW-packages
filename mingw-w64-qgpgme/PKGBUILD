# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_realname=qgpgme
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2.2.0
pkgrel=1
pkgdesc="GnuPG Made Easy (Qt bindings). (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://gnupg.org/related_software/gpgme/"
msys2_repository_url="https://git.gnupg.org/cgi-bin/gitweb.cgi?p=qgpgme.git"
msys2_references=(
  'archlinux: qgpgme'
)
license=('spdx:LGPL-2.0-or-later')
replaces=("${MINGW_PACKAGE_PREFIX}-qgpgme-qt6")
provides=("${MINGW_PACKAGE_PREFIX}-qgpgme-qt6")
conflicts=("${MINGW_PACKAGE_PREFIX}-qgpgme-qt6")
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs"
         "${MINGW_PACKAGE_PREFIX}-gpgme"
         "${MINGW_PACKAGE_PREFIX}-gpgmepp"
         "${MINGW_PACKAGE_PREFIX}-qt6-base")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-doxygen")
source=("https://github.com/gpg/gpgmeqt/archive/gpgmeqt-${pkgver}.tar.gz")
sha256sums=('be0c0a82252e10fe7e9a065978b8748c93a568142f8090c1536830ec107e29b5')

_apply_patch_with_msg() {
  for _patch in "$@"
  do
    msg2 "Applying ${_patch}"
    patch -p1 -i "${srcdir}/${_patch}"
  done
}

prepare() {
  cd "${srcdir}"/gpgmeqt-gpgmeqt-${pkgver}
  echo ${pkgver} >VERSION
}

build() {
  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      -DBUILD_WITH_QT5=OFF \
      -DBUILD_WITH_QT6=ON \
      -DBUILD_TESTING=OFF \
      "${_extra_config[@]}" \
      -S gpgmeqt-gpgmeqt-${pkgver} \
      -B build-${MSYSTEM}
      
  cmake --build build-${MSYSTEM}
}

package() {
  DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM}

  install -Dm644 "${srcdir}/gpgmeqt-gpgmeqt-${pkgver}/COPYING" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYING"
}
