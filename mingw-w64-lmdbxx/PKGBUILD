# Maintainer: Diego Sogari <diego.sogari@gmail.com>

_realname='lmdbxx'
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=1.0.2
pkgrel=1
pkgdesc='C++17 wrapper for the LMDB embedded B+ tree database library (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/hoytech/lmdbxx'
msys2_repository_url='https://github.com/hoytech/lmdbxx'
msys2_references=(
  'anitya: 18300'
  'archlinux: lmdbxx'
)
license=('spdx:Unlicense')
depends=(
  "${MINGW_PACKAGE_PREFIX}-lmdb"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=(
  "https://github.com/hoytech/lmdbxx/archive/${pkgver}/${_realname}-${pkgver}.tar.gz"
)
sha256sums=('3ae81209dbcf274002309c538f0cace34f3cb51e75568b2f64aaa30f0d50ac28')

build() {
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    meson setup \
      --prefix="${MINGW_PREFIX}" \
      --buildtype=plain \
      "build-${MSYSTEM}" \
      "${_realname}-${pkgver}"

  meson compile -C "build-${MSYSTEM}"
}

check() {
  meson test -C "build-${MSYSTEM}" --print-errorlogs
}

package() {
  meson install -C "build-${MSYSTEM}" --destdir="${pkgdir}"

  install -Dm644 "${_realname}-${pkgver}/UNLICENSE" -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
