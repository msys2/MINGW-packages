# Maintainer: Diego Sogari <diego.sogari@gmail.com>

_realname='lmdbxx'
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=1.0.0
pkgrel=1
pkgdesc='C++17 wrapper for the LMDB embedded B+ tree database library (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/hoytech/lmdbxx'
msys2_repository_url='https://github.com/hoytech/lmdbxx'
msys2_references=(
  'anitya: 18300'
  'archlinux: lmdbxx'
)
license=('spdx:Unlicense')
depends=(
  "${MINGW_PACKAGE_PREFIX}-lmdb"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
)
source=(
  "https://github.com/hoytech/lmdbxx/archive/${pkgver}/${_realname}-${pkgver}.tar.gz"
)
# needed again if there will be a new release (lmdb++.h symlink)
# noextract=("${_realname}-${pkgver}.tar.gz")
sha256sums=('5e12eb3aefe9050068af7df2c663edabc977ef34c9e7ba7b9d2c43e0ad47d8df')

prepare() {
  cd "${_realname}-${pkgver}"

  sed -i "s|/usr/local|${MINGW_PREFIX}|g" Makefile
}

package() {
  cd "${_realname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
