# Maintainer: Diego Sogari <diego.sogari@gmail.com>

_realname=lmdbxx
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=1.0.0
pkgrel=1
pkgdesc="C++17 wrapper for the LMDB embedded B+ tree database library (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/hoytech/lmdbxx"
msys2_repository_url="https://github.com/hoytech/lmdbxx"
license=('spdx:Unlicense')
depends=("${MINGW_PACKAGE_PREFIX}-lmdb")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc")
source=("https://github.com/hoytech/lmdbxx/archive/${pkgver}/${_realname}-${pkgver}.tar.gz")
sha256sums=('5e12eb3aefe9050068af7df2c663edabc977ef34c9e7ba7b9d2c43e0ad47d8df')
noextract=("${_realname}-${pkgver}.tar.gz")

prepare() {
  tar xf "${_realname}-${pkgver}.tar.gz" --exclude=README
  cd "${srcdir}/${_realname}-${pkgver}"
  sed -e "s|/usr/local|${MINGW_PREFIX}|g" -i Makefile
}

package() {
  cd "${srcdir}/${_realname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
