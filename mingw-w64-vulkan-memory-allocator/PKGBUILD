# Maintainer: Felix Xing (Felixaszx) <felixaszx@outlook.com>

_realname=vulkan-memory-allocator
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=3.5.0
pkgrel=1
pkgdesc="Memory allocation library for Vulkan API (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://gpuopen.com/vulkan-memory-allocator/'
msys2_repository_url='https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator'
msys2_references=(
  'anitya: 369620'
  'aur: vulkan-memory-allocator'
)
license=('spdx:MIT')
_archive=VulkanMemoryAllocator
source=("https://github.com/GPUOpen-LibrariesAndSDKs/${_archive}/archive/v${pkgver}/${_archive}-${pkgver}.tar.gz")
sha256sums=('c5f3db848fca9cb9726b41f256cc3007773321fa92a86d1e0902e66474e8a9e3')

package() {
  cd "${srcdir}/${_archive}-${pkgver}"

  install -Dm644 include/*.h -t "${pkgdir}${MINGW_PREFIX}/include/vma/"
  install -Dm644 LICENSE.txt -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
