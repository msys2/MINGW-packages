# Maintainer: Rafał Brzegowy <rafal.brzegowy@yahoo.com>

_realname=x86-simd-sort
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=7.0
pkgrel=1
pkgdesc="C++ template library for high performance SIMD based sorting (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64')
url="https://github.com/numpy/x86-simd-sort"
msys2_repository_url='https://github.com/numpy/x86-simd-sort'
license=('spdx:BSD-3-Clause')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-meson"
)
source=("${msys2_repository_url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('f1658b0562a56255b157b7ffbb81e53e78e2571db1962262e55db6ca01733907')

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"
  sed -i 's/shared_library/library/g' meson.build
}

build() {
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    meson setup \
      --prefix="${MINGW_PREFIX}" \
      --wrap-mode=nodownload \
      --auto-features=enabled \
      --buildtype=plain \
      --default-library=both \
      "build-${MSYSTEM}" \
      "${_realname}-${pkgver}"

  meson compile -C "build-${MSYSTEM}"
}

package() {
  meson install -C "build-${MSYSTEM}" --destdir "${pkgdir}"

  install -Dm644 "${srcdir}/${_realname}-${pkgver}/LICENSE.md" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
