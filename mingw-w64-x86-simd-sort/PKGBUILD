# Maintainer: Rafał Brzegowy <rafal.brzegowy@yahoo.com>

_realname=x86-simd-sort
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=7.0
pkgrel=1
pkgdesc="C++ template library for high performance SIMD based sorting (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64')
url="https://github.com/numpy/x86-simd-sort"
license=('BSD')
depends=()
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-meson"
             "${MINGW_PACKAGE_PREFIX}-ninja")
source=("https://github.com/numpy/${_realname}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('f1658b0562a56255b157b7ffbb81e53e78e2571db1962262e55db6ca01733907')

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"
  sed -i 's/shared_library/library/g' meson.build
}

build() {
  mkdir -p build-${MSYSTEM}
  cd build-${MSYSTEM}

  MSYS2_ARG_CONV_EXCL="--prefix=" \
  meson setup "${srcdir}/${_realname}-${pkgver}" \
    --prefix="${MINGW_PREFIX}" \
    --buildtype=release \
    --default-library=both

  meson compile
}

package() {
  cd build-${MSYSTEM}
  DESTDIR="${pkgdir}" meson install

  install -Dm644 "${srcdir}/${_realname}-${pkgver}/LICENSE.md" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
