# Maintainer: luadebug <lin@sz.cn.eu.org>

_realname=toomanycooks
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.6.1
pkgrel=1
pkgdesc="Runtime and concurrency library for C++20 coroutines (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/tzcnt/TooManyCooks'
msys2_repository_url='https://github.com/tzcnt/TooManyCooks'
license=('spdx:BSL-1.0')
# Boost.Asio headers and CMake targets are provided by the boost package.
depends=("${MINGW_PACKAGE_PREFIX}-boost"
         "${MINGW_PACKAGE_PREFIX}-hwloc")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja")
source=("${_realname}-${pkgver}.tar.gz::https://github.com/tzcnt/TooManyCooks/archive/refs/tags/v${pkgver}.tar.gz"
        '0001-cmake-dependencies.patch')
sha256sums=('f6cfa33b48292ff1eb5637f090bc5a09a41c8ed3cc2c95bcef8a6b4f94d7d2e7'
            '6dc61befd473f0aee9d177af5dad72296425244afc18a5e5039f9542c28c0a18')

prepare() {
  cd "TooManyCooks-${pkgver}"
  patch -Np1 -i "${srcdir}/0001-cmake-dependencies.patch"
}

build() {
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      -DTMC_USE_HWLOC=ON \
      -DTMC_USE_BOOST_ASIO=ON \
      -S "TooManyCooks-${pkgver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"
}
