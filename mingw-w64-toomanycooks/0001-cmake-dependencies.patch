--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,5 +1,5 @@
 cmake_minimum_required(VERSION 3.16)
-project(TooManyCooks VERSION 1.5.0 LANGUAGES CXX)
+project(TooManyCooks VERSION 1.6.1 LANGUAGES CXX)
 
 # ---- Dependency Options ----
 # all options are documented in detail at https://www.fleetcode.com/oss/tmc/docs/dev/build_flags.html
@@ -47,6 +47,15 @@
 
 # ---- Dependencies ----
 
+# Export Asio's headers and Windows socket libraries to consumers.
+if(TMC_USE_BOOST_ASIO)
+    find_package(Boost CONFIG REQUIRED COMPONENTS asio)
+    target_link_libraries(TooManyCooks INTERFACE Boost::asio)
+    if(WIN32)
+        target_link_libraries(TooManyCooks INTERFACE ws2_32 mswsock)
+    endif()
+endif()
+
 # hwloc
 if(TMC_USE_HWLOC)
     include(${CMAKE_CURRENT_LIST_DIR}/cmake/tmc-find-hwloc.cmake)
