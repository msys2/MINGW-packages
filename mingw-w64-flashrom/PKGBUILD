# Maintainer: Jonathan Armstrong <jda2158@gmail.com>

_realname='flashrom'
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=1.8.0
pkgrel=1
pkgdesc='Utility for detecting, reading, writing, verifying and erasing flash chips (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://www.flashrom.org/Flashrom'
msys2_repository_url='https://github.com/flashrom/flashrom'
license=('spdx:GPL-2.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-libftdi"
  "${MINGW_PACKAGE_PREFIX}-libusb"
  "${MINGW_PACKAGE_PREFIX}-libwinpthread"
  "${MINGW_PACKAGE_PREFIX}-openssl"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-git"
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-python-sphinx"
)
source=(
  "https://download.flashrom.org/releases/${_realname}-v${pkgver}.tar.xz"{,.asc}
  '0001-meson-check-version-script.patch'
)
sha256sums=('654c9c61745c250cd3b5ccd0e56fc43ee76980f92a5e078420420639d66975a2'
            'SKIP'
            '1fd930d8e76a64f116d971959f26a0b91a96b12235d51ac0fd7f5a09c0a6fbac')
validpgpkeys=(
  '6E6EF9A0BA478006E2776E4CC037BB413134D111' # Stefan Reinauer <stefan.reinauer@coreboot.org>
)

prepare() {
  cd "${_realname}-v${pkgver}"

  # Workaround: DEF file should be used instead of MAP file
  patch -Np1 -i "${srcdir}/0001-meson-check-version-script.patch"
}

build() {
  if [[ ${MINGW_PACKAGE_PREFIX} != *-clang-* ]]; then
    export CFLAGS+=" -Wno-error=format="
  else
    export CFLAGS+=" -Wno-format-security -Wno-sometimes-uninitialized"
  fi

  MSYS2_ARG_CONV_EXCL="--prefix=" \
  meson setup \
    --prefix="${MINGW_PREFIX}" \
    --buildtype=plain \
    --wrap-mode=nodownload \
    --auto-features=enabled \
    -Ddocumentation=disabled \
    -Dman-pages=enabled \
    -Dtests=disabled \
    "${_realname}-v${pkgver}" \
    "build-${MSYSTEM}"

  meson compile -C "build-${MSYSTEM}"
}

check() {
  # TODO: check once master branch gets numbered release (i.e., tests/)
  meson test -C "build-${MSYSTEM}"
}

package() {
  meson install -C "build-${MSYSTEM}" --destdir "${pkgdir}"

  mv "${pkgdir}${MINGW_PREFIX}/sbin/flashrom.exe" "${pkgdir}${MINGW_PREFIX}/bin/flashrom.exe"
  rmdir "${pkgdir}${MINGW_PREFIX}/sbin"

  install -Dm644 "${_realname}-v${pkgver}/COPYING.rst" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYING.rst"

  # echo replace USB-UART drivers (if needed) with WinUSB (libusb) using zadig [https://zadig.akeo.ie/]
}
