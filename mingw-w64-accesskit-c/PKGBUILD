# Maintainer: Christoph Reiter <reiter.christoph@gmail.com>

_realname=accesskit-c
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.18.0
pkgrel=1
pkgdesc="Accessibility infrastructure for UI toolkits - C bindings (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://accesskit.dev'
msys2_repository_url='https://github.com/AccessKit/accesskit-c'
license=('spdx:Apache-2.0 OR MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
)
makedepends=(
  'git'
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-rust"
)
source=("accesskit-c-${pkgver}::git+https://github.com/AccessKit/accesskit-c#tag=${pkgver}")
sha256sums=('4bc2f22625387184fa24566268d463f9920676d355f7166a61703cf8f0ceb3fa')

build() {
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    meson setup \
      --prefix="${MINGW_PREFIX}" \
      --wrap-mode=nodownload \
      --auto-features=enabled \
      --buildtype=plain \
      "build-${MSYSTEM}" \
      "${_realname}-${pkgver}"

  meson compile -C "build-${MSYSTEM}"
}

package() {
  meson install -C "build-${MSYSTEM}" --destdir "${pkgdir}"

  cd "${srcdir}/${_realname}-${pkgver}"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
