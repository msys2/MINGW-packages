_realname='prek'
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.5.2
pkgrel=1
pkgdesc='Better pre-commit, re-engineered in Rust (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://prek.j178.dev/'
msys2_repository_url='https://github.com/j178/prek'
msys2_references=(
  'aur: prek'
  'gentoo: dev-util/prek'
  'purl: pkg:cargo/prek'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-gcc-libs"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-git"
  "${MINGW_PACKAGE_PREFIX}-rust"
)
options=('!lto')
source=("${_realname}::git+https://github.com/j178/prek.git#tag=v${pkgver}")
sha256sums=('16ac286c46a5a2af2ff61d4a0492a4f6881d1355abf295d00ead2e96d10ce1e6')

prepare() {
  cd "${_realname}"

  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${_realname}"

  cargo build --locked --release --target-dir target
}

package() {
  cd "${_realname}"

  install -Dm755 "target/release/${_realname}.exe" "${pkgdir}${MINGW_PREFIX}/bin/${_realname}.exe"

  # rust adds absolute path gibberish that we need to remove
  install -Dm644 <(COMPLETE=bash "target/release/${_realname}.exe" | sed "s|[^'\"]*${_realname}\.exe|${_realname}|g") \
    "${pkgdir}${MINGW_PREFIX}/share/bash-completion/completions/${_realname}"

  install -Dm644 <(COMPLETE=zsh "target/release/${_realname}.exe" | sed "s|[^'\"]*${_realname}\.exe|${_realname}|g") \
    "${pkgdir}${MINGW_PREFIX}/share/zsh/site-functions/_${_realname}"

  install -Dm644 <(COMPLETE=fish "target/release/${_realname}.exe" | sed "s|[^'\"]*${_realname}\.exe|${_realname}|g") \
    "${pkgdir}${MINGW_PREFIX}/share/fish/vendor_completions.d/${_realname}.fish"

  install -Dm644 README.md -t "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}"
  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
