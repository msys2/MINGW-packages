_realname='prek'
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.5.3
pkgrel=1
pkgdesc='Better pre-commit, re-engineered in Rust (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://prek.j178.dev/'
msys2_repository_url='https://github.com/j178/prek'
msys2_references=(
  'aur: prek'
  'gentoo: dev-util/prek'
  'purl: pkg:cargo/prek'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-gcc-libs"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-rust"
)
source=(
  "https://github.com/j178/prek/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
  "completion-binary-path.patch::https://github.com/j178/prek/commit/372f0cf4785360a3ed47548cc45e50f8e3cd5a72.patch"
)
sha256sums=('2de788f26f8f32691c848d6ce3345c7df632813b099a3c0f48f10f3b37866d7a'
            '5b44f2bd74a179e6b62890a52f240cac917493654c4c9c585795bc713d599046')

prepare() {
  cd "${_realname}-${pkgver}"

  patch -p1 -i "${srcdir}"/completion-binary-path.patch
  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${_realname}-${pkgver}"

  cargo build --locked --release
}

package() {
  cd "${_realname}-${pkgver}"

  install -Dm755 "target/release/${_realname}.exe" -t "${pkgdir}${MINGW_PREFIX}/bin"

  install -Dm644 <(COMPLETE=bash "${_realname}") \
    "${pkgdir}${MINGW_PREFIX}/share/bash-completion/completions/${_realname}"

  install -Dm644 <(COMPLETE=zsh "${_realname}") \
    "${pkgdir}${MINGW_PREFIX}/share/zsh/site-functions/_${_realname}"

  install -Dm644 <(COMPLETE=fish "${_realname}") \
    "${pkgdir}${MINGW_PREFIX}/share/fish/vendor_completions.d/${_realname}.fish"

  install -Dm644 README.md -t "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}"
  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
