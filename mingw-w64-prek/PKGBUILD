

_realname=prek
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.5.5
pkgrel=2
pkgdesc='Better pre-commit, re-engineered in Rust (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://prek.j178.dev/'
msys2_repository_url='https://github.com/j178/prek'
msys2_references=(
  'aur: prek'
  'gentoo: dev-util/prek'
  'purl: pkg:cargo/prek'
)
license=('spdx:MIT')
makedepends=("${MINGW_PACKAGE_PREFIX}-rust")
source=("https://github.com/j178/prek/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz")
sha256sums=('a6441e8100fb83f5dedf0fd5db04e403f39a4132decebf2bfda67cd4173d7881')

prepare() {
  cd "${_realname}-${pkgver}"

  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${_realname}-${pkgver}"

  cargo build --locked --release
}

package() {
  cd "${_realname}-${pkgver}"

  install -Dm755 "target/release/${_realname}.exe" -t "${pkgdir}${MINGW_PREFIX}/bin"

  install -Dm644 <(COMPLETE=bash "target/release/${_realname}") \
    "${pkgdir}${MINGW_PREFIX}/share/bash-completion/completions/${_realname}"

  install -Dm644 <(COMPLETE=zsh "target/release/${_realname}") \
    "${pkgdir}${MINGW_PREFIX}/share/zsh/site-functions/_${_realname}"

  install -Dm644 <(COMPLETE=fish "target/release/${_realname}") \
    "${pkgdir}${MINGW_PREFIX}/share/fish/vendor_completions.d/${_realname}.fish"

  install -Dm644 README.md -t "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}"
  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
