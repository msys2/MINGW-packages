# Contributor: Xin Sun <sun.simpson@gmail.com>

_realname=hdf5
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=2.2.0
pkgrel=1
pkgdesc="General purpose library and file format for storing scientific data (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://www.hdfgroup.org/HDF5/"
msys2_repository_url="https://github.com/HDFGroup/hdf5"
msys2_references=(
  "anitya: 1303"
  "cpe: cpe:/a:hdfgroup:hdf5"
)
license=('spdx:BSD-3-Clause')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-aws-c-auth"
  "${MINGW_PACKAGE_PREFIX}-aws-c-common"
  "${MINGW_PACKAGE_PREFIX}-aws-c-http"
  "${MINGW_PACKAGE_PREFIX}-aws-c-io"
  "${MINGW_PACKAGE_PREFIX}-aws-c-s3"
  "${MINGW_PACKAGE_PREFIX}-aws-c-sdkutils"
  "${MINGW_PACKAGE_PREFIX}-fc-libs"
  "${MINGW_PACKAGE_PREFIX}-libaec"
  "${MINGW_PACKAGE_PREFIX}-zlib-ng"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  $([[ ${MSYSTEM} == CLANG64 ]] || echo "${MINGW_PACKAGE_PREFIX}-fc")
)
source=("${msys2_repository_url}/releases/download/${pkgver}/${_realname}-${pkgver}.tar.gz"
        "hdf5-proper-library-names-mingw.patch"
        "0001-fix-zlib-ng-static.patch"
        "0007-aws-c-s3-static.patch"
        "0008-h5cc-wrapper-static.patch"
        "hdf5-config.cmake")
sha256sums=('1a1ab8209b35586fbc1aa279ba76d102130b95badcb20ca329587219112d8c16'
            'bd27243196dfa5ae90c710187ddfa58a7f7e0a75a804e86fc29f09bd514de2f2'
            '232c8e47fb829c24942a1c51acb9a0731fd9eacc6eb7fc8fcfb099c9b57b85e4'
            '50c924798d79e1f57e3658c6cc05461a95bac44523bdf3b78ce6df681356cb6b'
            '4a86fffbc942318df4f155ab2487baf425d096d46f5ba524b416a9ffce283909'
            '7ebe5fe2c07b569c79153ddd02109ba7b3961013ae91057dde4148935d7c8e73')

source "$(dirname ${BASH_SOURCE[0]})"/../mingw-w64-PKGBUILD-common/patch.sh

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"

  apply_patch_with_msg \
    hdf5-proper-library-names-mingw.patch \
    0001-fix-zlib-ng-static.patch \
    0007-aws-c-s3-static.patch \
    0008-h5cc-wrapper-static.patch
}

build() {
  declare -a _cmake_opts=(
    -GNinja
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}"
    -DHDF5_BUILD_EXAMPLES=OFF
    -DBUILD_TESTING=OFF
    -DCMAKE_SKIP_RPATH=ON
    -DHDF5_BUILD_CPP_LIB=ON
    -DHDF5_BUILD_HL_LIB=ON
    -DHDF5_ENABLE_DEPRECATED_SYMBOLS=ON
    -DHDF5_ENABLE_SZIP_SUPPORT=ON
    -DHDF5_ENABLE_ZLIB_SUPPORT=ON
    -DHDF5_USE_ZLIB_NG=ON
    -DHDF5_ENABLE_ROS3_VFD=ON
    -DHDF5_INSTALL_DATA_DIR="share/doc/hdf5"
    -DHDF5_INSTALL_MODULE_DIR="include"
    -DHDF5_MSVC_NAMING_CONVENTION=OFF
    -DHDF5_ENABLE_ALL_WARNINGS=OFF
    -S "${_realname}-${pkgver}"
  )
  if check_option "debug" "n"; then
    _cmake_opts+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _cmake_opts+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  if [[ ${MSYSTEM} == CLANG64 ]]; then
    _cmake_opts+=("-DHDF5_BUILD_FORTRAN=OFF")
  else
    _cmake_opts+=("-DHDF5_BUILD_FORTRAN=ON")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      "${_cmake_opts[@]}" \
      -DCMAKE_DLL_NAME_WITH_SOVERSION=ON \
      -DHDF5_BUILD_TOOLS=ON \
      -DBUILD_STATIC_LIBS=OFF \
      -DHDF5_INSTALL_CMAKE_DIR="lib/cmake/hdf5/shared" \
      -B "build-${MSYSTEM}-shared"

  cmake --build "build-${MSYSTEM}-shared"

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      "${_cmake_opts[@]}" \
      -DHDF5_BUILD_TOOLS=OFF \
      -DBUILD_SHARED_LIBS=OFF \
      -DHDF5_USE_LIBAEC_STATIC=ON \
      -DHDF5_USE_ZLIB_STATIC=ON \
      -DHDF5_INSTALL_CMAKE_DIR="lib/cmake/hdf5/static" \
      -B "build-${MSYSTEM}-static"

  cmake --build "build-${MSYSTEM}-static"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}-static"
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}-shared"

  install -Dm644 "${srcdir}/hdf5-config.cmake" "${pkgdir}${MINGW_PREFIX}/lib/cmake/hdf5/hdf5-config.cmake"

  local PREFIX_WIN=$(cygpath -wm ${MINGW_PREFIX})
  sed -s "s|${PREFIX_WIN}|${MINGW_PREFIX}|g" -i "${pkgdir}${MINGW_PREFIX}"/lib/libhdf5.settings

  install -Dm644 "${srcdir}"/${_realname}-${pkgver}/LICENSE \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE
}
