# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=Sub-Exporter
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=0.992
pkgrel=1
pkgdesc="A sophisticated exporter for custom-built routines. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/Sub-Exporter"
msys2_repository_url="https://github.com/rjbs/Sub-Exporter"
msys2_changelog_url='https://metacpan.org/dist/Sub-Exporter/changes'
msys2_references=(
  'anitya: 11900'
  'archlinux: perl-sub-exporter'
  'gentoo: dev-perl/Sub-Exporter'
  'purl: pkg:cpan/RJBS/Sub-Exporter'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-perl"
         "${MINGW_PACKAGE_PREFIX}-perl-data-optlist"
         "${MINGW_PACKAGE_PREFIX}-perl-params-someutil"
         "${MINGW_PACKAGE_PREFIX}-perl-sub-install")
makedepends=("${MINGW_PACKAGE_PREFIX}-make")
source=("https://cpan.metacpan.org/authors/id/R/RJ/RJBS/${_perlname}-${pkgver}.tar.gz")
sha256sums=('31d1b7016390528f3ed2cda379f4026a4e7fbad2aa40c8c9a1808961bf642c67')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
  install -Dm644 LICENSE "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE
}
