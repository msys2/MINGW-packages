# Contributor: dragon-archer <dragon-archer@outlook.com>

_realname=jsonpath-ng
_pyname="${_realname//-/_}"
pkgbase="mingw-w64-python-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=1.15.0
pkgrel=1
pkgdesc='A final implementation of JSONPath for Python that aims to be standard compliant. (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
msys2_references=(
  'anitya: 83065'
  'archlinux: python-jsonpath-ng'
  'gentoo: dev-python/jsonpath-ng'
  'purl: pkg:pypi/jsonpath-ng'
)
url='https://github.com/h2non/jsonpath-ng'
msys2_repository_url='https://github.com/h2non/jsonpath-ng'
msys2_changelog_url="${url}/blob/master/CHANGELOG.md"
license=('spdx:Apache-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-pytest"
)
options=('!strip')
source=("https://pypi.org/packages/source/${_pyname::1}/${_realname}/${_pyname}-${pkgver}.tar.gz")
sha256sums=('6857e3817a04555375d68eb5be17562eea6d3a3de2d10dad6f54f259282ee1c9')

build() {
  cp -r "${_pyname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "build-${MSYSTEM}"

  PYTHONPATH=. "${MINGW_PREFIX}"/bin/python -m pytest
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
