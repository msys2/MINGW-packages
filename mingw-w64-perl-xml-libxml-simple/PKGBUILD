_perlname=XML-LibXML-Simple
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=1.01
pkgrel=1
pkgdesc="XML::LibXML clone of XML::Simple::XMLin(). (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/XML-LibXML-Simple"
msys2_repository_url="https://github.com/markov2/perl5-XML-LibXML-Simple"
msys2_references=(
  'purl: pkg:cpan/MARKOV/XML-LibXML-Simple'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
groups=("${MINGW_PACKAGE_PREFIX}-perl-modules")
depends=("${MINGW_PACKAGE_PREFIX}-perl"
         "${MINGW_PACKAGE_PREFIX}-perl-file-slurp-tiny"
         "${MINGW_PACKAGE_PREFIX}-perl-xml-libxml")
makedepends=("${MINGW_PACKAGE_PREFIX}-make")
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/M/MA/MARKOV/${_perlname}-${pkgver}.tar.gz")
sha256sums=('cd98c8104b70d7672bfa26b4513b78adf2b4b9220e586aa8beb1a508500365a6')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
}
