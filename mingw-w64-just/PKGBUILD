# Maintainer: Maksim Bondarenkov <maksapple2306@gmail.com>

_realname=just
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=1.59.0
pkgrel=1
pkgdesc='Just a command runner (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://just.systems'
msys2_repository_url='https://github.com/casey/just'
msys2_documentation_url='https://just.systems/man/en'
msys2_changelog_url='https://github.com/casey/just/blob/master/CHANGELOG.md'
msys2_references=(
  'anitya: 141393'
  'archlinux: just'
  'gentoo: dev-build/just'
  'purl: pkg:cargo/just'
)
license=('spdx:CC0-1.0')
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-rust"
)
source=("${_realname}-${pkgver}.tar.gz::https://github.com/casey/${_realname}/archive/${pkgver}.tar.gz")
noextract=("${_realname}-${pkgver}.tar.gz")
sha256sums=('20f876880851f1cc67fc7eb7589c7f7ccaa7612d827feac75797cf4a6ed729aa')

prepare() {
  bsdtar -xf "${_realname}-${pkgver}.tar.gz" || true

  cd "${_realname}-${pkgver}"

  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${_realname}-${pkgver}"

  WINAPI_NO_BUNDLED_LIBRARIES=1 \
    cargo build --release --frozen

  target/release/just --man >"just.1"
}

check() {
  cd "${_realname}-${pkgver}"

  WINAPI_NO_BUNDLED_LIBRARIES=1 \
    cargo test --frozen --release
}

package() {
  cd "${_realname}-${pkgver}"

  install -Dm755 "target/release/${_realname}.exe" "${pkgdir}${MINGW_PREFIX}/bin/${_realname}.exe"
  install -Dm644 "just.1" "${pkgdir}${MINGW_PREFIX}/share/man/man1/just.1"
  install -Dm644 "completions/${_realname}.bash" "${pkgdir}${MINGW_PREFIX}/share/bash-completion/completions/just"
  install -Dm644 "completions/${_realname}.zsh" "${pkgdir}${MINGW_PREFIX}/share/zsh/site-functions/_just"
  install -Dm644 "completions/${_realname}.fish" "${pkgdir}${MINGW_PREFIX}/share/fish/vendor_completions.d/just.fish"
  install -Dm644 "completions/${_realname}.elvish" "${pkgdir}${MINGW_PREFIX}/share/elvish/lib/just.elv"

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
