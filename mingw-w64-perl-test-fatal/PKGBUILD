# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname='Test-Fatal'
_realname="${_perlname,,}"
pkgbase="mingw-w64-perl-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-perl-${_realname}"
pkgver=0.019
pkgrel=1
pkgdesc='Incredibly simple helpers for testing code with exceptions (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://metacpan.org/dist/Test-Fatal'
msys2_repository_url='https://github.com/rjbs/Test-Fatal'
msys2_references=(
  'anitya: 11908'
  'archlinux: perl-test-fatal'
  'gentoo: dev-perl/Test-Fatal'
  'purl: pkg:cpan/RJBS/Test-Fatal'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-perl"
  "${MINGW_PACKAGE_PREFIX}-perl-try-tiny"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-make"
)
source=("https://cpan.metacpan.org/authors/id/R/RJ/RJBS/${_perlname}-${pkgver}.tar.gz")
sha256sums=('d8f6b6c87bb399a7d60c295a94a4b741a85b23889cfd6b72f1ff62f0c55cf70b')

build() {
  cp -r "${_perlname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX="${MINGW_PREFIX}"

  mingw32-make
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="PREFIX=" \
    mingw32-make DESTDIR="${pkgdir}" install

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE"
}
