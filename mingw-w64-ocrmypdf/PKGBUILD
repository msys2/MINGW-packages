# Maintainer: wszqkzqk <wszqkzqk@qq.com>

_realname=ocrmypdf
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=17.13.0
pkgrel=1
pkgdesc="A tool to add an OCR text layer to scanned PDF files, allowing them to be searched (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/ocrmypdf/OCRmyPDF"
msys2_repository_url='https://github.com/ocrmypdf/OCRmyPDF'
msys2_documentation_url='https://ocrmypdf.readthedocs.io/'
msys2_changelog_url='https://ocrmypdf.readthedocs.io/en/latest/release_notes.html'
msys2_references=(
  'anitya: 15744'
  'aur: ocrmypdf'
  'purl: pkg:pypi/ocrmypdf'
)
license=('spdx:MPL-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-ghostscript"
  "${MINGW_PACKAGE_PREFIX}-img2pdf"
  "${MINGW_PACKAGE_PREFIX}-pngquant"
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-deprecation"
  "${MINGW_PACKAGE_PREFIX}-python-fpdf2"
  "${MINGW_PACKAGE_PREFIX}-python-importlib_resources"
  "${MINGW_PACKAGE_PREFIX}-python-packaging"
  "${MINGW_PACKAGE_PREFIX}-python-pdfminer"
  "${MINGW_PACKAGE_PREFIX}-python-pikepdf"
  "${MINGW_PACKAGE_PREFIX}-python-pillow"
  "${MINGW_PACKAGE_PREFIX}-python-pluggy"
  "${MINGW_PACKAGE_PREFIX}-python-pydantic"
  "${MINGW_PACKAGE_PREFIX}-python-reportlab"
  "${MINGW_PACKAGE_PREFIX}-python-rich"
  "${MINGW_PACKAGE_PREFIX}-python-tqdm"
  "${MINGW_PACKAGE_PREFIX}-python-uharfbuzz"
  "${MINGW_PACKAGE_PREFIX}-tesseract-ocr"
  "${MINGW_PACKAGE_PREFIX}-unpaper"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-hatchling"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
)
options=('!strip')
source=(
  "https://files.pythonhosted.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz"
  "0001-pypdfium2-optional.patch"
)
sha256sums=('151c35d810eb628fbc5cb9bbe80b834ecf094737efa0e7a2e9e1fac3c730ed49'
            'e1ed264f21c904e047e3ab5546e5d37bf9986b02e983fca242fd3467ac8b68e2')

prepare() {
  cd "${_realname}-${pkgver}"

  patch -Np1 -i "${srcdir}/0001-pypdfium2-optional.patch"
}

build() {
  cp -r "${_realname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  sed -i '/^[[:space:]]*"pi-heif",/d' pyproject.toml

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  cd "${srcdir}/${_realname}-${pkgver}"
  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
