_rj_ver=1.1.0

_realname=supertux
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.7.0.1
pkgrel=1
pkgdesc="A classic 2D jump'n'run sidescroller game (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/supertux/supertux'
msys2_repository_url='https://github.com/supertux/supertux'
license=('spdx:GPL-3.0-or-later')
depends=(
  # "supertux-data=${pkgver}"
  "${MINGW_PACKAGE_PREFIX}-sdl2"
  "${MINGW_PACKAGE_PREFIX}-sdl2-image"
  "${MINGW_PACKAGE_PREFIX}-curl"
  "${MINGW_PACKAGE_PREFIX}-fmt"
  "${MINGW_PACKAGE_PREFIX}-freetype"
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-glew"
  "${MINGW_PACKAGE_PREFIX}-libiconv"
  "${MINGW_PACKAGE_PREFIX}-libpng"
  "${MINGW_PACKAGE_PREFIX}-libraqm"
  "${MINGW_PACKAGE_PREFIX}-libvorbis"
  "${MINGW_PACKAGE_PREFIX}-openal"
  "${MINGW_PACKAGE_PREFIX}-physfs"
  "${MINGW_PACKAGE_PREFIX}-zlib"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-glm"
)
source=(
  "https://github.com/SuperTux/supertux/releases/download/v${pkgver}/SuperTux-v${pkgver}-Source.tar.gz"
  "https://github.com/miloyip/rapidjson/archive/v${_rj_ver}/rapidjson-${_rj_ver}.tar.gz"
  0001-cmake-install-options.patch
  0002-src-fix-build.patch
  0004-cmake-fix-iconv-check.patch
  0101-rj-remove-non-compiling-assignment-operator.patch::https://patch-diff.githubusercontent.com/raw/Tencent/rapidjson/pull/719.patch
)
noextract=("SuperTux-v${pkgver}-Source.tar.gz")
sha256sums=('c3a3813bc57b8267960e4fcc33afe5f5cb468abe2a288fe58da4f288d0d7442c'
            'bf7ced29704a1e696fbccf2a2b4ea068e7774fa37f6d7dd4039d0787f8bed98e'
            '73430d5cb5b7059d3afb296cbc866eda056f2c6baac8d010781c4796d48c9c7e'
            '3516fdff2552bb119be1695c27a1a048c561e3de3e287cb6d77118ca020b6fd0'
            'b35fc35f585304acbed1b0b49e58774c74b14d6789ad1b4d16f2d01cadce2325'
            'ff2302f287b118d542177990e17ec967a3f97042b543b24e9f62a07db5f535a6')

apply_patch_with_msg() {
  for _patch in "$@"
  do
    msg2 "Applying $_patch"
    patch -Np1 -i "${srcdir}/$_patch"
  done
}

prepare() {
  msg "Extracting SuperTux-v${pkgver}-Source.tar.gz..."
  tar -xzf "SuperTux-v${pkgver}-Source.tar.gz" || true
  cd "${srcdir}"/SuperTux-v${pkgver}-Source

  apply_patch_with_msg \
    0001-cmake-install-options.patch \
    0002-src-fix-build.patch \
    0004-cmake-fix-iconv-check.patch

  rm -f mk/cmake/FindICONV.cmake

  cd "${srcdir}"/rapidjson-${_rj_ver}
  apply_patch_with_msg \
    0101-rj-remove-non-compiling-assignment-operator.patch

  cd ..
  cp -r "${srcdir}"/rapidjson-${_rj_ver} "${srcdir}"/SuperTux-v${pkgver}-Source/external/discord-sdk/thirdparty/
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  if [[ ${CARCH} == aarch64 ]]; then
    extra_config+=("-DENABLE_OPENGL=OFF")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=;-DINSTALL_SUBDIR_SHARE=;-DINSTALL_SUBDIR_DOC=" \
    cmake -Wno-author \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      -DINSTALL_SUBDIR_SHARE="../usr/share/supertux2" \
      -DINSTALL_SUBDIR_DOC="share/doc/supertux2" \
      -DINSTALL_DATA=OFF \
      -DUSE_STATIC_SIMPLESQUIRREL=ON \
      "${extra_config[@]}" \
      -DENABLE_DISCORD=ON \
      -DBUILD_TESTING=OFF \
      -DCURL_NO_CURL_CMAKE=ON \
      -S SuperTux-v${pkgver}-Source \
      -B build-${MSYSTEM}

  cmake --build build-${MSYSTEM}
}

package() {
  DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM}

  rm -rf "${pkgdir}${MINGW_PREFIX}"/include
  rm -vf "${pkgdir}${MINGW_PREFIX}"/*.bat
  rm -vf "${pkgdir}${MINGW_PREFIX}"/bin/*.a
  rm -vf "${pkgdir}${MINGW_PREFIX}"/lib/*.a

  install -Dm644 "SuperTux-v${pkgver}-Source/LICENSE.txt" -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/"
}
