# Maintainer: Konstantin Podsvirov <konstantin@podsvirov.su>

_realname=marshmallow
pkgbase="mingw-w64-python-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=4.3.1
pkgrel=1
pkgdesc='A lightweight library for converting complex objects to and from simple Python datatypes (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://marshmallow.readthedocs.io/'
msys2_repository_url='https://github.com/marshmallow-code/marshmallow'
msys2_references=(
  'anitya: 37959'
  'archlinux: python-marshmallow'
  'cpe: cpe:2.3:a:marshmallow_project:marshmallow'
  'gentoo: dev-python/marshmallow'
  'purl: pkg:pypi/marshmallow'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-flit-core"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
)
source=("https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz")
sha256sums=('fb6b8048af08d4ab061610d5b7d3696a7e4c95337dbda880edb9f95812cabc20')

build() {
  cp -r "${_realname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
