# Maintainer: Diego Sogari <diego.sogari@falker.com.br>

_realname=cpptest
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=2.0.1
pkgrel=1
pkgdesc="A C++ Unit Testing Framework (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://github.com/cpptest/cpptest'
msys2_repository_url='https://github.com/cpptest/cpptest'
license=('spdx:LGPL-2.1-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-cc"
)
source=(
  "${url}/releases/download/${pkgver}/${_realname}-${pkgver}.tar.bz2"
  "cpptest-2.0.0.patch"
)
sha256sums=('d2f13834dd9a5c4e56fa237e01d154474044687e7cc03f6c11017c5fe6ef0641'
            '364c89e288e181247ddf8a3c585f6b88dfc7f3199cf90c2a877055434175f36c')

prepare() {
  cd "${_realname}-${pkgver}"

  patch -Np1 -i "${srcdir}/cpptest-2.0.0.patch"

  autoreconf -fvi
}

build() {
  mkdir -p "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  "../${_realname}-${pkgver}/configure" \
    --build=${MINGW_CHOST} \
    --host=${MINGW_CHOST} \
    --target=${MINGW_CHOST} \
    --prefix=${MINGW_PREFIX} \
    --includedir=${MINGW_PREFIX}/include/cpptest

  make
}

package() {
  cd "build-${MSYSTEM}"

  make DESTDIR="${pkgdir}" install
}
