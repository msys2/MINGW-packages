# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=ntldd
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=r67.5d06c67
pkgrel=1
pkgdesc="Tracks dependencies in Windows PE binaries (mingw-w64)"
arch=('any')
# Note: Do NOT drop any arch from that list unless you also drop the whole
# environment at the same time. Package is required for CI runs.
mingw_arch=('mingw32' 'mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://github.com/roytam1/ntldd"
msys2_repository_url='https://github.com/roytam1/ntldd'
license=("spdx:GPL-3.0-or-later")
makedepends=(
  'git'
  "${MINGW_PACKAGE_PREFIX}-cc"
)
provides=("${MINGW_PACKAGE_PREFIX}-${_realname}-git")
conflicts=("${MINGW_PACKAGE_PREFIX}-${_realname}-git")
replaces=("${MINGW_PACKAGE_PREFIX}-${_realname}-git")
_commit="5d06c67a81cb20a67f35525e644d8c94266d3656"
source=("git+https://github.com/roytam1/ntldd.git#commit=${_commit}")
sha256sums=('7523e260de7705863fe18ef298295ad4e7f6c06ec01ea080a8820f84efd30d4b')

pkgver() {
  cd "${srcdir}/${_realname}"
  printf "r%s.%s" "$(git rev-list --count "${_commit}")" "$(git rev-parse --short "${_commit}")"
}

build() {
  cd "${srcdir}/${_realname}"
  sed -i -e 's/^gcc /$CC /' makeldd.sh
  ./makeldd.sh
}

package() {
  cd "${srcdir}/${_realname}"
  install -Dm755 ntldd.exe "${pkgdir}${MINGW_PREFIX}/bin/ntldd.exe"
  install -Dm644 libntldd.h "${pkgdir}${MINGW_PREFIX}/include/libntldd.h"
  install -Dm644 libntldd.a "${pkgdir}${MINGW_PREFIX}/lib/libntldd.a"
  install -Dm644 README "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}/README"
}
