# Maintainer: Biswapriyo Nath <nathbappai@gmail.com>

_realname=serd
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.32.10
pkgrel=1
pkgdesc='C library for RDF syntax supporting reading/ writing Turtle and NTriples (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://drobilla.net/software/serd.html'
msys2_repository_url='https://gitlab.com/drobilla/serd/'
msys2_changelog_url='https://gitlab.com/drobilla/serd/-/blob/main/NEWS'
msys2_references=(
  'archlinux: serd'
  'gentoo: dev-libs/serd'
)
license=("spdx:0BSD OR ISC")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
)
source=("https://download.drobilla.net/${_realname}-${pkgver}.tar.xz"{,.sig})
sha256sums=('b0e93b49e52f01a049475b7886ef140407115a32d3b1e5dc5f95141c88275d1c'
            'SKIP')
validpgpkeys=(
  '907D226E7E13FA337F014A083672782A9BF368F3' # David Robillard <d@drobilla.net>
)

build() {
  mkdir -p "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/meson setup \
    --prefix="${MINGW_PREFIX}" \
    --wrap-mode=nodownload \
    --auto-features=enabled \
    --buildtype=plain \
    -Ddocs=disabled \
    -Dman_html=disabled \
    ../${_realname}-${pkgver}

  meson compile
}

check() {
  cd "build-${MSYSTEM}"
  meson test
}

package() {
  cd "build-${MSYSTEM}"
  DESTDIR="${pkgdir}" ${MINGW_PREFIX}/bin/meson install
  install -Dm644 "${srcdir}/${_realname}-${pkgver}/COPYING" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYING"
}
