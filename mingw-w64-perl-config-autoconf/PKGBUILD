# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=Config-AutoConf
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=0.320
pkgrel=1
pkgdesc="A module to implement some of AutoConf macros in pure perl. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/Config-AutoConf"
msys2_repository_url="https://github.com/ambs/Config-AutoConf"
msys2_references=(
  'purl: pkg:cpan/AMBS/Config-AutoConf'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
groups=("${MINGW_PACKAGE_PREFIX}-perl-modules")
depends=("${MINGW_PACKAGE_PREFIX}-perl"
         "${MINGW_PACKAGE_PREFIX}-perl-capture-tiny"
         "${MINGW_PACKAGE_PREFIX}-perl-file-slurper")
makedepends=("${MINGW_PACKAGE_PREFIX}-make"
             "${MINGW_PACKAGE_PREFIX}-pkgconf")
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/A/AM/AMBS/${_perlname}-${pkgver}.tar.gz")
sha256sums=('bb57a958ef49d3f7162276dae14a7bd5af43fd1d8513231af35d665459454023')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
  install -Dm644 LICENSE "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE
}
