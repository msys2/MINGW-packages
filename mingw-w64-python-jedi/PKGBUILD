# Maintainer: J. Peter Mugaas <jpmugaas@suddenlink.net>

_realname=jedi
pkgbase="mingw-w64-python-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.20.1
pkgrel=1
pkgdesc="Awesome autocompletion for python (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='http://jedi.readthedocs.io/'
msys2_repository_url='https://github.com/davidhalter/jedi'
msys2_changelog_url='https://jedi.readthedocs.io/en/latest/docs/changelog.html'
msys2_references=(
  'anitya: 3893'
  'archlinux: python-jedi'
  'gentoo: dev-python/jedi'
  'purl: pkg:pypi/jedi'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-parso"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-pytest"
)
source=("https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz")
sha256sums=('2f71208c3f9c1bca057c0e90d3f272aba44ace88fc4067d7587e9e069331b7e5')

build() {
  cp -r "${_realname}-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "python-build-${MSYSTEM}"

  # 0.20.0: 10 failed, 3808 passed, 164 skipped, 5 xfailed, 5 errors
  python -m pytest || warning "Tests failed"
}

package() {
  cd "python-build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE.txt -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
