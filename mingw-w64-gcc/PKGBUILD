if [[ ${CARCH} != i686 ]]; then
  _enable_ada=yes
  _enable_fortran=yes
  _enable_jit=yes
  _enable_lto=yes
  _enable_objc=yes
  _enable_plugin=yes
  _enable_rust=no
else
  _enable_ada=no
  _enable_fortran=no
  _enable_jit=no
  _enable_lto=yes
  _enable_objc=no
  _enable_plugin=no
  _enable_rust=no
fi

_threads="posix"

