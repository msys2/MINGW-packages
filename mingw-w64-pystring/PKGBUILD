# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_realname=pystring
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=1.2.0
pkgrel=1
pkgdesc="A collection of C++ functions which match the interface and behavior of python's string class methods using std::string (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://github.com/imageworks/pystring"
msys2_repository_url='https://github.com/imageworks/pystring'
msys2_references=(
  'anitya: 374775'
  'archlinux: pystring'
  'gentoo: dev-cpp/pystring'
)
license=('spdx:BSD-3-Clause')
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-cc"
)
source=(
  "https://github.com/imageworks/pystring/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
)
sha256sums=('020a603a757ba1e429f4b1ea6feb3afbe0fb34bcafa355032e1f1b8a0019d198')

build() {
  cp -r "${_realname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  make
}

package() {
  cd "build-${MSYSTEM}"

  mkdir -p "${pkgdir}${MINGW_PREFIX}"/{include/pystring,lib}

  make DESTDIR="${pkgdir}" PREFIX=${MINGW_PREFIX} install

  cd "${srcdir}/${_realname}-${pkgver}"
  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
