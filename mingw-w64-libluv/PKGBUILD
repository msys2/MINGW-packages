# Maintainer: Konstantin Podsvirov <konstantin@podsvirov.su>

_realname=luv
_pkgname="lib${_realname}"
pkgbase="mingw-w64-${_pkgname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_pkgname}"
_pkgver=1.53.0-1
pkgver="${_pkgver/-/.}"
pkgrel=1
pkgdesc='Bare libuv bindings for lua (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/luvit/luv'
msys2_repository_url='https://github.com/luvit/luv'
msys2_references=(
  'anitya: 21510'
  'archlinux: libluv'
)
license=('spdx:Apache-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-libuv"
  "${MINGW_PACKAGE_PREFIX}-luajit"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=("https://github.com/luvit/luv/releases/download/${_pkgver}/luv-${_pkgver}.tar.gz")
sha256sums=('569b488d5d31609ea466a6c70e008a42661ec773ea1584d3d766d46280ab7cf4')

build() {
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
    -Wno-author \
    -GNinja \
    -DCMAKE_INSTALL_PREFIX=${MINGW_PREFIX} \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=ON \
    -DBUILD_MODULE=OFF \
    -DWITH_SHARED_LIBUV=ON \
    -DLUA_BUILD_TYPE=System \
    -S "${_realname}-${_pkgver}" \
    -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  cd "${srcdir}/${_realname}-${_pkgver}"
  install -Dm644 LICENSE.txt -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_pkgname}"
}
