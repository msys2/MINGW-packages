# Maintainer: Thibaut Melen <contact@qrcode-ai.com>

_realname=qrcode-barcode-scanner
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.11.0
pkgrel=1
pkgdesc="Offline QR code and barcode scanner for the command line, qrscan (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/qrcode-ai-com/qrcode-barcode-scanner-rust'
msys2_repository_url='https://github.com/qrcode-ai-com/qrcode-barcode-scanner-rust'
license=('spdx:AGPL-3.0-or-later')
makedepends=("${MINGW_PACKAGE_PREFIX}-rust")
_archive="qrcode-barcode-scanner-cli-${pkgver}-source"
source=("https://github.com/qrcode-ai-com/qrcode-barcode-scanner-rust/releases/download/v${pkgver}/${_archive}.tar.gz")
sha256sums=('8e5e09f0ec8d93ae49ca35615c05bb1d326448b6de9757cef86ef48d7bf3a96d')

# The archive holds the whole workspace and its Cargo.lock; only the qrscan crate is built. Keep
# the workspace release profile (overflow checks in the rxing reader) and never set
# CARGO_PROFILE_RELEASE_PANIC=abort: the engine catches reader panics.

prepare() {
  cd "${_archive}"

  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${_archive}"

  cargo build --release --frozen -p qrcode-barcode-scanner-cli
}

check() {
  cd "${_archive}"

  cargo test --release --frozen -p qrcode-barcode-scanner-cli

  # The mixed fixture holds a QR code and a Code 128: every profile must read both.
  local profile
  for profile in fast frame full; do
    ./target/release/qrscan.exe --profile "${profile}" --budget-ms 0 \
      fixtures/symbology/mixed-code128-qr.png > "scan-${profile}.json"
    grep -qF '"text": "https://qrc-ai.com/76xMa"' "scan-${profile}.json"
    grep -qF '"text": "STOCK-4827"' "scan-${profile}.json"
  done
}

package() {
  cd "${_archive}"

  install -Dm755 target/release/qrscan.exe "${pkgdir}${MINGW_PREFIX}/bin/qrscan.exe"
  install -Dm644 -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}" \
    LICENSE LICENSING.md \
    crates/qrcode-ai-scanner/LICENSE-APACHE-2.0 \
    crates/qrcode-ai-scanner/THIRD-PARTY.md
}
