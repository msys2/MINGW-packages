# Contributor: @ifurther <55025025+ifurther@users.noreply.github.com>

_realname='hugo'
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.170.0
pkgrel=1
pkgdesc='A Fast and Flexible Static Site Generator built with love by bep, spf13 and friends in Go (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://gohugo.io/'
msys2_repository_url='https://github.com/gohugoio/hugo/'
msys2_references=(
  'anitya: 12959'
  'archlinux: hugo'
  'aur: hugo-git'
  'cpe: cpe:/a:gohugo:hugo'
  'gentoo: www-apps/hugo'
  'purl: pkg:golang/github.com/gohugoio/hugo'
)
license=('spdx:Apache-2.0')
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-go"
)
optdepends=(
  "${MINGW_PACKAGE_PREFIX}-git: required to use the Hugo modules feature"
  "${MINGW_PACKAGE_PREFIX}-go: required to use the Hugo modules feature"
  "${MINGW_PACKAGE_PREFIX}-sass: required to transpile Sass to CSS"
)
options=('!strip')
source=("https://github.com/gohugoio/hugo/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz")
sha256sums=('dac429f01212d06979a1e939307f5bffdbfd3f75a63eba0fe3c817383d0525fe')

build() {
  cd "${_realname}-${pkgver}"

  export GOOS='windows'
  export GOROOT="${MINGW_PREFIX}/lib/go"
  export CGO_ENABLED=0
  export GOFLAGS='-trimpath -mod=readonly -modcacherw'

  go build -ldflags='-s -w'

  ./hugo.exe gen man
}

check() {
  cd "${_realname}-${pkgver}"

  export CGO_ENABLED=0
  go test
}

package() {
  cd "${_realname}-${pkgver}"

  install -Dm755 hugo.exe -t "${pkgdir}${MINGW_PREFIX}/bin"
  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
  install -Dm644 README.md -t "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}"

  install -Dm644 man/*.1 -t "${pkgdir}${MINGW_PREFIX}/share/man/man1/"

  install -Dm644 <(./hugo completion bash) "${pkgdir}${MINGW_PREFIX}/share/bash-completion/completions/hugo"
  install -Dm644 <(./hugo completion fish) "${pkgdir}${MINGW_PREFIX}/share/fish/vendor_completions.d/hugo.fish"
  install -Dm644 <(./hugo completion zsh) "${pkgdir}${MINGW_PREFIX}/share/zsh/site-functions/_hugo"
}
