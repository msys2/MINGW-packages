# Maintainer: Konstantin Podsvirov <konstantin@podsvirov.su>

_realname=click-repl
_pyname="${_realname//-/_}"
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.4.0
pkgrel=1
pkgdesc='Subcommand REPL for click apps (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/click-contrib/click-repl'
msys2_repository_url='https://github.com/click-contrib/click-repl'
msys2_references=(
  'purl: pkg:pypi/click-repl'
)
license=("spdx:MIT")
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-click"
  "${MINGW_PACKAGE_PREFIX}-python-prompt_toolkit"
  "${MINGW_PACKAGE_PREFIX}-python-typing_extensions"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
options=('!strip')
source=("https://pypi.python.org/packages/source/${_pyname::1}/${_realname}/${_pyname}-$pkgver.tar.gz")
sha256sums=('52f8962ff0fdae8105d568123b144951257b6bfcfb44ff6f043379c307d0a8ac')

build() {
  cp -r "${_pyname}-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"

  ${MINGW_PREFIX}/bin/python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "${srcdir}/python-build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
