--- a/src/gui/optionsdialog.cpp
+++ b/src/gui/optionsdialog.cpp
@@ -47,6 +47,9 @@
 
 #ifdef Q_OS_WIN
 #include <QProcess>
+#include <QCoreApplication>
+#include <QDir>
+#include <QSettings>
 #endif
 
 #include "base/bittorrent/session.h"
@@ -348,6 +351,45 @@
 #if defined(Q_OS_WIN)
     connect(m_ui->buttonOpenDefaultApps, &QPushButton::clicked, this, [](bool)
     {
+        {
+            const QString exePath = QDir::toNativeSeparators(QCoreApplication::applicationFilePath());
+            const QString openCmd = u"\""_s + exePath + u"\" \"%1\""_s;
+
+            // Write a plain magnet key only if no handler exists anywhere in HKCR
+            const QSettings existingMagnet(u"HKEY_CLASSES_ROOT\\magnet\\shell\\open\\command"_s, QSettings::NativeFormat);
+            if (existingMagnet.value(u"."_s).toString().isEmpty())
+            {
+                QSettings plainMagnet(u"HKEY_CURRENT_USER\\Software\\Classes\\magnet"_s, QSettings::NativeFormat);
+                plainMagnet.setValue(u"."_s, u"URL:magnet"_s);
+                plainMagnet.setValue(u"URL Protocol"_s, QString());
+                plainMagnet.setValue(u"DefaultIcon/."_s, u"\""_s + exePath + u"\",0"_s);
+                plainMagnet.setValue(u"shell/open/command/."_s, openCmd);
+            }
+
+            // Register .torrent in Applications\ (adds to "Open with" without changing defaults)
+            QSettings appTorrent(u"HKEY_CURRENT_USER\\Software\\Classes\\Applications\\qbittorrent.exe"_s, QSettings::NativeFormat);
+            appTorrent.setValue(u"FriendlyAppName"_s, u"qBittorrent (MSYS2)"_s);
+            appTorrent.setValue(u"SupportedTypes/.torrent"_s, QString());
+            appTorrent.setValue(u"DefaultIcon/."_s, u"\""_s + exePath + u"\",1"_s);
+            appTorrent.setValue(u"shell/open/command/."_s, openCmd);
+
+            // Register isolated Capabilities so Default Apps lists qBittorrent without clobbering official keys
+            QSettings msysMagnet(u"HKEY_CURRENT_USER\\Software\\Classes\\qBittorrent.msys2.magnet"_s, QSettings::NativeFormat);
+            msysMagnet.setValue(u"."_s, u"URL:magnet"_s);
+            msysMagnet.setValue(u"URL Protocol"_s, QString());
+            msysMagnet.setValue(u"DefaultIcon/."_s, u"\""_s + exePath + u"\",0"_s);
+            msysMagnet.setValue(u"shell/open/command/."_s, openCmd);
+
+            QSettings caps(u"HKEY_CURRENT_USER\\Software\\qBittorrent-MSYS2\\Capabilities"_s, QSettings::NativeFormat);
+            caps.setValue(u"ApplicationName"_s, u"qBittorrent (MSYS2)"_s);
+            caps.setValue(u"ApplicationDescription"_s, u"BitTorrent client"_s);
+            caps.setValue(u"ApplicationIcon"_s, u"\""_s + exePath + u"\",0"_s);
+            caps.setValue(u"URLAssociations/magnet"_s, u"qBittorrent.msys2.magnet"_s);
+
+            QSettings regApps(u"HKEY_CURRENT_USER\\Software\\RegisteredApplications"_s, QSettings::NativeFormat);
+            regApps.setValue(u"qBittorrent-MSYS2"_s, u"Software\\qBittorrent-MSYS2\\Capabilities"_s);
+        }
+
         const Path explorer = Utils::OS::windowsSystemPath().parentPath() / Path(u"explorer.exe"_s);
         QProcess::startDetached(explorer.data(), {u"ms-settings:defaultapps"_s});
     });
