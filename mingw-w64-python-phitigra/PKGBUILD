# Contributor: Dirk Stolle

_realname=phitigra
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.2.6
pkgrel=1
pkgdesc="Graph editor for SageMath/Jupyter (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/jfraymond/phitigra'
msys2_repository_url='https://github.com/jfraymond/phitigra'
msys2_references=(
  'archlinux: python-phitigra'
  'purl: pkg:pypi/phitigra'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-ipycanvas"
  # In Arch Linux, phitigra depends on sage, but MSYS2 has the more modular
  # passagemath fork of sage instead. So passagemath-modules is a good start
  # but may or may not be enough.
  "${MINGW_PACKAGE_PREFIX}-python-passagemath-modules"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
optdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-jupyter_notebook: for use in Jupyter notebooks"
  "${MINGW_PACKAGE_PREFIX}-python-passagemath-graphs: for graph algorithms from SageMath"
  "${MINGW_PACKAGE_PREFIX}-python-passagemath-repl"
)
options=('!strip')
source=("https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz")
sha256sums=('36cdc745316b876a4f675212b9a994439d2d9a1b3b12c4e8cce4a149304a9ba0')

build() {
  cp -r "${_realname}-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "python-build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
