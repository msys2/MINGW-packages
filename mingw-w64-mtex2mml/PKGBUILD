# Maintainer: Dominic Sisneros <dsisnero@gmail.com>

_archive=mtex2MML
_realname="${_archive,,}"
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=1.3.2
pkgrel=1
pkgdesc="A Bison grammar to convert TeX math into MathML (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/gjtorikian/mtex2MML/"
msys2_repository_url='https://github.com/gjtorikian/mtex2MML'
license=('spdx:MPL-2.0 OR LGPL-2.1-or-later OR GPL-2.0-or-later')
makedepends=(
  'flex'
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
)
conflicts=("${MINGW_PACKAGE_PREFIX}-mtex2MML")
provides=("${MINGW_PACKAGE_PREFIX}-mtex2MML=${pkgver}-${pkgrel}")
replaces=("${MINGW_PACKAGE_PREFIX}-mtex2MML")
source=(
  "https://github.com/gjtorikian/${_archive}/archive/v${pkgver}/${_archive}-${pkgver}.tar.gz"
  001-install-rules.patch
)
sha256sums=('b240096717aaabfdba7d05d60cbef18dde2f4a361e5d5ca5283dc38f0ec13a2d'
            '32a4fbcf633d165c4fd36b2f4af8b902d0509dcca0fd3585e244e9cad65e7eee')

prepare() {
  cd "${srcdir}/${_archive}-${pkgver}"
  patch -Np1 -i "${srcdir}/001-install-rules.patch"
}

build() {
  mkdir -p "${srcdir}/build-${MSYSTEM}" && cd "${srcdir}/build-${MSYSTEM}"

  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  CFLAGS+=" -Wno-strict-prototypes" \
    MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
    -Wno-author \
    -G"Ninja" \
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DBUILD_STATIC_LIBS=ON \
    -DBUILD_SHARED_LIBS=ON \
    -DBUILD_TESTING=OFF \
    "${_extra_config[@]}" \
    "../${_archive}-${pkgver}"

  cmake --build .
}

package() {
  cd "${srcdir}/build-${MSYSTEM}"
  DESTDIR="${pkgdir}" cmake --install .
}
