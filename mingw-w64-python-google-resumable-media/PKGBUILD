# Maintainer: Sarah Ottinger <schalaalexiazeal@gmail.com>

_realname='google-resumable-media'
_pyname="${_realname//-/_}"
pkgbase="mingw-w64-python-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-python-${_realname}"
pkgver=2.10.2
pkgrel=1
pkgdesc='Utilities for Google Media Downloads and Resumable Uploads (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/googleapis/google-cloud-python/tree/main/packages/google-resumable-media'
msys2_repository_url='https://github.com/googleapis/google-cloud-python/tree/main/packages/google-resumable-media'
msys2_changelog_url='https://github.com/googleapis/google-cloud-python/blob/main/packages/google-resumable-media/CHANGELOG.md'
msys2_references=(
  'anitya: 34797'
  'aur: python-google-resumable-media'
  'purl: pkg:pypi/google-resumable-media'
)
license=('spdx:Apache-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-google-crc32c"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
source=("https://pypi.org/packages/source/${_pyname::1}/${_realname}/${_pyname}-${pkgver}.tar.gz")
sha256sums=('1de441703cd298d75a419bfdc0066e9fc7b0a1de630df96eea8ce8f5c759358c')

build() {
  cp -r "${_pyname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
