#

_realname=httpcore2
pkgbase="mingw-w64-python-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=2.16.2
pkgrel=1
pkgdesc="A minimal low-level HTTP client (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/pydantic/httpx2'
msys2_repository_url='https://github.com/pydantic/httpx2'
msys2_references=(
  'purl: pkg:pypi/httpcore2'
)
license=('spdx:BSD-3-Clause')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-h11"
  "${MINGW_PACKAGE_PREFIX}-python-truststore"
)
optdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-anyio: for asyncio backend"
  "${MINGW_PACKAGE_PREFIX}-python-h2: for HTTP/2 support"
  # "${MINGW_PACKAGE_PREFIX}-python-socksio: for SOCKS support"
  "${MINGW_PACKAGE_PREFIX}-python-trio: for trio backend"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-hatchling"
  "${MINGW_PACKAGE_PREFIX}-python-hatch-fancy-pypi-readme"
  "${MINGW_PACKAGE_PREFIX}-python-uv-dynamic-versioning"
)
options=('!strip')
source=("https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz")
sha256sums=('6c519d0f7b44f7269fa9bbb4d2763db395a4a2370f046d8e8e0a4b38227815d2')

build() {
  cp -r "${_realname}-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"

  UV_DYNAMIC_VERSIONING_BYPASS="${pkgver}" \
    python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "${srcdir}/python-build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE.md -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
