# Maintainer: Christoph Reiter <reiter.christoph@gmail.com>

_realname=gjs
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.90.1
pkgrel=2
pkgdesc="Javascript Bindings for GNOME (mingw-w64)"
url="https://gitlab.gnome.org/GNOME/gjs"
msys2_repository_url="https://gitlab.gnome.org/GNOME/gjs"
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
arch=('any')
license=("spdx:LGPL-2.0-or-later")
depends=(
  "${MINGW_PACKAGE_PREFIX}-cairo"
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-gettext-runtime"
  "${MINGW_PACKAGE_PREFIX}-glib2"
  "${MINGW_PACKAGE_PREFIX}-gobject-introspection-runtime"
  "${MINGW_PACKAGE_PREFIX}-js140"
  "${MINGW_PACKAGE_PREFIX}-libffi"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-gobject-introspection"
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-python"
)
source=(
  "https://download.gnome.org/sources/${_realname}/${pkgver%.*}/${_realname}-${pkgver}.tar.xz"
  # Upstream Windows locale support (on the master-msvc branch).
  # https://gitlab.gnome.org/GNOME/gjs/-/commit/13c6b3715ad9a94adae3d9476a61d44fbc4ed3a1
  "https://github.com/GNOME/gjs/commit/13c6b3715ad9a94adae3d9476a61d44fbc4ed3a1.patch"
  # Backport only the libintl.h include needed to define LC_MESSAGES on Windows.
  # https://gitlab.gnome.org/GNOME/gjs/-/commit/c49690ed1d349d106c1e0d51087d3258302c742f
  "0001-win32-locale-header.patch"
  # Avoid a collision between InfoTag::CALLBACK and the Windows API macro.
  # https://gitlab.gnome.org/GNOME/gjs/-/commit/b1399e4b77e6659d366f67bf1eeb1eaf55a31dae
  "https://github.com/GNOME/gjs/commit/b1399e4b77e6659d366f67bf1eeb1eaf55a31dae.patch"
  # Imported function addresses cannot initialize a constexpr array on Windows.
  # https://gitlab.gnome.org/GNOME/gjs/-/commit/581766e38bb35a5ac2ad9019bacdf9f5c15447b8
  "https://github.com/GNOME/gjs/commit/581766e38bb35a5ac2ad9019bacdf9f5c15447b8.patch"
  # Exclude MinGW Clang from Linux ABI-specific argument size assertions.
  "0002-win32-argument-size-check.patch"
  # Avoid thread-exit deadlocks by shutting down the engine outside DllMain.
  "0003-win32-engine-shutdown.patch"
)
noextract=("${_realname}-${pkgver}.tar.xz")
sha256sums=('05ceaa80f48e3782e5c44938572fad863e02b8c4a6c55657a99aa81db8ce9efa'
            '22c93b189f0cd73a80f3f28995d2d5504be5d930ae398b40e7b7fdc4ade30f19'
            '1bbe23561f855dd2644a0fd8e48a04819794aeb4beb2e2514e68f8cd3216c55b'
            'ba77deab170e80f01a9257a6ff8d43431d90162c19e049305586fd945683bbec'
            '5c8101eafc6a6a623daf9c7ee7c62079ba5356db3f57534dcaaf8b31d80d5886'
            '7faf1c9e3be80a584341ef0d26b4b88d7da8b8eacfd0fe236c9f9de682d4db3d'
            '4b8db6ec8df66c9ecdb367f8069b0aac86993d0930525b22abf2d20a7e52dfa0')

prepare() {
  bsdtar -xf "${srcdir}/${_realname}-${pkgver}.tar.xz" \
    --exclude="${_realname}-${pkgver}/eslint.config.js"
  cd "${_realname}-${pkgver}"

  patch -Np1 -i "${srcdir}/13c6b3715ad9a94adae3d9476a61d44fbc4ed3a1.patch"
  patch -Np1 -i "${srcdir}/0001-win32-locale-header.patch"
  patch -Np1 -i "${srcdir}/b1399e4b77e6659d366f67bf1eeb1eaf55a31dae.patch"
  patch -Np1 -i "${srcdir}/581766e38bb35a5ac2ad9019bacdf9f5c15447b8.patch"
  patch -Np1 -i "${srcdir}/0002-win32-argument-size-check.patch"
  patch -Np1 -i "${srcdir}/0003-win32-engine-shutdown.patch"
}

build() {
  local meson_options=(
    --prefix="${MINGW_PREFIX}"
    --libdir=lib
    --buildtype=plain
    --wrap-mode=nofallback
    --default-library=shared
    -Dinstalled_tests=false
    -Dbsymbolic_functions=false
    -Dprofiler=disabled
    -Dreadline=disabled
    -Dskip_dbus_tests=true
    -Dskip_gtk_tests=true
  )

  MSYS2_ARG_CONV_EXCL="--prefix=" meson setup \
    "${srcdir}/build-${MSYSTEM}" "${_realname}-${pkgver}" "${meson_options[@]}"
  meson compile -C "${srcdir}/build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" meson install -C "${srcdir}/build-${MSYSTEM}" --no-rebuild
}
