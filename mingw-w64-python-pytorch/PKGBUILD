apply_patch_with_msg() {
  for _patch in "$@"; do
    msg2 "Applying ${_patch}"
    patch -Nbp1 -i "${srcdir}/${_patch}"
  done
}

prepare() {
  echo "Extracting pytorch-v${pkgver}.tar.gz ..."
  bsdtar -xzf "pytorch-v${pkgver}.tar.gz" || true

  cd "${srcdir}/${_srcdir}"

  apply_patch_with_msg \
    '0001-pytorch-use-system-libraries.patch' \
    '0003-pytorch-mingw-port.patch' \
    '0005-fix-build-with-glog-0.7.patch' \
    '0006-define-uint-for-aarch64.patch' \
    '0007-add-missing-includes.patch' \
    '0008-mingw-fix-cpp-extensions.patch' \
    '0009-mingw-leak-pthreadpool-at-process-exit.patch' \
    '0010-mingw-export-aoti-stable-abi-shim.patch'

  patch -Nbp1 -d third_party/onnx -i "${srcdir}/0004-third_party-onnx-optional-macro.patch"
}

build() {
  cp -r "${_srcdir}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"

  export PYTORCH_BUILD_VERSION="${pkgver}"
  export PYTORCH_BUILD_NUMBER=1
  export BUILD_TEST=0
  export USE_CUDA=0
  export USE_ROCM=0
  export USE_DISTRIBUTED=0
  export USE_GFLAGS=OFF
  export USE_GLOG=ON
  export USE_GLOO=0
  export USE_TENSORPIPE=0
  export USE_MAGMA=OFF
  export USE_MKLDNN=0
  # USE_*NNPACK and USE_FBGEMM has no effect on clangarm64
  export USE_NNPACK=ON
  export USE_PYTORCH_QNNPACK=ON
  export USE_XNNPACK=ON
  export USE_FBGEMM=ON
  export USE_KINETO=ON
  export USE_OPENCL=OFF # It has no effect when ON
  export USE_OPENMP=ON
  export USE_NUMA=0
  export USE_MPS=0
  export USE_XPU=0
  export USE_ITT=0
  export USE_MIMALLOC=0
  export USE_VULKAN=ON
  export USE_SYSTEM_BENCHMARK=1
  export USE_SYSTEM_EIGEN_INSTALL=1
  export USE_SYSTEM_PYBIND11=1
  export USE_SYSTEM_SLEEF=ON
  export BUILD_CUSTOM_PROTOBUF=0
  export CAFFE2_LINK_LOCAL_PROTOBUF=0
  export BLAS='OpenBLAS'
  export OpenBLAS_HOME="${MINGW_PREFIX}"
  export OpenBLAS_LIB_NAME='openblas'

  CFLAGS+=" -w"
  CXXFLAGS+=" -w"

  # pyproject.toml defaults CC/CXX to cl on win32
  if [[ ${MINGW_PACKAGE_PREFIX} == *-clang-* ]]; then
    export CC='clang' CXX='clang++'
  else
    export CC='gcc' CXX='g++'
    # FindOpenMP would otherwise pick up llvm-openmp's libomp if installed
    export CMAKE_ARGS="-DOpenMP_libomp_LIBRARY=$(cygpath -m "${MINGW_PREFIX}")/lib/libgomp.dll.a"
  fi

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "python-build-${MSYSTEM}"

  local _install_dir=$(mktemp -d)
  local _install_dest=$(cygpath -m "${_install_dir}")

  MSYS2_ARG_CONV_EXCL="--prefix=;--destdir=" \
    python -m installer --prefix="${MINGW_PREFIX}" \
    --destdir="${_install_dest}" dist/*.whl

  mkdir -p "${pkgdir}"
  cp -a "${_install_dir}/." "${pkgdir}/"
  rm -rf "${_install_dir}"

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
