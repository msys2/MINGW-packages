# Maintainer: Konstantin Podsvirov <konstantin@podsvirov.su>

_realname=pgmodeler
pkgbase="mingw-w64-${_realname}"
pkgname=(
  "${MINGW_PACKAGE_PREFIX}-${_realname}"
  "${MINGW_PACKAGE_PREFIX}-${_realname}-plugins"
)
pkgver=2.0.0
_plugsha=8736534fefed6de9038781bf966720fc06efcbcd
pkgrel=1
pkgdesc="PostgreSQL Database Modeler: an open source CASE tool for modeling PostgreSQL databases (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://pgmodeler.io"
msys2_repository_url="https://github.com/pgmodeler/pgmodeler"
license=('GPL3')
depends=(
  "${MINGW_PACKAGE_PREFIX}-libxml2"
  "${MINGW_PACKAGE_PREFIX}-postgresql"
  "${MINGW_PACKAGE_PREFIX}-qt6-svg"
)
optdepends=(
  "${MINGW_PACKAGE_PREFIX}-${_realname}-plugins: official plugins"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-qt6-tools"
)
source=(
  "${msys2_repository_url}/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
  "https://github.com/pgmodeler/plugins/archive/${_plugsha}/plugins-${_plugsha}.tar.gz"
  '0002-pgmodeler-1.0.2-no-check-update.patch'
  '0003-pgmodeler-1.0.2-fix-global-attributes.patch'
  '0004-pgmodeler-2.0.0-no-fix-compiler-path.patch'
  '0005-pgmodeler-2.0.0-fix-lib-output-name.patch'
)
sha256sums=('074a9a508d5c8415464ab5c37bb8d1a9d511e23daa2ba15a4a05feb84463754a'
            'b53573b8f966fdccdc09764056ed93c2a553e26191d18e310d61f30d2e8ea6f0'
            '38747cc62c068e1597a10661ceb750e7545ffcd9125ba9b237f663374e4b8a2b'
            'd902b82a0a397380c7b61327dd67fd6d6f2c50351d2b1fa480bc80b1ab47546d'
            '55abc433ccb951e3925e7c518938e66a43818e98b1a2efd164779d8e800d56f4'
            '90b21753f572430718467ad9746f6439d1d5c9e0cd220a43369ffe901572bcde')

prepare() {
  cd "${srcdir}"/${_realname}-${pkgver}

  patch -Np1 -i "${srcdir}"/0002-pgmodeler-1.0.2-no-check-update.patch
  patch -Np1 -i "${srcdir}"/0003-pgmodeler-1.0.2-fix-global-attributes.patch
  patch -Np1 -i "${srcdir}"/0004-pgmodeler-2.0.0-no-fix-compiler-path.patch
  patch -Np1 -i "${srcdir}"/0005-pgmodeler-2.0.0-fix-lib-output-name.patch

  cp -r "${srcdir}"/plugins-${_plugsha} "${srcdir}"/${_realname}-${pkgver}/plugins
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=;-DPGM_PREFIX=;-DPGM_BINDIR=;-DPGM_PRIVATEBINDIR=;-DPGM_PRIVATELIBDIR=;-DPGM_CONFDIR=;-DPGM_SHAREDIR=;-DPGM_DOCDIR=;-DPGM_LANGDIR=;-DPGM_SAMPLESDIR=;-DPGM_SCHEMASDIR=;-DPGM_PLUGINSDIR=" \
    cmake -Wno-author \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${extra_config[@]}" \
      -DBUILD_{SHARED,STATIC}_LIBS=ON \
      -DPGM_PREFIX="${MINGW_PREFIX}" \
      -DPGM_BINDIR="${MINGW_PREFIX}/bin" \
      -DPGM_PRIVATEBINDIR="${MINGW_PREFIX}/bin" \
      -DPGM_PRIVATELIBDIR="${MINGW_PREFIX}/bin" \
      -DPGM_CONFDIR="${MINGW_PREFIX}/etc/${_realname}" \
      -DPGM_SHAREDIR="${MINGW_PREFIX}/share/${_realname}" \
      -DPGM_DOCDIR="${MINGW_PREFIX}/share/doc/${_realname}" \
      -DPGM_LANGDIR="${MINGW_PREFIX}/share/${_realname}/lang" \
      -DPGM_SAMPLESDIR="${MINGW_PREFIX}/share/${_realname}/samples" \
      -DPGM_SCHEMASDIR="${MINGW_PREFIX}/share/${_realname}/schemas" \
      -DPGM_PLUGINSDIR="${MINGW_PREFIX}/lib/${_realname}/plugins" \
      -DBUILD_PLUGINS=ON \
      -DPLUGINS_DIR=plugins \
      -DNO_UPDATE_CHECK=MSYS2doesthis \
      -S "${_realname}-${pkgver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package_pgmodeler() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "${_realname}-${pkgver}/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"

  # split plugins
  rm -rf "dest${MINGW_PREFIX}" && mkdir -p "dest${MINGW_PREFIX}"
  mv "${pkgdir}${MINGW_PREFIX}/lib" "dest${MINGW_PREFIX}/lib"
}

package_pgmodeler-plugins() {
  cd "${srcdir}"/${_realname}-${pkgver}

  pkgdesc+=" (plugins)"
  depends=("${MINGW_PACKAGE_PREFIX}-${_realname}=${pkgver}")
  optdepends=()

  mv "${srcdir}"/dest/* "${pkgdir}"
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
