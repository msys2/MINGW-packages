From a256fca61fe83713c922a6f27b954a8ade10171c Mon Sep 17 00:00:00 2001
From: Christoph Reiter <reiter.christoph@gmail.com>
Date: Fri, 23 Jun 2023 21:47:32 +0200
Subject: [PATCH 063/N] configure: set BUILDEXEEXT and EXEEXT

---
 configure.ac | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/configure.ac b/configure.ac
index 9d5d6da..2c72a71 100644
--- a/configure.ac
+++ b/configure.ac
@@ -1454,6 +1454,7 @@ AC_ARG_WITH([suffix],
   AS_CASE([$ac_sys_system],
     [Emscripten], [EXEEXT=.mjs],
     [WASI], [EXEEXT=.wasm],
+    [MINGW*], [EXEEXT=.exe],
     [EXEEXT=]
   )
 ])
@@ -1480,6 +1481,10 @@ else
 fi
 rmdir CaseSensitiveTestDir
 
+AS_CASE([$ac_sys_system],
+  [MINGW], [BUILDEXEEXT=".exe"]
+)
+
 case $ac_sys_system in
 hp*|HP*)
     case $ac_cv_cc_name in
