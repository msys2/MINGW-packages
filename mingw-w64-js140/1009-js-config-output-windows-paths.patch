--- a/js/src/build/js-config.in
+++ b/js/src/build/js-config.in
@@ -6,9 +6,8 @@
-prefix='@prefix@'
+prefix="$(cygpath -m '@prefix@')"
 mozilla_version='@MOZILLA_VERSION@'
 JS_LIBRARY_NAME='@JS_LIBRARY_NAME@'
-NSPR_CFLAGS='@NSPR_CFLAGS@'
+NSPR_CFLAGS=''
 JS_CONFIG_LIBS='@JS_CONFIG_LIBS@'
-MOZ_JS_LIBS='@JS_CONFIG_MOZ_JS_LIBS@'
 
 FILENAME=`basename "$0"`
 
@@ -35,7 +35,7 @@
 
 while test $# -gt 0; do
   case "$1" in
-  -*=*) optarg=`echo "$1" | sed 's/[-_a-zA-Z0-9]*=//'` ;;
+  -*=*) optarg="$(cygpath -m "${1#*=}")" ;;
   *) optarg= ;;
   esac
 
@@ -83,27 +82,28 @@
 # Set variables that may be dependent upon other variables
 if test -z "$exec_prefix"; then
-    exec_prefix=@exec_prefix@
+  exec_prefix="$prefix"
 fi
 if test -z "$includedir"; then
-    includedir=@includedir@
+  includedir="$prefix/include"
 fi
 if test -z "$libdir"; then
-    libdir=@libdir@
+  libdir="$exec_prefix/lib"
 fi
+MOZ_JS_LIBS="-L${libdir} -l${JS_LIBRARY_NAME}"
 
 if test "$echo_prefix" = "yes"; then
-    echo $prefix
+  echo "$prefix"
 fi
 
 if test "$echo_exec_prefix" = "yes"; then
-    echo $exec_prefix
+  echo "$exec_prefix"
 fi
 
 if test "$echo_includedir" = "yes"; then
-    echo $includedir
+  echo "$includedir"
 fi
 
 if test "$echo_libdir" = "yes"; then
-    echo $libdir
+  echo "$libdir"
 fi
 
@@ -110,7 +110,7 @@
 if test "$echo_cflags" = "yes"; then
-    echo "-std=gnu++11 -isystem $includedir/$JS_LIBRARY_NAME $NSPR_CFLAGS"
+    echo "-std=gnu++17 -isystem $includedir/$JS_LIBRARY_NAME $NSPR_CFLAGS"
 fi
 
 if test "$echo_libs" = "yes"; then
     echo "$MOZ_JS_LIBS $JS_CONFIG_LIBS"
 fi
