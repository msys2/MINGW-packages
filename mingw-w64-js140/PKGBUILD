prepare() {
  mkdir -p "${srcdir}/mozbuild-${MSYSTEM}"
  cd "firefox-${pkgver}"

  local src
  for src in "${source[@]}"; do
    src="${src%%::*}"
    src="${src##*/}"
    [[ "${src}" = *.patch ]] || continue
    patch -Np1 < "${srcdir}/${src}"
  done

  local objdir="$(cygpath -m "${srcdir}/build-${MSYSTEM}")"
  local moz_chost="${RUST_CHOST}"
  cat > "${srcdir}/mozconfig-${MSYSTEM}" <<END
ac_add_options --enable-application=js
ac_add_options --build-backends=RecursiveMake
mk_add_options MOZ_OBJDIR=${objdir@Q}
ac_add_options --host=${moz_chost@Q}
ac_add_options --target=${moz_chost@Q}
ac_add_options --prefix=${MINGW_PREFIX@Q}
ac_add_options --enable-release
ac_add_options --enable-hardening
ac_add_options --enable-optimize
ac_add_options --enable-rust-simd
ac_add_options --disable-bootstrap
ac_add_options --disable-debug
ac_add_options --disable-jemalloc
ac_add_options --disable-strip
ac_add_options --with-system-zlib
ac_add_options --with-system-icu
ac_add_options --enable-shared-js
ac_add_options --enable-tests
ac_add_options --with-intl-api
END
}

build() {
  cd "firefox-${pkgver}"
  export MOZCONFIG="${srcdir}/mozconfig-${MSYSTEM}"
  # Mach searches the runner's rustup directory before PATH.
  export RUSTC="$(cygpath -m "${MINGW_PREFIX}/bin/rustc.exe")"
  export CARGO="$(cygpath -m "${MINGW_PREFIX}/bin/cargo.exe")"
  export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE=none
  export MACH_NO_UV=1
  export MOZBUILD_STATE_PATH="${srcdir}/mozbuild-${MSYSTEM}"
  export MOZ_NOSPAM=1
  if [[ -n "${SOURCE_DATE_EPOCH:-}" ]]; then
    export MOZ_BUILD_DATE="$(date -u -d "@${SOURCE_DATE_EPOCH}" +%Y%m%d%H%M%S)"
  else
    export MOZ_BUILD_DATE="$(date -u +%Y%m%d%H%M%S)"
  fi
  python mach build
}

package() {
  cd "build-${MSYSTEM}"
  mingw32-make DESTDIR="${pkgdir}" install
  local prefix="${pkgdir}${MINGW_PREFIX}"
  install -d "${prefix}/bin"
  mv "${prefix}/lib/libmozjs-${pkgver%%.*}.a" \
    "${prefix}/lib/libmozjs-${pkgver%%.*}.dll.a"
  find "${prefix}/lib" -maxdepth 1 -type f -name '*.dll' \
    -exec mv -t "${prefix}/bin" -- {} +
  find "${prefix}/lib" -maxdepth 1 -type f -name '*.ajs' -delete
  find "${prefix}/lib/pkgconfig" "${prefix}/include" \
    -type f -exec chmod -c a-x {} +
}
