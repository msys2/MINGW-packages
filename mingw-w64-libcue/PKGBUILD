# Maintainer: Andrew Sun <adsun701@gmail.com>

_realname=libcue
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2.4.2
pkgrel=1
pkgdesc="Parses so-called cue sheets and handles the parsed data (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/lipnitsk/libcue/"
msys2_repository_url='https://github.com/lipnitsk/libcue'
msys2_references=(
  "cpe: cpe:/a:lipnitsk:libcue"
)
license=('spdx:GPL-2.0-or-later')
makedepends=(
  'bison'
  'flex'
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=("https://github.com/lipnitsk/libcue/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz")
sha256sums=('fd93d8d8ed95e91feeb77f41712cc4aef604cfd0da853879efa51c4c95df89c6')

build() {
  declare -a _cmake_opts=(
    -Wno-author
    -GNinja
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}"
    -S "${_realname}-${pkgver}"
  )

  if check_option "debug" "n"; then
    _cmake_opts+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _cmake_opts+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  echo "Building static library"
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
    "${_cmake_opts[@]}" \
    -DBUILD_SHARED_LIBS=OFF \
    -B "build-${MSYSTEM}-static"

  cmake --build "build-${MSYSTEM}-static"

  echo "Building shared library"
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
    "${_cmake_opts[@]}" \
    -DBUILD_SHARED_LIBS=ON \
    -B "build-${MSYSTEM}-shared"

  cmake --build "build-${MSYSTEM}-shared"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}-static"
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}-shared"

  install -Dm644 "${srcdir}/${_realname}-${pkgver}/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
