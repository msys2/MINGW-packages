_realname='soapyhackrf'
_pkgname='SoapyHackRF'
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.3.4
_gitver="soapy-hackrf-${pkgver}"
pkgrel=3
pkgdesc='SoapySDR HackRF module (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/pothosware/SoapyHackRF'
msys2_repository_url='https://github.com/pothosware/SoapyHackRF'
msys2_references=(
  'archlinux: soapyhackrf'
  'aur:' # ignore soapyhackrf-git
  'gentoo: net-wireless/soapyhackrf'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-hackrf"
  "${MINGW_PACKAGE_PREFIX}-soapysdr"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=("${url}/archive/${_gitver}/${_realname}-${pkgver}.tar.gz")
sha256sums=('c7a1b8aee7af9d9e11e42aa436eae8508f19775cdc8bc52e565a5d7f2e2e43ed')

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
      "${extra_config[@]}" \
      -S "${_pkgname}-${_gitver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "${_pkgname}-${_gitver}/LICENSE" -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
