# Maintainer: Konstantin Podsvirov <konstantin@podsvirov.su>

_realname=readme-renderer
_pyname="${_realname//-/_}"
pkgbase="mingw-w64-python-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=46.0
pkgrel=1
pkgdesc='Safely render long_description/README files in Warehouse (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/pypa/readme_renderer'
msys2_repository_url='https://github.com/pypa/readme_renderer'
msys2_references=(
  'anitya: 85494'
  'archlinux: python-readme-renderer'
  'gentoo: dev-python/readme-renderer'
  'purl: pkg:pypi/readme-renderer'
)
license=('Apache')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python-docutils"
  "${MINGW_PACKAGE_PREFIX}-python-nh3"
  "${MINGW_PACKAGE_PREFIX}-python-pygments"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
options=('!strip')
source=("https://pypi.org/packages/source/${_pyname::1}/${_realname}/${_pyname}-${pkgver}.tar.gz")
sha256sums=('af3e964914f6310a33ff67b72a4bdd940bed8d7c3bdecd2d14f40edf284bfe90')

build() {
  cp -r "${_pyname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
