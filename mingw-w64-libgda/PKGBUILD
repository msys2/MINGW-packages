noextract=("${_realname}-${pkgver}.tar.xz")

apply_patch_with_msg() {
  for _patch in "$@"
  do
    msg2 "Applying ${_patch}"
    patch -Nbp1 -i "${srcdir}/${_patch}"
  done
}

prepare() {
  echo "Extracting ${_realname}-${pkgver}.tar.xz ..."
  tar -xJf ${_realname}-${pkgver}.tar.xz || true

  cd ${_realname}-${pkgver}

  apply_patch_with_msg \
    001-lemon.patch \
    002-fix-setup-with-latest-meson.patch \
    003-fix-build-on-mingw.patch

  # https://github.com/archlinux/svntogit-community/tree/packages/libgda/trunk
  apply_patch_with_msg \
    006-Use-goocanvas-3.0.patch

  apply_patch_with_msg \
    008-lemon-fix-segfault.patch

  # fix some providers plugins compilation
  apply_patch_with_msg \
    009-fix-libgcrypt-dep.patch \
    010-providers-pc-generation.patch \
    011-add-missing-include.patch

  # fix race condition when building localizations
  apply_patch_with_msg \
    012-fix-race-conditions.patch

  # this single char polluted the build log
  sed -e "s|\/\*\*|\/\*|g" -i libgda/gda-connection-model.vala
}

build() {
  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("--buildtype=release")
  else
    _extra_config+=("--buildtype=debug")
  fi

  local _c_args="
    -Wno-cast-function-type-mismatch
    -Wno-deprecated-declarations
    -Wno-deprecated-non-prototype
    -Wno-implicit-function-declaration
    -Wno-incompatible-function-pointer-types
    -Wno-incompatible-pointer-types
    -Wno-int-conversion
    -Wno-missing-field-initializers
    -Wno-unused-function
    -Wno-unused-result"

  MSYS2_ARG_CONV_EXCL="--prefix=;-Dglade-catalog-dir=;-Dglade-pixmap-dir" \
  meson setup \
    --prefix="${MINGW_PREFIX}" \
    --libexecdir=${MINGW_PREFIX}/lib \
    "${_extra_config[@]}" \
    -Dglade-catalog-dir=${MINGW_PREFIX}/share/glade/catalogs \
    -Dglade-pixmap-dir=${MINGW_PREFIX}/share/glade/pixmaps \
    -Dc_args="${_c_args}" \
    -Ddoc=true \
    -Dexperimental=true \
    -Dgraphviz=true \
    -Djson=true \
    -Dldap=true \
    -Dlibsecret=true \
    -Dsqlcipher=true \
    -Dtools=true \
    build-${MSYSTEM} \
    ${_realname}-${pkgver}

  meson compile -C build-${MSYSTEM}
}

package() {
  DESTDIR="${pkgdir}" meson install -C build-${MSYSTEM}

  local PREFIX_WIN=$(cygpath -wm ${MINGW_PREFIX})
  for pcfile in "${pkgdir}${MINGW_PREFIX}"/lib/pkgconfig/*.pc; do
    sed -i -e "s|${PREFIX_WIN}|\$\{prefix\}|g" -e "3,5s|${MINGW_PREFIX}|\$\{prefix\}|g" "${pcfile}"
  done

  for _f in "${pkgdir}${MINGW_PREFIX}"/bin/*.py; do
    # Remove shebang line
    sed -e '1 { s/^#!.*$// }' -i "${_f}"
  done

  install -d "$pkgdir${MINGW_PREFIX}"/share/licenses/${_realname}
  install -Dm644 $srcdir/${_realname}-${pkgver}/COPYING* -t "$pkgdir${MINGW_PREFIX}"/share/licenses/${_realname}
}
