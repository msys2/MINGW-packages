  "${MINGW_PACKAGE_PREFIX}-postgresql: provider for PostgreSQL"
  "${MINGW_PACKAGE_PREFIX}-sqlcipher: provider for SQLCipher"
)
source=(https://download.gnome.org/sources/${_realname}/${pkgver:0:3}/${_realname}-${pkgver}.tar.xz
