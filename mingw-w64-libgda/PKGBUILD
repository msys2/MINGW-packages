_realname=libgda
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=6.0.0
pkgrel=7
pkgdesc='GDA (GNOME Data Access) library (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://www.gnome-db.org/'
msys2_repository_url='https://gitlab.gnome.org/GNOME/libgda'
msys2_documentation_url='https://wiki.gnome.org/ChooseLibgdaSQLite'
msys2_references=(
  'archlinux: libgda6'
  'cpe: cpe:/a:gnome:libgda'
)
license=('spdx:LGPL-2.0-or-later AND GPL-2.0-or-later')
