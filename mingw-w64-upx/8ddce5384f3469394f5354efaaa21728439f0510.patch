From 8ddce5384f3469394f5354efaaa21728439f0510 Mon Sep 17 00:00:00 2001
From: Johannes Schindelin <johasc@microsoft.com>
Date: Sun, 27 Sep 2026 22:12:09 +0200
Subject: [PATCH 2/3] win64/arm64: add DLL non-attach gate to the stub

Windows invokes a DLL entry point for thread notifications and process
detach. Repeating in-place decompression then reads an already consumed
compressed stream. This was observed when `rustc.exe` created a thread.

Let the ARM64 loader source handle only `DLL_PROCESS_ATTACH` by
decompressing the payload; all other calls are passed directly to the
restored entry point, as the AMD64 PE loader does.

Note: This commit changes the stub source only; The actual stub will be
generated in a subsequent commit.

Assisted-by: GPT-6 Sol
Signed-off-by: Johannes Schindelin <johasc@microsoft.com>
---
 src/p_w64pe_arm64.cpp         | 3 ++-
 src/stub/src/arm64-win64.pe.S | 6 ++++++
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/p_w64pe_arm64.cpp b/src/p_w64pe_arm64.cpp
index 680d89c597..066eea34eb 100644
--- a/src/p_w64pe_arm64.cpp
+++ b/src/p_w64pe_arm64.cpp
@@ -90,7 +90,8 @@ void PackW64PeArm64::buildLoader(const Filter *ft) {
 
     initLoader(EM_AARCH64, stub_arm64_win64_pe, sizeof(stub_arm64_win64_pe), 2);
 
-    addLoader("START", "PEMAIN01", tmp_tlsindex ? "PETLSHAK" : "", "PEMAIN02");
+    addLoader("START", isdll ? "PEISDLL1" : "", "PEMAIN01",
+              tmp_tlsindex ? "PETLSHAK" : "", "PEMAIN02");
     addLoader(M_IS_NRV2B(ph.method)   ? "PECALL2B"
               : M_IS_NRV2D(ph.method) ? "PECALL2D"
               : M_IS_NRV2E(ph.method) ? "PECALL2E"
diff --git a/src/stub/src/arm64-win64.pe.S b/src/stub/src/arm64-win64.pe.S
index 7c64aac7b6..9fda1be89c 100644
--- a/src/stub/src/arm64-win64.pe.S
+++ b/src/stub/src/arm64-win64.pe.S
@@ -74,6 +74,12 @@
 // =============
 
 section START
+section PEISDLL1
+        cmp     w1, #1                           // 1 == DLL_PROCESS_ATTACH
+        b.eq    .Lprocess_attach
+        b       original_entry
+.Lprocess_attach:
+
 section PEMAIN01
 //#if UPX_VERSION_HEX >= 0x060000
         stp     x0, x1, [sp, #-4*NBPW]!  // save in-reg arss
