From 7a2a6d853928ffb7f0db8a66d4076582db06a576 Mon Sep 17 00:00:00 2001
From: Johannes Schindelin <johasc@microsoft.com>
Date: Sun, 27 Sep 2026 19:54:53 +0200
Subject: [PATCH 1/3] win64/arm64: add TLS index protection to stub source

Windows/ARM64 writes the Thread Local Storage (TLS) index values before
the compression starts; An index slot inside the compressed stream
corrupts the decompressed bytes.

Give the ARM64 loader the same TLS-state protection as its AMD64
counterpart so both the assigned index and the packed data survive
initialization.

The names `PETLSHAK` and `PETLSHAK2` refer to the legacy PE TLS hack
sections: the first saves the index and restores the original compressed
word; the second puts the assigned index back after decompression.
Select both for DLLs and for executables whose index might overlap
packed data so the decompressed image and TLS state remain valid.

Note: This commit changes the stub source only; The actual stub will be
generated in a subsequent commit.

Assisted-by: GPT-6 Sol
Signed-off-by: Johannes Schindelin <johannes.schindelin@gmx.de>
---
 src/p_w64pe_arm64.cpp         | 14 +++++++++++++-
 src/stub/src/arm64-win64.pe.S | 15 +++++++++++++++
 2 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/src/p_w64pe_arm64.cpp b/src/p_w64pe_arm64.cpp
index bbf1087614..680d89c597 100644
--- a/src/p_w64pe_arm64.cpp
+++ b/src/p_w64pe_arm64.cpp
@@ -82,14 +82,22 @@ tribool PackW64PeArm64::canPack() {
 void PackW64PeArm64::buildLoader(const Filter *ft) {
     UNUSED(ft);
 
+    unsigned tmp_tlsindex = tlsindex;
+    const unsigned oam1 = ih.objectalign - 1;
+    const unsigned newvsize = (ph.u_len + rvamin + ph.overlap_overhead + oam1) & ~oam1;
+    if (tlsindex && !isdll && ((newvsize - ph.c_len - 1024 + oam1) & ~oam1) > tlsindex + 4)
+        tmp_tlsindex = 0;
+
     initLoader(EM_AARCH64, stub_arm64_win64_pe, sizeof(stub_arm64_win64_pe), 2);
 
-    addLoader("START", "PEMAIN01", "PEMAIN02");
+    addLoader("START", "PEMAIN01", tmp_tlsindex ? "PETLSHAK" : "", "PEMAIN02");
     addLoader(M_IS_NRV2B(ph.method)   ? "PECALL2B"
               : M_IS_NRV2D(ph.method) ? "PECALL2D"
               : M_IS_NRV2E(ph.method) ? "PECALL2E"
                                       : "UNKNOWN_COMPRESSION_METHOD");
     addLoader("PEMAIN10");
+    if (tmp_tlsindex)
+        addLoader("PETLSHAK2");
     if (soimport)
         addLoader("PEIMPORT");
     if (sorelocs)
@@ -147,6 +155,10 @@ void PackW64PeArm64::defineSymbols(unsigned ncsection, unsigned upxsection, unsi
         linker->defineSymbol("compressed_imports", cimports);
     }
 
+    linker->defineSymbol("tls_value",
+                         (tlsindex + 4 > s1addr) ? get_le32(obuf + tlsindex - s1addr - ic) : 0);
+    linker->defineSymbol("tls_address", tlsindex - rvamin);
+
     const unsigned esi0 = s1addr + ic;
     linker->defineSymbol("start_of_uncompressed", 0u - esi0 + rvamin);
     linker->defineSymbol("start_of_compressed", esi0);
diff --git a/src/stub/src/arm64-win64.pe.S b/src/stub/src/arm64-win64.pe.S
index 9e6d2fa4e5..7c64aac7b6 100644
--- a/src/stub/src/arm64-win64.pe.S
+++ b/src/stub/src/arm64-win64.pe.S
@@ -86,6 +86,17 @@ section PEMAIN01
         LDVAL   x9,  start_of_uncompressed
         add     x19, x20, x9                    // x19 = xdst (VA decompressed region)
 
+// Windows initializes the TLS index before entry, possibly overwriting
+// compressed data. Restore the correct compressed bytes now, then restore
+// the TLS index afterward in PETLSHAK2.
+section PETLSHAK
+        LDVAL   x9, tls_address
+        add     x9, x19, x9
+        ldr     w10, [x9]
+        stp     x9, x10, [sp, #-16]!
+        LDVAL   x11, tls_value
+        str     w11, [x9] // restore compressed data overwritten by the TLS index
+
 section PEMAIN02
         // In-place (overlapping) decompression: the packer's
         // testOverlappingDecompression has already verified the source/dest
@@ -112,6 +123,10 @@ section PECALL2E
 section PEMAIN10
         add     sp, sp, #16                     // discard &u_len slot
 
+section PETLSHAK2                               // restore the TLS index
+        ldp     x9, x10, [sp], #16
+        str     w10, [x9]
+
 // =============
 // ============= IMPORTS  (x19 = xdst base, "rsi")
 // =============
