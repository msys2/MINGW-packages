# Maintainer: Maksim Bondarenkov <maksapple@gmail.com>

_realname=surrealdb
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=4.0.0
pkgrel=1
pkgdesc="A scalable, distributed, collaborative, document-graph database, for the realtime web (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64')
url='https://surrealdb.com'
msys2_repository_url='https://github.com/surrealdb/surrealdb'
msys2_references=(
  'aur: surrealdb'
  'purl: pkg:cargo/surrealdb'
)
license=('spdx:BUSL-1.1')
depends=("${MINGW_PACKAGE_PREFIX}-zstd")
makedepends=("${MINGW_PACKAGE_PREFIX}-rust"
             "${MINGW_PACKAGE_PREFIX}-clang"
             "${MINGW_PACKAGE_PREFIX}-llvm"
             "${MINGW_PACKAGE_PREFIX}-nasm"
             "${MINGW_PACKAGE_PREFIX}-rust-bindgen"
             "${MINGW_PACKAGE_PREFIX}-pkgconf"
             'git')
options=('!strip')
source=("git+${msys2_repository_url}#tag=v${pkgver}"
        "zstd-sys.tar.gz::https://static.crates.io/crates/zstd-sys/2.1.2+zstd.1.5.7/download"
        "zstd-sys-remove-statik.patch")
sha256sums=('3e82180922bf7487dd76621bc8d575668377c004b38f081edb8a6733d8ab8268'
            '481ada9c543b2323cbb7bbdbb5249177fbf0188ed959ed2c15e4b22421c84ed3'
            '48f4900ceb02d3aaf9a1020f33d56629156e96759f456c0e7ca18bfcf910767b')

prepare() {
  cd "${_realname}"

  patch -d ../zstd-sys-2.1.2+zstd.1.5.7 -i ../zstd-sys-remove-statik.patch
  cat >> Cargo.toml <<END

[patch.crates-io]
zstd-sys.path = "../zstd-sys-2.1.2+zstd.1.5.7"
END

  rm rust-toolchain.toml
  cargo update -p zstd-sys
  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${_realname}"

  export BINDGEN_EXTRA_CLANG_ARGS="--target=${CARCH}-pc-windows-gnu"
  export LIBCLANG_PATH="${MINGW_PREFIX}/bin"
  export ZSTD_SYS_USE_PKG_CONFIG=1
  # workaround for wasm-opt build
  if [[ ${MINGW_PACKAGE_PREFIX} != *-clang-* ]]; then
    export CC=clang CXX=clang++
    export RUSTFLAGS+=" -C linker=clang"
  fi
  cargo build --release --frozen
}

package() {
  cd "${_realname}"

  install -Dm755 target/release/surreal "${pkgdir}${MINGW_PREFIX}/bin/surreal"
  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
