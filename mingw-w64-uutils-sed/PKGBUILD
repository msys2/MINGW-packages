
_realname=sed
pkgbase=mingw-w64-uutils-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-uutils-${_realname}")
pkgver=0.3.0
pkgrel=1
pkgdesc="Rust rewrite of sed (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/uutils/sed'
msys2_repository_url="${url}"
msys2_references=(
)
license=('spdx:MIT')
test "$MSYSTEM" != "UCRT64" && depends=("${MINGW_PACKAGE_PREFIX}-libunwind")
makedepends=("${MINGW_PACKAGE_PREFIX}-rust")
source=("${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('d879d292ff93f4f769f299fb183be69d3ea6bcedeb2a698d944595ebc3a8dd6c')

prepare() {
  cd "${_realname}-${pkgver}"
  cargo fetch --locked --target "${RUST_CHOST}"
}

build(){
  cd "${_realname}-$pkgver"
  export RUSTFLAGS="${RUSTFLAGS/+crt-static/-crt-static}"
  cargo build --release --frozen
}

package() {
  cd "${_realname}-$pkgver"
  install -Dm755 "target/release/${_realname}" "${pkgdir}${MINGW_PREFIX}/bin/uu-${_realname}"
  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/uutils-${_realname}"
}
