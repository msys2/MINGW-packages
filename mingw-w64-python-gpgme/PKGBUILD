_pyname=gpg
_realname=gpgme
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=2.0.0
pkgrel=1
pkgdesc="Python bindings to the GPGME API of the GnuPG cryptography library. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://gnupg.org/related_software/gpgme/"
msys2_repository_url="https://git.gnupg.org/cgi-bin/gitweb.cgi?p=gpgmepy.git"
msys2_references=(
  'archlinux: python-gpgme'
  'pypi: gpg'
)
license=('spdx:LGPL-2.1-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-gpgme"
         "${MINGW_PACKAGE_PREFIX}-python")
makedepends=("${MINGW_PACKAGE_PREFIX}-python-build"
             "${MINGW_PACKAGE_PREFIX}-python-installer"
             "${MINGW_PACKAGE_PREFIX}-python-setuptools"
             "${MINGW_PACKAGE_PREFIX}-swig"
             "${MINGW_PACKAGE_PREFIX}-cc")
source=("https://pypi.org/packages/source/${_pyname::1}/${_pyname}/${_pyname}-${pkgver}.tar.gz"
        "001-fix-uname_s-for-mingw.patch"
        "002-fix-include_dir-for-mingw.patch"
        "003-fix-build-with-swig-4.5.patch")
sha256sums=('4eb7ad1477e713e97e623d5d1081f4ba05a522bdbc30024c4ce43ec47c045438'
            'f776f98b6d6c4068611df65b85966cb4c93020e2758c993f2838d78fc9ad760a'
            '61c81f533db485b99c1da1910738eb9bd6330eeaafe00d1f408b65408ff26699'
            'e076f2d8914f3f2f97ac7a7a17e9334bb7dc870d1561aa143c252885c47e68cf')

_apply_patch_with_msg() {
  for _patch in "$@"
  do
    msg2 "Applying ${_patch}"
    patch -p1 -i "${srcdir}/${_patch}"
  done
}

prepare() {
  cd "${_pyname}-${pkgver}"
  _apply_patch_with_msg \
    001-fix-uname_s-for-mingw.patch \
    002-fix-include_dir-for-mingw.patch \
    003-fix-build-with-swig-4.5.patch
}

build() {
  cp -r "${_pyname}-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"

  CFLAGS+=" -Wno-incompatible-pointer-types -Wno-incompatible-function-pointer-types"
  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "${srcdir}/python-build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix=${MINGW_PREFIX} --destdir="${pkgdir}" dist/*.whl
}
