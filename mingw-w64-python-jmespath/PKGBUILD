# Maintainer: Sarah Ottinger <schalaalexiazeal@gmail.com>

_realname='jmespath'
pkgbase="mingw-w64-python-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-python-${_realname}"
pkgver=1.1.0
pkgrel=1
pkgdesc='A query language for JSON (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/jmespath/jmespath'
msys2_repository_url='https://github.com/jmespath/jmespath'
msys2_references=(
  'purl: pkg:pypi/jmespath'
)
license=('spdx:Apache-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-hypothesis"
  "${MINGW_PACKAGE_PREFIX}-python-pytest"
)
source=(
  "https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz"
)
sha256sums=('472c87d80f36026ae83c6ddd0f1d05d4e510134ed462851fd5f754c8c3cbb88d')

build() {
  cp -r "${_realname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "build-${MSYSTEM}"

  LC_CTYPE=en_US.utf8 python -m pytest || warning "Tests failed"
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"

  local _prefix_win=$(cygpath -m "${MINGW_PREFIX}")
  sed -s "s|${_prefix_win}/bin/||g" -i "${pkgdir}${MINGW_PREFIX}/bin/jp.py"
}
