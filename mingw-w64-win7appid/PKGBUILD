# Maintainer: David Grayson <davidegrayson@gmail.com>

_realname=win7appid
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=1.1
pkgrel=6
pkgdesc='Windows 7 (and up) shortcut application id tool (mingw-w64)'
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://code.google.com/p/win7appid'
license=('custom')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc")
source=(
  "Win7AppId.cpp"
  "win7appid.1"
  "LICENSE.txt"
)
sha256sums=('609346360e10c1aa40098c0bdfdfc8a1376f628d8bb9d453ec88115a877adc92'
            'c012c8069b09a86a991ab6010d32b59480c6f9e1ae28b57e0b86788ce15b73ea'
            'daafcc2b56af560dde656a591c8ea5d29f200add98e96fd0e1eb7616a99e227a')

build() {
  ${CXX} ${CXXFLAGS} -municode -DWIN32_LEAN_AND_MEAN=1 -DUNICODE -D_UNICODE \
    Win7AppId.cpp -lole32 -o ${_realname}.exe
}

package() {
  install -Dm755 ${_realname}.exe "${pkgdir}${MINGW_PREFIX}/bin/${_realname}.exe"
  install -Dm644 ${_realname}.1 "${pkgdir}${MINGW_PREFIX}/share/man/man1/${_realname}.1"
  install -Dm644 LICENSE.txt "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.txt"
}
