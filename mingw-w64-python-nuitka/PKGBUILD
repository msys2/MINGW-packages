# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_realname=nuitka
pkgbase="mingw-w64-python-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=4.3
pkgrel=1
pkgdesc="Python to native compiler (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://www.nuitka.net/"
msys2_repository_url="https://github.com/Nuitka/Nuitka"
msys2_references=(
  'archlinux: nuitka'
  "cpe: cpe:/a:nuitka:nuitka"
  'gentoo: dev-python/nuitka'
  'purl: pkg:pypi/nuitka'
)
license=('spdx:Apache-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-ordered-set"
  "${MINGW_PACKAGE_PREFIX}-python-zstandard"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
optdepends=(
  "${MINGW_PACKAGE_PREFIX}-ccache: Provides build caching"
)
options=('!strip')
source=("https://pypi.org/packages/source/N/${_realname^}/${_realname}-${pkgver}.tar.gz")
sha256sums=('8b102c6bf30d9504e82e69674d396972729092b25cefa680e8fd05678fdfa30b')

build() {
  cp -r "${_realname}-${pkgver}" "python-build-${MSYSTEM}" && cd "python-build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "${srcdir}/python-build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE.txt -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
