The member-object INVOKE overload must not accept member functions. GCC 16
otherwise selects it for zero-argument member functions and deduces their
function type instead of the result of calling them, breaking projections.

--- a/include/range/v3/functional/invoke.hpp
+++ b/include/range/v3/functional/invoke.hpp
@@ -125,7 +125,8 @@
             return (invoke_fn::coerce<T>((T1&&) t1, 0).*f)((Args&&) args...);
         }
 
-        template<typename D, typename T, typename T1>
+        template(typename D, typename T, typename T1)(
+            requires (!std::is_function<D>::value))
         constexpr auto operator()(D T::*f, T1&& t1) const
             noexcept(noexcept(invoke_fn::coerce<T>((T1&&) t1, 0).*f))
             -> decltype(invoke_fn::coerce<T>((T1&&) t1, 0).*f)
