#Maintainer: Biswapriyo Nath <nathbappai@gmail.com>

_realname=xa65
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=2.4.1
pkgrel=1
pkgdesc='6502/65816 cross assembler'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='http://www.floodgap.com/retrotech/xa/'
msys2_references=(
  'anitya: 14146'
  'archlinux: xa'
  'gentoo: dev-embedded/xa'
)
license=('spdx:GPL-2.0-only')
depends=()
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
)
source=(
  "http://www.floodgap.com/retrotech/xa/dists/xa-${pkgver}.tar.gz"
  '0001-make-fix-predefined-variables.patch'
)
sha256sums=('63c12a6a32a8e364f34f049d8b2477f4656021418f08b8d6b462be0ed3be3ac3'
            'a71ba9fd730d85a15587c388cce0e75b20e4452235c2d2ca9644d3c9c56e3b9f')

prepare() {
  cd "xa-${pkgver}"

  patch -Np1 -i "${srcdir}/0001-make-fix-predefined-variables.patch"

  # For some reason make removes the main binary at start
  sed -i 's/all: killxa/all:/' Makefile
}

build() {
  cd "xa-${pkgver}"

  make "${MAKEFLAGS}"
}

package() {
  cd "xa-${pkgver}"

  make DESTDIR="${pkgdir}${MINGW_PREFIX}" install

  cd "${srcdir}/xa-${pkgver}"
  install -Dm644 README.1st "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}/README"
}
