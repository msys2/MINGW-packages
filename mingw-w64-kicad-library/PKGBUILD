# Support libraries for KiCad

_realname=kicad
pkgbase="mingw-w64-${_realname}-library"
pkgname=(
  "${MINGW_PACKAGE_PREFIX}-${_realname}-footprints"
  "${MINGW_PACKAGE_PREFIX}-${_realname}-symbols"
  "${MINGW_PACKAGE_PREFIX}-${_realname}-templates"
  "${MINGW_PACKAGE_PREFIX}-${_realname}-packages3D"
)
pkgver=10.0.8
pkgrel=1
pkgdesc="Support libraries for KiCad (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://www.kicad.org/'
msys2_repository_url="https://gitlab.com/kicad/libraries"
msys2_references=(
  'archlinux: kicad-library'
  'aur:' # ignore kicad-libraries-git
  'cpe: cpe:/a:kicad:kicad_eda'
)
license=("spdx:GPL-3.0-or-later")
groups=("${MINGW_PACKAGE_PREFIX}-eda")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-python"
)
options=('!strip')
source=(
  "https://gitlab.com/kicad/libraries/kicad-footprints/-/archive/${pkgver}/kicad-footprints-${pkgver}.tar.bz2"
  "https://gitlab.com/kicad/libraries/kicad-symbols/-/archive/${pkgver}/kicad-symbols-${pkgver}.tar.bz2"
  "https://gitlab.com/kicad/libraries/kicad-templates/-/archive/${pkgver}/kicad-templates-${pkgver}.tar.bz2"
  "https://gitlab.com/kicad/libraries/kicad-packages3D/-/archive/${pkgver}/kicad-packages3D-${pkgver}.tar.bz2"
)
sha256sums=('148d0a7913d2eff970a7879d6b4cd8ef08fc10f57f233f7652f5be7f9dcee460'
            '88c04057ac0de2ee3c26bb7976f5bf4a4536c3ec360368fbe4138f5080007256'
            'c273f8cab0de09f2e2d80e32ae79066335a7fc4cbad56238e77d572f4d1901e4'
            'c44650f5c6582fcfbc8463be848158a599ee58ae7a45df20533255d81e2ba1bd')

build() {
  export PYTHONUTF8=1
  export PYTHONIOENCODING=utf-8

  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  for _s in "footprints" "symbols" "templates" "packages3D"; do
    msg2 "Build kicad-${_s}"

    MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
      cmake \
      -Wno-author \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${_extra_config[@]}" \
      -S "${_realname}-${_s}-${pkgver}" \
      -B "build-${_s}-${MSYSTEM}"

    cmake --build "build-${_s}-${MSYSTEM}"
  done
}

package_footprints() {
  pkgdesc="KiCad footprints library (mingw-w64)"
  optdepends=("${MINGW_PACKAGE_PREFIX}-${_realname}")

  DESTDIR="${pkgdir}" cmake --install "build-footprints-${MSYSTEM}"
}

package_symbols() {
  pkgdesc="KiCad symbols library (mingw-w64)"
  optdepends=("${MINGW_PACKAGE_PREFIX}-${_realname}")

  DESTDIR="${pkgdir}" cmake --install "build-symbols-${MSYSTEM}"
}

package_templates() {
  pkgdesc="KiCad templates library (mingw-w64)"

  DESTDIR="${pkgdir}" cmake --install "build-templates-${MSYSTEM}"
}

package_packages3D() {
  pkgdesc="KiCad 3D models library (mingw-w64)"

  DESTDIR="${pkgdir}" cmake --install "build-packages3D-${MSYSTEM}"
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-${_realname}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
