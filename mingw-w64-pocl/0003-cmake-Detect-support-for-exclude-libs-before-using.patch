From 17722c9cdf2caef1919d83b56bd55b9cdeba1dab Mon Sep 17 00:00:00 2001
From: Andrew Johnson <andrew.johnson@arjohnsonau.com>
Date: Sun, 20 Sep 2026 16:44:06 +0800
Subject: [PATCH] cmake: Detect support for --exclude-libs before using

---
 lib/CL/CMakeLists.txt | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/lib/CL/CMakeLists.txt b/lib/CL/CMakeLists.txt
index 1dccd85d5..ec4837cba 100644
--- a/lib/CL/CMakeLists.txt
+++ b/lib/CL/CMakeLists.txt
@@ -454,7 +454,14 @@ endif()
 
 harden("${POCL_LIBRARY_NAME}")
 
-if((UNIX OR MINGW) AND (NOT APPLE))
+if(MINGW)
+  # lld's MinGW driver has no --exclude-libs.
+  include(CheckCXXSourceCompiles)
+  set(CMAKE_REQUIRED_LINK_OPTIONS "LINKER:--exclude-libs,ALL")
+  check_cxx_source_compiles("int main() { return 0; }" HAVE_LINKER_EXCLUDE_LIBS)
+  unset(CMAKE_REQUIRED_LINK_OPTIONS)
+endif()
+if((UNIX AND NOT APPLE) OR (MINGW AND HAVE_LINKER_EXCLUDE_LIBS))
   target_link_options("${POCL_LIBRARY_NAME}" PRIVATE "LINKER:--exclude-libs,ALL")
 endif()
 if(MINGW)
-- 
2.55.0.windows.3

