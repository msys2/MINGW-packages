From f3429dbe3e7ea75e761e66279a311c4179415073 Mon Sep 17 00:00:00 2001
From: Andrew Johnson <andrew.johnson@arjohnsonau.com>
Date: Sun, 20 Sep 2026 16:42:54 +0800
Subject: [PATCH] cmake: detect Windows ARM64 as ARM

---
 CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 98961aaf4..e276a1c21 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -449,7 +449,7 @@ elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "ppc")
   set(POWERPC 1)
 elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "mips")
   set(MIPS 1)
-elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "(arm|aarch64)")
+elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "(arm|aarch64|ARM64)")
   set(ARM 1)
   if(HOST_DEVICE_ADDRESS_BITS MATCHES "32")
     set(ARM32 1)
-- 
2.55.0.windows.3

