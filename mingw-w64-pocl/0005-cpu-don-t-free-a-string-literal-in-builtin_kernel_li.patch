From: Andrew Johnson <andrew.johnson@arjohnsonau.com>
Date: Mon, 21 Sep 2026 15:25:24 +0800
Subject: [PATCH] cpu: don't free a string literal in builtin_kernel_list

---
 lib/CL/devices/common.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/lib/CL/devices/common.c b/lib/CL/devices/common.c
index e23055e5f..5ba533191 100644
--- a/lib/CL/devices/common.c
+++ b/lib/CL/devices/common.c
@@ -2020,7 +2020,7 @@ pocl_init_default_device_infos (cl_device_id dev,
   else
     {
       dev->num_builtin_kernels = 0;
-      dev->builtin_kernel_list = "";
+      dev->builtin_kernel_list = strdup ("");
       dev->builtin_kernels_with_version = NULL;
     }
 
