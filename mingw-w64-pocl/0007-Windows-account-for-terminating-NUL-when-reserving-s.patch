From 468b64f17e374a24aa543eff07188034fd109e63 Mon Sep 17 00:00:00 2001
From: Andrew Johnson <andrew.johnson@arjohnsonau.com>
Date: Mon, 21 Sep 2026 16:59:54 +0800
Subject: [PATCH] Windows: account for terminating NUL when reserving size for
 command string

---
 lib/CL/pocl_run_command.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/lib/CL/pocl_run_command.c b/lib/CL/pocl_run_command.c
index 202223b6f..fb46dddbb 100644
--- a/lib/CL/pocl_run_command.c
+++ b/lib/CL/pocl_run_command.c
@@ -67,7 +67,7 @@ static char *
 build_cmd_from_arglist (const char **args)
 {
   /* Calculate required buffer size for all arguments. */
-  size_t total_len = 0;
+  size_t total_len = 1;
   for (const char **arg = args; *arg != NULL; arg++)
     {
       /* Account for spaces, quotes, and worst-case escaping. */
-- 
