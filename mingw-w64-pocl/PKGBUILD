_realname=pocl
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=7.2
pkgrel=1
pkgdesc="Portable OpenCL implementation (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://portablecl.org/'
msys2_repository_url='https://github.com/pocl/pocl'
msys2_references=(
  'anitya: 3676'
  'archlinux: pocl'
  'aur:' # ignore pocl-git
  'gentoo: dev-libs/pocl'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-clang"
  "${MINGW_PACKAGE_PREFIX}-llvm-libs"
  "${MINGW_PACKAGE_PREFIX}-hwloc"
  "${MINGW_PACKAGE_PREFIX}-opencl-icd"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-clang-tools-extra"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-llvm"
)
source=("https://github.com/pocl/pocl/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
        "0001-relocate-clang.patch"
        "0002-cmake-detect-Windows-ARM64-as-ARM.patch"
        "0003-cmake-Detect-support-for-exclude-libs-before-using.patch"
        "0004-cmake-Allow-fallback-to-a-generic-host-CPU-for-DKERN.patch"
        "0005-cpu-don-t-free-a-string-literal-in-builtin_kernel_li.patch"
        "0006-Windows-make-host-side-ulong-64-bit.patch"
        "0007-Windows-account-for-terminating-NUL-when-reserving-s.patch"
        "0008-Windows-Correctly-report-ARM64-in-platform-string.patch"
        "README.md")
sha256sums=('7ddc01a7afcd49d4ec7fa9bf94df20852db44fcda629a9763086a8c541e5da1e'
            '4e27e58927f9299ed13d85163607b9f994bcfb33614a9ae6a98e73a6e4c9fb95'
