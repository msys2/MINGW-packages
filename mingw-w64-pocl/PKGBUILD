noextract=("${_realname}-${pkgver}.tar.gz")

prepare() {
  # INSTALL is a symlink listed before its target; MSYS2 cannot copy it yet.
  bsdtar -xf "${_realname}-${pkgver}.tar.gz" --exclude "${_realname}-${pkgver}/INSTALL"
  cd "${_realname}-${pkgver}"

  # Find clang.exe beside pocl.dll at runtime instead of the build-time path.
  patch -Np1 -i "${srcdir}/0001-relocate-clang.patch"

  # 7.2: Backports from upstream master, drop on next release:
  # https://github.com/pocl/pocl/commit/f3429dbe3e7ea75e761e66279a311c4179415073
  patch -Np1 -i "${srcdir}/0002-cmake-detect-Windows-ARM64-as-ARM.patch"
  # https://github.com/pocl/pocl/commit/17722c9cdf2caef1919d83b56bd55b9cdeba1dab
  patch -Np1 -i "${srcdir}/0003-cmake-Detect-support-for-exclude-libs-before-using.patch"
  # https://github.com/pocl/pocl/commit/bc0e7c65ec310152845f0573eaab71f52a5bc0e6
  patch -Np1 -i "${srcdir}/0004-cmake-Allow-fallback-to-a-generic-host-CPU-for-DKERN.patch"
  # https://github.com/pocl/pocl/commit/a94d769a1cb12b6a71b07e6503e49d449d878e8d
  patch -Np1 -i "${srcdir}/0005-cpu-don-t-free-a-string-literal-in-builtin_kernel_li.patch"
  # https://github.com/pocl/pocl/commit/724a05d9a0253d8d98026e7c00d12cae9631708a
  patch -Np1 -i "${srcdir}/0006-Windows-make-host-side-ulong-64-bit.patch"
  # https://github.com/pocl/pocl/commit/468b64f17e374a24aa543eff07188034fd109e63
  patch -Np1 -i "${srcdir}/0007-Windows-account-for-terminating-NUL-when-reserving-s.patch"
  # https://github.com/pocl/pocl/commit/b69181e431d9c55f70bcf0dc7ca9d48d24ed25ac
  patch -Np1 -i "${srcdir}/0008-Windows-Correctly-report-ARM64-in-platform-string.patch"
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${extra_config[@]}" \
      -DBUILD_SHARED_LIBS=ON \
      -DSTATIC_LLVM=OFF \
      -DENABLE_ICD=ON \
      -DENABLE_HWLOC=ON \
      -DKERNELLIB_HOST_CPU_VARIANTS=distro \
      -DINSTALL_OPENCL_HEADERS=OFF \
      -DPOCL_INSTALL_PKGCONFIG_DIR_REL:STRING=lib/pkgconfig \
      -DENABLE_SPIRV=OFF \
      -DCMAKE_DISABLE_FIND_PACKAGE_LIBJPEG_TURBO=ON \
      -DCMAKE_DISABLE_FIND_PACKAGE_onnxruntime=ON \
      -DCMAKE_DISABLE_FIND_PACKAGE_OpenCV=ON \
      -DENABLE_EXAMPLES=OFF \
      -DENABLE_LLVM_FILECHECKS=OFF \
      -S "${_realname}-${pkgver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

check() {
  local builddir="${srcdir}/build-${MSYSTEM}"

  # The Khronos loader ignores OCL_ICD_FILENAMES in elevated (high integrity)
  # processes, so this must run from a non-elevated shell.
  # Load the MSYS2 ICD loader beside each test executable.
  local testdir
  while IFS= read -r testdir; do
    cp "${MINGW_PREFIX}/bin/OpenCL.dll" "${testdir}/"
  done < <(find "${builddir}/tests" "${builddir}/bin" -name '*.exe' -printf '%h\n' | sort -u)

  PATH="${builddir}/lib/CL:${PATH}" \
    OCL_ICD_FILENAMES="$(cygpath -w "${builddir}/lib/CL/pocl.dll")" \
    ctest --test-dir "${builddir}" --output-on-failure -LE 'cpu_fail|mingw_fail'
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  sed -i 's|^libdir=.*|libdir=${prefix}/lib|' \
    "${pkgdir}${MINGW_PREFIX}/lib/pkgconfig/pocl.pc"

  install -Dm644 "${srcdir}/${_realname}-${pkgver}/COPYING" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYING"
  install -Dm644 "${srcdir}/README.md" \
    "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}/README.md"
}
