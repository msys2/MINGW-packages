# Maintainer: Christoph Reiter <reiter.christoph@gmail.com>

_realname=gnome-sound-recorder
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=42.0
pkgrel=1
pkgdesc="A utility to make simple audio recording from your GNOME desktop (mingw-w64)"
url="https://wiki.gnome.org/Apps/SoundRecorder"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
license=("spdx:GPL-2.0-or-later")
depends=(
  "${MINGW_PACKAGE_PREFIX}-gjs"
  "${MINGW_PACKAGE_PREFIX}-gst-plugins-bad"
  "${MINGW_PACKAGE_PREFIX}-gst-plugins-bad-libs"
  "${MINGW_PACKAGE_PREFIX}-gst-plugins-base"
  "${MINGW_PACKAGE_PREFIX}-gst-plugins-good"
  "${MINGW_PACKAGE_PREFIX}-gtk4"
  "${MINGW_PACKAGE_PREFIX}-hicolor-icon-theme"
  "${MINGW_PACKAGE_PREFIX}-libadwaita"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-gettext-tools"
  "${MINGW_PACKAGE_PREFIX}-git"
  "${MINGW_PACKAGE_PREFIX}-gobject-introspection"
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "git"
)
source=(
  "git+https://gitlab.gnome.org/Archive/${_realname}.git#tag=${pkgver}"
  0001-Replace-emblem-icon-removed-from-Adwaita.patch
  # Resolve the installation prefix from the native GJS executable location.
  0003-Windows-launcher.patch
  # Skip the Unix symlink on Windows; package() supplies a launcher instead.
  0004-Skip-Unix-post-install-on-Windows.patch
  # Select a native Windows audio input instead of requiring PulseAudio.
  0005-Use-platform-independent-audio-source.patch
)
b2sums=('be3e4e1a0508075bc1e0fe895e2fa0660a1b5cbc4bb69db61c76c7aef0630e1eaa5567e1766b4d666a147383a532d06fced94078d43b5b557df4fc3ec477865f'
        '6c4301e6a639a33d0833dea49a73f73f6623e5eaaaf46a0d5a4d1793467019c2b5be147a6950026e0c97e839b2e7db31eb969ce0251ef6cb1a6431421f43b8b3'
        'e5835c52331d3b70edfa7d26218dea44e8a77aaf0fab3f69ee6d1012ff2eb95e2a5ce442e0be4b17cd0122d09af2b9340c2808d5b4aa278e17f0cab156c9f2bd'
        '919e3cc3adb2fdc77ab1564d8522e9e833bf1dca31a48df369b4e771b80cb9466c71ad5aafcabb6782bae7cf6ee03441e0a72b6ca7c51552de1a1d03927eddf6'
        'df99231e32909c20997c0022e50acaefc736c644f64e42f6ed300620a311fd113577420640e754f92f0cd3576b98479e58ee539aa9d70ecdc2922968085025d1')

prepare() {
  cd "${_realname}"

  # https://gitlab.gnome.org/Archive/gnome-sound-recorder/-/merge_requests/193
  git cherry-pick -n 3d9a5aab50823f3b6b64c8dd253abc43261d5e6b
  git cherry-pick -n 7568e10297d3bf1f2bc5ca87e15fa6e322a77b92
  git cherry-pick -n 8547fe753695a332d0efa045dc31a16a84eb8601

  git apply -3 ../0001-Replace-emblem-icon-removed-from-Adwaita.patch
  git apply ../0003-Windows-launcher.patch
  git apply ../0004-Skip-Unix-post-install-on-Windows.patch
  git apply ../0005-Use-platform-independent-audio-source.patch
}

build() {
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    meson setup "build-${MSYSTEM}" "${_realname}" \
      --prefix="${MINGW_PREFIX}" \
      --buildtype=release \
      --wrap-mode=nofallback
  meson compile -C "build-${MSYSTEM}"
}

check() {
  meson test -C "build-${MSYSTEM}" --print-errorlogs
}

package() {
  DESTDIR="${pkgdir}" meson install -C "build-${MSYSTEM}"

  # upstream uses a symlink, which we can't use
  install -dm755 "${pkgdir}${MINGW_PREFIX}/bin"
  cat > "${pkgdir}${MINGW_PREFIX}/bin/${_realname}" <<'EOF'
#!/usr/bin/env bash
exec gjs "$(dirname "$0")/../share/org.gnome.SoundRecorder/org.gnome.SoundRecorder" "$@"
EOF
  chmod 755 "${pkgdir}${MINGW_PREFIX}/bin/${_realname}"
}
