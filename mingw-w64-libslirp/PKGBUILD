# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_realname=libslirp
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=4.9.6
pkgrel=1
pkgdesc="General purpose TCP-IP emulator (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://gitlab.freedesktop.org/slirp/libslirp"
msys2_repository_url='https://gitlab.freedesktop.org/slirp/libslirp'
msys2_references=(
  'anitya: 96796'
  'archlinux: libslirp'
  'cpe: cpe:/a:libslirp_project:libslirp'
  'gentoo: net-libs/libslirp'
)
license=('spdx:BSD-3-Clause')
depends=(
  "${MINGW_PACKAGE_PREFIX}-glib2"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
)
_archive="${_realname}-v${pkgver}"
source=("https://gitlab.freedesktop.org/slirp/${_realname}/-/archive/v${pkgver}/${_archive}.tar.bz2")
noextract=("${_archive}.tar.bz2")
sha256sums=('d4c5d1473216ab9f59402a671e4d6e2af4497666d5d41fa5bf3431d42fb99327')

prepare() {
  bsdtar -xf "${_archive}.tar.bz2" 2>/dev/null || bsdtar -xf "${_archive}.tar.bz2"
}

build() {
  local -a _static_flags=(
    -DGIO_STATIC_COMPILATION
    -DGLIB_STATIC_COMPILATION
    -DGMODULE_STATIC_COMPILATION
    -DGOBJECT_STATIC_COMPILATION
  )

  CFLAGS+=" ${_static_flags[@]}" \
  CXXFLAGS+=" ${_static_flags[@]}" \
  MSYS2_ARG_CONV_EXCL="--prefix=" \
  meson setup \
    --prefix="${MINGW_PREFIX}" \
    --buildtype=plain \
    -Ddefault_library=static \
    "${_archive}" \
    "build-${MSYSTEM}-static"

  meson compile -C "build-${MSYSTEM}-static"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
  meson setup \
    --prefix="${MINGW_PREFIX}" \
    --buildtype=plain \
    -Ddefault_library=shared \
    "${_archive}" \
    "build-${MSYSTEM}-shared"

  meson compile -C "build-${MSYSTEM}-shared"
}

package() {
  meson install -C "build-${MSYSTEM}-static" --destdir "${pkgdir}"
  meson install -C "build-${MSYSTEM}-shared" --destdir "${pkgdir}"

  echo "Cflags.private: -DLIBSLIRP_STATIC" >> "${pkgdir}${MINGW_PREFIX}"/lib/pkgconfig/slirp.pc

  cd "${srcdir}/${_archive}"
  install -Dm644 COPYRIGHT -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
