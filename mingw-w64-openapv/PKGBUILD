# Maintainer: Christoph Reiter <reiter.christoph@gmail.com>

_realname=openapv
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.1.3.0
pkgrel=2
pkgdesc='The reference implementation of the APV codec (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/AcademySoftwareFoundation/openapv/'
msys2_repository_url='https://github.com/AcademySoftwareFoundation/openapv'
license=('spdx:BSD-3-Clause')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-cmake")
source=("https://github.com/AcademySoftwareFoundation/openapv/releases/download/v${pkgver}/${_realname}-${pkgver}.tar.gz"
        https://github.com/AcademySoftwareFoundation/openapv/commit/1d3cc6bfd0ff0c34953a2f8265f0fd6ee4efdd02.patch)
sha256sums=('9d010730934dae238427df2cabcd2aff99a774e3a2d6029ba3e5d9ad94c207cd'
            '95f50b3c84fa4c10884914b7bf3a870504222e39e58a31d6b56fa3a521ddb8e3')

prepare() {
  cd "${_realname}-${pkgver}"

  # https://github.com/AcademySoftwareFoundation/openapv/pull/315
  patch -Np1 -i ../1d3cc6bfd0ff0c34953a2f8265f0fd6ee4efdd02.patch
}

build() {
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
  cmake -B build -S "${_realname}-${pkgver}" \
    -G 'Ninja' \
    -DCMAKE_BUILD_TYPE='None' \
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
    -DOAPV_APP_STATIC_BUILD='OFF' \
    -DCMAKE_DLL_NAME_WITH_SOVERSION=ON \
    -Wno-author
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -D -m644 "${_realname}-${pkgver}/LICENSE" -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
