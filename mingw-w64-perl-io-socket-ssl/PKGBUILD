# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=IO-Socket-SSL
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=2.099
pkgrel=2
pkgdesc="SSL sockets with IO::Socket interface. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/IO-Socket-SSL"
msys2_repository_url="https://github.com/noxxi/p5-io-socket-ssl"
msys2_references=(
  'purl: pkg:cpan/SULLR/IO-Socket-SSL'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-perl"
         "${MINGW_PACKAGE_PREFIX}-perl-net-ssleay"
         "${MINGW_PACKAGE_PREFIX}-perl-uri")
makedepends=("${MINGW_PACKAGE_PREFIX}-make")
source=("https://cpan.metacpan.org/authors/id/S/SU/SULLR/${_perlname}-${pkgver}.tar.gz")
sha256sums=('a0be800ff4852b1567ee5500e772417ad7a360abff80c01b5b875c15d44be832')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
}
