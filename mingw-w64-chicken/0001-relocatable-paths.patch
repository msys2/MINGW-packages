diff -u -r -N a/runtime.c b/runtime.c
--- a/runtime.c	2024-07-16 11:13:18.000000000 +0530
+++ b/runtime.c	2026-11-21 01:36:27.994775300 +0530
@@ -12688,6 +12688,80 @@
   return path;
 }
 
+#if defined(_WIN32) && !defined(__CYGWIN__)
+static char *C_relocated_prefix = NULL;
+static char *C_relocated_bin_home = NULL;
+static char *C_relocated_lib_home = NULL;
+static char *C_relocated_egg_home = NULL;
+static char *C_relocated_share_home = NULL;
+static char *C_relocated_include_home = NULL;
+
+static void C_init_relocated_paths(void) {
+  if (C_relocated_prefix != NULL) return;
+  char *bindir = C_executable_dirname();
+  if (bindir != NULL && *bindir != '\0') {
+    char *p;
+    for (p = bindir; *p; p++) {
+      if (*p == '\\') *p = '/';
+    }
+    char *last_slash = strrchr(bindir, '/');
+    if (last_slash != NULL && (strcasecmp(last_slash + 1, "bin") == 0)) {
+      *last_slash = '\0';
+      C_relocated_prefix = bindir;
+    } else {
+      C_relocated_prefix = bindir;
+    }
+    size_t prefix_len = strlen(C_relocated_prefix);
+
+    C_relocated_bin_home = (char *)malloc(prefix_len + 5);
+    sprintf(C_relocated_bin_home, "%s/bin", C_relocated_prefix);
+
+    C_relocated_lib_home = (char *)malloc(prefix_len + 5);
+    sprintf(C_relocated_lib_home, "%s/lib", C_relocated_prefix);
+
+    C_relocated_egg_home = (char *)malloc(prefix_len + 32);
+    sprintf(C_relocated_egg_home, "%s/lib/chicken/%d", C_relocated_prefix, C_BINARY_VERSION);
+
+    C_relocated_share_home = (char *)malloc(prefix_len + 16);
+    sprintf(C_relocated_share_home, "%s/share/chicken", C_relocated_prefix);
+
+    C_relocated_include_home = (char *)malloc(prefix_len + 18);
+    sprintf(C_relocated_include_home, "%s/include/chicken", C_relocated_prefix);
+  }
+}
+
+C_fctexport const char *C_get_install_prefix(void) {
+  C_init_relocated_paths();
+  return C_relocated_prefix ? C_relocated_prefix : "";
+}
+
+C_fctexport const char *C_get_install_bin_home(void) {
+  C_init_relocated_paths();
+  return C_relocated_bin_home ? C_relocated_bin_home : "";
+}
+
+C_fctexport const char *C_get_install_lib_home(void) {
+  C_init_relocated_paths();
+  return C_relocated_lib_home ? C_relocated_lib_home : "";
+}
+
+C_fctexport const char *C_get_install_egg_home(void) {
+  C_init_relocated_paths();
+  return C_relocated_egg_home ? C_relocated_egg_home : "";
+}
+
+C_fctexport const char *C_get_install_share_home(void) {
+  C_init_relocated_paths();
+  return C_relocated_share_home ? C_relocated_share_home : "";
+}
+
+C_fctexport const char *C_get_install_include_home(void) {
+  C_init_relocated_paths();
+  return C_relocated_include_home ? C_relocated_include_home : "";
+}
+#endif
