# Maintainer: J. Peter Mugaas <jpmugaas@suddenlink.net>

_realname='fonttools'
pkgbase="mingw-w64-python-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-python-${_realname}"
pkgver=4.66.0
pkgrel=1
pkgdesc='Converts OpenType and TrueType fonts to and from XML (mingw-w64)'
arch=('any')
mingw_arch=('mingw32' 'mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://fonttools.readthedocs.io/'
msys2_repository_url='https://github.com/fonttools/fonttools/'
msys2_changelog_url='https://github.com/fonttools/fonttools/blob/main/NEWS.rst'
msys2_references=(
  'anitya: 7388'
  'archlinux: python-fonttools'
  'cpe: cpe:/a:fonttools:fonttools'
  'gentoo: dev-python/fonttools'
  'purl: pkg:pypi/fonttools'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
)
if [[ ${CARCH} != i686 ]]; then
optdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-brotli: WOFF 1.0 and WOFF 2.0 webfonts"
  "${MINGW_PACKAGE_PREFIX}-python-matplotlib: for visualizing DesignSpaceDocument and resulting VariationModel"
  "${MINGW_PACKAGE_PREFIX}-python-pyfilesystem2: for fontTools.ufoLib: to read/write UFO fonts"
  "${MINGW_PACKAGE_PREFIX}-python-pyzopfli: WOFF 1.0 and WOFF 2.0 webfonts"
  "${MINGW_PACKAGE_PREFIX}-python-sympy: for fontTools.misc.symfont, module for symbolic font statistics analysis"
)
fi
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cython"
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-brotli"
  "${MINGW_PACKAGE_PREFIX}-python-pyfilesystem2"
  "${MINGW_PACKAGE_PREFIX}-python-pytest"
  "${MINGW_PACKAGE_PREFIX}-python-ufolib2"
)
options=('!strip')
source=("https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz")
sha256sums=('ef0610dfe7bb5bf574d9bdad6f597403ebc9807d124ac6f148d7604b2609be98')

build() {
  cp -r "${_realname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "build-${MSYSTEM}"

  # 4.66.0: 8 failed, 4957 passed, 56 skipped, 2 xfailed, 28 warnings
  # 4.65.0: 8 failed, 4861 passed, 57 skipped, 2 xfailed
  PYTHONPATH="$PWD/Lib" python -m pytest || warning "Tests failed"
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
