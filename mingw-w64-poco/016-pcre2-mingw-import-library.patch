# https://github.com/pocoproject/poco/issues/4598
# Use the full extension and CMake's library suffixes to distinguish import
# libraries from static archives, retaining the existing static-first check.
diff --git a/cmake/FindPCRE2.cmake b/cmake/FindPCRE2.cmake
--- a/cmake/FindPCRE2.cmake
+++ b/cmake/FindPCRE2.cmake
@@ -98,7 +98,11 @@ if(PCRE2_FOUND AND NOT TARGET Pcre2::Pcre2)
   set(_PCRE2_LIB_TYPE UNKNOWN)
+  set(_PCRE2_LIB_PROPERTY IMPORTED_LOCATION)
-#  cmake_path(GET PCRE2_LIBRARY EXTENSION LAST_ONLY _PCRE2_SUFFIX) # CMake 3.20+
-  get_filename_component(_PCRE2_SUFFIX ${PCRE2_LIBRARY} LAST_EXT)
+#  cmake_path(GET PCRE2_LIBRARY EXTENSION _PCRE2_SUFFIX) # CMake 3.20+
+  get_filename_component(_PCRE2_SUFFIX "${PCRE2_LIBRARY}" EXT)
   if ("${_PCRE2_SUFFIX}" STREQUAL "${CMAKE_STATIC_LIBRARY_SUFFIX}")
     set(_PCRE2_LIB_TYPE STATIC)
+  elseif ("${_PCRE2_SUFFIX}" STREQUAL "${CMAKE_IMPORT_LIBRARY_SUFFIX}")
+    set(_PCRE2_LIB_TYPE SHARED)
+    set(_PCRE2_LIB_PROPERTY IMPORTED_IMPLIB)
   elseif ("${_PCRE2_SUFFIX}" STREQUAL "${CMAKE_SHARED_LIBRARY_SUFFIX}")
     set(_PCRE2_LIB_TYPE SHARED)
@@ -110,3 +114,3 @@ if(PCRE2_FOUND AND NOT TARGET Pcre2::Pcre2)
   set_target_properties(Pcre2::Pcre2 PROPERTIES
-    IMPORTED_LOCATION "${PCRE2_LIBRARY}"
+    ${_PCRE2_LIB_PROPERTY} "${PCRE2_LIBRARY}"
     INTERFACE_COMPILE_OPTIONS "${PC_PCRE2_CFLAGS_OTHER}"
@@ -115,2 +119,3 @@ if(PCRE2_FOUND AND NOT TARGET Pcre2::Pcre2)
   unset(_PCRE2_LIB_TYPE)
+  unset(_PCRE2_LIB_PROPERTY)
   unset(_PCRE2_SUFFIX)
