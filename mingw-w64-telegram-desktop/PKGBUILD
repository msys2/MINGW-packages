prepare() {
  # The archive has forward symlinks that MSYS2's copying extractor cannot resolve.
  rm -rf "${srcdir}/tdesktop-${pkgver}-full"
  python -m tarfile -e "${srcdir}/tdesktop-${pkgver}-full.tar.gz" "${srcdir}" --filter data
  cd "tdesktop-${pkgver}-full"
  patch -Np1 -i "${srcdir}/001-mingw.patch"
  patch -Np1 -i "${srcdir}/002-system-tdlib.patch"
  patch -Np1 -i "${srcdir}/003-webview2-uuid.patch"
  patch -Np1 -i "${srcdir}/004-cross-host-tools.patch"
  patch -Np1 -i "${srcdir}/005-cxx-portability.patch"

  install -Dm644 "${srcdir}/wrl-event.h" Telegram/ThirdParty/wrl/include/wrl/event.h
  install -Dm644 "${srcdir}/wrl-implements.h" Telegram/ThirdParty/wrl/include/wrl/implements.h
  install -Dm644 "${srcdir}/wrl-module.h" Telegram/ThirdParty/wrl/include/wrl/module.h
  install -Dm644 "${srcdir}/wrl-ftm.h" Telegram/ThirdParty/wrl/include/wrl/ftm.h
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  # Package-manager updates own the installed application, not its updater.
  # The public API credentials are the ones used by upstream's Snap package.
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${extra_config[@]}" \
      -DDESKTOP_APP_USE_PACKAGED=ON \
      -DDESKTOP_APP_DISABLE_AUTOUPDATE=ON \
      -DDESKTOP_APP_DISABLE_CRASH_REPORTS=ON \
      -DTDESKTOP_API_ID=611335 \
      -DTDESKTOP_API_HASH=d524b414d21f4d37f08684c1df41ac9c \
      -S "tdesktop-${pkgver}-full" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "tdesktop-${pkgver}-full/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
  install -Dm644 "tdesktop-${pkgver}-full/LEGAL" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LEGAL"
  install -Dm644 "${srcdir}/wrl-LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/WRL-LICENSE"
}
