--- a/cmake/init_target.cmake
+++ b/cmake/init_target.cmake
@@ -5,6 +5,26 @@
 # https://github.com/desktop-app/legal/blob/master/LEGAL
 
 set(MAXIMUM_CXX_STANDARD cxx_std_20)
+
+set(DESKTOP_APP_HOST_TOOLS_DIR "" CACHE PATH
+    "Directory containing separately native-built code generators for cross compilation")
+
+function(desktop_app_import_host_tool target_name)
+    if (NOT CMAKE_CROSSCOMPILING OR TARGET ${target_name})
+        return()
+    endif()
+    if (NOT DESKTOP_APP_HOST_TOOLS_DIR)
+        message(FATAL_ERROR
+            "Cross compilation requires DESKTOP_APP_HOST_TOOLS_DIR with native-built ${target_name}")
+    endif()
+    find_program(host_tool
+        NAMES ${target_name}
+        PATHS "${DESKTOP_APP_HOST_TOOLS_DIR}"
+        NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH NO_CACHE REQUIRED
+    )
+    add_executable(${target_name} IMPORTED GLOBAL)
+    set_target_properties(${target_name} PROPERTIES IMPORTED_LOCATION "${host_tool}")
+endfunction()
 
