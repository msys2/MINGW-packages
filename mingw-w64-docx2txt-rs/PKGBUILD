

_realname=docx2txt-rs
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.2.0
pkgrel=3
pkgdesc="Rust rewrite of docx2txt (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://github.com/dscho/docx2txt-rs'
msys2_repository_url="${url}"
msys2_references=(
  'archlinux: docx2txt-rs' # just in case and ignore original docx2txt
  'aur: docx2txt-rs' # just in case
  'gentoo: app-text/docx2txt-rs' # just in case
  'purl: pkg:cargo/docx2txt'
)
license=('spdx:GPL-3.0-or-later')
makedepends=("${MINGW_PACKAGE_PREFIX}-rust")
source=("${url}/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz")
sha256sums=('25321fa9a937590017419eab8e285076b9530af588bb4c580bcee59285c3f41e')

prepare() {
  cd "${_realname}-${pkgver}"

  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${_realname}-${pkgver}"

  export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 # release profile lacks it
  cargo build --release --frozen
}

check() {
  cd "${_realname}-${pkgver}"

  cargo test --release --frozen
}

package() {
  cd "${_realname}-${pkgver}"

  cargo install \
    --offline \
    --no-track \
    --frozen \
    --path . \
    --root "${pkgdir}${MINGW_PREFIX}"

  install -Dm644 COPYING "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYING"
}
