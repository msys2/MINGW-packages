# Maintainer: Tiphereth-A <tifa-233@outlook.com>

_realname='nox'
pkgbase="mingw-w64-python-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-python-${_realname}"
pkgver=2026.8.17
pkgrel=1
pkgdesc='Flexible test automation for Python (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://nox.thea.codes/'
msys2_repository_url='https://github.com/wntrblm/nox/'
msys2_changelog_url='https://nox.thea.codes/en/stable/changelog.html'
msys2_references=(
  'anitya: 41244'
  'archlinux: python-nox'
  'gentoo: dev-python/nox'
  'purl: pkg:pypi/nox'
)
license=('spdx:Apache-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-argcomplete"
  "${MINGW_PACKAGE_PREFIX}-python-attrs"
  "${MINGW_PACKAGE_PREFIX}-python-colorlog"
  "${MINGW_PACKAGE_PREFIX}-python-dependency-groups"
  "${MINGW_PACKAGE_PREFIX}-python-humanize"
  "${MINGW_PACKAGE_PREFIX}-python-packaging"
  "${MINGW_PACKAGE_PREFIX}-python-virtualenv"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-hatchling"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-jinja"
  "${MINGW_PACKAGE_PREFIX}-python-pytest"
  "${MINGW_PACKAGE_PREFIX}-python-tox"
  "${MINGW_PACKAGE_PREFIX}-uv"
)
optdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-jinja: tox_to_nox"
  "${MINGW_PACKAGE_PREFIX}-python-tox: tox_to_nox"
  "${MINGW_PACKAGE_PREFIX}-uv: uv backend"
)
options=('!strip')
source=(
  "https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz"
  '001-fix-uv-as-venv-backend.patch'
  '002-fix-test-virtualenv.patch'
)
sha256sums=('8d9c69c9b996a59db1eb2c6968deaebc2edbc55317d205981bbc4a37351d3f2e'
            '940a2279715b93a650d4de09bc95a9000d4aa0a10c21c2d4270a78d956847a0f'
            '0aff5e0aa7c1fd74256568b7b00ea97c2990aaea934519880e240da7ed3e6252')

prepare() {
  cd "${_realname}-${pkgver}"

  patch -Np1 -i "${srcdir}/001-fix-uv-as-venv-backend.patch"
  patch -Np1 -i "${srcdir}/002-fix-test-virtualenv.patch"
}

build() {
  cp -r "${_realname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  local pytest_options=(
    -vv
    # from https://gitlab.archlinux.org/archlinux/packaging/packages/python-nox/-/blob/1223a4323c25429ef9b627c8b5f9da4cda1b4d8d/PKGBUILD#L50
    --deselect tests/test_main.py::test_noxfile_script_mode_url_req
    # symlink test, seems fail as intended
    --deselect tests/test_main.py::test_symlink_sym
  )
  cd "build-${MSYSTEM}"

  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest "${pytest_options[@]}"
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
