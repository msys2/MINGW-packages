# Maintainer: Ilya Rakhlin <i.rakhlin@gmail.com>

_realname=pkgconf
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
epoch=1
pkgver=3.0.10
pkgrel=1
pkgdesc='pkg-config compatible utility which does not depend on glib'
arch=('any')
mingw_arch=('mingw32' 'mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://pkgconf.org'
msys2_repository_url='https://github.com/pkgconf/pkgconf'
msys2_changelog_url='https://github.com/pkgconf/pkgconf/blob/main/NEWS'
msys2_references=(
  'anitya: 12753'
  'archlinux: pkgconf'
  'cpe: cpe:/a:pkgconf:pkgconf'
  'gentoo: dev-util/pkgconf'
)
license=('spdx:ISC')
groups=("${MINGW_PACKAGE_PREFIX}-toolchain")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-meson"
)
conflicts=("${MINGW_PACKAGE_PREFIX}-pkg-config")
provides=("${MINGW_PACKAGE_PREFIX}-pkg-config")
replaces=("${MINGW_PACKAGE_PREFIX}-pkg-config")
source=("https://github.com/pkgconf/pkgconf/archive/${_realname}-${pkgver}/${_realname}-${pkgver}.tar.gz")
noextract=("${_realname}-${pkgver}.tar.gz")
sha256sums=('11818a25f2730132f3b258ac8be4e82f83b9db03a1a99a6c29cd01b94fc9d310')

prepare() {
  # fixes encoding: tests/lib1/te\360\237\230\213st/
  bsdtar -xf "${_realname}-${pkgver}.tar.gz" || true

  mv "${_realname}-${_realname}-${pkgver}" "${_realname}-${pkgver}"
}

build() {
  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("--buildtype=release")
  else
    _extra_config+=("--buildtype=debug")
  fi

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    meson setup \
      --prefix="${MINGW_PREFIX}" \
      "${_extra_config[@]}" \
      "build-${MSYSTEM}" \
      "${_realname}-${pkgver}"

  meson compile -C "build-${MSYSTEM}"
}

check() {
  # 3.07: 16/29 pkgconf:basic FAIL
  #       Ok: 28, Fail: 1
  meson test -C "build-${MSYSTEM}" || true
}

package() {
  meson install -C "build-${MSYSTEM}" --destdir "${pkgdir}"

  cp "${pkgdir}${MINGW_PREFIX}/bin/pkgconf" "${pkgdir}${MINGW_PREFIX}/bin/pkg-config"
  cp "${pkgdir}${MINGW_PREFIX}/bin/pkgconf" "${pkgdir}${MINGW_PREFIX}/bin/${MINGW_CHOST}-pkgconf"
  cp "${pkgdir}${MINGW_PREFIX}/bin/pkg-config" "${pkgdir}${MINGW_PREFIX}/bin/${MINGW_CHOST}-pkg-config"
}
