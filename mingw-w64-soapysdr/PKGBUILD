_realname='soapysdr'
_pkgname='SoapySDR'
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.9.0
_gitver="soapy-sdr-${pkgver}"
pkgrel=1
pkgdesc='Vendor and platform neutral SDR support library (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/pothosware/SoapySDR'
msys2_repository_url='https://github.com/pothosware/SoapySDR'
msys2_references=(
  'anitya: 14536'
  'archlinux: soapysdr'
  'gentoo: net-wireless/soapysdr'
)
license=('spdx:BSL-1.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-libwinpthread"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-swig"
)
source=(
  "${url}/archive/${_gitver}/${_pkgname}-${pkgver}.tar.gz"
)
sha256sums=('64f97c1ad241156fe299acb8902169019eab34517cd580b563968a43d7533509')

prepare() {
  cd "${_pkgname}-${_gitver}"

  # fix missing <cstdlib> for std::strtod with libc++
  sed -i '/#pragma once/a #include <cstdlib>' include/SoapySDR/Types.hpp
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
    -Wno-author \
    -GNinja \
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
    -DPython3_EXECUTABLE="${MINGW_PREFIX}/bin/python" \
    -DPython3_ROOT_DIR=${MINGW_PREFIX} \
    -DPython3_FIND_REGISTRY=NEVER \
    -DENABLE_CSHARP=OFF \
    -DENABLE_LUAJIT=OFF \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    "${extra_config[@]}" \
    -S "${_pkgname}-${_gitver}" \
    -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "${_pkgname}-${_gitver}/LICENSE_1_0.txt" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
