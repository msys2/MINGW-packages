_apply_patch_with_msg() {
  for _patch in "$@"; do
    msg2 "Applying ${_patch}"
    patch -Nbp1 -i "${srcdir}/${_patch}"
  done
}

prepare() {
  cd "${_realname}-${pkgver}"

  _apply_patch_with_msg \
    '0001-meson-add-winpthread.patch' \
    '0002-fix-plugin-search.patch' \
    '0003-libdir.patch' \
    '0004-perl-flags.patch' \
    '0005-icon.patch' \
    '0006-enchant-dll-name.patch' \
    '0007-no-Werror.patch'

  cp "${srcdir}/zoitechat.rc" ./
}

build() {
  local _extra_config=()
  if check_option 'debug' 'n'; then
    _extra_config+=('--buildtype=release')
  else
    _extra_config+=('--buildtype=debug')
  fi

  # Work around fatal pointer type errors on legacy C code for both GCC and Clang
  CFLAGS+=" -Wno-error=incompatible-pointer-types"
  CXXFLAGS+=" -Wno-error=incompatible-pointer-types"

  MSYS2_ARG_CONV_EXCL='--prefix=' \
    meson setup \
    --prefix="${MINGW_PREFIX}" \
    "${_extra_config[@]}" \
    --wrap-mode=nodownload \
    -Dtext-frontend=true \
    -Dwith-upd=false \
    "build-${MSYSTEM}" \
    "${_realname}-${pkgver}"

  meson compile -C "build-${MSYSTEM}"
}

check() {
  meson test -C "build-${MSYSTEM}" || true
}

package() {
  DESTDIR="${pkgdir}" meson install -C "build-${MSYSTEM}"

  cd "${_realname}-${pkgver}"
  install -Dm644 COPYING -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
