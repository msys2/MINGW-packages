#

_realname=xonotic
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.8.6
pkgrel=1
pkgdesc='A free, fast-paced cross-platform first person shooter (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://xonotic.org/'
msys2_repository_url='https://gitlab.com/xonotic/xonotic'
msys2_references=(
  'archlinux: xonotic'
  'gentoo: games-fps/xonotic'
)
license=('spdx:GPL-3.0-or-later')
depends=(
  # 'xonotic-data'
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-curl"
  "${MINGW_PACKAGE_PREFIX}-freetype"
  "${MINGW_PACKAGE_PREFIX}-gmp"
  "${MINGW_PACKAGE_PREFIX}-libjpeg-turbo"
  "${MINGW_PACKAGE_PREFIX}-libmodplug"
  "${MINGW_PACKAGE_PREFIX}-libogg"
  "${MINGW_PACKAGE_PREFIX}-libpng"
  "${MINGW_PACKAGE_PREFIX}-libvorbis"
  "${MINGW_PACKAGE_PREFIX}-sdl2"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
)
source=("https://dl.xonotic.org/xonotic-${pkgver}-source.zip")
sha256sums=('8b92ac781cff4ae89c121a23eacd7dec05a2aabedaccc23a19d1a0958b4012a8')

