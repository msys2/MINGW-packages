# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=ExtUtils-LibBuilder
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=0.09
pkgrel=1
pkgdesc="A tool to build C libraries. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/ExtUtils-LibBuilder"
msys2_repository_url="https://github.com/ambs/ExtUtils-LibBuilder"
msys2_references=(
  'purl: pkg:cpan/AMBS/ExtUtils-LibBuilder'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
groups=("${MINGW_PACKAGE_PREFIX}-perl-modules")
depends=("${MINGW_PACKAGE_PREFIX}-perl")
makedepends=("${MINGW_PACKAGE_PREFIX}-perl-module-build")
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/A/AM/AMBS/${_perlname}-${pkgver}.tar.gz")
sha256sums=('dbfac85d015874189a704fa0a2f001d13b5a0c7d89f36c06ff32d569720a6cfb')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  PERL_MM_USE_DEFAULT=1 perl Build.PL
  ./Build
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="--prefix=" \
  ./Build install --destdir="${pkgdir}" --prefix=${MINGW_PREFIX}
}
