_realname='google-crc32c'
_pyname="${_realname//-/_}"
pkgbase="mingw-w64-python-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-python-${_realname}"
pkgver=1.8.0
pkgrel=1
pkgdesc='A python wrapper of the C library "Google CRC32C" (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/googleapis/google-cloud-python/tree/main/packages/google-crc32c'
msys2_repository_url='https://github.com/googleapis/google-cloud-python/tree/main/packages/google-crc32c'
msys2_changelog_url='https://github.com/googleapis/google-cloud-python/blob/main/packages/google-crc32c/CHANGELOG.md'
msys2_references=(
  'anitya: 84648'
  'aur: google-crc32c'
  'purl: pkg:pypi/google-crc32c'
)
license=('spdx:Apache-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
options=('!emptydirs')
source=("https://pypi.org/packages/source/${_pyname::1}/${_realname}/${_pyname}-${pkgver}.tar.gz")
sha256sums=('a428e25fb7691024de47fecfbff7ff957214da51eddded0da0ae0e0f03a2cf79')

build() {
  cp -r "${_pyname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
