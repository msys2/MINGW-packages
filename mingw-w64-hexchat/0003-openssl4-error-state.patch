OpenSSL 1.1 and newer clean up thread error state automatically. Do not
call the legacy fallback ERR_remove_state(), which OpenSSL 4 removed.

--- a/src/common/ssl.c
+++ b/src/common/ssl.c
@@ -353,7 +353,7 @@
 	/* OpenSSL handles this itself in 1.1+ and this is a no-op */
 	ERR_remove_thread_state (NULL);
 #endif
-#else
+#elif OPENSSL_VERSION_NUMBER < 0x10100000L
 	ERR_remove_state (0);
 #endif
 }
