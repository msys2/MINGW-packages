+     &     RCVCNTS, FIRST, MPI_INTEGER, MASTER,
      &     ord%COMM_PARAORD, IERR )
       END IF 
       IF (ord%MYID_PARAORD.EQ.MASTER) THEN
@@ -2333,7 +2337,7 @@
      &     MPI_INTEGER8, ord%COMM, IERR)
       CALL MUMPS_I8DEALLOC(SNDCNT, MEMCNT=MEMCNT)
       RDISPL(:) = MAXS
