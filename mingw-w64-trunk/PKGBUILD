# Maintainer: Konstantin Podsvirov <konstantin@podsvirov.su>

_realname=trunk
pkgbase="mingw-w64-${_realname}"
pkgname=(
  "${MINGW_PACKAGE_PREFIX}-${_realname}"
  "${MINGW_PACKAGE_PREFIX}-${_realname}-docs"
)
pkgver=0.22.0
pkgrel=2
pkgdesc='Build, bundle & ship your Rust WASM application to the web (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://trunkrs.dev/'
msys2_repository_url='https://github.com/trunk-rs/trunk'
msys2_references=(
  'archlinux: trunk'
  'aur:' # ignore trunk-lwt-bin'
  'purl: pkg:cargo/trunk'
)
license=('spdx:MIT OR Apache-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-openssl"
  "${MINGW_PACKAGE_PREFIX}-rust-wasm"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-mdbook"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-rust"
)
source=("${msys2_repository_url}/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz")
sha256sums=('68bb132c7f827ed40d31948432dd4175f7d16aa745f175b9321987123d9d236b')

prepare() {
  cp -r "${_realname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "build-${MSYSTEM}"

  cargo build \
    --no-default-features --features native-tls \
    --release \
    --frozen

  msg "Build documentation"
  cd "${srcdir}/build-${MSYSTEM}/guide"
  "${MINGW_PREFIX}/bin/mdbook.exe" build
}

check() {
  cd "build-${MSYSTEM}"

  cargo test \
    --no-default-features --features native-tls \
    --release \
    --frozen
}

package_trunk() {
  cd "build-${MSYSTEM}"

  install -Dm755 "target/release/${_realname}.exe" "${pkgdir}${MINGW_PREFIX}/bin/${_realname}.exe"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}

package_trunk-docs() {
  pkgdesc+=" (documentation)"
  depends=()

  mkdir -p "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}"
  cp -a "${srcdir}/build-${MSYSTEM}/guide/book/html" "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}/html"
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;

# vim:set ts=2 sw=2 et:
