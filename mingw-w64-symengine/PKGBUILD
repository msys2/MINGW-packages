# Maintainer: Dirk Stolle

_realname=symengine
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.15.0
pkgrel=1
pkgdesc="Fast symbolic manipulation library, written in C++ (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://symengine.org/'
msys2_repository_url='https://github.com/symengine/symengine'
msys2_references=(
  'archlinux: symengine'
  'gentoo: sci-libs/symengine'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-flint"
  "${MINGW_PACKAGE_PREFIX}-gmp"
  "${MINGW_PACKAGE_PREFIX}-gmp-ecm"
  "${MINGW_PACKAGE_PREFIX}-llvm-libs"
  "${MINGW_PACKAGE_PREFIX}-mpc"
  "${MINGW_PACKAGE_PREFIX}-mpfr"
  "${MINGW_PACKAGE_PREFIX}-primesieve"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-boost"
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cereal"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-llvm"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=("https://github.com/symengine/symengine/releases/download/v${pkgver}/${_realname}-${pkgver}.tar.gz")
sha256sums=('9f75f0367221abd88b9b60ef7b104b4aa1e34e99d3152c3df2bb2467bad2f04f')

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${extra_config[@]}" \
      -DBUILD_SHARED_LIBS=ON \
      -DWITH_SYMENGINE_THREAD_SAFE=ON \
      -DWITH_ARB=ON \
      -DWITH_BOOST=ON \
      -DWITH_ECM=ON \
      -DWITH_FLINT=ON \
      -DWITH_LLVM=ON \
      -DWITH_MPC=ON \
      -DWITH_MPFR=ON \
      -DWITH_PRIMESIEVE=ON \
      -DWITH_SYSTEM_CEREAL=ON \
      -S "${_realname}-${pkgver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

check() {
  cd "build-${MSYSTEM}"
  # Copy libsymengine-x.y.dll to test directories, because they depend on it, but symengine is not
  # installed yet.
  cp symengine/libsymengine-*.dll symengine/tests/basic/
  cp symengine/libsymengine-*.dll symengine/tests/cwrapper/
  cp symengine/libsymengine-*.dll symengine/tests/eval/
  cp symengine/libsymengine-*.dll symengine/tests/expression/
  cp symengine/libsymengine-*.dll symengine/tests/finitediff/
  cp symengine/libsymengine-*.dll symengine/tests/logic/
  cp symengine/libsymengine-*.dll symengine/tests/matrix/
  cp symengine/libsymengine-*.dll symengine/tests/ntheory/
  cp symengine/libsymengine-*.dll symengine/tests/polynomial/
  cp symengine/libsymengine-*.dll symengine/tests/printing/
  cp symengine/libsymengine-*.dll symengine/tests/rcp/
  cp symengine/libsymengine-*.dll symengine/utilities/matchpycpp/autogen_tests/
  cp symengine/libsymengine-*.dll symengine/utilities/matchpycpp/tests/bipartite/
  cp symengine/libsymengine-*.dll symengine/utilities/matchpycpp/tests/hopcroft_karp/

  cmake --build . --target test
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "${_realname}-${pkgver}/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
