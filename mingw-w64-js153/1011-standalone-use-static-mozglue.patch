--- a/mfbt/tests/moz.build
+++ b/mfbt/tests/moz.build
@@ -103,6 +103,11 @@
         "-wd4530",  # C++ exception handler used, but unwind semantics are not enabled
     ]
 
+# Standalone SpiderMonkey without jemalloc links mozglue statically.
+# Match its symbol declarations instead of requesting DLL imports.
+if CONFIG["JS_STANDALONE"] and not CONFIG["MOZ_MEMORY"]:
+    DEFINES["IMPL_MFBT"] = True
+
 USE_LIBS += [
     "mozglue",
 ]
