Subject: [PATCH] Migrate build script to Premake 5

---
 premake4.lua => premake5.lua | 125 ++++++++++++++++++++---------------
 1 file changed, 70 insertions(+), 55 deletions(-)
 rename premake4.lua => premake5.lua (74%)

diff --git a/premake4.lua b/premake5.lua
similarity index 74%
rename from premake4.lua
rename to premake5.lua
index 0f86168..fa3d587 100644
--- a/premake4.lua
+++ b/premake5.lua
@@ -1,10 +1,9 @@
 
 local action = _ACTION or ""
 
-solution "nanovg"
+workspace "nanovg"
 	location ( "build" )
 	configurations { "Debug", "Release" }
-	platforms {"native", "x64", "x32"}
 
    	project "nanovg"
 		language "C"
@@ -14,13 +13,15 @@ solution "nanovg"
 		targetdir("build")
 		defines { "_CRT_SECURE_NO_WARNINGS" } --,"FONS_USE_FREETYPE" } Uncomment to compile with FreeType support
 
-		configuration "Debug"
+		filter "configurations:Debug"
 			defines { "DEBUG" }
-			flags { "Symbols", "ExtraWarnings"}
+			symbols "On"
+			warnings "Extra"
 
-		configuration "Release"
+		filter "configurations:Release"
 			defines { "NDEBUG" }
-			flags { "Optimize", "ExtraWarnings"}
+			optimize "On"
+			warnings "Extra"
 
 	project "example_gl2"
 
@@ -31,26 +32,28 @@ solution "nanovg"
 		targetdir("build")
 		links { "nanovg" }
 
-		configuration { "linux" }
+		filter "system:linux"
 			 linkoptions { "`pkg-config --libs glfw3`" }
 			 links { "GL", "GLU", "m", "GLEW" }
 			 defines { "NANOVG_GLEW" }
 
-		configuration { "windows" }
+		filter "system:windows"
 			 links { "glfw3", "gdi32", "winmm", "user32", "GLEW", "glu32","opengl32", "kernel32" }
 			 defines { "NANOVG_GLEW", "_CRT_SECURE_NO_WARNINGS" }
 
-		configuration { "macosx" }
+		filter "system:macosx"
 			links { "glfw3" }
 			linkoptions { "-framework OpenGL", "-framework Cocoa", "-framework IOKit", "-framework CoreVideo", "-framework Carbon" }
 
-		configuration "Debug"
