diff -Naur ImageMagick-7.1.2-29_orig/Makefile.am ImageMagick-7.1.2-29/Makefile.am
--- ImageMagick-7.1.2-29_orig/Makefile.am	2025-01-01 00:00:00.000000000 +0000
+++ ImageMagick-7.1.2-29/Makefile.am	2025-01-01 00:00:00.000000000 +0000
@@ -239,7 +239,7 @@
 install-data-html:
 	$(mkinstalldirs) $(DESTDIR)$(pkgdocdir)
 	$(INSTALL_DATA) $(srcdir)/index.html $(DESTDIR)$(pkgdocdir)
-	@for dir in $$(find www -type d) ; do \
+	@for dir in $$(cd "$(srcdir)" && find www -type d) ; do \
	  $(mkinstalldirs) $(DESTDIR)$(pkgdocdir)/$$dir && \
	  if test -d $(builddir)/$$dir ; then \
	    docsrcdir=$(builddir)/$$dir; \
@@ -257,5 +257,5 @@
 uninstall-data-html:
 	rm -f $(DESTDIR)$(pkgdocdir)/index.html
-	for dir in $$(find www -type d) ; do \
+	for dir in $$(cd "$(srcdir)" && find www -type d) ; do \
	  rm -f -r $(DESTDIR)$(pkgdocdir)/$$dir ; \
	done
