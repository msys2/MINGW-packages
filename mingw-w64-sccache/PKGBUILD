# Contributor: Sarah Ottinger <schalaalexiazeal@gmail.com>

_realname=sccache
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.20.1
pkgrel=1
pkgdesc='Shared compilation cache (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/mozilla/sccache"
msys2_repository_url='https://github.com/mozilla/sccache'
msys2_references=(
  'anitya: 227267'
  'archlinux: sccache'
  'aur:' # ignore sccache-git
  'gentoo: dev-util/sccache'
  'purl: pkg:cargo/sccache'
)
license=('spdx:Apache-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-zstd"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-llvm-tools"
  "${MINGW_PACKAGE_PREFIX}-openssl"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-rust"
)
options=('!strip')
source=(
  "https://github.com/mozilla/sccache/archive/v$pkgver/${_realname}-${pkgver}.tar.gz"
  "zstd-sys.tar.gz::https://static.crates.io/crates/zstd-sys/2.1.2+zstd.1.5.7/download"
  "link-zstd-dynamically.patch"
)
sha256sums=('1568b19b3e9bcf911986670dbf92264100974319ddde0b1ccaeecfa82b953632'
            '481ada9c543b2323cbb7bbdbb5249177fbf0188ed959ed2c15e4b22421c84ed3'
            '48f4900ceb02d3aaf9a1020f33d56629156e96759f456c0e7ca18bfcf910767b')

_env() {
  export OPENSSL_NO_VENDOR=1
  export PKG_CONFIG_ALL_DYNAMIC=1
  export ZSTD_SYS_USE_PKG_CONFIG=1
  export WINAPI_NO_BUNDLED_LIBRARIES=1
}

prepare() {
  cd "${_realname}-${pkgver}"

  patch -d ../zstd-sys-2.1.2+zstd.1.5.7 -i ../link-zstd-dynamically.patch
  cat >> Cargo.toml <<END

[patch.crates-io]
zstd-sys.path = "../zstd-sys-2.1.2+zstd.1.5.7"
END

  cargo update -p zstd-sys
  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${_realname}-${pkgver}"

  # build PGO-optimized sccache
  _env
  sh scripts/build-pgo.sh --llvm-profdata "${MINGW_PREFIX}/bin/llvm-profdata.exe"
}

check() {
  cd "${_realname}-${pkgver}"

  _env
  cargo test --frozen
}

package() {
  cd "${_realname}-${pkgver}"

  install -Dm755 target/${_realname}-pgo/${RUST_CHOST}/release/${_realname} \
    -t "${pkgdir}${MINGW_PREFIX}/bin"
  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
