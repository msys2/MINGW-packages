# Contributor: Teemu Nätkinniemi ("teepean") <tnatkinn@gmail.com>

_realname=samtools
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
# update together with bcftools, htslib
pkgver=1.25
pkgrel=1
pkgdesc="tools for manipulating next-generation sequencing data"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://www.htslib.org/"
msys2_repository_url='https://github.com/samtools/samtools'
msys2_references=(
  'anitya: 4759'
  'aur: samtools'
  'gentoo: sci-biology/samtools'
)
license=('custom')
depends=(
  "${MINGW_PACKAGE_PREFIX}-bzip2"
  "${MINGW_PACKAGE_PREFIX}-htslib"
  "${MINGW_PACKAGE_PREFIX}-libdeflate"
  "${MINGW_PACKAGE_PREFIX}-ncurses"
  "${MINGW_PACKAGE_PREFIX}-xz"
  "${MINGW_PACKAGE_PREFIX}-zlib"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-cc"
)
source=("https://github.com/samtools/samtools/releases/download/${pkgver}/${_realname}-${pkgver}.tar.bz2")
sha256sums=('8bbd2b3cb447953149a74ab0b00e3ec4e88a789a27b8373a31fa6b5b2dee02b1')

prepare() {
  cd "${_realname}-${pkgver}"

  # prevent shipped htslib to be used
  rm -rf "htslib-${pkgver}" || exit 1
}

build() {
  cd "${_realname}-${pkgver}"

  ./configure \
    --prefix=${MINGW_PREFIX} \
    --build=${MINGW_CHOST} \
    --host=${MINGW_CHOST} \
    --target=${MINGW_CHOST} \
    --with-htslib=system

  make
}

check() {
  cd "${_realname}-${pkgver}"

  make check || warning "Tests failed"
}

package() {
  cd "${_realname}-${pkgver}"

  make DESTDIR="${pkgdir}" install

  install -d "${pkgdir}${MINGW_PREFIX}/include/bam"
  install -Dm644 *.h "${pkgdir}${MINGW_PREFIX}/include/bam"

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
