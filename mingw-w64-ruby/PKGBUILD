## End of updpkgprovs modifications
source=("https://cache.ruby-lang.org/pub/ruby/${pkgver%.*}/${_realname}-${pkgver}.tar.xz")
sha256sums=('9c9d121fe3314ea7c801e690b9de981d2b9d12d7849db99c27482468a541ba0a')

prepare() {
  cd ${_realname}-${pkgver}
  autoreconf -fi
}

build() {
  mkdir -p build-${MSYSTEM} && cd build-${MSYSTEM}

  ../${_realname}-${pkgver}/configure \
    --prefix=${MINGW_PREFIX} \
    --disable-install-doc \
    --without-baseruby \
    --with-setjmp-type=setjmp

  make
}

check() {
  cd build-${MSYSTEM}
  make test
}

package() {
  cd build-${MSYSTEM}
  make DESTDIR="${pkgdir}${MINGW_PREFIX}" install-nodoc

  install -Dm755 "${srcdir}"/${_realname}-${pkgver}/bin/gem "${pkgdir}"${MINGW_PREFIX}/bin/gem

  install -Dm644 "${srcdir}"/${_realname}-${pkgver}/COPYING "${pkgdir}${MINGW_PREFIX}/share/licenses/ruby/LICENSE"
  install -Dm644 "${srcdir}"/${_realname}-${pkgver}/BSDL "${pkgdir}${MINGW_PREFIX}/share/licenses/ruby/BSDL"
}
