# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=File-HomeDir
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=1.006
pkgrel=1
pkgdesc="Find your home and other directories on any platform. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/File-HomeDir"
msys2_repository_url="https://github.com/perl5-utils/File-HomeDir"
msys2_references=(
  'purl: pkg:cpan/REHSACK/File-HomeDir'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-perl"
         "${MINGW_PACKAGE_PREFIX}-perl-file-which")
makedepends=("${MINGW_PACKAGE_PREFIX}-make")
source=("https://cpan.metacpan.org/authors/id/R/RE/REHSACK/${_perlname}-${pkgver}.tar.gz")
sha256sums=('593737c62df0f6dab5d4122e0b4476417945bb6262c33eedc009665ef1548852')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  mingw32-make DESTDIR="${pkgdir}/" install
  install -Dm644 LICENSE "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE
}
