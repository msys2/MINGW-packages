# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=Authen-SASL
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=2.2000
pkgrel=1
pkgdesc="SASL Authentication framework. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/Authen-SASL"
msys2_repository_url="https://github.com/perl-authen-sasl/perl-authen-sasl"
msys2_references=(
  'purl: pkg:cpan/EHUELS/Authen-SASL'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-perl")
makedepends=("${MINGW_PACKAGE_PREFIX}-make")
source=("https://cpan.metacpan.org/authors/id/E/EH/EHUELS/${_perlname}-${pkgver}.tar.gz")
sha256sums=('8cdf5a7f185448b614471675dae5b26f8c6e330b62264c3ff5d91172d6889b99')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
  install -Dm644 LICENSE "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE
}
