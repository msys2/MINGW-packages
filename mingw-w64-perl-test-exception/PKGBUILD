# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=Test-Exception
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=0.43
pkgrel=2
pkgdesc="Test exception-based code (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/Test-Exception"
msys2_repository_url="https://github.com/Test-More/test-exception"
msys2_references=(
  'purl: pkg:cpan/EXODIST/Test-Exception'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-perl"
         "${MINGW_PACKAGE_PREFIX}-perl-sub-uplevel")
makedepends=("${MINGW_PACKAGE_PREFIX}-make")
source=("https://cpan.metacpan.org/authors/id/E/EX/EXODIST/${_perlname}-${pkgver}.tar.gz")
sha256sums=('156b13f07764f766d8b45a43728f2439af81a3512625438deab783b7883eb533')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
}
