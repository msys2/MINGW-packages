# Maintainer: luadebug lin@sz.cn.eu.org

_realname=tdlib
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.8.68
pkgrel=1
_commit=c15d3f5a5de6e3ba5839822c451152e5e18bb700
pkgdesc="Telegram client library and command-line client (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://core.telegram.org/tdlib'
msys2_repository_url='https://github.com/tdlib/td'
msys2_references=('purl: pkg:github/tdlib/td')
# GNU Readline is linked only by tg_cli; the libraries retain their upstream licenses.
license=('spdx:BSL-1.0' 'spdx:BSD-3-Clause' 'spdx:GPL-3.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs"
         "${MINGW_PACKAGE_PREFIX}-openssl"
         "${MINGW_PACKAGE_PREFIX}-readline"
         "${MINGW_PACKAGE_PREFIX}-zlib")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-gperf")
source=("${_realname}-${pkgver}.tar.gz::https://github.com/tdlib/td/archive/${_commit}.tar.gz"
        '001-relocatable-dependencies.patch'
        '002-preserve-mingw-attributes.patch'
        '003-coff-linker-flags.patch'
        '004-package-cli.patch')
sha256sums=('59602db556c42fce6b08144946ed71660e0915018f7a950d9e75db2a883e6215'
            '166afe19fdee6b3bcb982f16af4e62aff55be6f25693920821fa109a0e65af2d'
            'c07e61d3f0ed9186bf130c0123d7d761e00697cd5645f2fb65d90503043a420a'
            '31e55b9493454c593b671893cfa771e50748379fdb542392e8e62229b30e85f9'
            '50b046f703baeb03a7c27ae9f5e6d3ea78ad534c538633daa769b7badc3f8a32')

prepare() {
  cd "td-${_commit}"
  # Imported targets supply dependency include paths and relocatable link metadata.
  patch -Np1 -i "${srcdir}/001-relocatable-dependencies.patch"
  # Preserve GNU always_inline attributes required by fortified MinGW headers.
  patch -Np1 -i "${srcdir}/002-preserve-mingw-attributes.patch"
  # LLD's COFF linker does not support --exclude-libs.
  patch -Np1 -i "${srcdir}/003-coff-linker-flags.patch"
  patch -Np1 -i "${srcdir}/004-package-cli.patch"
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=('-DCMAKE_BUILD_TYPE=Release')
  else
    extra_config+=('-DCMAKE_BUILD_TYPE=Debug')
  fi

  if check_option "lto" "n"; then
    extra_config+=('-DTD_ENABLE_LTO=OFF')
  else
    extra_config+=('-DTD_ENABLE_LTO=ON')
  fi

  MSYS2_ARG_CONV_EXCL='-DCMAKE_INSTALL_PREFIX=' \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${extra_config[@]}" \
      -DTD_INSTALL_SHARED_LIBRARIES=ON \
      -DTD_INSTALL_STATIC_LIBRARIES=ON \
      -DTD_GENERATE_SOURCE_FILES=OFF \
      -DTD_ENABLE_JNI=OFF \
      -DTD_ENABLE_DOTNET=OFF \
      -DTD_E2E_ONLY=OFF \
      -DBUILD_TESTING=OFF \
      -DPHP_EXECUTABLE=OFF \
      -S "${srcdir}/td-${_commit}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "td-${_commit}/LICENSE_1_0.txt" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE_1_0.txt"
  install -Dm644 "td-${_commit}/sqlite/sqlite/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/SQLCipher-LICENSE"
  install -Dm644 "${MINGW_PREFIX}/share/licenses/readline/COPYING" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/tg_cli-GPL-3.0.txt"
}
