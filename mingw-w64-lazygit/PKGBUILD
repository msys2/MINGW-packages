_realname='lazygit'
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver='0.64.1'
pkgrel=2
pkgdesc='Simple terminal UI for git commands (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/jesseduffield/lazygit'
msys2_repository_url='https://github.com/jesseduffield/lazygit'
msys2_references=(
	'archlinux: lazygit'
)
license=('spdx:MIT')
optdepends=('git' "${MINGW_PACKAGE_PREFIX}-git")
makedepends=(
	"${MINGW_PACKAGE_PREFIX}-go"
	"${MINGW_PACKAGE_PREFIX}-cc"
)
source=(
	"${_realname}-${pkgver}.tar.gz::https://github.com/jesseduffield/lazygit/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
	'support-cygwin-git.patch::https://github.com/jesseduffield/lazygit/pull/5984.patch'
)
noextract=("${_realname}-${pkgver}.tar.gz")
sha256sums=('b1df6ee72f17efc0ef95fc20a64821cd9eda3935b81cb98b1719c8266163bd07'
            'f08a202b36af26a7a329fdc6b145a80058b00d63e74bbb6b263a7d0c560ce9e9')

prepare() {
	bsdtar -xf "${_realname}-${pkgver}.tar.gz" || bsdtar -xf "${_realname}-${pkgver}.tar.gz"

	cd "${_realname}-${pkgver}"

	patch -Np1 -i "${srcdir}/support-cygwin-git.patch"
}

build() {
	cd "${_realname}-${pkgver}"

	export CGO_CPPFLAGS="${CPPFLAGS}"
	export CGO_CFLAGS="${CFLAGS}"
	export CGO_CXXFLAGS="${CXXFLAGS}"
	export GOFLAGS='-buildmode=pie -trimpath -mod=readonly -modcacherw -x -v'

	go build \
		-ldflags "\
			-linkmode external \
			-extldflags '${LDFLAGS}' \
			-X main.date=$(date --date=@${SOURCE_DATE_EPOCH} -u +%Y-%m-%dT%H:%M-%SZ) \
			-X main.buildSource=binaryRelease \
			-X main.version=${pkgver} \
			-X main.commit=v${pkgver} \
		"
}

package() {
	cd "${_realname}-${pkgver}"

	install -Dm755 lazygit.exe -t "${pkgdir}${MINGW_PREFIX}/bin"
	install -Dm644 README*.md -t "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}"
	cp -r docs/* -t "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}"
	install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
