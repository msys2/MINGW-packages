# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=MIME-Charset
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=1.013.1
pkgrel=1
pkgdesc="Charset Information for MIME. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/MIME-Charset"
msys2_repository_url="https://github.com/hatukanezumi/MIME-Charset"
msys2_references=(
  'purl: pkg:cpan/NEZUMI/MIME-Charset'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
groups=("${MINGW_PACKAGE_PREFIX}-perl-modules")
depends=("${MINGW_PACKAGE_PREFIX}-perl")
makedepends=("${MINGW_PACKAGE_PREFIX}-make")
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/N/NE/NEZUMI/${_perlname}-${pkgver}.tar.gz")
sha256sums=('1bb7a6e0c0d251f23d6e60bf84c9adefc5b74eec58475bfee4d39107e60870f0')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
  PERL_AUTOINSTALL=--skipdeps \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
  install -Dm644 ARTISTIC -t "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/
  install -Dm644 COPYING -t "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/
}
