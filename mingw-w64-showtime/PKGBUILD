# Maintainer: tling <tling0001@mymail.lausd.net>

_realname=showtime
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=50.0
pkgrel=1
pkgdesc="A distraction-free video player for GNOME (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://gitlab.gnome.org/GNOME/showtime"
msys2_repository_url="https://gitlab.gnome.org/GNOME/showtime"
msys2_references=(
  "archlinux: showtime"
)
license=('spdx:GPL-3.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-gettext-runtime"
         "${MINGW_PACKAGE_PREFIX}-glib2"
         "${MINGW_PACKAGE_PREFIX}-gstreamer"
         "${MINGW_PACKAGE_PREFIX}-gst-plugin-gtk"
         "${MINGW_PACKAGE_PREFIX}-gst-plugins-base"
         "${MINGW_PACKAGE_PREFIX}-gtk4"
         "${MINGW_PACKAGE_PREFIX}-hicolor-icon-theme"
         "${MINGW_PACKAGE_PREFIX}-libadwaita"
         "${MINGW_PACKAGE_PREFIX}-python"
         "${MINGW_PACKAGE_PREFIX}-python-gobject")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-meson"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-pkgconf"
             "${MINGW_PACKAGE_PREFIX}-blueprint-compiler"
             "${MINGW_PACKAGE_PREFIX}-gettext-tools"
             "${MINGW_PACKAGE_PREFIX}-appstream-glib"
                 "${MINGW_PACKAGE_PREFIX}-desktop-file-utils"
                 "${MINGW_PACKAGE_PREFIX}-icoutils"
                 "${MINGW_PACKAGE_PREFIX}-librsvg")
source=(https://download.gnome.org/sources/${_realname}/${pkgver%.*}/${_realname}-${pkgver}.tar.xz
        0001-disable-dbus-service-on-windows.patch
  0002-no-console.patch
            showtime-launcher.c
            showtime.rc)
sha256sums=('4399c9fa7f61e5984242e279acd1519beec246b98a676d44a4b2ab94e9eecb01'
            '36afa5f977a1bccf21b681e430f7ae393cf69120e4e550a10d22a14657b98141'
            '1b92ce2d4266174ca875c67e956947a14d51aed442c128fb99b1892bd2fac256'
                'ab248f000d2db552b9e301c8237f0b9ff8365abd95beaba4eb6c0621110fdd9b'
                '7a921b57662080710cebfd97c3a8b6969a80e47d62d40c5b8795dcb8e8808abe')
noextract=(${_realname}-${pkgver}.tar.xz)

prepare() {
  tar -xJf "${srcdir}/${_realname}-${pkgver}.tar.xz" \
    --exclude="${_realname}-${pkgver}/showtime/__init__.py"
  cd "${srcdir}/${_realname}-${pkgver}"
  patch -Np1 -i "${srcdir}/0001-disable-dbus-service-on-windows.patch"
  patch -Np1 -i "${srcdir}/0002-no-console.patch"
}

build() {
  mkdir -p build-${MSYSTEM} && cd build-${MSYSTEM}

  MSYS2_ARG_CONV_EXCL="--prefix=" \
  meson setup \
    --prefix="${MINGW_PREFIX}" \
    --wrap-mode=nodownload \
    --buildtype=plain \
    -Dprofile=release \
    "../${_realname}-${pkgver}"

  meson compile

  rsvg-convert -w 16 -h 16 -o showtime-16.png \
    "${srcdir}/${_realname}-${pkgver}/data/icons/hicolor/scalable/apps/org.gnome.Showtime.svg"
  rsvg-convert -w 32 -h 32 -o showtime-32.png \
    "${srcdir}/${_realname}-${pkgver}/data/icons/hicolor/scalable/apps/org.gnome.Showtime.svg"
  rsvg-convert -w 48 -h 48 -o showtime-48.png \
    "${srcdir}/${_realname}-${pkgver}/data/icons/hicolor/scalable/apps/org.gnome.Showtime.svg"
  icotool -c -o showtime.ico showtime-16.png showtime-32.png showtime-48.png
  windres "${srcdir}/showtime.rc" -O coff -o showtime-res.o

  ${MINGW_PREFIX}/bin/gcc.exe \
    -municode \
    -mwindows \
    -O2 \
    -o showtime.exe \
    "${srcdir}/showtime-launcher.c" \
    showtime-res.o
}

package() {
  cd "${srcdir}/build-${MSYSTEM}"
  DESTDIR="${pkgdir}" meson install
  install -Dm755 showtime.exe "${pkgdir}${MINGW_PREFIX}/bin/showtime.exe"

  install -Dm644 "${srcdir}/${_realname}-${pkgver}/COPYING" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYING"
}
