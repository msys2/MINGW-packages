

_realname=innex
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.6.0
pkgrel=2
pkgdesc="Extract Inno Setup installers (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/russellbanks/inno"
msys2_repository_url="${url}"
msys2_references=(
)
license=('spdx:Apache-2.0 OR MIT')
depends=("${MINGW_PACKAGE_PREFIX}-zlib")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-rust"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
)
source=("${url}/archive/refs/tags/v${pkgver}.tar.gz"
"https://github.com/rust-lang/libz-sys/archive/refs/tags/1.1.29.tar.gz")
sha256sums=('7970ae4b6278ef737ed9a61f5c791829102fee81ec3b4b67cf593d0785f2ff7e'
            'e9f4f7c491d03e8637bac076b9489f785f5d6ac00d198e83521123e388d96543')

prepare() {
  cd "inno-${pkgver}"
  sed -i "s/pc-windows-gnu/use-system-zlib/" ../libz-sys-1.1.29/build.rs
  cat >> Cargo.toml <<END

[patch.crates-io]
libz-sys.path = "../libz-sys-1.1.29"
END
  cargo update -p libz-sys
  cargo fetch --locked --target "${RUST_CHOST}"
}

build(){
  cd "inno-$pkgver"
  export LIBZ_SYS_STATIC=0
  cargo build --release --frozen
}

package() {
  cd "inno-$pkgver"
  install -Dm755 "target/release/${_realname}" -t "${pkgdir}${MINGW_PREFIX}/bin"
  install -Dm644 LICENSE-{APACHE,MIT}.md -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
