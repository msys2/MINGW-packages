

_realname=innex
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.7.5
pkgrel=1
pkgdesc="Extract Inno Setup installers (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/russellbanks/inno"
msys2_repository_url="${url}"
msys2_references=(
)
license=('spdx:Apache-2.0 OR MIT')
makedepends=("${MINGW_PACKAGE_PREFIX}-rust")
source=("${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('8152104ff6fd2cd5f50bd5d33b78fd3265705f67849fd510aebe814833235286')

prepare() {
  cd "inno-${pkgver}"/core
  # upstream does not want to use fast backend by default since it is a library crate...
  cargo remove flate2
  cargo add flate2 --no-default-features --features zlib-rs
  cd ..
  cargo fetch --locked --target "${RUST_CHOST}"
}

build(){
  cd "inno-$pkgver"

  cargo build --release --frozen
}

package() {
  cd "inno-$pkgver"
  install -Dm755 "target/release/${_realname}" -t "${pkgdir}${MINGW_PREFIX}/bin"
  install -Dm644 LICENSE-{APACHE,MIT}.md -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
