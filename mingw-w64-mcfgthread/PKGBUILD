# Maintainer: LH_Mouse <lh_mouse@126.com>

_realname=mcfgthread
pkgbase=mingw-w64-${_realname}
pkgname=(
  "${MINGW_PACKAGE_PREFIX}-${_realname}"
  "${MINGW_PACKAGE_PREFIX}-${_realname}-libs"
)
_pkgver=2.5-ga.2
pkgver=${_pkgver/-ga}
pkgrel=1
pkgdesc="An efficient gthread implementation, providing C++11 threading support (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://github.com/lhmouse/mcfgthread'
msys2_repository_url="${url}"
msys2_references=(
  'purl: pkg:github/lhmouse/mcfgthread'
)
license=('spdx:LGPL-3.0-or-later WITH GCC-exception-3.1')
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-meson"
)
source=("${url}/archive/refs/tags/v${_pkgver}.tar.gz")
sha256sums=('7d7b78d21e9680eec939c01fe6c28ba5b86e0922009947d2530f34c9cef98796')

build() {
  # Once-initialization routines do support SEH.
  # test/c11_call_once_unwind_seh.c depends on it.
  LDFLAGS+=' -Wl,--disable-no-seh'

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    meson setup \
      --prefix="${MINGW_PREFIX}" \
      --buildtype=plain \
      "build-${MSYSTEM}" \
      "${_realname}-${_pkgver}"

  meson compile -C "build-${MSYSTEM}"
}

check() {
  meson test -C "build-${MSYSTEM}"
}

package_mcfgthread() {
  pkgdesc+=" (devel)"
  depends=("${MINGW_PACKAGE_PREFIX}-${_realname}-libs=${pkgver}")

  DESTDIR="${pkgdir}" meson install -C "build-${MSYSTEM}" --tags devel
}

package_mcfgthread-libs() {
  pkgdesc+=" (libs)"

  DESTDIR="${pkgdir}" meson install -C "build-${MSYSTEM}" --tags runtime
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
