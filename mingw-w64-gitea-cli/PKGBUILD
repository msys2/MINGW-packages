# Maintainer: Konstantin Podsvirov <konstantin@podsvirov.su>

_realname=gitea-cli
_binname=gt
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.2.0
pkgrel=1
pkgdesc='Official Gitea CLI (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://gitea.com/gitea/cli'
msys2_references=(
  'anitya: 377482'
  'archlinux: tea'
  'aur: gitea-tea-git'
  'gentoo: dev-util/tea'
  'purl: pkg:golang/code.gitea.io/tea'
)
license=('spdx:MIT')
makedepends=("${MINGW_PACKAGE_PREFIX}-go" "${MINGW_PACKAGE_PREFIX}-cc" "git")
optdepends=("${MINGW_PACKAGE_PREFIX}-git: To interact with repositories")
provides=("${MINGW_PACKAGE_PREFIX}-tea")
replaces=("${MINGW_PACKAGE_PREFIX}-tea")
options=('!strip')
source=("$_realname-$pkgver.tar.gz::${url}/archive/v${pkgver}.tar.gz")
sha256sums=('09854deee075d10d1930131c1acb9d3e1f035627bbdad729d4c994410e90b433')

build() {
  [[ -d "${srcdir}/build-${MSYSTEM}" ]] && rm -rf "${srcdir}/build-${MSYSTEM}"
  cp -r "${srcdir}/cli" "${srcdir}/build-${MSYSTEM}"
  cd "${srcdir}/build-${MSYSTEM}" && mkdir build

  export GOOS=windows
  export GOROOT=${MINGW_PREFIX}/lib/go
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GO_LDFLAGS="-s -w"
  case "${CARCH}" in
    i686|x86_64)
      GOFLAGS+=" -buildmode=pie"
      ;;
  esac

  ${MINGW_PREFIX}/bin/go build -v \
    -trimpath \
    -mod=readonly \
    -modcacherw \
    -ldflags "-linkmode=external -compressdwarf=false -X gitea.dev/cli/internal/version.Version=${pkgver}" \
    -o build \
    ./cmd/...
}

package() {
  cd "${srcdir}/build-${MSYSTEM}"

  install -Dm755 "build/${_binname}.exe" "${pkgdir}${MINGW_PREFIX}/bin/${_binname}.exe"

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
  install -Dm644 README.md "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}/README.md"

  local _complete="${pkgdir}${MINGW_PREFIX}/bin/${_binname} completion"
  $_complete bash | install -Dm644 /dev/stdin "${pkgdir}${MINGW_PREFIX}/share/bash-completion/completions/${_binname}"
  $_complete zsh | install -Dm644 /dev/stdin "${pkgdir}${MINGW_PREFIX}/share/zsh/site-functions/_${_binname}"
  $_complete fish | install -Dm644 /dev/stdin "${pkgdir}${MINGW_PREFIX}/share/fish/vendor_completions.d/${_binname}.fish"
}
