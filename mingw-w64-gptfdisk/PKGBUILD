# Maintainer: Bin Meng <bmeng.cn@gmail.com>

_realname=gptfdisk
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=1.0.9
pkgrel=1
pkgdesc="A text-mode partitioning tool that works on GUID Partition Table (GPT) disks (mingw-w64)"
arch=('x86_64')
mingw_arch=('mingw64' 'ucrt64')
url="https://www.rodsbooks.com/gdisk/"
license=('spdx:GPL-2.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-popt"
)
makedepends=("${MINGW_PACKAGE_PREFIX}-cc")
source=("https://downloads.sourceforge.net/project/${_realname}/${_realname}/$pkgver/${_realname}-$pkgver.tar.gz"
        '0001-fix-makefile.patch'
        '0002-fix-mingw.patch')
sha256sums=('dafead2693faeb8e8b97832b23407f6ed5b3219bc1784f482dd855774e2d50c2'
            '99492b9a5aef0607c27be53ebdf079eeb89f19979b79107650d93c9c62ca2f3d'
            'c1afcee5c034e80d4cc96ca4856aa174f32f40dc9aec7804ed353b8d94fef769')

prepare() {
  cd "${_realname}-${pkgver}"
  patch -Nbp1 -i "${srcdir}/0001-fix-makefile.patch"
  patch -Nbp1 -i "${srcdir}/0002-fix-mingw.patch"
}

build() {
  cd "${_realname}-${pkgver}"
  make -f Makefile.mingw64
}

package() {
  cd "${_realname}-${pkgver}"
  install -d "${pkgdir}${MINGW_PREFIX}"/{bin,share/{doc/gdisk,man/man8}}
  install -t "${pkgdir}${MINGW_PREFIX}/bin" {,s}gdisk.exe fixparts.exe
  install -m644 -t "${pkgdir}${MINGW_PREFIX}/share/man/man8" {{,s}gdisk,fixparts}.8
  install -m644 -t "${pkgdir}${MINGW_PREFIX}/share/doc/gdisk" README NEWS
}
