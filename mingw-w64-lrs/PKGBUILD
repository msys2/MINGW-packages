# Maintainer: Dirk Stolle

_realname=lrs
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=073.a
_pkgver=${pkgver/./}
pkgrel=1
pkgdesc="Reverse search algorithm for vertex enumeration/convex hull problems (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://cgm.cs.mcgill.ca/~avis/C/lrs.html'
msys2_references=(
  'anitya: 7718'
  'archlinux: lrs'
  'gentoo: sci-libs/lrslib'
)
license=('spdx:GPL-2.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-gmp"
  "${MINGW_PACKAGE_PREFIX}-omp"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-cc"
)
source=(
  "http://cgm.cs.mcgill.ca/~avis/C/lrslib/archive/lrslib-${_pkgver}.tar.gz"
  "0001-lrs-system-cflags.patch"
  "0002-cflags.patch"
  "0003-soname-dll.patch"
)
noextract=("lrslib-${_pkgver}.tar.gz")
sha256sums=('7fb16ad5c2b7380ef8deaecbfaf53599eef074fd225012aa431b76ee0bded6a6'
            'e3a2b1713d9a381ff72ca627ff0c70acc9bfbce9a8b60e743a03147e9e8b8f0d'
            'f1e551096faff1e1b7b3b4ab8796b70b7178bfd414ea2fc682aef1e033b43ec5'
            '6a0f9e214243a4f82c36ec057d981a66a0ef84157ffbf5e6d93a960591b44ad6')

prepare() {
  bsdtar -xf "lrslib-${_pkgver}.tar.gz" 2>/dev/null || bsdtar -xf "lrslib-${_pkgver}.tar.gz"

  cd "lrslib-${_pkgver}"

  patch -Np1 -i ../0001-lrs-system-cflags.patch
  patch -Np1 -i ../0002-cflags.patch
  patch -Np1 -i ../0003-soname-dll.patch
}

build() {
  cd "lrslib-${_pkgver}"

  make
}

package() {
  cd "lrslib-${_pkgver}"

  DESTDIR="${pkgdir}" make install prefix="${MINGW_PREFIX}"

  # move shared library + cleanup
  mv "${pkgdir}${MINGW_PREFIX}/lib/"*.dll "${pkgdir}${MINGW_PREFIX}/bin/"
  rmdir "${pkgdir}${MINGW_PREFIX}/lib"

  # license file
  install -Dm644 COPYING "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
