# Maintainer: Bjoern Lemke <lemke@lemke-it.com>

_realname=lfcbase
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.23.7
pkgrel=1
pkgdesc="LFC C++ base classes (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://www.lemke-it.com/'
msys2_references=(
  'anitya: 1551'
)
license=('spdx:GPL-3.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-libwinpthread"
  "${MINGW_PACKAGE_PREFIX}-ncurses"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-cc"
)
source=(
  "https://www.lemke-it.com/${_realname}-${pkgver}.tar.bz2"
  '0001-fix-mingw-build.patch'
)
sha256sums=('23b30e37e6ec5b816749ced57a76f241a9713943a5a54b268732311d7b1d0e2e'
            '2d210ba45433a7245b6324d41c12d21a8ee4414588520453873445ac5f040e0d')

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"

  # Strip Windows carriage returns from test program output for the TAP driver
  sed -i "s/LC_ALL=C/sed 's\/\\\\r\/\/g' | LC_ALL=C/" build-aux/tap-driver.sh

  patch -Np1 -i "${srcdir}/0001-fix-mingw-build.patch"
}

build() {
  mkdir -p "${srcdir}/build-${MSYSTEM}" && cd "${srcdir}/build-${MSYSTEM}"

  CPPFLAGS+=" -DHAVE_MINGW"
  CXXFLAGS+=" -DLFCNOCURSES -DDISABLE_SYSLOG"

  ../${_realname}-${pkgver}/configure \
    --prefix=${MINGW_PREFIX} \
    --build=${MINGW_CHOST} \
    --host=${MINGW_CHOST} \
    --target=${MINGW_CHOST} \
    --enable-static \
    --enable-shared

  make

  ${CXX} -shared \
    -Wl,--out-implib,liblfcbase.dll.a \
    -o liblfcbase-0.dll \
    "${srcdir}"/build-${MSYSTEM}/src/*.o \
    -lsystre -lws2_32 -lpthread
}

check() {
  cd "${srcdir}/build-${MSYSTEM}"

  make check
}

package() {
  cd "${srcdir}/build-${MSYSTEM}"

  make install DESTDIR="${pkgdir}"

  mkdir -p "${pkgdir}"${MINGW_PREFIX}/{bin,lib}
  install -m 0755 liblfcbase-0.dll "${pkgdir}${MINGW_PREFIX}/bin"
  install -m 0644 liblfcbase.dll.a "${pkgdir}${MINGW_PREFIX}/lib"
}
