--- a/src/Datetime.cc
+++ b/src/Datetime.cc
@@ -23,6 +23,23 @@
 #include <time.h>
 #include <stdlib.h>
 
+#ifndef HAVE_STRPTIME
+#include <sstream>
+#include <iomanip>
+static char* strptime(const char* s, const char* f, struct tm* tm)
+{
+    std::istringstream input(s);
+    input.imbue(std::locale::classic());
+    input >> std::get_time(tm, f);
+    if (input.fail())
+    {
+        return nullptr;
+    }
+    auto pos = input.tellg();
+    return const_cast<char*>(s + (pos >= 0 ? static_cast<std::ptrdiff_t>(pos) : 0));
+}
+#endif
+
