# Maintainer: Andrea Zagli <andrea.zagli.free@gmail.com>

_realname='gplugin'
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.44.2
pkgrel=1
pkgdesc='A GObject based library that implements a reusable plugin system (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://keep.imfreedom.org/gplugin/gplugin'
msys2_repository_url='https://keep.imfreedom.org/gplugin/gplugin'
msys2_references=(
  'anitya: 12812'
  'aur: gplugin'
)
license=('spdx:LGPL-2.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-gettext-runtime"
  "${MINGW_PACKAGE_PREFIX}-glib2"
  "${MINGW_PACKAGE_PREFIX}-gtk4"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-gettext"
  "${MINGW_PACKAGE_PREFIX}-gi-docgen"
  "${MINGW_PACKAGE_PREFIX}-gobject-introspection"
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-vala"
)
source=(
  "${_realname}-${pkgver}.tar.gz::https://keep.imfreedom.org/${_realname}/${_realname}/archive/v${pkgver}.tar.gz"
  '001-win.patch'
)
sha256sums=('033d196c4c520b6d5c5eb02307795094937872eafe4a4aa1ff8a46a57f560b29'
            '86963a0347d36ac1e1d9b6ae09bd0da808fb608973df3864781a4ecc8c770682')

prepare() {
  cd "${_realname}-v${pkgver}"

  patch -Np1 -i "${srcdir}/001-win.patch"
}

build() {
  local _meson_options=(
    --prefix="${MINGW_PREFIX}"
    --buildtype=plain
    -D gtk4=enabled
    -D gplugin-introspection=true
    -D lua=false
    -D python3=false
    -D help2man=false
  )

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    meson setup \
    "${_meson_options[@]}" \
    "build-${MSYSTEM}" \
    "${_realname}-v${pkgver}"

  # fixes unknown introspectable.dll
  export PATH="${srcdir}/build-${MSYSTEM}/gplugin:${PATH}"

  meson compile -C "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" meson install -C "build-${MSYSTEM}"

  cd "${_realname}-v${pkgver}"

  install -Dm644 COPYING -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
