# Maintainer: Glarboy <Nahida1027@aliyun.com>

_realname=libsixel
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver='1.8.7_r2'
pkgrel=1
pkgdesc="A lightweight, fast implementation of DEC SIXEL graphics codec (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/saitoha/libsixel"
msys2_changelog_url='https://github.com/saitoha/libsixel/blob/master/ChangeLog'
msys2_repository_url='https://github.com/saitoha/libsixel'
msys2_references=(
  'archlinux: libsixel'
  'gentoo: media-libs/libsixel'
)
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-libwinpthread"
         "${MINGW_PACKAGE_PREFIX}-curl"
         "${MINGW_PACKAGE_PREFIX}-libpng"
         "${MINGW_PACKAGE_PREFIX}-libjpeg-turbo")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-pkgconf"
             "${MINGW_PACKAGE_PREFIX}-make"
             "${MINGW_PACKAGE_PREFIX}-curl"
             "${MINGW_PACKAGE_PREFIX}-winpthreads"
             "${MINGW_PACKAGE_PREFIX}-libjpeg-turbo"
             "${MINGW_PACKAGE_PREFIX}-libpng")
source=("https://github.com/saitoha/libsixel/archive/v${pkgver//_/-}/v${pkgver//_/-}.tar.gz")
sha256sums=('1b083d1d4e53b0017ca3b63d43207ce70001dd229d856a72f4f953c6958a1f0e')

#prepare() {}

build() {
  cd "${_realname}-${pkgver//_/-}"

  ./configure \
    --prefix="${MINGW_PREFIX}" \
    --build="${MINGW_CHOST}" \
    --host="${MINGW_CHOST}" \
    --target="${MINGW_CHOST}" \
    --enable-python=no

  mingw32-make
}

check() {
  cd "${_realname}-${pkgver//_/-}"
  ./configure \
    --prefix="${MINGW_PREFIX}" \
    --build="${MINGW_CHOST}" \
    --host="${MINGW_CHOST}" \
    --target="${MINGW_CHOST}" \
    --enable-tests \
    --enable-python=no
  mingw32-make test
  # loader.c:1601:31: error: use of undeclared identifier 'allocator'
}

package() {
  cd "${_realname}-${pkgver//_/-}"
  mingw32-make install DESTDIR="${pkgdir}"

  install -Dm644 ../"${_realname}-${pkgver//_/-}"/LICENSE* \
    -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
