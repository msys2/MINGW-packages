# Contributor: Dirk Stolle

_realname=pari-seadata
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=20090618
pkgrel=1
pkgdesc="PARI database needed by ellap for large primes (mingw-w64)"
arch=('any')
# Currently pari is available for UCRT64 only, and so is this packages.
mingw_arch=('ucrt64') # 'clang64' 'clangarm64'
url='https://pari.math.u-bordeaux.fr/'
msys2_references=(
  'archlinux: pari-seadata'
)
license=('spdx:GPL-2.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-pari-seadata-small")
source=("https://pari.math.u-bordeaux.fr/pub/pari/packages/seadata.tgz"{,.asc})
sha256sums=('c9282a525ea3f92c1f9c6c69e37ac5a87b48fb9ccd943cfd7c881a3851195833'
            'SKIP')

# Bill Allombert <ballombe@debian.org>
validpgpkeys=('4940AE28C5F8E8A35E4D8D287833ECF1B5444815')

package() {
  mkdir -p "${pkgdir}${MINGW_PREFIX}/share/pari"
  cp -r data/seadata "${pkgdir}${MINGW_PREFIX}/share/pari"
  # Remove files which are already provided by pari-seadata-small.
  rm "${pkgdir}${MINGW_PREFIX}"/share/pari/seadata/{README,sea0,sea2}
}
