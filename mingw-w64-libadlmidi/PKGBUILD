_realname=libadlmidi
_pkgname=libADLMIDI
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=1.6.1
pkgrel=1
pkgdesc="A Software MIDI Synthesizer library with OPL3 (YMF262) emulator"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
msys2_references=(
  'archlinux: libadlmidi-git'
)
url="https://github.com/Wohlstand/libADLMIDI/"
msys2_repository_url="https://github.com/Wohlstand/libADLMIDI/"
license=("spdx:GPL-3.0-or-later")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=("https://github.com/Wohlstand/libADLMIDI/archive/refs/tags/v${pkgver}.tar.gz"
        '0001-fix-static-name.patch')
sha256sums=('9f14489ce1e6d020b8b90b6cf902e31d61b2d4e82122505cec6d5d4afebcb3e1'
            '95bbfdac1eedc6a4d3fffcf1e7e590add78c1a736ed5ea88130facb977f9f597')

prepare() {
  cd "${_pkgname}-${pkgver}"
  patch -Nbp1 -i "${srcdir}/0001-fix-static-name.patch"
}

build() {
  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX=${MINGW_PREFIX} \
      -DlibADLMIDI_STATIC=ON \
      -DlibADLMIDI_SHARED=ON \
      -DWITH_MIDIPLAY=ON \
      -DWITH_EMBEDDED_BANKS=ON \
      -DUSE_NUKED_EMULATOR=ON \
      "${_extra_config[@]}" \
      -S ${_pkgname}-${pkgver} \
      -B build-${MSYSTEM}

  cmake --build build-${MSYSTEM}
}

package() {
  DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM}
}
