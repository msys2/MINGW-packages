# Maintainer: Sarah Ottinger <schalaalexiazeal@gmail.com>

_realname=labelme
pkgbase="mingw-w64-python-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=5.2.1
pkgrel=7
pkgdesc='Image Polygonal Annotation with Python (polygon, rectangle, circle, line, point and image-level flag annotation). (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64')
url="https://github.com/wkentaro/labelme"
msys2_repository_url='https://github.com/wkentaro/labelme'
msys2_references=(
  'aur: labelme'
  'purl: pkg:pypi/labelme'
)
license=('spdx:GPL-3.0-or-later')
# commented packages are needed for labelme 7.8.1+
depends=(
  # -- remove when updating
  "${MINGW_PACKAGE_PREFIX}-python-colorama"
  "${MINGW_PACKAGE_PREFIX}-python-pyqt5"
  "${MINGW_PACKAGE_PREFIX}-python-qtpy"
  "${MINGW_PACKAGE_PREFIX}-python-termcolor"
  "${MINGW_PACKAGE_PREFIX}-python-yaml"
  # -- end remove when updating
  # "${MINGW_PACKAGE_PREFIX}-pyside6"
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-imgviz"
  # "${MINGW_PACKAGE_PREFIX}-python-loguru"
  "${MINGW_PACKAGE_PREFIX}-python-matplotlib"
  "${MINGW_PACKAGE_PREFIX}-python-natsort"
  "${MINGW_PACKAGE_PREFIX}-python-numpy"
  # "${MINGW_PACKAGE_PREFIX}-python-onnxruntime"
  # "${MINGW_PACKAGE_PREFIX}-python-osam"
  "${MINGW_PACKAGE_PREFIX}-python-pillow"
  # "${MINGW_PACKAGE_PREFIX}-python-ruamel-yaml"
  # "${MINGW_PACKAGE_PREFIX}-python-scikit-image"
  # "${MINGW_PACKAGE_PREFIX}-python-scipy"
  # "${MINGW_PACKAGE_PREFIX}-python-tifffile"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  # "${MINGW_PACKAGE_PREFIX}-python-hatch-fancy-pypi-readme"
  # "${MINGW_PACKAGE_PREFIX}-python-hatch-vcs"
  # "${MINGW_PACKAGE_PREFIX}-python-hatchling"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  # remove setuptools when updating to 7.8.1
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
options=('!strip')
source=("https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz")
sha256sums=('556c793b33b32de47324d60182c356ccefcbf8ae4a9217392b5f6a32ea5251e1')

build() {
  cp -r "${_realname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 labelme/icons/icon.png "${pkgdir}${MINGW_PREFIX}/share/pixmaps/labelme.png"
  # use for 7.8.1+
  # install -Dm644 labelme/icons/icon-256.png "${pkgdir}${MINGW_PREFIX}/share/pixmaps/labelme.png"
  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
