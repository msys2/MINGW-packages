# Maintainer: Harsh Mishra <harshmishrahm01@gmail.com>

_realname=papers
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=51.beta
pkgrel=1
pkgdesc="Document viewer for GNOME (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://apps.gnome.org/Papers/"
msys2_repository_url="https://gitlab.gnome.org/GNOME/papers"
license=('spdx:GPL-2.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cairo"
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-djvulibre"
  "${MINGW_PACKAGE_PREFIX}-exempi"
  "${MINGW_PACKAGE_PREFIX}-gdk-pixbuf2"
  "${MINGW_PACKAGE_PREFIX}-gettext-runtime"
  "${MINGW_PACKAGE_PREFIX}-glib2"
  "${MINGW_PACKAGE_PREFIX}-gsettings-desktop-schemas"
  "${MINGW_PACKAGE_PREFIX}-gtk4"
  "${MINGW_PACKAGE_PREFIX}-hicolor-icon-theme"
  "${MINGW_PACKAGE_PREFIX}-libadwaita"
  "${MINGW_PACKAGE_PREFIX}-libarchive"
  "${MINGW_PACKAGE_PREFIX}-libspelling"
  "${MINGW_PACKAGE_PREFIX}-libtiff"
  "${MINGW_PACKAGE_PREFIX}-pango"
  "${MINGW_PACKAGE_PREFIX}-poppler"
  "${MINGW_PACKAGE_PREFIX}-zlib"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-appstream"
  "${MINGW_PACKAGE_PREFIX}-blueprint-compiler"
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-desktop-file-utils"
  "${MINGW_PACKAGE_PREFIX}-gettext-tools"
  "${MINGW_PACKAGE_PREFIX}-gobject-introspection"
  "${MINGW_PACKAGE_PREFIX}-itstool"
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-rust"
  "git"
)
source=(
  "https://download.gnome.org/sources/${_realname}/${pkgver%%.*}/${_realname}-${pkgver}.tar.xz"
  "0001-windows-port.patch"
)
sha256sums=(
  '8b19c974f576f72867fc89c6796c6c711eef58976e8c6684e008774aa468f614'
  '9ea49f9db2a0612cfd353d3ae3a3d9ede758b2d3dd23a0bafd2bcb7b6f63f4bc'
)

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"

  git apply -v "${srcdir}/0001-windows-port.patch"
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("--buildtype=release" "-Dprofile=default")
  else
    extra_config+=("--buildtype=debugoptimized" "-Dprofile=default")
  fi

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    meson setup \
      --prefix="${MINGW_PREFIX}" \
      --wrap-mode=nodownload \
      --auto-features=enabled \
      "${extra_config[@]}" \
      -Dpreviewer=false \
      -Dgtk_doc=false \
      -Duser_doc=false \
      "${srcdir}/build-${MSYSTEM}" \
      "${srcdir}/${_realname}-${pkgver}"

  meson compile -C "${srcdir}/build-${MSYSTEM}"
}

package() {
  meson install -C "${srcdir}/build-${MSYSTEM}" --destdir "${pkgdir}"

  install -Dm644 "${srcdir}/${_realname}-${pkgver}/COPYING" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/COPYING"
}
