# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_realname=libint
pkgbase=mingw-w64-${_realname}2
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}2")
pkgver=2.13.1
pkgrel=1
pkgdesc="high-performance library for computing Gaussian integrals in quantum mechanics (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/evaleev/libint'
msys2_repository_url='https://github.com/evaleev/libint'
msys2_references=(
  'aur: libint2'
)
license=('spdx:LGPL-3.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs")
optdepends=(
  "${MINGW_PACKAGE_PREFIX}-boost"
  "${MINGW_PACKAGE_PREFIX}-eigen3"
  "${MINGW_PACKAGE_PREFIX}-gmp"
  "${MINGW_PACKAGE_PREFIX}-mpfr"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-fc"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-python"
  "${optdepends[@]%%:*}"
)
source=("https://github.com/evaleev/libint/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz"
        #https://github.com/evaleev/libint/releases/download/v${pkgver}/${_realname}-${pkgver}.tgz
        '001-fix-build-on-mingw.patch'
        '002-fix-clang-23.patch')
sha256sums=('9651705c79f77418ef0230aafc0cf1b71b17c1c89e413ee0e5ee7818650ce978'
            '72c313c472f0514893efb699d377056bbc3415cf58e9b8f0971e023ab293250a'
            'a5eeccd933f690c2c9f8a156019275cd1efc435ca74c8c1623c41c3bec09a0de')
noextract=("${_realname}-${pkgver}.tar.gz")

prepare() {
  echo "Extracting ${_realname}-${pkgver}.tar.gz..."
  tar -xzf ${_realname}-${pkgver}.tar.gz || true

  cd "${srcdir}"/${_realname}-${pkgver}

  patch -Np1 -i "${srcdir}"/001-fix-build-on-mingw.patch
  patch -Np1 -i "${srcdir}"/002-fix-clang-23.patch

  mv export/lib/basis/6-31g\*.g94 export/lib/basis/6-31gs.g94
  mv export/lib/basis/6-31g\*\*.g94 export/lib/basis/6-31gss.g94
  mv export/lib/basis/6-311g\*\*.g94 export/lib/basis/6-311gss.g94
}

build() {
  local LMAX=5
  cmake \
    -Wno-author \
    -GNinja \
    -DLIBINT2_ENABLE_ERI=1 \
    -DLIBINT2_ENABLE_ERI3=1 \
    -DLIBINT2_ENABLE_ERI2=1 \
    -DLIBINT2_MAX_AM=${LMAX} \
    -DLIBINT2_OPT_AM=3 \
    -DLIBINT2_ERI_MAX_AM="${LMAX};$((LMAX-1))" \
    -DLIBINT2_ERI3_MAX_AM="$((LMAX+2));$((LMAX+1))" \
    -DLIBINT2_ERI2_MAX_AM="$((LMAX+2));$((LMAX+1))" \
    -DLIBINT2_MULTIPOLE_MAX_ORDER=4 \
    -DLIBINT2_ENABLE_GENERIC_CODE=ON \
    -DLIBINT2_ENABLE_UNROLLING=0 \
    -S ${_realname}-${pkgver} \
    -B generated

  cmake --build generated --target export

  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -Wno-author \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${extra_config[@]}" \
      -DBUILD_SHARED_LIBS=ON \
      -DCMAKE_DLL_NAME_WITH_SOVERSION=ON \
      -DLIBINT2_ENABLE_FORTRAN=ON \
      -DLIBINT2_ENABLE_MPFR=ON \
      -DPython_EXECUTABLE=${MINGW_PREFIX}/bin/python \
      -S generated/${_realname}-${pkgver}-post999 \
      -B build-${MSYSTEM}

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  local PREFIX_WIN=$(cygpath -wm ${MINGW_PREFIX})
  for _f in "${pkgdir}${MINGW_PREFIX}"/lib/cmake/libint2/*.cmake; do
    sed -e "s|${PREFIX_WIN}|\$\{_IMPORT_PREFIX\}|g" -i ${_f}
    sed -e "s|${MINGW_PREFIX}|\$\{_IMPORT_PREFIX\}|g" -i ${_f}
  done

  # Remove some unrequired files
  find "${pkgdir}"${MINGW_PREFIX}/ -type f -name '\._*' -exec rm -v {} \;

  install -Dm644 "${srcdir}"/${_realname}-${pkgver}/LICENSE \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}2/LICENSE
  install -Dm644 "${srcdir}"/${_realname}-${pkgver}/COPYING \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}2/COPYING
  install -Dm644 "${srcdir}"/${_realname}-${pkgver}/COPYING.LESSER \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}2/COPYING.LESSER
}
