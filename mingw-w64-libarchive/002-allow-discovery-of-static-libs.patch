 # Enable the pkg-config helpers.
-INCLUDE(FindPkgConfig)
+FIND_PACKAGE(PkgConfig)
+
+SET(ARCHIVE_PC_REQUIRES_PRIVATE "")
+
+MACRO(PKG_ENSURE_STATIC pkg_name module_name)
+  IF(NOT TARGET PkgConfig::${pkg_name}_STATIC)
+    PKG_CHECK_MODULES(STATIC_${pkg_name} QUIET ${module_name})
+    IF(STATIC_${pkg_name}_FOUND)
+      STRING(REGEX REPLACE "[ <>=].*$" "" _pc_name "${module_name}")
+      LIST(APPEND ARCHIVE_PC_REQUIRES_PRIVATE ${_pc_name})
+      ADD_LIBRARY(PkgConfig::${pkg_name}_STATIC INTERFACE IMPORTED GLOBAL)
+      SET_TARGET_PROPERTIES(PkgConfig::${pkg_name}_STATIC PROPERTIES
+        INTERFACE_INCLUDE_DIRECTORIES "${STATIC_${pkg_name}_STATIC_INCLUDE_DIRS}"
+        INTERFACE_COMPILE_OPTIONS     "${STATIC_${pkg_name}_STATIC_CFLAGS_OTHER}"
+        INTERFACE_LINK_LIBRARIES      "${STATIC_${pkg_name}_STATIC_LDFLAGS}")
+    ELSE()
+      MESSAGE(WARNING "No static pkg-config data for ${module_name}")
+    ENDIF()
+  ENDIF()
+ENDMACRO()
 
