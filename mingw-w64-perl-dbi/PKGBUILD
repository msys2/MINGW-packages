# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=DBI
_realname="${_perlname,,}"
pkgbase="mingw-w64-perl-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=1.656
pkgrel=1
pkgdesc="Database independent interface for Perl. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/DBI"
msys2_changelog_url='https://metacpan.org/dist/DBI/changes'
msys2_repository_url="https://github.com/perl5-dbi/dbi"
msys2_references=(
  'anitya: 2811'
  'archlinux: perl-dbi'
  'cpe: cpe:/a:perl:database_interface'
  'cpe: cpe:/a:perl:dbi'
  'purl: pkg:cpan/HMBRAND/DBI'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-perl"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-make"
)
source=("https://cpan.metacpan.org/authors/id/H/HM/HMBRAND/${_perlname}-${pkgver}.tgz")
sha256sums=('ab5f2b9aef00951ed4598723d6131a00b03e68193478dd5e5f211015520a6ef0')

build() {
  cp -r "${_perlname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="PREFIX=" \
    PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}

  mingw32-make
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="PREFIX=" \
    mingw32-make DESTDIR="${pkgdir}/" install

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/perl-${_realname}"
}
