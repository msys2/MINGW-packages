# Maintainer: Biswapriyo Nath <nathbappai@gmail.com>

_pyname=PyMuPDF
_realname=pymupdf
pkgbase="mingw-w64-python-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=2.0
pkgrel=1
pkgdesc="Python bindings for MuPDF's rendering library (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://pymupdf.io/'
msys2_repository_url='https://github.com/pymupdf/PyMuPDF/'
msys2_documentation_url='https://pymupdf.readthedocs.io/'
msys2_references=(
  'archlinux: python-pymupdf'
  'purl: pkg:pypi/pymupdf'
)
license=('spdx:AGPL-3.0-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-libmupdf"
  "${MINGW_PACKAGE_PREFIX}-python-mupdf"
  "${MINGW_PACKAGE_PREFIX}-python"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-distro"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-pipcl"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
  "${MINGW_PACKAGE_PREFIX}-swig"
)
optdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-fonttools: for building font subsets using fontTools"
  "${MINGW_PACKAGE_PREFIX}-python-pillow: for image file saving using pillow"
)
options=('!strip')
source=(
  "https://pypi.org/packages/source/${_pyname::1}/${_pyname}/${_realname}-${pkgver}.tar.gz"
  0001-pymupdf-add-mingw-setup.patch
)
sha256sums=('7733136f626fffe98677daa53c906eb45f2eb486a6450dbcfd652cbbd760f1e2'
            'f7dc658ea19ebc949cef592175a6cd91891a4c93453f09b74b5feb33786be649')

prepare() {
  cd "${_realname}-${pkgver}"

  patch -Np1 -i "${srcdir}/0001-pymupdf-add-mingw-setup.patch"
}

build() {
  cp -r "${_realname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  # Use system provided mupdf libraries
  export PYMUPDF_SETUP_IMPLEMENTATIONS=b
  export PYMUPDF_SETUP_MUPDF_BUILD=''
  export PYMUPDF_MUPDF_LIB=${MINGW_PREFIX}/bin
  export PIPCL_PYTHON_CONFIG=${MINGW_PREFIX}/bin/python-config

  python -m build --wheel --skip-dependency-check --no-isolation
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 COPYING -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
