# Maintainer: Wu, Zhenyu <wuzhenyu@ustc.edu>

_realname=lumis
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.10.2
pkgrel=1
pkgdesc='Syntax highlighter CLI powered by Tree-sitter and Neovim themes'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/leandrocp/lumis'
msys2_repository_url='https://github.com/leandrocp/lumis'
msys2_references=(
  'purl: pkg:cargo/lumis-cli'
)
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs")
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-rust"
             "${MINGW_PACKAGE_PREFIX}-pkgconf")
source=("${_realname}-${pkgver}.tar.gz::${url}/archive/refs/tags/hex-${_realname}/v${pkgver}.tar.gz")
sha256sums=('ff253bdcfecac1c818e609035e3927b7e21798ff0a06785658a801cc4e180897')

prepare() {
  cd "${_realname}-hex-${_realname}-v${pkgver}"
  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${_realname}-hex-${_realname}-v${pkgver}"
  export RUSTFLAGS="${RUSTFLAGS/+crt-static/-crt-static}"
  cargo build --release --frozen -p lumis-cli
}

check() {
  cd "${_realname}-hex-${_realname}-v${pkgver}"
  cargo test --release --frozen -p lumis-cli
}

package() {
  cd "${_realname}-hex-${_realname}-v${pkgver}"
  install -Dm755 target/release/lumis.exe -t "${pkgdir}${MINGW_PREFIX}/bin"
  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
