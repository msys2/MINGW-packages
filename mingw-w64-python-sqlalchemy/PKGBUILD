# Maintainer: J. Peter Mugaas <jpmugaas@suddenlink.net>

_realname='sqlalchemy'
pkgbase="mingw-w64-python-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-python-${_realname}"
# must be in sync with python-sqlmodel requirements
pkgver=2.1.0
pkgrel=1
pkgdesc='Python SQL toolkit and Object Relational Mapper (mingw-w64)'
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://www.sqlalchemy.org/'
msys2_repository_url='https://github.com/sqlalchemy/sqlalchemy'
msys2_changelog_url='https://docs.sqlalchemy.org/en/21/changelog/changelog_21.html'
msys2_references=(
  'anitya: 179915'
  'archlinux: python-sqlalchemy'
  'aur:' # ignore python-sqlalchemy-git
  'cpe: cpe:/a:sqlalchemy:sqlalchemy'
  'gentoo: dev-python/sqlalchemy'
  'purl: pkg:pypi/sqlalchemy'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-greenlet"
  "${MINGW_PACKAGE_PREFIX}-python-typing_extensions"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cython"
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-mock"
  "${MINGW_PACKAGE_PREFIX}-python-pytest"
  "${MINGW_PACKAGE_PREFIX}-python-pytest-xdist"
)
source=(
  "https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz"
)
sha256sums=('37600e4641c435a7e4549f4e6df79d9dfc096bb9712a10dba8925921bc87bc3c')

build() {
  cp -r "${_realname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "build-${MSYSTEM}"

  # 2.0.51: 22526 passed, 1290 skipped, 927 warnings, 115 errors
  python -m pytest || warning "Tests failed"
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
