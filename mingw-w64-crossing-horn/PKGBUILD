# Maintainer: Horn Notes <info@hornguns.com>

_realname=crossing-horn
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.1.0
pkgrel=1
pkgdesc="Grade-crossing train horn timing and audibility calculator (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64')
url='https://hornguns.com/'
msys2_repository_url="https://github.com/bosshorncom-cmd/crossing-horn"
license=('spdx:MIT')
makedepends=("${MINGW_PACKAGE_PREFIX}-ocaml"
             "${MINGW_PACKAGE_PREFIX}-flexdll"
             "${MINGW_PACKAGE_PREFIX}-cc")
source=("${_realname}-${pkgver}.tar.gz::https://github.com/bosshorncom-cmd/crossing-horn/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('a53feda987f28452b601a5eed3633240357e6c65f8213371a2a2b2053940f9a6')

# Upstream builds with dune, which is not packaged in MSYS2. The project is
# one library module plus a CLI with no other dependencies, so compile it
# directly with ocamlopt.
build() {
  [[ -d "${srcdir}"/build-${MSYSTEM} ]] && rm -rf "${srcdir}"/build-${MSYSTEM}
  cp -r "${srcdir}"/${_realname}-${pkgver} "${srcdir}"/build-${MSYSTEM}
  cd "${srcdir}"/build-${MSYSTEM}

  ocamlopt -I src -c src/crossing_horn.mli src/crossing_horn.ml
  ocamlopt -I src -o crossing-horn.exe src/crossing_horn.cmx bin/main.ml
}

check() {
  cd "${srcdir}"/build-${MSYSTEM}

  ocamlopt -I src -o test_crossing_horn.exe src/crossing_horn.cmx test/test_crossing_horn.ml
  ./test_crossing_horn.exe
}

package() {
  cd "${srcdir}"/build-${MSYSTEM}

  install -Dm755 crossing-horn.exe "${pkgdir}${MINGW_PREFIX}/bin/crossing-horn.exe"
  install -Dm644 README.md "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}/README.md"
  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
