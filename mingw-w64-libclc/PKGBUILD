# Maintainer: Biswapriyo Nath <nathbappai@gmail.com>

_realname=libclc
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
_pkgver=23.1.3
pkgver=${_pkgver/-/}
pkgrel=1
pkgdesc='Library requirements of the OpenCL C programming language (mingw-w64)'
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://libclc.llvm.org/'
license=('spdx:Apache-2.0')
makedepends=("${MINGW_PACKAGE_PREFIX}-clang"
             "${MINGW_PACKAGE_PREFIX}-llvm"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             "${MINGW_PACKAGE_PREFIX}-python"
             "${MINGW_PACKAGE_PREFIX}-spirv-llvm-translator")
_url=https://github.com/llvm/llvm-project/releases/download/llvmorg-${_pkgver}
_pkgfn=llvm-project-${_pkgver}.src
source=($_url/${_pkgfn}.tar.xz{,.sig})
sha256sums=('c44186a7762ed28954be72e5ff6df9808e0779d4f1bf014ecc4e7e211d31ee34'
            'SKIP')
validpgpkeys=('B6C8F98282B944E3B0D5C2530FC3042E345AD05D'  # Hans Wennborg, Google.
              '474E22316ABF4785A88C6E8EA2C794A986419D8A'  # Tom Stellard
              '71046D1E9C6656BDD61171873E83BABF4A4F9E85'  # Cullen Rhodes
              'FFB3368980F3E6BB5737145A316C56D064CACBA5'  # Douglas Yung
              'D574BD5D1D0E98895E3BF90044F2485E45D59042') # Tobias Hieta
noextract=(${_pkgfn}.tar.xz)

prepare() {
  plain "Extracting ${_pkgfn}.tar.xz due to symlink(s) without pre-existing target(s)"
  ${MINGW_PREFIX}/bin/bsdtar -xJf "${srcdir}"/${_pkgfn}.tar.xz -C "${srcdir}" || true

  cd "${srcdir}"/${_pkgfn}/${_realname}
}

_targets=(
  spirv32-unknown-unknown
  spirv64-unknown-unknown
)

build() {
  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  CC=clang
  CXX=clang++

  for _target in ${_targets[@]}; do
    MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
      cmake \
        -GNinja \
        -DCMAKE_INSTALL_PREFIX=${MINGW_PREFIX} \
        -DLLVM_DEFAULT_TARGET_TRIPLE=${_target} \
        "${_extra_config[@]}" \
        -DPython3_EXECUTABLE=${MINGW_PREFIX}/bin/python \
        -S ${_pkgfn}/${_realname} \
        -B build-${MSYSTEM}-${_target}

    cmake --build build-${MSYSTEM}-${_target}
  done
}

package() {
  for _target in ${_targets[@]}; do
    DESTDIR="${pkgdir}" cmake --install build-${MSYSTEM}-${_target}
  done

  # For mesa
  cp "${pkgdir}"${MINGW_PREFIX}/share/clc/spirv32-unknown-unknown/libclc.spv \
    "${pkgdir}"${MINGW_PREFIX}/share/clc/spirv-mesa3d-.spv
  cp "${pkgdir}"${MINGW_PREFIX}/share/clc/spirv64-unknown-unknown/libclc.spv \
    "${pkgdir}"${MINGW_PREFIX}/share/clc/spirv64-mesa3d-.spv

  # Mesa wants a pkg-config file.
  install -Dm644 /dev/stdin "${pkgdir}"${MINGW_PREFIX}/share/pkgconfig/libclc.pc <<END
prefix=${MINGW_PREFIX}
datarootdir=\${prefix}/share
datadir=\${prefix}/share
pkgdatadir=\${datadir}/clc
libexecdir=\${pkgdatadir}

Name: libclc
Description: Library requirements of the OpenCL C programming language
Version: ${pkgver}
END

  install -Dm644 "${srcdir}"/${_pkgfn}/${_realname}/LICENSE.TXT \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE.TXT
}
