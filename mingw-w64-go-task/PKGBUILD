# Maintainer: Glarboy <Nahida1027@aliyun.com>

_realname=go-task
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=3.54.0
pkgrel=1
pkgdesc="A fast, cross-platform build tool inspired by Make, designed for modern workflows"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://taskfile.dev/"
msys2_repository_url="https://github.com/go-task/task"
msys2_issue_tracker_url="https://github.com/go-task/task/issues"
msys2_documentation_url="https://taskfile.dev/docs/"
msys2_changelog_url="https://taskfile.dev/docs/changelog"
msys2_references=(
  'archlinux: go-task'
)
license=('spdx: MIT')
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-go")
options=('!strip')
source=("${msys2_repository_url}/archive/v${pkgver}/v${pkgver}.tar.gz")
sha256sums=('d9e92770c2c18f135701431d04bb24fb77b5f13464699683892bdfc0b26f2eb8')


build() {
  cd "task-${pkgver}"

  export GOOS=windows
  export GOROOT="${MINGW_PREFIX}/lib/go"
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-trimpath -ldflags=-linkmode=external -ldflags=-s -ldflags=-w -mod=readonly -modcacherw"
  case "${CARCH}" in
  x86_64)
    GOFLAGS+=" -buildmode=pie"
    ;;
  esac

  go build -v -o build/go-task.exe ./cmd/task
}

package() {
  cd "task-${pkgver}"
  install -vDm755 build/go-task.exe -t "${pkgdir}${MINGW_PREFIX}/bin/"
  install -vDm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/"
  install -vDm644 README.md -t "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}/"
}
