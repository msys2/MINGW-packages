# Maintainer: Sahil Gautam <printfdebugging@gmail.com>

_realname=bear
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=4.2.3
pkgrel=1
pkgdesc='A tool that generates a compilation database for clang tooling (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/rizsotto/Bear'
msys2_repository_url='https://github.com/rizsotto/Bear'
msys2_references=(
  'anitya: 18436'
  'archlinux: bear'
  'aur:' # ignore bear-git
  'gentoo: dev-util/bear'
)
license=('spdx:GPL-3.0-or-later')
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-rust"
)
options=('!strip')
source=("${url}/archive/${pkgver}/${_realname}-${pkgver}.tar.gz")
sha256sums=('7c3901786f01da60d606cc80afdda36e866259b78e1dd7f890fd42cee64d3574')

prepare() {
  cd "${_realname}-${pkgver}"

  cargo fetch --locked --target "${RUST_CHOST}"
}

build() {
  cd "${_realname}-${pkgver}"

  cargo build --frozen --release
}

check() {
  cd "${_realname}-${pkgver}"

  cargo test --frozen --release
}

package() {
  cd "${_realname}-${pkgver}"

  DESTDIR="${pkgdir}" PREFIX="${MINGW_PREFIX}" sh scripts/install.sh
}
