# Maintainer: g-willems <136915997+g-willems@users.noreply.github.com>

_realname=libspelling
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.4.11
pkgrel=1
pkgdesc="A GNOME library for spellchecking (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://gnome.pages.gitlab.gnome.org/libspelling/libspelling-1/'
msys2_repository_url="https://gitlab.gnome.org/GNOME/libspelling"
msys2_references=(
  'anitya: 369148'
  'archlinux: libspelling'
  'aur:' # ignore libspelling-git
  'gentoo: app-text/libspelling'
)
license=("spdx:LGPL-2.1-or-later")
depends=(
  "${MINGW_PACKAGE_PREFIX}-enchant"
  "${MINGW_PACKAGE_PREFIX}-glib2"
  "${MINGW_PACKAGE_PREFIX}-gtk4"
  "${MINGW_PACKAGE_PREFIX}-gtksourceview5"
  "${MINGW_PACKAGE_PREFIX}-icu"
  "${MINGW_PACKAGE_PREFIX}-pango"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-gobject-introspection"
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-vala"
)
source=("https://download.gnome.org/sources/${_realname}/${pkgver%.*}/${_realname}-${pkgver}.tar.xz")
sha256sums=('52e53ec3fba0f604cfd0931e26af7f7241a0d4f0208dd5574f43b3589f6d28b2')

build() {
  mkdir -p "${srcdir}"/build-${MSYSTEM} && cd "${srcdir}"/build-${MSYSTEM}

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    meson setup \
    --prefix="${MINGW_PREFIX}" \
    --buildtype=plain \
    -Ddocs=false \
    -Dvapi=true \
    -Denchant=enabled \
    -Dsysprof=false \
    "../${_realname}-${pkgver}"

  meson compile
}

package() {
  meson install -C "${srcdir}/build-${MSYSTEM}" --destdir "${pkgdir}"

  install -Dm644 "${srcdir}"/${_realname}-${pkgver}/COPYING \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}/COPYING
}
