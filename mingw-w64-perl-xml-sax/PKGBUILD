# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=XML-SAX
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=1.02
pkgrel=2
pkgdesc="Simple API for XML. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/XML-SAX"
msys2_repository_url="https://github.com/grantm/xml-sax"
msys2_references=(
  'purl: pkg:cpan/GRANTM/XML-SAX'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-perl"
         "${MINGW_PACKAGE_PREFIX}-perl-xml-namespacesupport"
         "${MINGW_PACKAGE_PREFIX}-perl-xml-sax-base")
makedepends=("${MINGW_PACKAGE_PREFIX}-make")
source=("https://cpan.metacpan.org/authors/id/G/GR/GRANTM/${_perlname}-${pkgver}.tar.gz")
sha256sums=('4506c387043aa6a77b455f00f57409f3720aa7e553495ab2535263b4ed1ea12a')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  PERLLIB=blib/lib \
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
  install -Dm644 LICENSE "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE
}
