# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_realname=libgme
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=0.6.5
pkgrel=3
pkgdesc="Video game music file emulation/playback library (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://github.com/libgme/game-music-emu"
msys2_repository_url='https://github.com/libgme/game-music-emu'
msys2_references=(
  "cpe: cpe:/a:game-music-emu_project:game-music-emu"
)
license=('spdx:LGPL-2.1-or-later')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-zlib"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
)
options=('!emptydirs')
source=(
  "${url}/releases/download/${pkgver}/${_realname}-${pkgver}-src.tar.gz"
  '0001-fix-pkgconfig.patch'
)
sha256sums=('a133f19278222136ba0d8c27b64a07987ba05fec9d2e6d293ccd8cabdd97ddbb'
            '65784ffefb1e3645573ac5aa547da10fefe29c0a69dad725cef9337cc16d6919')

prepare() {
  cd "${_realname}-${pkgver}"

  patch -Np1 -i "${srcdir}/0001-fix-pkgconfig.patch"
}

build() {
  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -Wno-author \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX=${MINGW_PREFIX} \
      "${_extra_config[@]}" \
      -DGME_BUILD_SHARED=ON \
      -DGME_BUILD_STATIC=ON \
      -DGME_BUILD_TESTING=OFF \
      -DGME_BUILD_EXAMPLES=OFF \
      -DGME_ENABLE_UBSAN=OFF \
      -S "${_realname}-${pkgver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "${_realname}-${pkgver}/license.txt" -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/"
}
