prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: cld3
Description: Compact Language Detector 3
Version: @PROJECT_VERSION@
Requires: protobuf-lite
Libs: -L${libdir} -lcld3
# Protobuf 36.2 public headers require C++17, not advertised by protobuf-lite.pc.
Cflags: -I${includedir} -I${includedir}/cld3 -std=c++17
