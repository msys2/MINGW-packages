# Maintainer: luadebug <lin@sz.cn.eu.org>

_realname=cld3
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=r128.b48dc46
pkgrel=1
pkgdesc="Compact Language Detector 3 (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/google/cld3'
msys2_repository_url='https://github.com/google/cld3'
license=('spdx:Apache-2.0')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs"
         "${MINGW_PACKAGE_PREFIX}-protobuf")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  'git'
)
_commit='b48dc46512566f5a2d41118c8c1116c4f96dc661'
source=("${_realname}::git+https://github.com/google/cld3.git#commit=${_commit}"
        '0001-cmake.patch'
        'cld3-config.cmake.in'
        'cld3.pc.in')
sha256sums=('SKIP'
            'd68af2ee9f4deb316d88feb596d5d03a2dde5807d953971b68f3c648b57b8e3e'
            'dd727354157a0d9ecb58f526752d6d29faccf86ff236c25feb68190be2ad8836'
            '5728fcda3a082e2db242b3d67059f70c38d029bcb665f532e2007999d21d55b7')

pkgver() {
  cd cld3
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd cld3
  patch -Np1 -i "${srcdir}/0001-cmake.patch"
  cp "${srcdir}/cld3-config.cmake.in" "${srcdir}/cld3.pc.in" .
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      "${extra_config[@]}" \
      -DBUILD_SHARED_LIBS=ON \
      -S cld3 \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "${srcdir}/cld3/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
