#

_realname=mumble
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
_tag=v1.6.0-alpha2
pkgver=1.6.1001
pkgrel=1
pkgdesc='An Open Source, low-latency, high quality voice chat software (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://www.mumble.info/'
msys2_repository_url='https://github.com/mumble-voip/mumble'
msys2_changelog_url='https://github.com/mumble-voip/mumble/blob/master/CHANGES'
msys2_references=(
  'archlinux: mumble'
  'cpe: cpe:/a:mumble:mumble'
  'gentoo: media-sound/mumble'
)
license=('spdx:BSD-3-Clause')
depends=(
  "${MINGW_PACKAGE_PREFIX}-abseil-cpp"
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-libsndfile"
  "${MINGW_PACKAGE_PREFIX}-openssl"
  "${MINGW_PACKAGE_PREFIX}-opus"
  "${MINGW_PACKAGE_PREFIX}-poco"
  "${MINGW_PACKAGE_PREFIX}-protobuf"
  "${MINGW_PACKAGE_PREFIX}-qt6-5compat"
  "${MINGW_PACKAGE_PREFIX}-qt6-base"
  "${MINGW_PACKAGE_PREFIX}-qt6-svg"
  "${MINGW_PACKAGE_PREFIX}-rnnoise"
  "${MINGW_PACKAGE_PREFIX}-spdlog"
  "${MINGW_PACKAGE_PREFIX}-speexdsp"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-boost"
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cli11"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-microsoft-gsl"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-nlohmann-json"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-qt6-tools"
  "${MINGW_PACKAGE_PREFIX}-utf8cpp"
)
source=(
  "https://github.com/mumble-voip/mumble/releases/download/${_tag}/${_realname}-${pkgver}.tar.gz"
)
sha256sums=('6fbe7f9258dd480a918b868f925620b6dcc8a78e29a326f91d1f8a7842ce5b83')

prepare() {
  cd "${_realname}-${pkgver}"

  sed -i '/#include <tlhelp32.h>/a #include <utility>' plugins/HostWindows.cpp
  grep -rl 'std::terminate' plugins src | xargs -r sed -i '0,/^#include/s//#include <exception>\n&/'

  find plugins -type f \( -name '*.h' -o -name '*.hpp' -o -name '*.c' -o -name '*.cpp' \) \
    -exec sed -i -E '/^[[:space:]]*#[[:space:]]*(if|ifdef|ifndef|elif)\b/s/\bWIN32\b/_WIN32/g' {} +

  sed -i '0,/^#include/s//#if defined(__aarch64__) || defined(_M_ARM64)\n#include <cstring>\nstatic inline void __cpuid(int info[4], int) { std::memset(info, 0, 4 * sizeof(int)); }\n#endif\n&/' src/OSInfo.cpp
  sed -i 's/typedef UINT32 QOS_FLOWID, \*PQOS_FLOWID;/typedef ULONG QOS_FLOWID, *PQOS_FLOWID;/' src/win.h

  sed -i \
    -e '/#include <audioclient.h>/i #include <cstddef>\n#define ServerInformation Win32ServerInformation' \
    -e '/struct WASAPIDevice/i #undef ServerInformation' \
    -e 's/WASAPIDevice(nullptr_t);/WASAPIDevice(std::nullptr_t);/' \
    src/mumble/WASAPI.h
  sed -i 's/WASAPIDevice::WASAPIDevice(nullptr_t)/WASAPIDevice::WASAPIDevice(std::nullptr_t)/' src/mumble/WASAPI.cpp

  sed -i '0,/HID_USAGE_GENERIC_MULTI_AXIS_CONTROLLER/{/HID_USAGE_GENERIC_MULTI_AXIS_CONTROLLER/i #ifndef HID_USAGE_GENERIC_MULTI_AXIS_CONTROLLER\n#define HID_USAGE_GENERIC_MULTI_AXIS_CONTROLLER ((USAGE) 0x08)\n#endif
}' src/mumble/GlobalShortcut_win.cpp

  sed -i -E '/^[[:space:]]*(extern[[:space:]]+"C"[[:space:]]+)?void[[:space:]]+mumble_speex_init[[:space:]]*\(/s|^|// |' src/mumble/os_win.cpp
  sed -i 's/\bmumble_speex_init();/(void)0;/g' src/mumble/os_win.cpp

  # Install mumble.exe into bin/ and plugins into lib/mumble/plugins/ following MSYS2 FHS layout
  sed -i 's|DESTINATION "\."|DESTINATION "${CMAKE_INSTALL_BINDIR}"|g' src/mumble/CMakeLists.txt
  sed -i 's|DESTINATION "plugins"|DESTINATION "${CMAKE_INSTALL_LIBDIR}/mumble/plugins"|g' plugins/CMakeLists.txt
  sed -i 's|"/plugins"|"/../lib/mumble/plugins"|g' src/mumble/PluginManager.cpp

  echo 'target_link_libraries(mumble_client_object_lib PUBLIC crypt32 shlwapi)' >>src/mumble/CMakeLists.txt
}

build() {
  local _extra_config=()
  if check_option 'debug' 'n'; then
    _extra_config+=('-DCMAKE_BUILD_TYPE=Release')
  else
    _extra_config+=('-DCMAKE_BUILD_TYPE=Debug')
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
    -Wno-author \
    -G Ninja \
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
    -DCMAKE_CXX_STANDARD=20 \
    -DCMAKE_C_STANDARD=11 \
    -DPython_EXECUTABLE="${MINGW_PREFIX}/bin/python" \
    -DBUILD_NUMBER="${pkgver##*.}" \
    -Dclient=ON \
    -Dserver=OFF \
    -Dupdate=OFF \
    -Dzeroconf=OFF \
    -Dasio=OFF \
    -Dportaudio=OFF \
    -Doverlay=OFF \
    -Dbundled-cli11=OFF \
    -Dbundled-json=OFF \
    -Dbundled-rnnoise=OFF \
    -Dbundled-spdlog=OFF \
    -Dbundled-speex=OFF \
    -Dbundled-utfcpp=OFF \
    -Drnnoise=ON \
    -Dtests=ON \
    -Dwarnings-as-errors=OFF \
    "${_extra_config[@]}" \
    -S "${_realname}-${pkgver}" \
    -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

check() {
  ctest --test-dir "build-${MSYSTEM}" --output-on-failure
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  cd "${_realname}-${pkgver}"

  install -Dm644 icons/mumble.svg "${pkgdir}${MINGW_PREFIX}/share/icons/hicolor/scalable/apps/mumble.svg"
  install -Dm644 man/mumble.1 "${pkgdir}${MINGW_PREFIX}/share/man/man1/mumble.1"

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
