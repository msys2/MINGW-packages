_realname=vhs
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=0.12.1
pkgrel=1
pkgdesc="A tool for recording terminal GIFs (mingw-w64)"
arch=(any)
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/charmbracelet/vhs"
msys2_references=(
  'archlinux: vhs'
  'purl: pkg:golang/github.com/charmbracelet/vhs'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-ffmpeg"
  "${MINGW_PACKAGE_PREFIX}-ttyd"
)
makedepends=(
  'git'
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-go"
)
options=(!lto)
source=("${url}/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz")
sha512sums=('964a3c4ddef85e36c3c186d44e364e906d9727613b6cc3cdb48a24527e03e97073c4975e620a3bf2d8f23f68b787483a19833f8f2c49039748e5bf62530e9348')

prepare() {
  cd "${_realname}-${pkgver}"
  mkdir -p build
  export GOROOT=${MINGW_PREFIX}/lib/go
  export GOPATH="${srcdir}"
  go mod download
}

build() {
  cd "${_realname}-${pkgver}"

  # set Go flags
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export GOROOT=${MINGW_PREFIX}/lib/go
  export GOPATH="${srcdir}"

  go build \
    -trimpath \
    -buildmode=pie \
    -mod=readonly \
    -modcacherw \
    -ldflags "-linkmode external -extldflags \"${LDFLAGS}\" ${_BUILDINFO}" \
    -o dist/${_realname}.exe \
    .
}

package() {
  cd "${_realname}-${pkgver}"
  install -Dm 755 "dist/${_realname}.exe" -t "${pkgdir}/$MINGW_PREFIX/bin"
  install -Dm 644 LICENSE  -t "${pkgdir}/$MINGW_PREFIX/share/licenses/${_realname}"
  install -Dm 644 README.md -t "${pkgdir}/$MINGW_PREFIX/share/doc/${_realname}"
}
