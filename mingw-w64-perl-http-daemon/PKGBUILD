# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=HTTP-Daemon
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=6.17
pkgrel=1
pkgdesc="A simple http server class. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/HTTP-Daemon"
msys2_repository_url="https://github.com/libwww-perl/HTTP-Daemon"
msys2_references=(
  'purl: pkg:cpan/OALDERS/HTTP-Daemon'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
groups=("${MINGW_PACKAGE_PREFIX}-perl-modules")
depends=("${MINGW_PACKAGE_PREFIX}-perl"
         "${MINGW_PACKAGE_PREFIX}-perl-http-date"
         "${MINGW_PACKAGE_PREFIX}-perl-http-message"
         "${MINGW_PACKAGE_PREFIX}-perl-lwp-mediatypes")
makedepends=("${MINGW_PACKAGE_PREFIX}-perl-module-build-tiny")
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/O/OA/OALDERS/${_perlname}-${pkgver}.tar.gz")
sha256sums=('16281580c40e23108d028434698b5d7d53637bf904c9df822481e253cbec920c')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MPERL_MM_USE_DEFAULT=1 perl Build.PL
  ./Build
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="--prefix=" \
  ./Build install --destdir="${pkgdir}" --prefix=${MINGW_PREFIX}
  install -Dm644 LICENCE "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE
}
