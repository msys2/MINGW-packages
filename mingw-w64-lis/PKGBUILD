# Maintainer: Rafał Brzegowy <rafal.brzegowy@yahoo.com>

_realname=lis
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2.1.15
pkgrel=1
pkgdesc='Library of Iterative Solvers for linear systems (mingw-w64)'
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://www.ssisc.org/lis/'
msys2_repository_url="https://github.com/anishida/lis"
license=('spdx:BSD-3-Clause')
depends=("${MINGW_PACKAGE_PREFIX}-omp"
         $([[ ${MINGW_PACKAGE_PREFIX} != *-clang-* ]] && echo "${MINGW_PACKAGE_PREFIX}-fc-libs"))
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-autotools"
             $([[ ${MINGW_PACKAGE_PREFIX} != *-clang-* ]] && echo "${MINGW_PACKAGE_PREFIX}-fc")
             $([[ ${CARCH} == aarch64 ]] || echo "${MINGW_PACKAGE_PREFIX}-msmpi"))
options=('!docs')
source=(https://www.ssisc.org/lis/dl/${_realname}-${pkgver}.zip)
sha256sums=('e37607ffa8dde84fa48d6fd0dc9a498686d0a8193451627e6b1899f2870c190f')

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"
  autoreconf -fiv
}

build() {
  [[ -d "build-${MSYSTEM}" ]] && rm -rf "build-${MSYSTEM}"
  cp -r "${_realname}-${pkgver}" "build-${MSYSTEM}"
  cd "build-${MSYSTEM}"

  declare -a _extra_config
  if [[ ${MINGW_PACKAGE_PREFIX} == *-clang-* ]]; then
    _extra_config+=("--disable-f90" "--disable-fortran")
  else
    _extra_config+=("--enable-f90" "--enable-fortran")
    export FFLAGS="-fallow-invalid-boz"
    CFLAGS+=" -fallow-invalid-boz"
  fi
  CFLAGS+=" -Wno-incompatible-pointer-types"

  if [[ ${CARCH} == x86_64 ]]; then
    _extra_config+=("--enable-mpi" "--enable-sse2" "--enable-fma")
  else
    _extra_config+=("--disable-mpi" "--disable-sse2" "--disable-fma")
  fi

  ./configure \
    --prefix=${MINGW_PREFIX} \
    --enable-omp \
    --enable-shared \
    --enable-longlong \
    --enable-longdouble \
    --enable-quad \
    --enable-complex \
    --disable-test \
    --with-gnu-ld \
    ${_extra_config[@]}

  make
}

check() {
  cd "${srcdir}/build-${MSYSTEM}"
  make check || true
}

package() {
  cd "${srcdir}/build-${MSYSTEM}"
  make install DESTDIR="${pkgdir}"

  install -Dm644 COPYING "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE
}

# vim: ts=2 sw=2 et:
