# Maintainer: William D. Jones <thor0505@comcast.net>

_realname=yices
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2.7.0
pkgrel=1
pkgdesc="Yices is a fast SMT solver with C and Python bindings"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://yices.csl.sri.com"
msys2_repository_url='https://github.com/SRI-CSL/yices2'
license=('GPL-3.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-gmp")
makedepends=(
  'dos2unix'
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-gperf"
)
source=("https://github.com/SRI-CSL/yices2/archive/${_realname}-${pkgver}.tar.gz")
sha256sums=('584db72abf6643927b2c3ba98ff793f602216b452b8ff2f34a8851d35904804a')

prepare() {
  cd "${_realname}-${pkgver}"

  if [[ "${MINGW_PACKAGE_PREFIX}" == *-clang-* ]]; then
    sed -i "s/-Wl,--no-undefined //g" src/Makefile
  fi
}

build() {
  cd "${_realname}-${pkgver}"

  local build
  local mode

  # Autodetection of build architecture isn't great within the build system.
  # Using config.guess directly works.
  build=$(./config.guess)

  if check_option "debug" "y"; then
    mode="debug"
  else
    mode="release"
  fi

  export CFLAGS="${CFLAGS} -fcommon" # workaround gcc 10 being stricter here

  rm -rf "build/${build}-${mode}"

  ./configure \
    --prefix="${MINGW_PREFIX}" \
    --build="${build}"

  MODE="${mode}" make
}

check() {
  cd "${_realname}-${pkgver}"
  # make check # wd/parser-bug-reduced fails as of 2.6.1
}

package() {
  cd "${_realname}-${pkgver}"

  make DESTDIR="${pkgdir}" install

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
