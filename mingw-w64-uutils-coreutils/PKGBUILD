_realname=coreutils
pkgbase=mingw-w64-uutils-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-uutils-${_realname}")
pkgver=0.10.0
pkgrel=2
pkgdesc="Cross-platform Rust rewrite of the GNU coreutils (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/uutils/coreutils'
msys2_repository_url='https://github.com/uutils/coreutils'
msys2_references=(
  'archlinux: uutils-coreutils'
  'purl: pkg:cargo/coreutils'
)
license=('spdx:MIT')
depends=("${MINGW_PACKAGE_PREFIX}-oniguruma"
         "${MINGW_PACKAGE_PREFIX}-openssl"
         "${MINGW_PACKAGE_PREFIX}-cc-libs")
makedepends=("${MINGW_PACKAGE_PREFIX}-rust" "${MINGW_PACKAGE_PREFIX}-pkgconf")
optdepends=("uutils-coreutils: stdbuf support via MSYS libstdbuf")
source=("${url}/archive/${pkgver}/${_realname}-${pkgver}.tar.gz"
        "cksum-openssl.patch::${url}/commit/9d7a644a30f9fd655a3045a78109720a841754cd.patch"
        "uucore-openssl.patch::${url}/commit/f19bba7cce44715124216a8804ad8fd255fba1d5.patch")
sha256sums=('f8e68cd0e3629378f047544ead272161a83211c43f4985a9f52944e5db8f1a44'
            '532b21cf2921e5ae58c7b2c13b9d1d83643e1610d76039148d7d6634872d20d5'
            '2cc79bbbec6114219cfa06b92cef26c94e6052abc8607acd594ab362468f616d')

prepare() {
  cd "${_realname}-${pkgver}"
  cargo fetch --locked --target "${RUST_CHOST}"
  patch -p1 -i ../cksum-openssl.patch
  patch -p1 -i ../uucore-openssl.patch
}

# spliting build() sometimes cause building twice at make build
package() {
  cd "${_realname}-${pkgver}"

  export OPENSSL_NO_VENDOR=1 # statically linked?
  export OPENSSL_STATIC=0
  export OPENSSL_DIR="${MINGW_PREFIX}"
  export RUSTONIG_DYNAMIC_LIBONIG=1
  export RUSTFLAGS="${RUSTFLAGS/+crt-static/-crt-static}"
  export CARGOFLAGS="--features openssl"
  make install \
    DESTDIR="${pkgdir}" \
    PREFIX="${MINGW_PREFIX}" \
    PROG_PREFIX=uu- \
    PROFILE=release \
    LIBSTDBUF_DIR=/usr/lib/uutils-coreutils \
    MULTICALL=y

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/uutils-${_realname}/LICENSE"
}
