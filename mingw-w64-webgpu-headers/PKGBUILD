# Maintainer: Konstantin Podsvirov <konstantin@podsvirov.su>

_realname=webgpu-headers
pkgbase=mingw-w64-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}"
         "${MINGW_PACKAGE_PREFIX}-${_realname}-docs")
pkgver=2026.08.26
_pkgsha=b5ff182caa90e53293f47939716281342c0812ba
pkgrel=1
pkgdesc="C version of the WebGPU JS API, for both native and Wasm (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://webgpu-native.github.io/webgpu-headers/'
msys2_repository_url='https://github.com/webgpu-native/webgpu-headers'
license=('spdx:BSD-3-Clause')
makedepends=("${MINGW_PACKAGE_PREFIX}-doxygen")
source=("${msys2_repository_url}/archive/${_pkgsha}/${_realname}-${_pkgsha}.tar.gz")
sha256sums=('a8481a2121b2bc247e309d973ed5eb090564cd13882ec91f7a7f474db4ced423')

build() {
  cd "${_realname}-${_pkgsha}"

  (cat Doxyfile; echo "WARN_AS_ERROR=NO") | doxygen -

  ! grep -RE '`|>::' doc/generated/**/*.html
}

package_webgpu-headers() {
  cd "${_realname}-${_pkgsha}"

  install -Dm644 -t "${pkgdir}${MINGW_PREFIX}/include/webgpu" webgpu.h

  install -Dm644 -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}" LICENSE
}

package_webgpu-headers-docs() {
  cd "${_realname}-${_pkgsha}"

  pkgdesc+=" (documentation)"
  depends=()

  mkdir -p "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}"
  cp -a doc/generated/html "${pkgdir}${MINGW_PREFIX}/share/doc/${_realname}/html"
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;

# vim:set ts=2 sw=2 et:
