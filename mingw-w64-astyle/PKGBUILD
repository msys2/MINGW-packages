# Maintainer: Ray Donnelly <mingw.android@gmail.com>

_realname=astyle
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=3.6.19
pkgrel=1
pkgdesc='A Free, Fast, and Small Automatic Formatter for C, C++, C++/CLI, Objective-C, C#, and Java Source Code (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://astyle.sourceforge.net/'
msys2_repository_url='https://gitlab.com/saalen/astyle/'
msys2_references=(
  'anitya: 123'
  'archlinux: astyle'
  'gentoo: dev-util/astyle'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=(
  "https://gitlab.com/saalen/${_realname}/-/archive/${pkgver}/${_realname}-${pkgver}.tar.gz"
  "0001-Fix-CMake-install.patch"
)
sha256sums=('7bb1fa11ce24fb94db139bb49e73fd05604b28cd7fb75c0dcbf6661e52d3e43e'
            '052e1e1528ff3bfb5dc90c37c7f7f3dff48d49c35042f0dba4ef565ba85f2f14')

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"

  patch -Np1 -i "${srcdir}/0001-Fix-CMake-install.patch"

  # quickfix for Clang 23
  # https://gitlab.com/saalen/astyle/-/merge_requests/23
  sed -i '1i #include <new>' AStyle/src/ASLocalizer.cpp
}

build() {
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
      -Wno-author \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      -DINSTALL_DOC=ON \
      "${extra_config[@]}" \
      -S "${_realname}-${pkgver}/AStyle" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  cd "${srcdir}/${_realname}-${pkgver}"
  install -Dm644 AStyle/LICENSE.md -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
