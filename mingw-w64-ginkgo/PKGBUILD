# Maintainer: Rafał Brzegowy <rafal.brzegowy@yahoo.com>

_realname=ginkgo
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=1.11.0
pkgrel=1
pkgdesc='Numerical linear algebra software package (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://ginkgo-project.github.io"
msys2_references=(
  'archlinux: ginkgo-hpc'
  'aur: ginkgo-hpc-git'
  'gentoo: sci-libs/ginkgo'
)
license=('spdx:BSD-3-Clause')
depends=(
  "${MINGW_PACKAGE_PREFIX}-hwloc"
  "${MINGW_PACKAGE_PREFIX}-metis"
  "${MINGW_PACKAGE_PREFIX}-omp"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-ninja"
)
source=("https://github.com/ginkgo-project/${_realname}/archive/v${pkgver}/${_realname}-${pkgver}.tar.gz")
sha256sums=('8052c3d5994e1c996ebabe50a169deb565965da4f1c6c02e814ff0c7146c0378')

prepare() {
  cd "${_realname}-${pkgver}"

  # Resolve gko::scoped_device_id_guard(const ReferenceExecutor*, int) when linking libginkgo_omp.dll
  # https://github.com/ginkgo-project/ginkgo/issues/2168
  echo 'target_link_libraries(ginkgo_omp PRIVATE ginkgo_reference)' >> omp/CMakeLists.txt
}

build() {
  declare -a _cmake_opts=(
    -Wno-author
    -GNinja
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}"
    -DCMAKE_BUILD_TYPE=Release
    -DGINKGO_MIXED_PRECISION=ON
    -DGINKGO_BUILD_OMP=ON
    -DGINKGO_BUILD_HWLOC=ON
    -DGINKGO_BUILD_TESTS=OFF
    -DGINKGO_BUILD_BENCHMARKS=OFF
    -DGINKGO_BUILD_EXAMPLES=OFF
    -DGINKGO_ENABLE_HALF=OFF
    -S "${_realname}-${pkgver}"
  )

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
    "${_cmake_opts[@]}" \
    -DBUILD_SHARED_LIBS=OFF \
    -B "build-${MSYSTEM}-static"

  cmake --build "build-${MSYSTEM}-static"

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    cmake \
    "${_cmake_opts[@]}" \
    -DBUILD_SHARED_LIBS=ON \
    -B "build-${MSYSTEM}-shared"

  cmake --build "build-${MSYSTEM}-shared"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}-static"

  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}-shared"

  cd "${srcdir}/${_realname}-${pkgver}"
  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}"
}
