# Maintainer: Biswapriyo Nath <nathbappai@gmail.com>

_realname=zxing-cpp
_pyname="${_realname/-/_}"
pkgbase="mingw-w64-python-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=3.1.1
pkgrel=1
pkgdesc="Python bindings for the zxing-cpp barcode library (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/zxing-cpp/zxing-cpp'
msys2_repository_url='https://github.com/zxing-cpp/zxing-cpp'
msys2_references=(
  'anitya: 207536'
  'aur: python-zxing-cpp'
  'purl: pkg:pypi/zxing-cpp'
)
license=('spdx:Apache-2.0')
depends=(
  "${MINGW_PACKAGE_PREFIX}-cc-libs"
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-zint"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cmake"
  "${MINGW_PACKAGE_PREFIX}-nanobind"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-scikit-build-core"
)
options=('!strip')
source=(
  "https://pypi.org/packages/source/${_realname::1}/${_pyname}/${_pyname}-${pkgver}.tar.gz"
  '0001-fix-build-with-gcc-16.patch'
)
sha256sums=('1051a521b21a9fe206702ad4186aeb195154e3e1badcd99576d030723f36382b'
  'd674137e4a73d7b41ace0eb7aa91fe7b767e9035f2d6eb41e3638723b90f49db')

prepare() {
  cd "${_pyname}-${pkgver}"

  patch -Np1 -i "${srcdir}/0001-fix-build-with-gcc-16.patch"
}

build() {
  cp -r "${_pyname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  local _extra_cxxflags=""
  if [[ ${CXX} != *clang* ]]; then
    # Work around GCC 16 C++20 libstdc++ constructor decloning bug
    # https://gcc.gnu.org/bugzilla/show_bug.cgi?id=125359
    _extra_cxxflags=" -fno-declone-ctor-dtor"
  fi

  CXXFLAGS+="${_extra_cxxflags}" \
    python -m build --wheel --skip-dependency-check --no-isolation \
    -Ccmake.define.ZXING_USE_BUNDLED_ZINT=OFF \
    -Ccmake.define.ZXING_DEPENDENCIES=LOCAL
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix=${MINGW_PREFIX} \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
