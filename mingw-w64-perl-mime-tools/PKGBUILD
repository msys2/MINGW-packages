# Contributor: Mehdi Chinoune <mehdi.chinoune@hotmail.com>

_perlname=MIME-tools
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=5.517
pkgrel=1
pkgdesc="Modules for parsing (and creating!) MIME entities. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/MIME-tools"
msys2_repository_url="https://github.com/Perl-Toolchain-Gang/MIME-tools"
msys2_references=(
  'purl: pkg:cpan/DSKOLL/MIME-tools'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-perl"
         "${MINGW_PACKAGE_PREFIX}-perl-convert-binhex"
         "${MINGW_PACKAGE_PREFIX}-perl-io-stringy"
         "${MINGW_PACKAGE_PREFIX}-perl-mailtools")
makedepends=("${MINGW_PACKAGE_PREFIX}-make")
source=("https://cpan.metacpan.org/authors/id/D/DS/DSKOLL/${_perlname}-${pkgver}.tar.gz")
sha256sums=('e05f8e45d0895164b1fe53a0a8e725dd81e92191a29409e1b48c55f823b03483')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
  install -Dm644 COPYING "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE
}
