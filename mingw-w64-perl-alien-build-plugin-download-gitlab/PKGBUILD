_perlname=Alien-Build-Plugin-Download-GitLab
_realname="${_perlname,,}"
pkgbase=mingw-w64-perl-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-perl-${_realname}")
pkgver=0.01
pkgrel=2
pkgdesc="Alien::Build plugin to download from GitLab. (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://metacpan.org/dist/Alien-Build-Plugin-Download-GitLab"
msys2_repository_url="https://github.com/PerlAlien/Alien-Build-Plugin-Download-GitLab"
msys2_references=(
  'purl: pkg:cpan/PLICEASE/Alien-Build-Plugin-Download-GitLab'
)
license=('spdx:Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=("${MINGW_PACKAGE_PREFIX}-perl"
         "${MINGW_PACKAGE_PREFIX}-perl-alien-build"
         "${MINGW_PACKAGE_PREFIX}-perl-path-tiny"
         "${MINGW_PACKAGE_PREFIX}-perl-uri")
makedepends=("${MINGW_PACKAGE_PREFIX}-make")
source=("https://cpan.metacpan.org/authors/id/P/PL/PLICEASE/${_perlname}-${pkgver}.tar.gz")
sha256sums=('c1f089c8ea152a789909d48a83dbfcf2626f773daf30431c8622582b26aba902')

build() {
  cp -r ${_perlname}-${pkgver} build-${MSYSTEM} && cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  PERL_MM_USE_DEFAULT=1 \
    perl Makefile.PL \
    PREFIX=${MINGW_PREFIX}
  mingw32-make
}

package() {
  cd build-${MSYSTEM}
  MSYS2_ARG_CONV_EXCL="PREFIX=" \
  mingw32-make DESTDIR="${pkgdir}/" install
  install -Dm644 LICENSE "${pkgdir}"${MINGW_PREFIX}/share/licenses/perl-${_realname}/LICENSE
}
