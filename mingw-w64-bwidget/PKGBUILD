# Based on Arch's PKGBUILD

_realname='bwidget'
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=1.10.1
pkgrel=1
pkgdesc='A companion to Tcllib, for Tk related packages (mingw-w64)'
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://core.tcl.tk/bwidget/home'
msys2_references=(
  'anitya: 14646'
  'aur: bwidget'
  'gentoo: dev-tcltk/bwidget'
)
license=('spdx:BSD-2-Clause')
depends=(
  "${MINGW_PACKAGE_PREFIX}-tk"
)
source=(
  "https://downloads.sourceforge.net/project/tcllib/BWidget/${pkgver}/bwidget-${pkgver}.tar.gz"
)
sha256sums=('4aea02f38cf92fa4aa44732d4ed98648df839e6537d6f0417c3fe18e1a34f880')

package() {
  local _libdir="${pkgdir}${MINGW_PREFIX}/lib"

  install -dm755 "${_libdir}"
  cp -r "bwidget-${pkgver}" "${_libdir}/"

  rm -rf "${_libdir}/bwidget-${pkgver}"/{.fslckout,Changelog,demo,tests}
}
