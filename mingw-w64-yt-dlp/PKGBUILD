# Maintainer: Biswapriyo Nath <nathbappai@gmail.com>

_realname=yt-dlp
pkgbase="mingw-w64-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}")
pkgver=2026.10.26
pkgrel=1
pkgdesc="A youtube-dl fork with additional features and fixes (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url='https://github.com/yt-dlp/yt-dlp/'
msys2_repository_url='https://github.com/yt-dlp/yt-dlp'
msys2_references=(
  'anitya: 143399'
  'archlinux: yt-dlp'
  'aur:' # ignore neodlp
  'cpe: cpe:/a:yt-dlp_project:yt-dlp'
  'gentoo: net-misc/yt-dlp'
  'purl: pkg:pypi/yt-dlp'
)
license=('spdx:Unlicense')
depends=(
  "${MINGW_PACKAGE_PREFIX}-python-brotli"
  "${MINGW_PACKAGE_PREFIX}-python-certifi"
  "${MINGW_PACKAGE_PREFIX}-python-mutagen"
  "${MINGW_PACKAGE_PREFIX}-python-pycryptodomex"
  "${MINGW_PACKAGE_PREFIX}-python-requests"
  "${MINGW_PACKAGE_PREFIX}-python-urllib3"
  "${MINGW_PACKAGE_PREFIX}-python-websockets"
  "${MINGW_PACKAGE_PREFIX}-yt-dlp-ejs"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-hatchling"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-pytest"
)
optdepends=(
  "${MINGW_PACKAGE_PREFIX}-aria2: for using aria2 as external downloader"
  "${MINGW_PACKAGE_PREFIX}-ffmpeg: for video post-processing"
  "${MINGW_PACKAGE_PREFIX}-nodejs: JavaScript runtime (--js-runtimes node)"
  "${MINGW_PACKAGE_PREFIX}-quickjs: JavaScript runtime (--js-runtimes quickjs)"
  "${MINGW_PACKAGE_PREFIX}-quickjs-ng: JavaScript runtime (--js-runtimes quickjs)"
)
options=('!strip')
source=("${_realname}-${pkgver}.tar.gz::https://github.com/yt-dlp/yt-dlp/releases/download/${pkgver}/yt-dlp.tar.gz")
sha256sums=('21f942d258d25cc4e60b4982a25c423460f0bebb835f38e6dfd1fcb140087f95')

build() {
  cp -r "${_realname}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "build-${MSYSTEM}"

  python -m pytest || warning "Tests failed"
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix"=${MINGW_PREFIX}" \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
