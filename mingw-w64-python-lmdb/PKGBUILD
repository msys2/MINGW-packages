# Maintainer: Egor Savkin <es@m-labs.hk>

_realname=lmdb
pkgbase="mingw-w64-python-${_realname}"
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=3.0.0
pkgrel=1
pkgdesc="Universal Python binding for the LMDB 'Lightning' Database (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://github.com/jnwatson/py-lmdb"
msys2_repository_url='https://github.com/jnwatson/py-lmdb'
msys2_references=(
  'cpe: cpe:/a:py-lmdb_project:py-lmdb'
  'purl: pkg:pypi/lmdb'
)
license=('spdx:OLDAP-2.8')
depends=(
  "${MINGW_PACKAGE_PREFIX}-lmdb"
  "${MINGW_PACKAGE_PREFIX}-python"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
source=(
  "https://pypi.org/packages/source/${_realname::1}/${_realname}/${_realname}-${pkgver}.tar.gz"
  "001-py-lmdb-1.4.1-mingw-build.patch"
)
sha256sums=('06dda0723545e14d56ac7dcd6f582d9922c2ed5e16f1c3f8d0e670a96ec2ee65'
            '32615e568ada211e9f2e0c8e48b6b8b9b63f26ee55d6bb61406c9b4869ce9c83')

prepare() {
  cp -r "${_realname}-${pkgver}" "build-${MSYSTEM}" && cd "build-${MSYSTEM}"

  patch -Np1 -i "${srcdir}/001-py-lmdb-1.4.1-mingw-build.patch"
}

build() {
  cd "build-${MSYSTEM}"

  LMDB_FORCE_SYSTEM=1 \
    python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  cd "build-${MSYSTEM}"

  local _libdir=(build/lib.*)
  cd "${_libdir[0]}"

  # py-lmdb carries ~25 downstream patches but our system ldmb
  # will fail some explicitly corruption tests
  LMDB_FORCE_SYSTEM=1 \
    python -m pytest ../../tests
}

package() {
  cd "build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="--prefix=;--install-scripts=;--install-purelib=;" \
    python -m installer --prefix="${MINGW_PREFIX}" \
    --destdir="${pkgdir}" dist/*.whl

  install -Dm644 LICENSE -t "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}"
}
