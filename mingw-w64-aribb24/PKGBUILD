# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_realname=aribb24
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=1.0.4
pkgrel=1
pkgdesc="A library for ARIB STD-B24, decoding JIS 8 bit characters and parsing MPEG-TS stream (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64' 'clangarm64')
url="https://code.videolan.org/jeeb/aribb24"
msys2_repository_url='https://code.videolan.org/jeeb/aribb24'
license=("spdx:LGPL-3.0-or-later")
depends=(
  "${MINGW_PACKAGE_PREFIX}-libpng"
)
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-autotools"
  "${MINGW_PACKAGE_PREFIX}-cc"
)
_archive="${_realname}-v${pkgver}"
source=(
  "https://code.videolan.org/jeeb/aribb24/-/archive/v${pkgver}/${_archive}.tar.bz2"
  001-no-undefined.patch
)
sha256sums=('88b58dd760609372701087e25557ada9f7c6d973306c017067c5dcaf9e2c9710'
            '2832363ed204051fbc34c34da0fbac993e7bc0213de3a34baf37b2622da87657')

prepare() {
  cd "${srcdir}/${_archive}"
  patch -p1 -i "${srcdir}"/001-no-undefined.patch
  autoreconf -fiv
}

build() {
  mkdir -p "${srcdir}/build-${MSYSTEM}" && cd "${srcdir}/build-${MSYSTEM}"

  "../${_archive}/configure" \
    --prefix=${MINGW_PREFIX} \
    --enable-static \
    --enable-shared

  make
}

package() {
  cd "${srcdir}/build-${MSYSTEM}"

  make -j1 DESTDIR="${pkgdir}" install

  install -Dm644 "${srcdir}/${_archive}/COPYING" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
