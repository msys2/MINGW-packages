--- a/build/gen.py
+++ b/build/gen.py
@@ -584,6 +584,26 @@
                      '-D_WIN32_WINNT=0x0A00',
                      '-D_HAS_EXCEPTIONS=0'
       ])
+      # gen.py defaults to -O3 for release builds. That has been observed to
+      # miscompile gn with GCC targeting msvcrt: the resulting gn.exe
+      # segfaulted inside 'gn gen', while the very same sources built with
+      # clang, or with GCC targeting ucrt, ran fine. gn is a short-lived
+      # meta-build tool, so keep the optimizer conservative. Note that the
+      # env CFLAGS/CXXFLAGS are prepended BEFORE the defaults above, so this
+      # -O1 wins over any -O2/-O3 inherited from the environment, too.
+      cflags.append('-O1')
+      ldflags.append('-O1')
+      if is_gcc(cxx):
+        # GNU ld reserves only 2 MiB of stack on Windows, while gn enjoys
+        # the 8 MiB POSIX default everywhere else; its BUILD.gn parser and
+        # the script evaluator recurse per template/condition scope, so
+        # give the bootstrap the same headroom. (Clang/LLVM builds keep
+        # their linker defaults; they have shown no such problem.)
+        ldflags.append('-Wl,--stack,0x800000')
+      # Packaging escape hatches, applied LAST (they win over everything
+      # above): e.g. GN_CFLAGS="-O0" rebuilds a gn.exe that still crashes.
+      cflags += os.environ.get('GN_CFLAGS', '').split()
+      ldflags += os.environ.get('GN_LDFLAGS', '').split()
   elif platform.is_msvc():
     if not options.debug:
       cflags.extend(['/O2', '/DNDEBUG', '/Zc:inline'])
