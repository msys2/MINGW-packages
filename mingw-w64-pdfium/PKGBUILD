# PDFium does not publish version tags; its releases are the per-milestone
# branch heads "chromium/<version>" on pdfium.googlesource.com. This package
# tracks the latest branch head.
_realname=pdfium
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=8096
pkgrel=1
pkgdesc="PDF rendering library from Chromium's PDFium project (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://pdfium.googlesource.com/pdfium/"
msys2_repository_url="https://pdfium.googlesource.com/pdfium/"
msys2_references=(
  'aur: pdfium'
)
license=('spdx:BSD-3-Clause')

