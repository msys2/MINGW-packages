# googlesource archives have no top-level directory
noextract=("pdfium-*.tar.gz")

apply_patch_with_msg() {
  for _patch in "$@"
  do
    msg2 "Applying ${_patch}"
    patch -Np1 -i "${srcdir}/${_patch}"
  done
}

prepare() {
  msg2 "Assembling standalone pdfium source tree"

  # With noextract=() above, makepkg leaves the tarballs in $SRCDEST
  # (falling back to $startdir when SRCDEST is unset, and $srcdir for
  # some makepkg versions / local-source setups).
  local _sdest=""
  local _cand
  for _cand in "${SRCDEST}" "${startdir}" "${srcdir}"; do
    if [[ -n "${_cand}" && -f "${_cand}/pdfium-${_pdfium_rev}.tar.gz" ]]; then
      _sdest="${_cand}"
      break
    fi
  done
  if [[ -z "${_sdest}" ]]; then
    echo "pdfium source tarballs not found in SRCDEST/startdir/srcdir" >&2
    return 1
  fi

  # Main checkout (the googlesource archive has no top-level directory).
  mkdir -p "${srcdir}/${_realname}"
  cd "${srcdir}/${_realname}"
  tar -xzf "${_sdest}/pdfium-${_pdfium_rev}.tar.gz"

  # Dependencies pinned by pdfium's DEPS, assembled without depot_tools.
  mkdir -p build buildtools
  mkdir -p third_party/{abseil-cpp,dragonbox/src,fast_float/src,googletest/src,harfbuzz/src,libjpeg_turbo,libyuv,nasm,simdutf,test_fonts,freetype/src,icu}
  mkdir -p build/util
  tar -xzf "${_sdest}/pdfium-build-${_build_rev}.tar.gz"            -C build
  tar -xzf "${_sdest}/pdfium-buildtools-${_buildtools_rev}.tar.gz"  -C buildtools
  tar -xzf "${_sdest}/pdfium-abseil-cpp-${_abseil_rev}.tar.gz"      -C third_party/abseil-cpp
  tar -xzf "${_sdest}/pdfium-dragonbox-${_dragonbox_rev}.tar.gz"    -C third_party/dragonbox/src
  tar -xzf "${_sdest}/pdfium-fast_float-${_fast_float_rev}.tar.gz"  -C third_party/fast_float/src
  tar -xzf "${_sdest}/pdfium-googletest-${_gtest_rev}.tar.gz"       -C third_party/googletest/src
  tar -xzf "${_sdest}/pdfium-libyuv-${_libyuv_rev}.tar.gz"          -C third_party/libyuv
  tar -xzf "${_sdest}/pdfium-simdutf-${_simdutf_rev}.tar.gz"        -C third_party/simdutf
  tar -xzf "${_sdest}/pdfium-harfbuzz-${_harfbuzz_rev}.tar.gz"      -C third_party/harfbuzz/src
  tar -xzf "${_sdest}/pdfium-freetype2-${_freetype_rev}.tar.gz"     -C third_party/freetype/src
  tar -xzf "${_sdest}/pdfium-icu-${_icu_rev}.tar.gz"                -C third_party/icu
  tar -xzf "${_sdest}/pdfium-libjpeg_turbo-${_libjpeg_rev}.tar.gz"  -C third_party/libjpeg_turbo
  tar -xzf "${_sdest}/pdfium-nasm-${_nasm_rev}.tar.gz"              -C third_party/nasm
  tar -xzf "${_sdest}/pdfium-test_fonts-${_test_fonts_rev}.tar.gz"  -C third_party/test_fonts

  # gn, bootstrapped from source (see the comment at _gn_rev above).
  mkdir -p "${srcdir}/gn-src"
  tar -xzf "${_sdest}/pdfium-gn-${_gn_rev}.tar.gz"                  -C "${srcdir}/gn-src"

  apply_patch_with_msg \
    001-pdfium-mingw-build.patch
  msg2 "Applying 101-build-mingw-toolchain.patch"
  patch -d build -Np1 -i "${srcdir}/101-build-mingw-toolchain.patch"
  msg2 "Applying 201-icu-mingw.patch"
  patch -d third_party/icu -Np1 -i "${srcdir}/201-icu-mingw.patch"
  msg2 "Applying 202-libjpeg-turbo-mingw.patch"
  patch -d third_party/libjpeg_turbo -Np1 -i "${srcdir}/202-libjpeg-turbo-mingw.patch"
  msg2 "Applying 203-libyuv-mingw.patch"
  patch -d third_party/libyuv -Np1 -i "${srcdir}/203-libyuv-mingw.patch"
  msg2 "Applying 204-abseil-cpp-mingw.patch"
  patch -d third_party/abseil-cpp -Np1 -i "${srcdir}/204-abseil-cpp-mingw.patch"
  msg2 "Applying 205-buildtools-libcxx-mingw.patch"
  patch -d buildtools -Np1 -i "${srcdir}/205-buildtools-libcxx-mingw.patch"
  msg2 "Applying 301-gn-gen-mingw.patch"
  patch -d "${srcdir}/gn-src" -Np1 -i "${srcdir}/301-gn-gen-mingw.patch"
  msg2 "Applying 302-gn-missing-header.patch"
  patch -d "${srcdir}/gn-src" -Np1 -i "${srcdir}/302-gn-missing-header.patch"
  msg2 "Applying 303-gn-msvc-flags.patch"
  patch -d "${srcdir}/gn-src" -Np1 -i "${srcdir}/303-gn-msvc-flags.patch"
  msg2 "Applying 304-gn-arm64-arch.patch"
  patch -d "${srcdir}/gn-src" -Np1 -i "${srcdir}/304-gn-arm64-arch.patch"
  msg2 "Applying 305-gn-bootstrap-hardening.patch"
  patch -d "${srcdir}/gn-src" -Np1 -i "${srcdir}/305-gn-bootstrap-hardening.patch"

  # Pin the script interpreter used by gn itself
  local _gn_python="" _pycand
  if command -v cygpath >/dev/null 2>&1; then
    for _pycand in python3.exe python.exe; do
      if [[ -f "${MINGW_PREFIX}/bin/${_pycand}" ]]; then
        _gn_python="$(cygpath -m "${MINGW_PREFIX}/bin/${_pycand}")"
        break
      fi
    done
    if [[ -z "${_gn_python}" ]]; then
      echo "native python not found under ${MINGW_PREFIX}/bin;" >&2
      echo "please install ${MINGW_PACKAGE_PREFIX}-python" >&2
      return 1
    fi
  else
    # POSIX host (packaging-time regression runs): a POSIX python3 is
    # the correct interpreter there.
    _gn_python="$(command -v python3 || true)"
    if [[ -z "${_gn_python}" ]]; then
      echo "python3 not found on PATH" >&2
      return 1
    fi
  fi
  {
    echo
    echo "# MSYS2 packaging: pin the script interpreter to the native MinGW"
    echo "# Python (absolute path); a bare \"python3\" may resolve through PATH"
    echo "# to the MSYS2 POSIX Python, which cannot open gn's Windows-style"
    echo "# absolute script paths."
    echo "script_executable = \"${_gn_python}\""
  } >> .gn
  # Files normally generated by `gclient sync` / its hooks.
  cat > build/config/gclient_args.gni <<GCLIENTEOF
# Generated for this standalone build; mirrors gclient's gclient_gn_args.
android_ndk_version = "2@30.0.16248370"
build_with_chromium = false
checkout_android = false
checkout_libpng = false
checkout_skia = false
checkout_configuration = "minimal"
checkout_v8 = false
checkout_rust = false
checkout_testing_corpus = false
checkout_win = false
checkout_mac = false
checkout_linux = false
non_git_source = true
GCLIENTEOF
  date +%s > build/util/LASTCHANGE.committime
}

build() {
  # Make sure every spawned tool resolves the native MinGW toolchain and
  # Python first (the pkg-config.py wrapper, action scripts, ...), never
  # the MSYS2 POSIX equivalents in /usr/bin.
  export PATH="${MINGW_PREFIX}/bin:${PATH}"

  # Toolchain selection per MSYS2 environment. MSYSTEM is uppercase in
  # MSYS2 shells (UCRT64, CLANG64, ...), so normalize before matching.
  case "${MSYSTEM,,}" in
    clang64|clangarm64)
      _is_clang=true
      _cc="clang"
      _cxx="clang++"
      ;;
    *)
      _is_clang=false
      _cc="gcc"
      _cxx="g++"
      ;;
  esac
  case "${MSYSTEM,,}" in
    clangarm64) _target_cpu="arm64" ;;
    *)          _target_cpu="x64" ;;
  esac

  # Bootstrap gn from the pinned sources (see _gn_rev above): the distro
  # mingw-w64-*-gn binaries are not used, so every environment builds the
  # exact same meta-generator with the same toolchain that compiles pdfium.
  _bootstrap_gn() {
    local _gn_cflags="${1:-}"
    ( cd "${srcdir}/gn-src" \
        && CFLAGS="" CXXFLAGS="" LDFLAGS="" \
           CXX="${_cxx}" LD="${_cxx}" AR="ar" GN_CFLAGS="${_gn_cflags}" \
           python3 build/gen.py --allow-warnings --no-static-libstdc++ \
        && ninja -C out gn.exe )
  }

  local _gn_bin="${srcdir}/gn-src/out/gn"
  if [[ ! -f "${_gn_bin}" && ! -f "${_gn_bin}.exe" ]]; then
    msg2 "Bootstrapping gn (${_gn_rev})"
    # gen.py names the link target with the platform executable extension,
    _bootstrap_gn "" || return 1
  fi
  [[ -f "${_gn_bin}.exe" ]] && _gn_bin="${_gn_bin}.exe"
  if [[ ! -f "${_gn_bin}" ]]; then
    echo "gn bootstrap failed" >&2
    return 1
  fi

  # Build inside the source tree (out-<MSYSTEM> under the pdfium checkout)
  mkdir -p "${srcdir}/${_realname}/out-${MSYSTEM}"
  cd "${srcdir}/${_realname}/out-${MSYSTEM}"

  if check_option "debug" "y"; then
    _is_debug=true
    _symbol_level=1
  else
    _is_debug=false
    _symbol_level=0
  fi

  cat > args.gn <<ARGSGNEOF
# MSYS2 MINGW build for pdfium (generated by the PKGBUILD).
target_os = "win"
target_cpu = "${_target_cpu}"
is_mingw = true
# MSYS2 MINGW toolchains only provide UNPREFIXED tool names on PATH
# (ar.exe, gcc.exe, ...; the \${MINGW_CHOST}-* variants of binutils live
# in a dedicated subdirectory that is not searched), so use plain names.
mingw_toolprefix = ""
mingw_cc = "${_cc}"
mingw_cxx = "${_cxx}"
mingw_ar = "ar"
is_clang = ${_is_clang}
is_debug = ${_is_debug}
symbol_level = ${_symbol_level}
is_component_build = false
treat_warnings_as_errors = false
fatal_linker_warnings = false
pdf_is_standalone = true
pdf_enable_v8 = false
pdf_enable_xfa = false
pdf_use_partition_alloc = false
use_custom_libcxx = false
use_system_zlib = true
use_system_libpng = true
use_system_libjpeg = true
use_system_lcms2 = true
# Bundled (in-repo) openjpeg2 and DEPS-pinned harfbuzz: the system variants
# are wired via pkg-config, whose POSIX-style include paths the native MinGW
# toolchain cannot consume, and both install headers in nested directories
# (openjpeg.h under include/openjpeg-2.5, hb-subset.h under include/harfbuzz)
# that the compiler's default search path does not cover.
use_system_libopenjpeg2 = false
use_system_harfbuzz = false
clang_use_chrome_plugins = false
clang_unsafe_buffers_paths = ""
clang_warning_suppression_file = ""
clang_base_path = "${MINGW_PREFIX}"
use_sysroot = false
ARGSGNEOF

  # 'gn gen' runs the freshly bootstrapped gn.exe; on mingw64 a gn.exe
  # built at gen.py's default -O3 has been observed to segfault here
  # (GCC + msvcrt miscompile; patch 305 now builds the bootstrap at -O1
  # with an 8 MiB stack). Should it still crash, rebuild it at -O0 and
  # retry once before giving up with diagnostics.
  if ! "${_gn_bin}" gen . ; then
    warning "'gn gen' failed in ${MSYSTEM}; rebuilding gn with -O0 and retrying"
    rm -rf "${srcdir}/gn-src/out"
    _bootstrap_gn "-O0" || return 1
    if ! "${_gn_bin}" gen . ; then
      error "'gn gen' still fails in the ${MSYSTEM} environment"
      error "Please capture a backtrace and attach it to the report:"
      error "  cd '${srcdir}/${_realname}/out-${MSYSTEM}'"
      error "  gdb -q -batch -ex run -ex bt --args '${srcdir}/gn-src/out/gn.exe' gen ."
      return 1
    fi
  fi
  ninja pdfium
}

package() {
  local _build="${srcdir}/${_realname}/out-${MSYSTEM}"
  local _prefix="${pkgdir}${MINGW_PREFIX}"

  cd "${srcdir}/${_realname}"

  install -Dm755 "${_build}/libpdfium.dll" "${_prefix}/bin/libpdfium.dll"
  install -Dm644 "${_build}/libpdfium.dll.a" "${_prefix}/lib/libpdfium.dll.a"

  while read -r _header; do
    install -Dm644 "${_header}" "${_prefix}/include/pdfium/${_header#public/}"
  done < <(find public -maxdepth 1 -name 'fpdf*.h' -type f)

  install -d "${_prefix}/lib/pkgconfig"
  cat > "${_prefix}/lib/pkgconfig/pdfium.pc" <<PCEOF
prefix=${MINGW_PREFIX}
libdir=\${prefix}/lib
includedir=\${prefix}/include/pdfium

Name: pdfium
Description: PDFium - PDF rendering library from Chromium
Version: ${pkgver}
Libs: -L\${libdir} -lpdfium
Cflags: -I\${includedir}
PCEOF

  install -Dm644 LICENSE "${_prefix}/share/licenses/${_realname}/LICENSE"
}
