# Integrity note: the googlesource gitiles "+archive" endpoints build each
# tarball on the fly and stamp every tar header with the archive generation
# time, so the byte stream (and its sha256) differs on every download of the
# very same URL. Static checksums are therefore impossible for these sources
# and integrity is anchored by the exact commit SHA pinned in each URL above.
# The local patch files below are still verified with real sha256sums.
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'fb50f36b1a94df37a57ca81f9756468fabde0fb8b0f095755e2a9cfaa70b426f'
            '5cd6c7df5766c85a35fdc0d7f3df1c366d84d33a647924bec452efd92d378487'
            'ec33129d47e77448e32b69d20fa4a0af2ce5a1e30c638f38a2dd64877d26c555'
            'b472ee97d734ce34938b89e7a4d8bedf7a97527ebbe6c46b042722e16b0baad1'
            'd63d5548627666e4c15f0307837195f9e595982c5ae1c2e1c12f0e120dd0c9b1'
            '9cf6a5e9e576d38898bc8f9586f542f0731577e281334990ca64e35d5fe1c22f'
            '8ed528985b8a157df60605bddaa9a2c859b6fda046e3778f73b533681717f598')

# googlesource archives have no top-level directory: makepkg's automatic
# bsdtar extraction would spill every archive flat into $srcdir, mixing all
# trees and dropping a stray .gn into $srcdir, which then hijacks gn's
# source-root detection ("Unable to load //build/dotfile_settings.gni").
# Skip automatic extraction and unpack into the assembled tree in prepare()
# instead; makepkg still downloads and checksum-verifies the tarballs.
noextract=("pdfium-*.tar.gz")

apply_patch_with_msg() {
  for _patch in "$@"
  do
    msg2 "Applying ${_patch}"
    patch -Np1 -i "${srcdir}/${_patch}"
  done
}

prepare() {
  msg2 "Assembling standalone pdfium source tree"

  # With noextract=() above, makepkg leaves the tarballs in $SRCDEST
  # (falling back to $startdir when SRCDEST is unset, and $srcdir for
  # some makepkg versions / local-source setups).
  local _sdest=""
  local _cand
  for _cand in "${SRCDEST}" "${startdir}" "${srcdir}"; do
    if [[ -n "${_cand}" && -f "${_cand}/pdfium-${_pdfium_rev}.tar.gz" ]]; then
      _sdest="${_cand}"
      break
    fi
  done
  if [[ -z "${_sdest}" ]]; then
    echo "pdfium source tarballs not found in SRCDEST/startdir/srcdir" >&2
    return 1
  fi

  # Main checkout (the googlesource archive has no top-level directory).
  mkdir -p "${srcdir}/${_realname}"
  cd "${srcdir}/${_realname}"
  tar -xzf "${_sdest}/pdfium-${_pdfium_rev}.tar.gz"

  # Dependencies pinned by pdfium's DEPS, assembled without depot_tools.
  mkdir -p build buildtools
  mkdir -p third_party/{abseil-cpp,dragonbox/src,fast_float/src,googletest/src,libjpeg_turbo,libyuv,nasm,simdutf,test_fonts,freetype/src,icu}
  mkdir -p build/util
  tar -xzf "${_sdest}/pdfium-build-${_build_rev}.tar.gz"            -C build
  tar -xzf "${_sdest}/pdfium-buildtools-${_buildtools_rev}.tar.gz"  -C buildtools
  tar -xzf "${_sdest}/pdfium-abseil-cpp-${_abseil_rev}.tar.gz"      -C third_party/abseil-cpp
  tar -xzf "${_sdest}/pdfium-dragonbox-${_dragonbox_rev}.tar.gz"    -C third_party/dragonbox/src
  tar -xzf "${_sdest}/pdfium-fast_float-${_fast_float_rev}.tar.gz"  -C third_party/fast_float/src
  tar -xzf "${_sdest}/pdfium-googletest-${_gtest_rev}.tar.gz"       -C third_party/googletest/src
  tar -xzf "${_sdest}/pdfium-libyuv-${_libyuv_rev}.tar.gz"          -C third_party/libyuv
  tar -xzf "${_sdest}/pdfium-simdutf-${_simdutf_rev}.tar.gz"        -C third_party/simdutf
  tar -xzf "${_sdest}/pdfium-freetype2-${_freetype_rev}.tar.gz"     -C third_party/freetype/src
  tar -xzf "${_sdest}/pdfium-icu-${_icu_rev}.tar.gz"                -C third_party/icu
  tar -xzf "${_sdest}/pdfium-libjpeg_turbo-${_libjpeg_rev}.tar.gz"  -C third_party/libjpeg_turbo
  tar -xzf "${_sdest}/pdfium-nasm-${_nasm_rev}.tar.gz"              -C third_party/nasm
  tar -xzf "${_sdest}/pdfium-test_fonts-${_test_fonts_rev}.tar.gz"  -C third_party/test_fonts

  apply_patch_with_msg \
    001-pdfium-mingw-build.patch
  msg2 "Applying 101-build-mingw-toolchain.patch"
  patch -d build -Np1 -i "${srcdir}/101-build-mingw-toolchain.patch"
  msg2 "Applying 201-icu-mingw.patch"
  patch -d third_party/icu -Np1 -i "${srcdir}/201-icu-mingw.patch"
  msg2 "Applying 202-libjpeg-turbo-mingw.patch"
  patch -d third_party/libjpeg_turbo -Np1 -i "${srcdir}/202-libjpeg-turbo-mingw.patch"
  msg2 "Applying 203-libyuv-mingw.patch"
  patch -d third_party/libyuv -Np1 -i "${srcdir}/203-libyuv-mingw.patch"
  msg2 "Applying 204-abseil-cpp-mingw.patch"
  patch -d third_party/abseil-cpp -Np1 -i "${srcdir}/204-abseil-cpp-mingw.patch"
  msg2 "Applying 205-buildtools-libcxx-mingw.patch"
  patch -d buildtools -Np1 -i "${srcdir}/205-buildtools-libcxx-mingw.patch"

  # Files normally generated by `gclient sync` / its hooks.
  cat > build/config/gclient_args.gni <<GCLIENTEOF
# Generated for this standalone build; mirrors gclient's gclient_gn_args.
android_ndk_version = "2@30.0.16248370"
build_with_chromium = false
checkout_android = false
checkout_libpng = false
checkout_skia = false
checkout_configuration = "minimal"
checkout_v8 = false
checkout_rust = false
checkout_testing_corpus = false
checkout_win = false
checkout_mac = false
checkout_linux = false
non_git_source = true
GCLIENTEOF
  date +%s > build/util/LASTCHANGE.committime
}

build() {
  # Toolchain selection per MSYS2 environment.
  case "${MSYSTEM}" in
    clang64|clangarm64)
      _is_clang=true
      _cc="clang"
      _cxx="clang++"
      ;;
    *)
      _is_clang=false
      _cc="gcc"
      _cxx="g++"
      ;;
  esac
  case "${MSYSTEM}" in
    clangarm64) _target_cpu="arm64" ;;
    *)          _target_cpu="x64" ;;
  esac

  # Build inside the source tree (out-<MSYSTEM> under the pdfium checkout):
  # gn finds the source root (.gn) by walking up from the output directory,
  # so the output directory MUST be a descendant of ${srcdir}/${_realname}.
  mkdir -p "${srcdir}/${_realname}/out-${MSYSTEM}"
  cd "${srcdir}/${_realname}/out-${MSYSTEM}"

  if check_option "debug" "y"; then
    _is_debug=true
    _symbol_level=1
  else
    _is_debug=false
    _symbol_level=0
  fi

  cat > args.gn <<ARGSGNEOF
# MSYS2 MINGW build for pdfium (generated by the PKGBUILD).
target_os = "win"
target_cpu = "${_target_cpu}"
is_mingw = true
mingw_toolprefix = "${MINGW_CHOST}-"
mingw_cc = "${_cc}"
mingw_cxx = "${_cxx}"
mingw_ar = "${MINGW_CHOST}-ar"
is_clang = ${_is_clang}
is_debug = ${_is_debug}
symbol_level = ${_symbol_level}
is_component_build = false
treat_warnings_as_errors = false
fatal_linker_warnings = false
pdf_is_standalone = true
pdf_enable_v8 = false
pdf_enable_xfa = false
pdf_use_partition_alloc = false
use_custom_libcxx = false
use_system_zlib = true
use_system_libpng = true
use_system_libjpeg = true
use_system_lcms2 = true
use_system_libopenjpeg2 = true
use_system_harfbuzz = true
clang_use_chrome_plugins = false
clang_unsafe_buffers_paths = ""
clang_warning_suppression_file = ""
clang_base_path = "${MINGW_PREFIX}"
use_sysroot = false
ARGSGNEOF

  gn gen .
  ninja pdfium
}

package() {
  local _build="${srcdir}/${_realname}/out-${MSYSTEM}"
  local _prefix="${pkgdir}${MINGW_PREFIX}"

  cd "${srcdir}/${_realname}"

  install -Dm755 "${_build}/libpdfium.dll" "${_prefix}/bin/libpdfium.dll"
  install -Dm644 "${_build}/libpdfium.dll.a" "${_prefix}/lib/libpdfium.dll.a"

  while read -r _header; do
    install -Dm644 "${_header}" "${_prefix}/include/pdfium/${_header#public/}"
  done < <(find public -maxdepth 1 -name 'fpdf*.h' -type f)

  install -d "${_prefix}/lib/pkgconfig"
  cat > "${_prefix}/lib/pkgconfig/pdfium.pc" <<PCEOF
prefix=${MINGW_PREFIX}
libdir=\${prefix}/lib
includedir=\${prefix}/include/pdfium

Name: pdfium
Description: PDFium - PDF rendering library from Chromium
Version: ${pkgver}
Libs: -L\${libdir} -lpdfium
Cflags: -I\${includedir}
PCEOF

  install -Dm644 LICENSE "${_prefix}/share/licenses/${_realname}/LICENSE"
}
