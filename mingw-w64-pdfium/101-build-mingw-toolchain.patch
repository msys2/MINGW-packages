diff --git a/toolchain/mingw/BUILD.gn b/toolchain/mingw/BUILD.gn
new file mode 100644
index 0000000..5635d2d
--- /dev/null
+++ b/toolchain/mingw/BUILD.gn
@@ -0,0 +1,75 @@
+# Copyright 2026 The PDFium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# Toolchains for MSYS2 MINGW environments (MinGW-w64 GCC or LLVM-MinGW style
+# clang targeting *-w64-mingw32), used when the gn arg `is_mingw` is true and
+# target_os is "win".
+#
+# Tool selection is controlled by gn args so the same file works for the four
+# MSYS2 environments (mingw64, ucrt64, clang64, clangarm64) and for
+# cross-building from POSIX hosts:
+#   mingw_toolprefix - prefix for the tool names, e.g. "x86_64-w64-mingw32-".
+#                      May be empty when tools are already on PATH.
+#   mingw_cc, mingw_cxx, mingw_ar, mingw_ld, mingw_strip
+#                    - explicit tool overrides; when empty they are derived
+#                      from mingw_toolprefix with GCC-style names.
+
+import("//build/toolchain/gcc_toolchain.gni")
+
+assert(is_mingw, "mingw toolchains require is_mingw = true")
+
+template("mingw_toolchain") {
+  gcc_toolchain(target_name) {
+    toolprefix = mingw_toolprefix
+    if (mingw_cc == "") {
+      cc = "${toolprefix}gcc"
+    } else {
+      cc = mingw_cc
+    }
+    if (mingw_cxx == "") {
+      cxx = "${toolprefix}g++"
+    } else {
+      cxx = mingw_cxx
+    }
+    if (mingw_ar == "") {
+      ar = "${toolprefix}ar"
+    } else {
+      ar = mingw_ar
+    }
+    if (mingw_ld == "") {
+      ld = cxx
+    } else {
+      ld = mingw_ld
+    }
+    if (mingw_strip != "") {
+      strip = mingw_strip
+    }
+    readelf = "${toolprefix}readelf"
+    nm = "${toolprefix}nm"
+
+    # Windows PE executables always carry the .exe extension.
+    executable_extension = ".exe"
+
+    enable_linker_map = false
+
+    toolchain_args = {
+      current_cpu = invoker.current_cpu
+      current_os = "win"
+      use_remoteexec = false
+      use_reclient = false
+    }
+  }
+}
+
+mingw_toolchain("x64") {
+  current_cpu = "x64"
+}
+
+mingw_toolchain("x86") {
+  current_cpu = "x86"
+}
+
+mingw_toolchain("arm64") {
+  current_cpu = "arm64"
+}
